<link href="Resources/AnnouncementText.less" rel="stylesheet" type="text/css" />
<div id="popup_container_text" style="top: {top}px; left: {left}px; position: fixed; z-index: 99999; padding: 0pt; margin: 0pt; position:absolute;" class="ui-draggable">
    <div class="{toptitlepopup}">
        <div class='closeAd'>
            <a href="javascript:;" onclick="RemoveAnnouncement();" title="{static:Resources.Lang.close}">
                <img src="Resources/Images/iconClose.png" style="border: 0px" alt="{static:Resources.Lang.close}" />
            </a>
        </div>
    </div>
    <div class="paddingleft">
        <div class="linebg">
            <div>
                <div class="message">
                    {content}
                </div>
                <div class="showAd">
                    <input type="checkbox" class='pointer' id="chkHide" onclick="DoNotShowAnnoucement(this.checked)" />
                    <label for="chkHide" class='pointer'> {static:Resources.Lang.donotshowagain}</label>
                </div>
            </div>
            <div class='lineblue'></div>
            <div class='linewhite'></div>
        </div>
        <div class="bottomborder"></div>
    </div>
    
</div>
<input id="announcementCookiesId" value="{announcementCookiesId}" type="hidden" />
<input id="popUpId" value="{popUpId}" type="hidden" />

