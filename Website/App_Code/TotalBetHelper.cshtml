@helper FormatValue(decimal value)
    {
       
        if (value != 0)
        {
            if (Math.Round(value) < 0)
            {
    <font color='red'>@Fanex.Age.Utility.Formater.DecFormat(value, 0) </font>       
            }
            else
            {
    @Fanex.Age.Utility.Formater.DecFormat(value, 0)
            }
        }
}

@helper FormatPositiveNumber(decimal value)
{
    if (Math.Round(value) > 0)
    { 
        <font color='red'> @Fanex.Age.Utility.Formater.FormatNumber2(value, "en-US") </font>
    }
    else
    { 
         @Html.Raw(Fanex.Age.Utility.Formater.FormatNumber2(value, "en-US"))
    }
}