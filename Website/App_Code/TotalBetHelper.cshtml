@helper FormatNegativeNumber(decimal value, byte numDecimals = 0, bool showZero = false)
{
    if (value != 0 || showZero)
    {
        if (Math.Round(value, numDecimals) < 0)
        {
            <span class="red-num">@Fanex.Age.Utility.Formater.DecFormat(value, numDecimals) </span>       
        }
        else
        {
            @Fanex.Age.Utility.Formater.DecFormat(value, numDecimals)
        }
    }
}

@helper FormatPositiveNumber(decimal value, byte numDecimals = 0, bool showZero = false)
{
    if (value != 0 || showZero)
    {
        if (Math.Round(value, numDecimals) > 0)
        { 
            <span class="red-num">@Fanex.Age.Utility.Formater.DecFormat(value, numDecimals) </span>
        }
        else
        { 
            @Fanex.Age.Utility.Formater.DecFormat(value, numDecimals)
        }
    }
}

@helper FormatNumber(decimal value, byte numDecimals = 0, bool showZero = false)
{
    if (value != 0 || showZero)
    {
        @Fanex.Age.Utility.Formater.DecFormat(value, numDecimals)
    }
}