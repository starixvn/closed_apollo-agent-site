@helper RenderMainShareHolderDropDownList(int currentMainShareHolderId, IEnumerable<Apollo.Age.Entities.Agent> mainShareHolders)
    {
    <div id="main-shareholder-box" class="box-header">
        <div class="row">
            <div class="cell">
                <div class="label">
                    <label for="ddlLeague">@Resources.Lang.lblMainShareHolder</label>
                </div>
                <div class="editor">
                    @{
                        if (mainShareHolders != null && mainShareHolders.Any())
                        {
                        <select id='ddlMainShareHolder' name='ddlMainShareHolder' style="width: 280px">
                            @{
                            var selectedString = string.Empty;
                            foreach (var mainShareHolder in mainShareHolders)
                            {
                                if (mainShareHolder.Id == currentMainShareHolderId)
                                {
                                    selectedString = "selected='selected'";
                                }
                                else
                                {
                                    selectedString = string.Empty;
                                }
                                <option value="@mainShareHolder.Id" @(selectedString) >@mainShareHolder.Username</option>
                            }
                            }
                        </select>
                        }
                    }
                </div>
            </div>
        </div>
    </div>
}