        <td colspan="@colspan">
            @Resources.Lang.noInfo
        </td>
    </tr>
    <!--/NotFoundContent-->
}
@helper RefreshCountDown(string refreshCountDownId, int initCountDown = 15, int fromSecond = 15, string onRefresh = "location.reload();")
    {
    <div class="btnCountDown clearfix">
        <div id="CountDownRefresh" class="btnRefresh" title="@Resources.Lang.refresh" onclick="CountDownRefresh_Refresh();">
        </div>
        <div class="btnDown" id="btnDown" onclick="CountDownRefresh_DoOpenOption(this);">
        </div>
    </div>
    <div id="CountDownMenu" class="panelDown" style="display: none">
        <!--Seconds-->
        @for (int i = 1; i < 6; i++)
        {
            <div id="option@(i)" class="menuitem {OptionClass}" onclick="CountDownRefresh_SaveOption(this.id)">
                @(fromSecond + i * 15)@Resources.Lang.sec
            </div>
        }
        <!--/Seconds-->
    </div>

    <script type="text/javascript">
        var refreshCountDownId = "@refreshCountDownId";
        var initCountDown = @initCountDown;
        var loadingTxt = "<span class='miniloading'>Loading</span>";
        var countDownRefreshFunc= "@onRefresh";
    </script>
}
@helper FormatNegativeNumber(decimal value, byte numDecimals = 0, bool showZero = false)
    {
        if (value != 0 || showZero)
        {
            if (Math.Round(value, numDecimals) < 0 || (numDecimals == 0 && value < 0))
            {
    <span class="red-num">@Formater.DecFormat(value, numDecimals)
    </span>
            }
            else
            {
    @Formater.DecFormat(value, numDecimals)
            }
        }
}
@helper FormatPositiveNumber(decimal value, byte numDecimals = 0, bool showZero = false)
    {
        if (value != 0 || showZero)
        {
            if (Math.Round(value, numDecimals) > 0 || (numDecimals == 0 && value > 0))
            {
    <span class="red-num">@Formater.DecFormat(value, numDecimals)
    </span>
            }
            else
            {
    @Formater.DecFormat(value, numDecimals)
            }
        }
}
@helper FormatPositiveNumber(decimal? value, byte numDecimals = 0, bool showZero = false)
    {
        if (value != null && (value.Value != 0 || showZero))
        {
            if (Math.Round(value.Value, numDecimals) > 0 || (numDecimals == 0 && value > 0))
            {
    <span class="red-num">@Formater.DecFormat(value.Value, numDecimals)
    </span>
            }
            else
            {
    @Formater.DecFormat(value, numDecimals)
            }
        }
}
@helper FormatNumber(decimal value, byte numDecimals = 0, bool showZero = false)
{
    if (value != 0 || showZero)
    {
		@Formater.DecFormat(value, numDecimals)
    }
}
@helper FormatComm(decimal value)
{
	<text>@string.Format("{0:#,##0.00}", value)</text>
}
@helper Navigation(List<Apollo.Age.Entities.Agent> Model)
    {
    <div id="divnavigation" class="boxNavigation">
        @foreach (Apollo.Age.Entities.Agent item in Model)
        {
            var last = Model.LastOrDefault();
            if (last != null && !last.Equals(item))
            { <a href="javascript:void(0);" name="navigation" class="navigation" agentid="@item.Id">@item.Username</a>
            <span class="breadcrumbs"></span>
            }
            else
            { <span>@item.Username</span> }
        }
    </div>
}
@helper Navigation(List<Apollo.Age.Entities.Agent> Model, bool linkLastItem)
    {
        if (linkLastItem)
        {
    <div id="divnavigation" class="boxNavigation">
        @foreach (Apollo.Age.Entities.Agent item in Model)
        {
            var last = Model.LastOrDefault();
            if (last != null && !last.Equals(item))
            {
            <a href="javascript:void(0);" name="navigation" class="navigation" agentid="@item.Id">@item.Username</a>
            <span class="breadcrumbs"></span>
            }
            else
            {
            <a href="javascript:void(0);" name="navigation" class="navigation" agentid="@item.Id">@item.Username</a>
            }
        }
    </div>
        }
        else
        {
            RazorHelper.Navigation(Model);

        }
}
@helper Piwik ()
{
    <!-- Piwik -->
    <script type="text/javascript">
        var pkBaseURL = (("https:" == document.location.protocol) ? "https://10.18.200.204:7777/" : "http://10.18.200.204:7777/");
        document.write(unescape("%3Cscript src='" + pkBaseURL + "piwik.js' type='text/javascript'%3E%3C/script%3E"));
    </script>
    <script type="text/javascript">
        try {
            var piwikTracker = Piwik.getTracker(pkBaseURL + "piwik.php", 5);
            piwikTracker.trackPageView();
            piwikTracker.enableLinkTracking();
        } catch (err) { }
    </script>
    <noscript>
        <p>
            <img src="http://10.18.200.204:7777/piwik.php?idsite=5" style="border: 0" alt="" /></p>
    </noscript>
    <!-- End Piwik Tracking Code -->
}