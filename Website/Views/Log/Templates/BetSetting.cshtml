@using Apollo.Age.Account.Models
@using Apollo.Age.Resources
@model List<BetSettingModel>
@if (!ReferenceEquals(Model, null) && Model.Any())
{
    var isShowOld = (bool)ViewBag.IsShowOldValue;
    
    <table class="tblRpt">
        <tr class="no-border-top">
            <td class="colW1 sub-title">            
            </td>
            <td class="colW1 sub-title">
                @Lang.lblMinBet
            </td>
            <td class="colW1 sub-title">
                @Lang.lblMaxBet
            </td>
            <td class="colW1 no-border-right sub-title">
                @Lang.lblMaxPerMatch
            </td>
        </tr>
        @foreach (var item in Model)
        {
            var sportName = item.SportName;
            <tr>
                <td class="colW1">
                    @sportName
                </td>
                <td class="colW2">
                    @ToString(isShowOld, item.OldMinBet, item.MinBet)
                </td>
                <td class="colW2">
                    @ToString(isShowOld, item.OldMaxBet, item.MaxBet)
                </td>
                <td class="colW2 no-border-right">
                    @ToString(isShowOld, item.OldMaxPerMatch, item.MaxPerMatch)
                </td>
            </tr>
        }
    </table>
}
@helper ToString(bool isShowOld, decimal oldValue, decimal newValue)
    {
        string strOld = Math.Round(oldValue, 0).ToString("#,#");
        string strNew = Math.Round(newValue, 0).ToString("#,#");

        if (oldValue != newValue)
        { <span class="valuechanged" title="@Lang.OldValue : @strOld">@strNew</span> 
            if (isShowOld)
            {
   <span>| </span><span class="valueold">@strOld</span>
            }
        }
        else
        { <span class="valueold">@strOld</span>
        }            
}