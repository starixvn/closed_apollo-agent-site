@using Apollo.Age.Enumerations
@using Apollo.Age.Account.Models
@using Apollo.Age.Resources
@model List<DiscountModel>
@if (!ReferenceEquals(Model, null) && Model.Any())
{
    var isShowOld = (bool)ViewBag.IsShowOldValue;
    var oldGroup = (string)ViewBag.OldGroup;
    var group = (string)ViewBag.Group;
    
    <table class="tblRpt">
        <tr class="colW">
            <td>
                @Lang.group
            </td>
            <td colspan="2">
                @Lang.membercomm
            </td>
        </tr>
        <tr>
            <td class="colW2" rowspan="3">
                @if (oldGroup != group)
                { 
                    <span class="valuechanged">@group</span>                        
                    if (isShowOld)
                    {
                    <div class="line">
                    </div>
                    <span class="valueold">@oldGroup</span>
                    }
                }
                else
                { 
                    <span class="valueold">@oldGroup</span>
                }
            </td>
            <td class="colW">
                @Lang.hdp, @Lang.lblOU, @Lang.lblOE
            </td>
            <td class="colW2">
                @foreach (var item in Model)
                {
                    if (item.BetType == (int)BetTypes.Handicap)
                    {
                    @ToString(isShowOld, item.OldGroupA, item.GroupA);
                    }
                }
            </td>
        </tr>
        <tr>
            <td class="colW">
                @Lang.lbl1x2Comm
            </td>
            <td class="colW2">
                @foreach (var item in Model)
                {
                    if (item.BetType == (int)BetTypes.FT_1X2)
                    {
                    @ToString(isShowOld, item.OldGroupA, item.GroupA);
                    }
                }
            </td>
        </tr>
        <tr>
            <td class="colW">
                @Lang.lblOtherComm
            </td>
            <td class="colW2">
                @foreach (var item in Model)
                {
                    if (item.BetType == (int)BetTypes.Correct_Score)
                    {
                    @ToString(isShowOld, item.OldGroupA, item.GroupA);
                    }
                }
            </td>
        </tr>
    </table>
}
@helper ToString(bool isShowOld, decimal oldValue, decimal newValue)
    {
        string strOld = Math.Round(oldValue * 100, 2).ToString();
        string strNew = Math.Round(newValue * 100, 2).ToString();

        if (oldValue != newValue)
        { <span class="valuechanged">@strNew</span> 
            if (isShowOld)
            {
    <div class="line">
    </div>
    <span class="valueold">@strOld</span> 
            }
        }
        else
        { <span class="valueold">@strOld</span>
        }            
}