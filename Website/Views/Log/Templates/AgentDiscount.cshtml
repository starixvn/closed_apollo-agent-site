@model List<Apollo.Age.Account.Models.DiscountModel>
@if (!ReferenceEquals(Model, null) && Model.Any())
{
    var isShowOld = (bool)ViewBag.IsShowOldValue;

    var group = new Apollo.Age.Account.Models.DiscountModel();
    var group1x2 = new Apollo.Age.Account.Models.DiscountModel();
    var groupOthers = new Apollo.Age.Account.Models.DiscountModel();

    foreach (var item in Model)
    {
        if (item.SportType == 1 && item.BetType == 1)
        {
            group = item;
        }
        if (item.SportType == 1 && item.BetType == 4)
        {
            groupOthers = item;
        }
        if (item.SportType == 1 && item.BetType == 5)
        {
            group1x2 = item;
        }
    }
    
    <table class="tblRpt">
        <tr>
            <td class="colW1">
                @Apollo.Age.Resources.Lang.lblGroupa
            </td>
            <td class="colW2">
                @if (group.GroupA != group.OldGroupA)
                { <span class="valuechanged">@group.GroupA</span> 
                    if (isShowOld)
                    {
                    <div class="line">
                    </div>
                    <span class="valueold">@group.OldGroupA</span> 
                    }
                }
                else
                { <span class="valueold">@group.OldGroupA</span>
                }
            </td>
            <td class="colW1">
                @Apollo.Age.Resources.Lang.lblGroupb
            </td>
            <td class="colW2">
                @if (group.GroupB != group.OldGroupB)
                { <span class="valuechanged">@group.GroupB</span> 
                    if (isShowOld)
                    {
                    <div class="line">
                    </div>
                    <span class="valueold">@group.OldGroupB</span> 
                    }
                }
                else
                { <span class="valueold">@group.OldGroupB</span>
                }
            </td>
            <td class="colW1">
                @Apollo.Age.Resources.Lang.lblGroupc
            </td>
            <td class="colW2">
                @if (group.GroupC != group.OldGroupC)
                { <span class="valuechanged">@group.GroupC</span> 
                    if (isShowOld)
                    {
                    <div class="line">
                    </div>
                    <span class="valueold">@group.OldGroupC</span> 
                    }
                }
                else
                { <span class="valueold">@group.OldGroupC</span>
                }
            </td>
        </tr>
        <tr>
            <td class="colW1">
                @Apollo.Age.Resources.Lang.lblGroupd
            </td>
            <td class="colW2">
                @if (group.GroupD != group.OldGroupD)
                { <span class="valuechanged">@group.GroupD</span> 
                    if (isShowOld)
                    {
                    <div class="line">
                    </div>
                    <span class="valueold">@group.OldGroupD</span> 
                    }
                }
                else
                { <span class="valueold">@group.OldGroupD</span>
                }
            </td>
            <td class="colW1">
                @Apollo.Age.Resources.Lang.lbl1x2Comm
            </td>
            <td class="colW2">
                @if (group1x2.GroupA != group1x2.OldGroupA)
                { <span class="valuechanged">@group1x2.GroupA</span> 
                    if (isShowOld)
                    {
                    <div class="line">
                    </div>
                    <span class="valueold">@group1x2.OldGroupA</span> 
                    }
                }
                else
                { <span class="valueold">@group1x2.OldGroupA</span>
                }
            </td>
            <td class="colW1">
                @Apollo.Age.Resources.Lang.lblOtherComm
            </td>
            <td class="colW2">
                @if (groupOthers.GroupA != groupOthers.OldGroupA)
                { <span class="valuechanged">@groupOthers.GroupA</span> 
                    if (isShowOld)
                    {
                    <div class="line">
                    </div>
                    <span class="valueold">@groupOthers.OldGroupA</span> 
                    }
                }
                else
                { <span class="valueold">@groupOthers.OldGroupA</span>
                }
            </td>
        </tr>
    </table>
}
