@using Apollo.Age.Enumerations
@using Apollo.Age.Account.Models
@model List<DiscountModel>
@if (!ReferenceEquals(Model, null) && Model.Any())
{
    var isShowOld = (bool)ViewBag.IsShowOldValue;

    var group = new DiscountModel();
    var group1x2 = new DiscountModel();
    var groupOthers = new DiscountModel();

    foreach (var item in Model)
    {
        switch (item.BetType)
        {
            case (int)BetTypes.Handicap:
                group = item;
                break;
            case (int)BetTypes.Correct_Score:
                groupOthers = item;
                break;
            case (int)BetTypes.FT_1X2:
                group1x2 = item;
                break;
        }
    }
    
    <table class="tblRpt">
        <tr>
            <td class="colW1">
                @Apollo.Age.Resources.Lang.lblGroupa
            </td>
            <td class="colW2">
                @ToString(isShowOld, group.OldGroupA, group.GroupA)
            </td>
            <td class="colW1">
                @Apollo.Age.Resources.Lang.lblGroupb
            </td>
            <td class="colW2">
                @ToString(isShowOld, group.OldGroupB, group.GroupB)
            </td>
            <td class="colW1">
                @Apollo.Age.Resources.Lang.lblGroupc
            </td>
            <td class="colW2">
                @ToString(isShowOld, group.OldGroupC, group.GroupC)
            </td>
        </tr>
        <tr>
            <td class="colW1">
                @Apollo.Age.Resources.Lang.lblGroupd
            </td>
            <td class="colW2">
                @ToString(isShowOld, group.OldGroupD, group.GroupD)
            </td>
            <td class="colW1">
                @Apollo.Age.Resources.Lang.lbl1x2Comm
            </td>
            <td class="colW2">
                @ToString(isShowOld, group1x2.OldGroupA, group1x2.GroupA)
            </td>
            <td class="colW1">
                @Apollo.Age.Resources.Lang.lblOtherComm
            </td>
            <td class="colW2">
                @ToString(isShowOld, groupOthers.OldGroupA, groupOthers.GroupA)
            </td>
        </tr>
    </table>
}
@helper ToString(bool isShowOld, decimal oldValue, decimal newValue)
    {
        string strOld = Math.Round(oldValue * 100, 2).ToString();
        string strNew = Math.Round(newValue * 100, 2).ToString();

        if (oldValue != newValue)
        { <span class="valuechanged">@strNew</span> 
            if (isShowOld)
            {
    <div class="line">
    </div>
    <span class="valueold">@strOld</span> 
            }
        }
        else
        { <span class="valueold">@strOld</span>
        }
}