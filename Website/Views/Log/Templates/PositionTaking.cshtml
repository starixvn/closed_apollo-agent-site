@model List<Apollo.Age.Account.Models.PositionTakingModel>
@if (!ReferenceEquals(Model, null) && Model.Any())
{
    var isShowOld = (bool)ViewBag.IsShowOldValue;

    var agentLevel = (int)ViewBag.AgentLevel;

    var isAgent = (bool)ViewBag.IsAgent;

    var listPTGroupBySport = Model.GroupBy(m => m.SportType);

    var isHaveLive = false;

    var itemMixSport = new Apollo.Age.Account.Models.PositionTakingModel();
    
    <table class="tblRpt">
        @foreach (var itemSport in listPTGroupBySport)
        {
            var itemSportFirst = itemSport.FirstOrDefault();        
            <tr>
                @if (itemSportFirst.SportType == 1)
                { 
                    <td colspan="6">
                        @itemSportFirst.SportName - @Apollo.Age.Resources.Lang.lblDeadball
                    </td>
                }
                else
                {
                    <td colspan="6">
                        @itemSportFirst.SportName
                    </td>
                }
            </tr>    
                int index = 0;
                int wide = 5;

                var listItemSport = itemSport.OrderBy(m => m.IsLive).ToList();

                if (itemSportFirst.SportType == 99)
                {
                    itemMixSport = listItemSport[3];
                    listItemSport.RemoveAt(3);

                }

                while (index < listItemSport.Count)
                {
                    var itemBet = listItemSport[index];

                    if (itemBet.SportType == 1 && itemBet.IsLive && !isHaveLive)
                    {
            <tr>
                <td colspan="6">
                    @itemSport.FirstOrDefault().SportName - @Apollo.Age.Resources.Lang.lblLive
                </td>
            </tr>    
                        isHaveLive = true;
                    }      
                    
            <tr>
                <td class="colW1">
                </td>
                @for (int i = index; i < wide && i < listItemSport.Count; i++)
                {     
                    <td class="colW1">
                        @listItemSport[i].BetName
                    </td>                                   
                }
            </tr>
                if (isAgent)
                { 
            <tr>
                <td class="colW1">
                    @Apollo.Age.Resources.Lang.lblMaxGivenShare
                </td>
                @for (int i = index; i < wide && i < listItemSport.Count; i++)
                {    
                    <td class="colW2">
                        @ToString(isShowOld, listItemSport[i].OldMaxGiven, listItemSport[i].MaxGiven)
                    </td>
                }
            </tr>
                }
                if (agentLevel != 1)
                { 
            <tr>
                <td class="colW1">
                    @if (isAgent)
                    { 
                        @Apollo.Age.Resources.Lang.lblMaxTakenShare
                    }
                    else
                    {
                        @Apollo.Age.Resources.Lang.lblTakenShare
                    }
                </td>
                @for (int i = index; i < wide && i < listItemSport.Count; i++)
                {                  
                    <td class="colW2">
                        @ToString(isShowOld, listItemSport[i].OldMaxUpper, listItemSport[i].MaxUpper)
                    </td>
                }
            </tr>
                }
                if (isAgent)
                { 
            <tr>
                <td class="colW1">
                    @Apollo.Age.Resources.Lang.lblMinGivenShare
                </td>
                @for (int i = index; i < wide && i < listItemSport.Count; i++)
                {                   
                    <td class="colW2">
                        @ToString(isShowOld, listItemSport[i].OldMinGiven, listItemSport[i].MinGiven)
                    </td>
                }
            </tr>
                }
                index = index + 5;
                wide += wide;
                }
        }
        <tr>
            <td colspan="6">
                @Apollo.Age.Resources.Lang.lblMixParlay
            </td>
        </tr>
        <tr>
            <td class="colW1">
            </td>
            <td class="colW1">
                @itemMixSport.BetName
            </td>
        </tr>
        @if (isAgent)
        { 
            <tr>
                <td class="colW1">
                    @Apollo.Age.Resources.Lang.lblMaxGivenShare
                </td>
                <td class="colW2">
                    @ToString(isShowOld, itemMixSport.OldMaxGiven, itemMixSport.MaxGiven)
                </td>
            </tr>
        }
        @if (agentLevel != 1)
        { 
            <tr>
                <td class="colW1">
                    @if (isAgent)
                    { 
                        @Apollo.Age.Resources.Lang.lblMaxTakenShare
                    }
                    else
                    {
                        @Apollo.Age.Resources.Lang.lblTakenShare
                    }
                </td>
                <td class="colW2">
                    @ToString(isShowOld, itemMixSport.OldMaxUpper, itemMixSport.MaxUpper)
                </td>
            </tr>
        }
        @if (isAgent)
        { 
            <tr>
                <td class="colW1">
                    @Apollo.Age.Resources.Lang.lblMinGivenShare
                </td>
                <td class="colW2">
                    @ToString(isShowOld, itemMixSport.OldMinGiven, itemMixSport.MinGiven)
                </td>
            </tr>
        }
    </table>
}
@helper ToString(bool isShowOld, decimal oldValue, decimal newValue)
    {
        string strOld = Math.Round(oldValue / 100, 2).ToString();
        string strNew = Math.Round(newValue / 100, 2).ToString();

        if (oldValue != newValue)
        { <span class="valuechanged">@strNew</span> 
            if (isShowOld)
            {
    <div class="line">
    </div>
    <span class="valueold">@strOld</span> 
            }
        }
        else
        { <span class="valueold">@strOld</span>
        }            
}