@{
	Layout = "~/Views/Instruction/Shared/_Layout.cshtml";
}

<div class="instruction-content">
	<ul>
		<li>Given Share (%): the share amount which will be given to a main shareholder.</li>
	    <li>[x - y]: input range. If K is the entered amount, then K must be: x <= K <= y.</li>
    </ul>
	<p>
		<span class="note">Note:</span> only allow two numbers after the decimal point. For instance, 100.25 is a valid input, but 100.555 is not.
	</p>
</div>