@{    
    Layout = null;
}
@using Apollo.Age.Web.Mvc
@model GetMessageCriteria
<!--calendar-include-->
<link href="~/_GlobalResources/Css/jquery-ui-1.10.2/apollo/jquery-ui.min.css" rel="stylesheet"
    type="text/css" />
<!--/calendar-include-->
<link href="~/App_Themes/AgencyV2/message.less" rel="stylesheet" type="text/css">
<div id="page_main">
    <div id="header_main">
        @Resources.Lang.messagetitle
    </div>
    <div id="content_main">
        <div id="box_header">
            <div class="date-range">
                <!--DateTimeSearch-->
                <div class="date">
                    <label>
                        @Resources.Lang.from</label>
                    @*<input id="{txtDate}" class="{TxtDateCls} input-date" value="{currentDate}" type="text"
                        size="13" name="{txtDate}" />*@
                    @Html.DatePickerFor(m => m.From)
                </div>
                <div class="date">
                    <label>
                        @Resources.Lang.to</label>
                    @Html.DatePickerFor(m => m.To)
                </div>
                <!--/DateTimeSearch-->
                <input type="button" class="btn" style="width: 55px" id="dSubmit" value="@Resources.Lang.submit"
                    onclick="javascript:showMsg('');" />
            </div>
        </div>
        <table class="tblRpt">
            <thead>
                <tr>
                    <td colspan="4" class="tbList">
                        <ul>
                            <li><a href="javascript:showMsg('normal');"><span>@Resources.Lang.normalmessage</span></a></li>
                            <li><span class="line">|</span><a href="javascript:showMsg('special');"><span>@Resources.Lang.specialmessage</span></a></li>
                            <li><span class="line">|</span><a href="javascript:showMsg('private');"><span>@Resources.Lang.personalmessage</span></a></li>
                        </ul>
                    </td>
                </tr>
                <tr class="RptHeader">
                    <td width="20px">
                        @Resources.Lang.no
                    </td>
                    <td width="60px">
                        @Resources.Lang.messageIDHeader
                    </td>
                    <td width="80px">
                        @Resources.Lang.lblPostdate
                    </td>
                    <td>
                        @Resources.Lang.lblMessage
                    </td>
                </tr>
            </thead>
            <tbody>
                <!--MsgContent-->
                <tr bgcolor="{clor-class}" onmouseover="bgColor='{clor-over}'" onmouseout="bgColor='{clor-class}'">
                    <td class="w_order_ms">
                        {No}
                    </td>
                    <td class="c_ms">
                        {MessageID}
                    </td>
                    <td class="bl_time_ms">
                        {PostDate}
                    </td>
                    <td class="message_content">
                        {Message}
                    </td>
                </tr>
                <!--/MsgContent-->
            </tbody>
        </table>
    </div>
</div>
<input type="hidden" name="eroMeg" id="eroMeg" value="@Resources.Lang.invalidDateMessage">
<input type="hidden" name="msgType" id="msgType" value="{msgType}">
<script src="~/_GlobalResources/Js/jquery.js" type="text/javascript"></script>
<script src="~/_GlobalResources/Js/jquery-ui.js" type="text/javascript"></script>
<script src="~/_GlobalResources/Js/Core.js" type="text/javascript"></script>
<script src="~/Views/Message/Resources/message.js" type="text/javascript"></script>
