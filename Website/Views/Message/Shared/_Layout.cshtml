<!DOCTYPE html>
<!--[if IE 7 ]> <html class="ie7 ie" lang="en"> <![endif]-->
<!--[if IE 8 ]> <html class="ie8 ie" lang="en"> <![endif]-->
<!--[if IE 9 ]> <html class="ie9 ie" lang="en"> <![endif]-->
<!--[if (gt IE 9)]><!--> <html class="ie10 ie" lang="en"> <!--<![endif]-->
<!--[if !(IE)]> <html lang="en"><![endif]-->
<head>
    <meta charset="utf-8" />
    <title>@ViewBag.Title</title>
    <meta name="viewport" content="width=device-width" />
    <link href="~/_GlobalResources/Css/jquery-ui-1.10.2/apollo/jquery-ui.min.css" rel="stylesheet"
        type="text/css" />
    @RenderSection("head", required: false)
</head>
<!-- Piwik -->
<script type="text/javascript">
    var pkBaseURL = ( ( "https:" == document.location.protocol ) ? "https://10.18.200.204:7777/" : "http://10.18.200.204:7777/" );
    document.write( unescape( "%3Cscript src='" + pkBaseURL + "piwik.js' type='text/javascript'%3E%3C/script%3E" ) );
</script>
<script type="text/javascript">
    try {
        var piwikTracker = Piwik.getTracker( pkBaseURL + "piwik.php", 5 );
        piwikTracker.trackPageView();
        piwikTracker.enableLinkTracking();
    } catch ( err ) { }
</script>
<noscript>
    <p>
        <img src="http://10.18.200.204:7777/piwik.php?idsite=5" style="border: 0" alt="" /></p>
</noscript>
<!-- End Piwik Tracking Code -->
<body>
    <div id="page_main">
        <div id="header_main">
            @ViewBag.Title
        </div>
        <div id="content_main">
            @RenderBody()
        </div>
    </div>
    @Html.Hidden("ApoRoot", Url.Content("~/"))
    <script src="~/_GlobalResources/Js/jquery.js" type="text/javascript"></script>
    <script src="~/_GlobalResources/Js/jquery-ui.js" type="text/javascript"></script>
    <script src="~/_GlobalResources/Js/jquery-ui-1.10.2/dialog.min.js" type="text/javascript"></script>
    <script src="~/_GlobalResources/Js/Core.js" type="text/javascript"></script>
    <script src="~/_Components/AGEWnd/AGEWnd.js" type="text/javascript"></script>
    <script src="~/_Components/Paging/Paging.js" type="text/javascript"></script>
    <script src="~/Views/Message/Resources/PortalPage.js" type="text/javascript"></script>
    @RenderSection("foot", required: false)
</body>
</html>