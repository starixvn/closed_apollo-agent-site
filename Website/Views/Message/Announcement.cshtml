@model IEnumerable<AnnouncementModel>
@{
	Layout = null;
	var userLang = ViewBag.UserLang as string;
}
@if (Model != null && Model.Any())
{
	var lastPostDate = ViewBag.LastPostTime.Date;
	var index = 0;

	foreach (var msg in Model)
	{
		index++;
		
		if (msg.PostTime.Date != lastPostDate)
		{
	<div class="divGroupDate">
		@msg.PostTime.Date.ToShortDateString()
	</div>
		}

		string ccs =
			(msg.IsRead ? msg.GetMessageType : string.Format("{0}_unread", msg.GetMessageType)) +
			(index % 2 == 0 ? " evenRow" : " oddRow");
		
	<div class="@ccs message clear" id="@msg.MessageId.ToString()" IsRead="@(msg.IsRead ? 1 : 0)">
		<div class="divTime">
			<div class="toogleIcon"></div>
			<div class="time">
				@msg.PostTime.ToLongTimeString()
			</div>
		</div>
		<div class="divContent">
			<div class="text_exposed_show small">
				@msg.GetSmallContent(userLang)
			</div>
			<div class="text_exposed_hide full">
				@msg.GetFullContent(userLang)
			</div>
		</div>
	</div>
		{ lastPostDate = msg.PostTime.Date; }

	}
	<div id="divMore">
		@Resources.Lang.more
	</div>
}
else
{
	<div class="no-info">
		@Resources.Lang.noInfo
	</div>
}