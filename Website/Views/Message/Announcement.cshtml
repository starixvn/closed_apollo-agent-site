@model IEnumerable<Apollo.Age.Account.ViewModels.AnnouncementViewModel>
@{
    Layout = null;
}
@if (Model != null && Model.Any())
{
    var lastPostDate = ViewBag.LastPostTime.Date;
    var index = 0;

    foreach (var msgItem in Model)
    {
        index++;
    <!--GroupDate-->
    <!--GroupTitle-->
        if (msgItem.PostTime.Date != lastPostDate)
        {
           
    <div class="divGroupDate">
        @msgItem.PostTime.Date.ToShortDateString()
    </div>
        }
    <!--/GroupTitle-->
    <!--DataRow-->
        var ccs = (msgItem.IsRead ? msgItem.GetMessageType : msgItem.GetMessageType + "_unread");
        ccs = index % 2 == 0 ? ccs + " evenRow" : ccs + " oddRow";
    <div class="@ccs" style="clear:both" id="@msgItem.MessageId.ToString()" onclick="ToggleAnnouncementContent('@msgItem.MessageId');"
        IsRead="@(msgItem.IsRead ? 1 : 0)">
        <div class="divTime">
            <div class="toogleIcon">
            </div>
            <div>
                @msgItem.PostTime.ToLongTimeString()
            </div>
        </div>
        <div class="divContent">
            <div class="text_exposed_show small">
                @msgItem.SmallContent
            </div>
            <div class="text_exposed_hide full">
                @msgItem.FullContent
            </div>
        </div>
    </div>
    <!--/DataRow-->
    <!--/GroupDate-->
        { lastPostDate = msgItem.PostTime.Date; }

    }
    <!--MoreFooter-->    
    <div id="divMore" onclick="ShowMoreAnnouncements();">
        {Resources.Lang.more} ...
    </div>
    <!--/MoreFooter-->
}
else
{
    <!--NoRow-->
    <div class="c">
        {Resources.Lang.NoRowInfo}
    </div>
    <!--/NoRow-->
}
