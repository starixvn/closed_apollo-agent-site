@model IEnumerable<Apollo.Age.TotalBets.ViewModels.TotalGoalViewModel>
<div id="page_main">
    <div id="header_main">
        {static:Resources.Lang.totalgoal}</div>
    [count down component]
    <div id="sContent">
        <table class="tblRpt">
            <thead>
                <tr class="RptHeader">
                    <td style="width: 20px;">
                        {static:Resources.Lang.no}
                    </td>
                    <td style="width: 150px;">
                        {static:Resources.Lang.home}
                    </td>
                    <td style="width: 150px;">
                        {static:Resources.Lang.away}
                    </td>
                    <td style="width: 80px;">
                        {static:Resources.Lang.total01}
                    </td>
                    <td style="width: 80px;">
                        {static:Resources.Lang.total23}
                    </td>
                    <td style="width: 80px;">
                        {static:Resources.Lang.total46}
                    </td>
                    <td style="width: 80px;">
                        {static:Resources.Lang.total7over}
                    </td>
                </tr>
            </thead>
            <tbody>
                @{
                    int count = 0;
                    foreach (var item in Model)
                    {
                        count++;
                    <tr class="RptHeader">
                        <td style="width: 20px;">
                            @count
                        </td>
                        <td style="width: 150px;">
                            @item.HomeTeam
                        </td>
                        <td style="width: 150px;">
                            @item.AwayTeam
                        </td>
                        <td style="width: 80px;">
                            @item.Total01
                        </td>
                        <td style="width: 80px;">
                            @item.Total23
                        </td>
                        <td style="width: 80px;">
                            @item.Total46
                        </td>
                        <td style="width: 80px;">
                            @item.Total7Over
                        </td>
                    </tr>
                    }
                }
            </tbody>
        </table>
    </div>
</div>
