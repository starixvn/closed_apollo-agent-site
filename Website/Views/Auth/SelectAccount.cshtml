@model Apollo.Age.Web.ViewModels.InternalSelectAccountViewModel
@{
	string title = Apollo.Age.Resources.Lang.SignInAsAgent;
	ViewBag.Title = title;
}

@section css {
	<link href="~/Views/Auth/Resources/style.css" rel="stylesheet" type="text/css" />
}

<div class="login-box">
@using (Html.BeginForm())
{
	<h1>@title</h1>
	<p class="username">
		@Html.LabelFor(m => m.Agent)
		@Html.TextBoxFor(m => m.Agent, new { @class = "input-textbox", autocomplete = "off" })
	</p>	
		
	if (!ViewData.ModelState.IsValid)
	{
		@Html.ValidationSummary()
	}
	<p>
		<input type="submit" value="@Apollo.Age.Resources.Lang.Continue &rarr;" />
	</p>
}
</div>