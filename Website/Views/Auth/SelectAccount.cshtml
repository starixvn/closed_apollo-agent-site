@model Apollo.Age.Web.ViewModels.InternalSelectAccountViewModel
@{
    
}
@section css {
	<link href="~/Views/Auth/Resources/style.css" rel="stylesheet" type="text/css" />
}

<div class="login-box">
@using (Html.BeginForm())
{
	<h1>Login as</h1>
	<p class="username">
		@Html.LabelFor(m => m.Agent)
		@Html.TextBoxFor(m => m.Agent, new { @class = "input-textbox" })
	</p>	
    	
    if (!ViewData.ModelState.IsValid)
    {
		@Html.ValidationSummary()
    }
	<p>
		<input type="submit" value="Go..." />
	</p>
}
</div>