
@model Apollo.Age.Web.ViewModels.SignIn2ViewModel
@{
	ViewBag.Title = "Sign In";
}

@section css {
	<link href="~/Views/Auth/Resources/style.css" rel="stylesheet" type="text/css" />
}

<div class="login-box">
@using (Html.BeginForm())
{
	<h1>Sign In</h1>
	<p class="username">
		@Html.LabelFor(m => m.Username)
		@Html.TextBoxFor(m => m.Username)
	</p>
	<p>
		@Html.LabelFor(m => m.Password)
		@Html.PasswordFor(m => m.Password)
	</p>
	<p>
		@Html.LabelFor(m=>m.Captcha)
        @Html.EditorFor(m => m.Captcha)
		
        
	</p>
    <p> 
   
        <a href="@Url.Action("SignIn2")"> 
            <img alt="Captcha" src="@Url.Action("CaptchaImage")" style="" /> 
        </a>  
    </p>
    if (!ViewData.ModelState.IsValid)
    {
		@Html.ValidationSummary()
    }
	<p>
		<input type="submit" value="Sign In" />
	</p>
}
</div>