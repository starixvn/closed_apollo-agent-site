
@model Apollo.Age.Web.ViewModels.SignIn2ViewModel
@{
	ViewBag.Title = "Sign In";
}

@section css {
	<link href="~/Views/Auth/Resources/style.css" rel="stylesheet" type="text/css" />
}

<div class="login-box">
@using (Html.BeginForm())
{
	<h1>Sign In</h1>
	<p class="username">
		@Html.LabelFor(m => m.Username)
		@Html.TextBoxFor(m => m.Username, "width:220px")
	</p>
	<p>
		@Html.LabelFor(m => m.Password)
		@Html.PasswordFor(m => m.Password, "width:220px")
	</p>

    <p> 
        @Html.LabelFor(m=>m.Captcha)
        <img alt="Captcha" src="@Url.Action("CaptchaImage")" onclick="location.href='@Url.Action("SignIn2")';" />  
        @Html.TextBoxFor(m => m.Captcha, "width:70px")		
    </p>    	
    if (!ViewData.ModelState.IsValid)
    {
		@Html.ValidationSummary()
    }
	<p>
		<input type="submit" value="Sign In" />
	</p>
}
</div>