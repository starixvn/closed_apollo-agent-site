<!DOCTYPE html>
<html lang="en-us">
    <head>
        <meta charset="utf-8" />
        <meta name="viewport" content="width=device-width" />
        <title>@ViewBag.Title</title>
        <link href="~/_GlobalResources/Css/jquery-ui-1.10.2/apollo/jquery-ui.min.css" rel="stylesheet" type="text/css" />
        <link href="~/Views/Admin/Resources/Admin.less" rel="stylesheet" type="text/css" />

        @RenderSection("head", required: false)
    </head>
    <body>
        <div id="page_main">
            <div id="header_main">
                @ViewBag.Title
            </div>
            <div id="content_main">
                @RenderBody()
            </div>
        </div>

    <script src="~/_GlobalResources/Js/jquery.js" type="text/javascript"></script>
    <script src="~/_GlobalResources/Js/jquery-ui.js" type="text/javascript"></script>
    <script src="~/_GlobalResources/Js/Core.js" type="text/javascript"></script>    

    @RenderSection("foot", required: false)

    </body>
</html>