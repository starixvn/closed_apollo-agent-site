@model Apollo.Age.Web.ViewModels.SignInViewModel
@{
    string SIGN_IN = Apollo.Age.Resources.Lang.SignIn;
    ViewBag.Title = SIGN_IN;
}
@section css {
    <link href="~/Views/Internal/Resources/style.css" rel="stylesheet" type="text/css" />
}
<div class="login-box">
    @using (Html.BeginForm())
    {
        <h1>@SIGN_IN</h1>
        <p class="username">
            @Html.LabelFor(m => m.Username)
            @Html.TextBoxFor(m => m.Username, new { @class = "input-textbox" })
        </p>
        <p>
            @Html.LabelFor(m => m.Password)
            @Html.PasswordFor(m => m.Password, new { @class = "input-textbox" })
        </p>
        if (!ViewData.ModelState.IsValid)
        {
        @Html.ValidationSummary()
        }
        <p>
            <input type="submit" value="@SIGN_IN" />
        </p>
    }
</div>