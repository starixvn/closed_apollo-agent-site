@model Apollo.Age.Web.ViewModels.InternalSignInViewModel
@{
    string title = Apollo.Age.Resources.Lang.SignIn;
    ViewBag.Title = title;
}

@section css {
    <link href="~/Views/Internal/Resources/style.css" rel="stylesheet" type="text/css" />
}
<div class="login-box">
    @using (Html.BeginForm())
    {
        <h1>@title</h1>
        <p class="username">
            @Html.LabelFor(m => m.Username)
            @Html.TextBoxFor(m => m.Username, new { @class = "input-textbox", autocomplete = "off" })
        </p>
        <p>
            @Html.LabelFor(m => m.Password)
            @Html.PasswordFor(m => m.Password, new { @class = "input-textbox", autocomplete = "off" })
        </p>
        <p>
            @Html.LabelFor(m => m.Captcha)
            <img src="@Url.Action("CaptchaImage")" id="img-captcha" alt="Captcha" />
            @Html.TextBoxFor(m => m.Captcha, new { @class = "input-captcha", autocomplete = "off" })
            <label>
            </label>
            <em>@Apollo.Age.Resources.Lang.CaptchaInstruction</em>
        </p>
        if (Apollo.Age.Configurations.AppSettings.AllowInternalUpdate)
        {
        <p>
            @Html.LabelFor(m => m.AllowUpdates, Apollo.Age.Resources.Lang.allowupdates)
            @Html.CheckBoxFor(m => m.AllowUpdates)
        </p>
        }
        <p>
       
            <label for="Language">Langues</label>
            @Html.DropDownListFor(m => m.Language, Model.Languages)
        </p>
        if (!ViewData.ModelState.IsValid)
        {
        @Html.ValidationSummary()
        }
        <p>
            <input type="submit" value="@title" />
        </p>
    }
</div>
@section scripts {
    <script type="text/javascript">

        window.onload = function () {
            document.getElementById('img-captcha').onclick = function () {
                window.location.reload();
            };
        };

    </script>
}