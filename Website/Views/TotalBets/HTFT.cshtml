@using Apollo.Age.TotalBets.ViewModels
@{
    Layout = "~/Views/TotalBets/Shared/_Layout.cshtml";
    ViewBag.Title = Resources.Lang.htft;
}
@model IEnumerable<HTFTViewModel>
@RazorHelper.RefreshCountDown("HTFT", 90, 60)
<table class="tblRpt" cellpadding="0" cellspacing="1" border="0">
    <thead class="RptHeader">
        <td style="width: 20px;">
            @Resources.Lang.no
        </td>
        <td style="width: 200px;">
            @Resources.Lang.home
        </td>
        <td style="width: 200px;">
            @Resources.Lang.away
        </td>
        <td style="width: 50px;">
            @Resources.Lang.hh
        </td>
        <td style="width: 50px;">
            @Resources.Lang.hd
        </td>
        <td style="width: 50px;">
            @Resources.Lang.ha
        </td>
        <td style="width: 50px;">
            @Resources.Lang.dh
        </td>
        <td style="width: 50px;">
            @Resources.Lang.dd
        </td>
        <td style="width: 50px;">
            @Resources.Lang.da
        </td>
        <td style="width: 50px;">
            @Resources.Lang.ah
        </td>
        <td style="width: 50px;">
            @Resources.Lang.ad
        </td>
        <td style="width: 50px;">
            @Resources.Lang.aa
        </td>
    </thead>
    @{
        
        if (Model != null && Model.Any())
        {
            int rowIndex = 0;
            var classRow = string.Empty;
            
            foreach (var item in Model)
            {
                rowIndex++;
                if (rowIndex % 2 == 0)
                {
                    classRow = "r alt";
                }
                else
                {
                    classRow = "r";
                }
                <tr class="@classRow">
                    <td class="c">
                        @rowIndex
                    </td>
                    <td class="l">
                        <a class="view-bet-list" match-id="@item.MatchId" bet-type="16" betlist-type="BettypeMatch" href="javascript:void(0);">@item.HomeTeam</a>
                    </td>
                    <td class="l">
                        @item.AwayTeam
                    </td>
                    <td class="fcnum">
                        @RazorHelper.FormatPositiveNumber(item.TotalHH, 2)
                    </td>
                    <td class="fcnum">
                        @RazorHelper.FormatPositiveNumber(item.TotalHD, 2)
                    </td>
                    <td class="fcnum">
                        @RazorHelper.FormatPositiveNumber(item.TotalHA, 2)
                    </td>
                    <td class="fcnum">
                        @RazorHelper.FormatPositiveNumber(item.TotalDH, 2)
                    </td>
                    <td class="fcnum">
                        @RazorHelper.FormatPositiveNumber(item.TotalDD, 2)
                    </td>
                    <td class="fcnum">
                        @RazorHelper.FormatPositiveNumber(item.TotalDA, 2)
                    </td>
                    <td class="fcnum">
                        @RazorHelper.FormatPositiveNumber(item.TotalAH, 2)
                    </td>
                    <td class="fcnum">
                        @RazorHelper.FormatPositiveNumber(item.TotalAD, 2)
                    </td>
                    <td class="fcnum">
                        @RazorHelper.FormatPositiveNumber(item.TotalAA, 2)
                    </td>
                </tr>
            }
        }
        else
        {
        @RazorHelper.ShowNoInfo(colspan: 12)
        }
    }
</table>
@section scripts
{
    <script src="~/Views/TotalBets/Resources/TotalBets.js" type="text/javascript"></script>
    <script type="text/javascript">
        $(function () {
            totalBets.InitViewBetList();
        });
    </script>       
}
