@using Apollo.Age.TotalBets.ViewModels
@{
    Layout = "~/Views/TotalBets/Shared/_Layout.cshtml";
    ViewBag.Title = Resources.Lang.htft;
}
@model IEnumerable<HTFTViewModel>
@RazorHelper.RefreshCountDown("HTFT", 90, 60)
<table class="tblRpt" cellpadding="0" cellspacing="1" border="0">
    <thead class="RptHeader">
        <td style="width: 20px;">
            @Resources.Lang.no
        </td>
        <td style="width: 200px;">
            @Resources.Lang.home
        </td>
        <td style="width: 200px;">
            @Resources.Lang.away
        </td>
        <td style="width: 50px;">
            @Resources.Lang.hh
        </td>
        <td style="width: 50px;">
            @Resources.Lang.hd
        </td>
        <td style="width: 50px;">
            @Resources.Lang.ha
        </td>
        <td style="width: 50px;">
            @Resources.Lang.dh
        </td>
        <td style="width: 50px;">
            @Resources.Lang.dd
        </td>
        <td style="width: 50px;">
            @Resources.Lang.da
        </td>
        <td style="width: 50px;">
            @Resources.Lang.ah
        </td>
        <td style="width: 50px;">
            @Resources.Lang.ad
        </td>
        <td style="width: 50px;">
            @Resources.Lang.aa
        </td>
    </thead>
    @{
        
        if (Model != null && Model.Any())
        {
            int rowIndex = 0;
            int currentLeagueId = 0;

            foreach (var item in Model)
            {
                rowIndex++;
        <tr class="r">
            <td class="c">
                @rowIndex
            </td>
            <td class="l">
                <a href="javascript:doViewBetList({MatchId}, 16, '{BetType}')">@item.HomeTeam</a>
            </td>
            <td class="l">
                @item.AwayTeam
            </td>
            <td class="fcnum">
                @TotalBetHelper.FormatPositiveNumber(item.totalHH, 2)
            </td>
            <td class="fcnum">
                @TotalBetHelper.FormatPositiveNumber(item.totalHD, 2)
            </td>
            <td class="fcnum">
                @TotalBetHelper.FormatPositiveNumber(item.totalHA, 2)
            </td>
            <td class="fcnum">
                @TotalBetHelper.FormatPositiveNumber(item.totalDH, 2)
            </td>
            <td class="fcnum">
                @TotalBetHelper.FormatPositiveNumber(item.totalDD, 2)
            </td>
            <td class="fcnum">
                @TotalBetHelper.FormatPositiveNumber(item.totalDA, 2)
            </td>
            <td class="fcnum">
                @TotalBetHelper.FormatPositiveNumber(item.totalAH, 2)
            </td>
            <td class="fcnum">
                @TotalBetHelper.FormatPositiveNumber(item.totalAD, 2)
            </td>
            <td class="fcnum">
                @TotalBetHelper.FormatPositiveNumber(item.totalAA, 2)
            </td>
        </tr>
            }
        }
        else
        {
        @RazorHelper.ShowNoInfo(colspan: 12)
        }
    }
</table>
