@using Apollo.Age.TotalBets.ViewModels
@using Fanex.Age.Utility
@{
    Layout = "~/Views/TotalBets/Shared/_Layout.cshtml";
    ViewBag.Title = Resources.Lang.lblOutRight;
}
@model IEnumerable<OutRightViewModel>
@helper ShowLeague(int currentLeagueId, OutRightViewModel item)
    {
        if (currentLeagueId != item.LeagueId)
        { 
    <!--LeagueContents-->
    <tr class="league">
        <td colspan="4" style="padding-left: 20px;" class="league">
            @item.LeagueName
        </td>
    </tr>
        }            
}
@RazorHelper.RefreshCountDown("OutRight", 90, 60)
<table class="tblRpt  persist-area">
    <thead class="persist-header">
        <tr class="RptHeader">
            <td style="width: 5%;">
                #
            </td>
            <td style="width: 45%;">
                @Resources.Lang.lblTeam
            </td>
            <td style="width: 25%">
                @Resources.Lang.lblBalance
            </td>
            <td style="width: 25%">
                @Resources.Lang.lblForecast
            </td>
        </tr>
    </thead>
    <tbody>
        <!--LeagueContents-->
        @{
        
            if (Model != null && Model.Any())
            {
                int rowIndex = 0;
                int currentLeagueId = 0;
                var classRow = string.Empty;
                
                foreach (var item in Model)
                {
                    rowIndex++;

                    if (rowIndex % 2 == 0)
                    {
                        classRow = "alt";
                    }
                    else
                    {
                        classRow = string.Empty;
                    }
            @ShowLeague(currentLeagueId, item)  
            <!--MatchContents-->
            <tr class="r @classRow">
                <td class="w-order">
                    @rowIndex
                </td>
                <td class="l">
                    <a class="view-bet-list" match-id="@item.MatchId" bet-type="10" betlist-type="BettypeMatch" href="javascript:void(0);">@item.TeamName</a>
                </td>
                <td class="fcnum">
                    @RazorHelper.FormatNumber(item.Balance, 2)
                </td>
                <td class="fcnum">
                    @RazorHelper.FormatPositiveNumber(item.TotalWinLost, 2)
                </td>
            </tr>
                    currentLeagueId = item.LeagueId;
                }
            }
            else
            { 
            @RazorHelper.ShowNoInfo(colspan: 4)
            }     
        }
    </tbody>
</table>
@section scripts
{
    <script src="~/Views/TotalBets/Resources/TotalBets.js" type="text/javascript"></script>
    <script type="text/javascript">
        $(function () {
            totalBets.InitViewBetList();
            totalBets.InnitFreeHeader();
        });
    </script>       
}
