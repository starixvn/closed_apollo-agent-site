@using Apollo.Age.TotalBets.ViewModels
@using Fanex.Age.Utility
@{
    Layout = "~/Views/TotalBets/Shared/_Layout.cshtml";
    ViewBag.Title = Resources.Lang.lblOutRight;
}
@model IEnumerable<OutRightViewModel>
@helper ShowLeague(int currentLeagueId, OutRightViewModel item)
    {
        if (currentLeagueId != item.leagueid)
        { 
    <!--LeagueContents-->
    <tr align="center">
        <td colspan="4" style="padding-left: 20px;" class="league">
            @item.LeagueName
        </td>
    </tr>
        }            
}
@RazorHelper.RefreshCountDown("OutRight", 90, 60)
<table class="tblRpt c" cellpadding="0" cellspacing="1" border="0" style="width: 600px">
    <thead>
        <tr class="RptHeader">
            <td style="width: 5%;">
                #
            </td>
            <td style="width: 45%;">
                @Resources.Lang.lblTeam
            </td>
            <td style="width: 25%">
                @Resources.Lang.lblBalance
            </td>
            <td style="width: 25%">
                @Resources.Lang.lblForecast
            </td>
        </tr>
    </thead>
    <tbody>
        <!--LeagueContents-->
        @{
        
            if (Model != null && Model.Any())
            {
                int rowIndex = 0;
                int currentLeagueId = 0;

                foreach (var item in Model)
                {
                    rowIndex++;
            @ShowLeague(currentLeagueId, item)  
            <!--MatchContents-->
            <tr class="r">
                <td class="w-order">
                    @rowIndex
                </td>
                <td class="l">
                    <a href="javascript:doViewBetList(@item.orid, 10, '{BetType}')">@item.TeamName</a>
                </td>
                <td>
                    @TotalBetHelper.FormatNumber(item.balance, 2)
                </td>
                <td class="fcnum">
                    @TotalBetHelper.FormatPositiveNumber(item.totalwinlost, 2)
                </td>
            </tr>
                    currentLeagueId = item.leagueid;
                }
            }
            else
            { 
            @RazorHelper.ShowNoInfo(colspan: 3)
            }     
        }
    </tbody>
</table>
