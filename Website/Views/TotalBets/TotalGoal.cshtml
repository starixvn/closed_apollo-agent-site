@model IEnumerable<Apollo.Age.TotalBets.ViewModels.TotalGoalViewModel>
@{
    Layout = "~/Views/TotalBets/Shared/_Layout.cshtml";
    ViewBag.Title = Resources.Lang.totalgoal;
}
@RazorHelper.RefreshCountDown("TotalGoal", 90, 60)
<table class="tblRpt">
    <thead>
        <tr class="RptHeader">
            <td style="width: 20px;">
                #
            </td>
            <td style="width: 150px;">
                @Resources.Lang.home
            </td>
            <td style="width: 150px;">
                @Resources.Lang.away
            </td>
            <td style="width: 80px;">
                @Resources.Lang.total01
            </td>
            <td style="width: 80px;">
                @Resources.Lang.total23
            </td>
            <td style="width: 80px;">
                @Resources.Lang.total46
            </td>
            <td style="width: 80px;">
                @Resources.Lang.total7over
            </td>
        </tr>
    </thead>
    <tbody>
        @{
            if (Model.Any())
            {
                int count = 0;
                var classRow = string.Empty;
                foreach (var item in Model)
                {
                    count++;
                    if (count % 2 == 0)
                    {
                        classRow = "alt";
                    }
                    else
                    {
                        classRow = string.Empty;
                    }
            <tr class="item @item.Closed @classRow">
                <td class="c" style="width: 20px;">
                    @count
                </td>
                <td style="width: 150px;">
                    <a  class="view-bet-list" match-id="@item.MatchId" bet-type="6" betlist-type="BettypeMatch"  href="javascript:void(0);" >
                        @item.HomeTeam
                    </a>
                </td>
                <td style="width: 150px;">
                    @item.AwayTeam
                </td>
                <td class="r fcnum" style="width: 80px;">
                    @RazorHelper.FormatPositiveNumber(item.Total01, 0)
                </td>
                <td class="r fcnum" style="width: 80px;">
                    @RazorHelper.FormatPositiveNumber(item.Total23, 0)
                </td>
                <td class="r fcnum" style="width: 80px;">
                    @RazorHelper.FormatPositiveNumber(item.Total46, 0)
                </td>
                <td class="r fcnum" style="width: 80px;">
                    @RazorHelper.FormatPositiveNumber(item.Total7Over, 0)
                </td>
            </tr>
                }
            }
            else
            { 
            @RazorHelper.ShowNoInfo(colspan: 7)
            }
        }
    </tbody>
</table>

@section scripts
{
    <script src="~/Views/TotalBets/Resources/TotalBets.js" type="text/javascript"></script>
    <script type="text/javascript">
        $(function () {
            totalBets.InitViewBetList();
        });
    </script>       
}
