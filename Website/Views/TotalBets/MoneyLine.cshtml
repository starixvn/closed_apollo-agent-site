@using Apollo.Age.TotalBets.Models
@using Fanex.Age.Utility
@{
    Layout = "~/Views/TotalBets/Shared/_Layout.cshtml";
    ViewBag.Title = Resources.Lang.moneyline;
}
@model IEnumerable<MoneyLineModel>
@helper ShowLeague(int currentLeagueId, MoneyLineModel item)
    {
        if (currentLeagueId != item.LeagueId)
        { 
    <!--LeagueContents-->
    <tr class="league">
        <td colspan="11" style="padding-left: 20px;">
            @item.LeagueName
        </td>
    </tr>
        }            
}
@helper ShowTotal(int betCount, decimal odds)
    {
        if (betCount != 0)
        {
    @Formater.FormatNumber2(odds, "en-US")                
        }   
}
@helper ShowForecas(int betCount, decimal winlost)
    {
        if (betCount != 0)
        {
    @RazorHelper.FormatPositiveNumber(winlost, 2)
        }
}
@RazorHelper.RefreshCountDown("MoneyLine", 90, 60)
<table class="tblRpt persist-area" style="width: 100%">
    <thead class="persist-header">
        <tr class="RptHeader">
            <td rowspan="2">
                @Resources.Lang.no
            </td>
            <td rowspan="2">
                @Resources.Lang.time
            </td>
            <td rowspan="2">
                @Resources.Lang.events
            </td>
            <td colspan="4">
                @Resources.Lang.fulltime
            </td>
            <td colspan="4">
                @Resources.Lang.lbl1sthalf
            </td>
        </tr>
        <tr class="RptHeader02">
            <td>
                @Resources.Lang.totalhome
            </td>
            <td>
                @Resources.Lang.totalaway
            </td>
            <td>
                @Resources.Lang.forecasthome
            </td>
            <td>
                @Resources.Lang.forecastaway
            </td>
            <td>
                @Resources.Lang.totalhome
            </td>
            <td>
                @Resources.Lang.totalaway
            </td>
            <td>
                @Resources.Lang.forecasthome
            </td>
            <td>
                @Resources.Lang.forecastaway
            </td>
        </tr>
    </thead>
    <tbody>
        <!--LeagueContents-->
        @{
        
            if (Model != null && Model.Any())
            {
                int rowIndex = 0;
                int currentLeagueId = 0;
                var classRow = string.Empty;

                foreach (var item in Model)
                {
                    rowIndex++;
                    if (rowIndex % 2 == 0)
                    {
                        classRow = "alt";
                    }
                    else
                    {
                        classRow = string.Empty;
                    }
            @ShowLeague(currentLeagueId, item)  
            
            <!--MatchContents-->
            <tr class='r @classRow'>
                <td class="w-order">
                    @rowIndex
                </td>
                <td class="c bl_time">
                    @Html.Raw(@item.ShowTime)
                </td>
                <td class="l">
                    @item.HomeTeam -vs- @item.AwayTeam
                </td>
                <td>
                    <a class="fcnum  view-bet-list" match-id="@item.MatchId" bet-type="20" betlist-type="BettypeMatch" 
                        href="javascript:void(0);" title="@Resources.Lang.ViewBetList">@ShowTotal(item.BetCountHome, item.HomeOdds)
                    </a>
                </td>
                <td>
                    <a class="fcnum  view-bet-list" match-id="@item.MatchId" bet-type="20" betlist-type="BettypeMatch" 
                        href="javascript:void(0);" title="@Resources.Lang.ViewBetList">@ShowTotal(item.BetCountAway, item.AwayOdds)
                    </a>
                </td>
                <td>
                    <a class="fcnum view-bet-list" match-id="@item.MatchId" bet-type="20" betlist-type="BettypeMatch" 
                        href="javascript:void(0);" title="@Resources.Lang.ViewBetList">@ShowForecas(item.BetCountHome, item.HomeWinLost)
                    </a>
                </td>
                <td >
                    <a class="fcnum view-bet-list" match-id="@item.MatchId" bet-type="20" betlist-type="BettypeMatch" 
                        href="javascript:void(0);" title="@Resources.Lang.ViewBetList">@ShowForecas(item.BetCountAway, item.AwayWinLost)
                    </a>
                </td>
                <td>
                    <a class="fcnum view-bet-list" match-id="@item.MatchId" bet-type="21" betlist-type="BettypeMatch" 
                        href="javascript:void(0);" title="@Resources.Lang.ViewBetList">@ShowTotal(item.BetCountHomeHalfTime, item.HomeOddsHalfTime)
                    </a>
                </td>
                <td>
                    <a class="fcnum view-bet-list" match-id="@item.MatchId bet-type="21" betlist-type="BettypeMatch" 
                        href="javascript:void(0);" title="@Resources.Lang.ViewBetList">@ShowTotal(item.BetCountAwayHalfTime, item.AwayOddsHalfTime)
                    </a>
                </td>
                <td>
                    <a class="fcnum view-bet-list" match-id="@item.MatchId" bet-type="21" betlist-type="BettypeMatch" 
                        href="javascript:void(0);" title="@Resources.Lang.ViewBetList">@ShowForecas(item.BetCountHomeHalfTime, item.HomeHalfTimeWinLost)
                    </a>
                </td>
                <td>
                    <a class="fcnum view-bet-list" match-id="@item.MatchId" bet-type="21" betlist-type="BettypeMatch" 
                        href="javascript:void(0);" title="@Resources.Lang.ViewBetList">@ShowForecas(item.BetCountAwayHalfTime, item.AwayHalfTimeWinLost)
                    </a>
                </td>
            </tr>
            
                    currentLeagueId = item.LeagueId;
                }
            }
            else
            { 
            @RazorHelper.ShowNoInfo(colspan: 11)
            }            
        }
    </tbody>
</table>

@section scripts
{
    <script src="~/Views/TotalBets/Resources/TotalBets.js" type="text/javascript"></script>
    <script type="text/javascript">
        $(function () {
            totalBets.InitViewBetList();
            totalBets.InnitFreeHeader();
        });
    </script>    
}
