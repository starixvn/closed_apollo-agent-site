@using Apollo.Age.TotalBets.Models
@using Fanex.Age.Utility
@{
    Layout = "~/Views/TotalBets/Shared/_Layout.cshtml";
    ViewBag.Title = string.Format("{0} + {1} + {2}/{3}", Resources.Lang.lblOddEven, Resources.Lang.lbl1x2, Resources.Lang.lblDraw, Resources.Lang.lblNoDraw);
}
@model IEnumerable<OddEvenModel>
@helper ShowLeague(int currentLeagueId, OddEvenModel item)
    {
        if (currentLeagueId != item.LeagueId)
        { 
    <!--LeagueContents-->
    <tr class="league">
        <td colspan="11" class="league" style="padding-left: 20px;">
            @item.LeagueName
        </td>
    </tr>
        }            
}
@helper ShowTotal(int betCount, decimal odds)
    {
    if (betCount != 0)
    {
    @Formater.FormatNumber2(odds, "en-US")                
    }   
}
@helper ShowForecas(int betCount, decimal winlost)
    {
    if (betCount != 0)
    {
    @RazorHelper.FormatPositiveNumber(winlost, 2)
    }
}
@helper Show1x2Button(OddEvenModel item, bool isFullTime)
    {
    if (isFullTime)
    {
        <td style="width: 70px">
            <!--OneXTwoValue-->
            <a class="fcnum  view-bet-list" match-id="@item.MatchId" bet-type="5" betlist-type="BettypeMatch" 
                href="javascript:void(0);" title="@Resources.Lang.ViewBetList">
                @RazorHelper.FormatNumber(item.OneXTwoTotal, showZero: item.BetCount1X2 != 0)
            </a>
            <!--/OneXTwoValue-->
        </td>
           
        <td class="fcbtn" align="center" style="width: 16px">
            @if (item.OneXTwoTotal != 0)
            { 
                <!--OneXTwoButton-->
                <a match-id="@item.MatchId" bet-type="5" href="javascript:void(0);" class="btnInfo view-forecast" title="@Resources.Lang.ViewForeCast"></a>
                <!--/OneXTwoButton-->
            }
        </td>
        
    }
    else
    {
        <td style="width: 70px">
            <!--OneXTwoFirstHalfValue-->
            <a class="fcnum  view-bet-list" match-id="@item.MatchId" bet-type="15" betlist-type="BettypeMatch" 
                href="javascript:void(0);" title="@Resources.Lang.ViewBetList">
                @RazorHelper.FormatNumber(item.OneXTwoFirstHalf, showZero: item.BetCount1X2HalfTime != 0)
            </a>
            <!--/OneXTwoFirstHalfValue-->
        </td>
        
        <td class="fcbtn" align="center" style="width: 16px">
            @if (item.OneXTwoFirstHalf != 0)
            {
                <!--OneXTwoFirstHalfButton-->
                <a match-id="@item.MatchId" bet-type="15" href="javascript:void(0);" class="btnInfo view-forecast" title="@Resources.Lang.ViewForeCast"></a>
            }
            <!--/OneXTwoFirstHalfButton-->
        </td>
       
    }
}
@helper ShowTime(OddEvenModel item)
{
    <td class="c bl_time">
        @if (item.LiveIndicator)
        {
            @Html.Raw(item.LiveHomeScore + " - " + item.LiveAwayScore)
            <br />
            <!--LiveNotice-->
            <i style="color: red">Live</i>
            <!--/LiveNotice-->
        }
        else
        {
            @Html.Raw(item.ShowTime)
        }
    </td>
}
@RazorHelper.RefreshCountDown("OddEven", 45, 15)
<table class="tblRpt persist-area">
    <thead class="persist-header">
        <tr class="RptHeader">
            <td rowspan="2" style="width: 20px;">
                #
            </td>
            <td rowspan="2" style="width: 110px;">
                @Resources.Lang.time
            </td>
            <td rowspan="2">
                @Resources.Lang.events
            </td>
            <td colspan="4">
                @Resources.Lang.fulltime
            </td>
            <td colspan="3">
                @Resources.Lang.lbl1sthalf
            </td>
        </tr>
        <tr class="RptHeader02">
            <td style="width: 100px;">
                @Resources.Lang.lblOddEven
            </td>
            <td colspan="2" style="width: 100px;">
                @Resources.Lang.lbl1x2
            </td>
            <td style="width: 100px;">
                @Resources.Lang.lblDraw/@Resources.Lang.lblNoDraw
            </td>
            <td style="width: 100px;">
                @Resources.Lang.lblOddEven
            </td>
            <td colspan="2" style="width: 100px;">
                @Resources.Lang.lbl1x2
            </td>
        </tr>
    </thead>
    <tbody>
        <!--LeagueContents-->
        @{
        
            if (Model != null && Model.Any())
            {
                int rowIndex = 0;
                int currentLeagueId = 0;
                var classRow = string.Empty;

                foreach (var item in Model)
                {
                    rowIndex++;
                    
                    if (item.LiveIndicator)
                    {
                        classRow = "live";
                    }
                    else
                    {
                        if (rowIndex % 2 == 0)
                        {
                            classRow = "alt";
                        }
                        else
                        {
                            classRow = string.Empty;
                        }
                    }
                    
            @ShowLeague(currentLeagueId, item)  
            
            <!--MatchContents-->
            <tr class='r @classRow'>
                <td class="w-order">
                    @rowIndex
                </td>
                    @ShowTime(item)
                <td class="l">
                    @item.HomeTeam -vs- @item.AwayTeam
                </td>
                <td>
                    <!--OddEvenValue-->
                    <a class="fcnum  view-bet-list" match-id="@item.MatchId" bet-type="2" betlist-type="BettypeMatch" 
                        href="javascript:void(0);" title="@Resources.Lang.ViewBetList"> 
                        @RazorHelper.FormatNegativeNumber(item.OddEvenTotal, showZero: item.BetCountOddEven != 0)
                    </a>
                    <!--/OddEvenValue-->
                </td>
                @Show1x2Button(item, true)
                <td style="width: 86px">
                    <!--DNDValue-->
                    <a class="fcnum  view-bet-list" match-id="@item.MatchId" bet-type="123" betlist-type="BettypeMatch" 
                        href="javascript:void(0);" title="@Resources.Lang.ViewBetList">
                        @RazorHelper.FormatNumber(item.DrawNoDrawTotal, showZero: item.BetCountDrawNoDraw != 0)
                    </a>
                    <!--/DNDValue-->
                </td>
                <td>
                    <!--OddEvenFirstHalfValue-->
                    <a class="fcnum  view-bet-list" match-id="@item.MatchId" bet-type="12" betlist-type="BettypeMatch" 
                        href="javascript:void(0);" title="@Resources.Lang.ViewBetList">
                        @RazorHelper.FormatNegativeNumber(item.OddEvenFirstHalf, showZero: item.BetCountHalfTimeOddEven != 0)
                    </a>
                    <!--/OddEvenFirstHalfValue-->
                </td>
                @Show1x2Button(item, false)
            </tr>
            
                    currentLeagueId = item.LeagueId;
                }
            }
            else
            { 
            @RazorHelper.ShowNoInfo(colspan: 11)
            }            
        }
    </tbody>
</table>
@section scripts
{
    <script src="~/Views/TotalBets/Resources/TotalBets.js" type="text/javascript"></script>
    <script type="text/javascript">
        $(function () {
            TOTALBETS.initViewForecast1x2();
            TOTALBETS.initViewBetList();
            TOTALBETS.innitFreeHeader();
        });
    </script>       
}