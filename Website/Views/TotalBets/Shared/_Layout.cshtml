@{
    var currentMainShareHolderId = ViewBag.CurrentMainShareHolderId ?? 0;
    var currentAgentId = ViewBag.CurrentAgentId;
    var mainShareHolders = (IEnumerable<Apollo.Age.Entities.Agent>)ViewBag.MainShareHolders;
}

<!DOCTYPE html>
<html lang="en-us">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <title>@ViewBag.Title - Total Bets</title>
    <script src="~/_GlobalResources/Js/head.min.js" type="text/javascript"></script>
    <link href="~/_GlobalResources/Css/jquery-ui-1.10.2/apollo/jquery-ui.min.css" rel="stylesheet"
        type="text/css" />
    <link href="~/_Components/RefreshCountDown/RefreshCountDown.less" rel="Stylesheet"
        type="text/css" />
    <link href="~/Views/TotalBets/Resources/TotalBets.less" rel="Stylesheet" type="text/css" />
    @RenderSection("css", required: false)
</head>
<body>    
    <div id="page_main">
        <div id="header_main">
            @*<span class="upper">@Resources.Lang.totalbets</span>*@
            @ViewBag.Title
        </div>
        <div id="content_main">
            @{
                if (currentAgentId == 0)
                {
                    @DropDownListHelper.RenderMainShareHolderDropDownList(currentMainShareHolderId, mainShareHolders)
                }
            }
            @RenderBody()
        </div>
    </div>
    @Html.Hidden("ApoRoot", Url.Content("~/"))
    <script src="~/_GlobalResources/Js/jquery.js" type="text/javascript"></script>
    <script src="~/_GlobalResources/Js/jquery-ui.js" type="text/javascript"></script>
    <script src="~/_GlobalResources/Js/Core.js" type="text/javascript"></script>
    <script src="~/_Components/AGEWnd/AGEWnd.js" type="text/javascript"></script>
    <script src="~/_Components/RefreshCountDown/RefreshCountDown.js" type="text/javascript"></script>
    <script src="~/Views/TotalBets/Resources/TotalBets.js" type="text/javascript"></script>
    <script type="text/javascript">
        var currentMainShareHolderId = @(currentMainShareHolderId);
        var currentActionLink = '@Url.Action(null)'
    </script>
    @RenderSection("scripts", required: false)
</body>
</html>
