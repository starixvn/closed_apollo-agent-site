@using Apollo.Age.TotalBets.Models
@{
    Layout = "~/Views/TotalBets/Shared/_Layout.cshtml";
    ViewBag.Title = Resources.Lang.lblHOUL;
}

@model IEnumerable<HandicapModel>

@helper ShowBlock(int betType, int matchId, decimal homeOdds, decimal awayOdds, string leagueName, string betTypeName)
{
    var totalOdds = homeOdds - awayOdds;
        
    if (Math.Round(totalOdds) != 0)
    { 
        <td class="r" style="width: 90px">
            <!--HandicapTotalValue-->
            <a class="fcnum view-bet-list" match-id="@matchId" bet-type="@betType" 
            betlist-type="BettypeMatch" href="javascript:void(0);" league-name="@leagueName" bet-type-name="@betTypeName"  title="@Resources.Lang.ViewBetList">@RazorHelper.FormatNegativeNumber(totalOdds)</a>
            <!--/HandicapTotalValue-->
        </td>
        <td class="fcbtn">
            <!--HandicapTotalButton-->
            <a href="javascript:void(0);" match-id="@matchId" bet-type="@betType" 
            class="btnInfo view-forecast" league-name="@leagueName" title="@Resources.Lang.ViewForeCast"></a>
            <!--/HandicapTotalButton-->
        </td>
    }
    else
    { 
        <td class="r" style="width: 90px"></td>
        <td class="fcbtn"></td>
    }
}

@helper ShowTime(HandicapModel item)
{
    <td class="c bl_time">
        @if (item.LiveIndicator)
        {
            @Html.Raw(item.LiveHomeScore + " - " + item.LiveAwayScore)
            <br />
            <!--LiveNotice-->
            <i style="color: red">Live</i>
            <!--/LiveNotice-->
        }
        else
        {
            @Html.Raw(item.ShowTime)
        }
    </td>
}

@helper ShowMatch(int index, HandicapModel item)
{
    var classRow = string.Empty;
    if (item.LiveIndicator)
    {
        classRow = "class=live";
    }
    else
    {        
        classRow = string.Empty;        
    }
    
    <tr @classRow>
        <td class="c">
            @index
        </td>
        @ShowTime(item)
        <td>
            @item.HomeTeam -vs- @item.AwayTeam
        </td>
        @ShowBlock(1, item.MatchId, item.HomeOddsHandicap, item.AwayOddsHandicap, item.LeagueName, Resources.Lang.lblHandicapFC)
        @ShowBlock(3, item.MatchId, item.HomeOddsOverUnder, item.AwayOddsOverUnder, item.LeagueName, Resources.Lang.lblOU)
        @ShowBlock(7, item.MatchId, item.HomeOddsHalfTimeHandicap, item.AwayOddsHalfTimeHandicap, item.LeagueName, Resources.Lang.lbl1stHdp)
        @ShowBlock(8, item.MatchId, item.HomeOddHalfTimeOverUnder, item.AwayOddHalfTimeOverUnder, item.LeagueName, Resources.Lang.lbl1stOU)
    </tr>           
}

@helper ShowLeague(int currentLeagueId, HandicapModel item)
{
    if (currentLeagueId != item.LeagueId)
    { 
    <!--LeagueContents-->
    <tr class="league">
        <td colspan="11">
            @item.LeagueName
        </td>
    </tr>
    }            
}

@RazorHelper.RefreshCountDown("HDPOU", 15, 15)

<table class="tblRpt persist-area">
    <thead class="persist-header">
        <tr>
            <td rowspan="2" style="width: 20px">
                #
            </td>
            <td rowspan="2" style="width: 110px">
                @Resources.Lang.time
            </td>
            <td rowspan="2">
                @Resources.Lang.events
            </td>
            <td colspan="4">
                @Resources.Lang.fulltime
            </td>
            <td colspan="4">
                @Resources.Lang.lbl1sthalf
            </td>
        </tr>
        <tr>
            <td colspan="2">
                @Resources.Lang.lblHandicapFC
            </td>
            <td colspan="2">
                @Resources.Lang.lblOverUnder
            </td>
            <td colspan="2">
                @Resources.Lang.lblHandicapFC
            </td>
            <td colspan="2">
                @Resources.Lang.lblOverUnder
            </td>
        </tr>
    </thead>
    <tbody>
        @if (Model != null && Model.Any())
        {
            int rowIndex = 0;
            int currentLeagueId = 0;

            foreach (var item in Model)
            {
                rowIndex++;

                @ShowLeague(currentLeagueId, item)
                @ShowMatch(rowIndex, item)

                currentLeagueId = item.LeagueId;
            }
        }
        else
        {
            @RazorHelper.ShowNoInfo(colspan: 11)
        }
    </tbody>
</table>

@section scripts
{
    <script type="text/javascript">
        $(document).ready(function () {
            TOTALBETS.initViewForeCastHandicap();
            TOTALBETS.initViewBetList();
            TOTALBETS.innitFreeHeader();
        }).ajaxStart($.blockUI).ajaxStop($.unblockUI); ;
    </script>    
}
