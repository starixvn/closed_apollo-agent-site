@using Apollo.Age.TotalBets.ViewModels
@{
    Layout = "~/Views/TotalBets/Shared/_Layout.cshtml";
    ViewBag.Title = Resources.Lang.numbergame;
}

@model IEnumerable<NumberGameViewModel>

@helper ShowLeague(int currentLeagueId, NumberGameViewModel item)
{
    if (currentLeagueId != item.LeagueId)
    { 
        <!--LeagueContents-->
        <tr class="league">
            <td colspan="18">
                @item.LeagueName
            </td>
        </tr>
    }            
}

@helper ShowMatch(int index, NumberGameViewModel item)
{
    <tr>
        <td class="c">
            @index
        </td>
        <td>
            @Resources.Lang.numbergameno  @item.MatchCode
        </td>
        <td>
            @if (item.BetCount_Warrior_2ndBall != 0)
            {
                <a class="fcnum view-bet-list-new-game" match-id="@item.MatchId" bet-type="88" betlist-type="BettypeMatch" is-live="0" bet-team="h" href="javascript:void(0);">
                    @TotalBetHelper.FormatNegativeNumber(item.Warrior_2ndBall)
                </a>
            }
        </td>
        <td>
            @if (item.BetCount_Warrior_3rdBall != 0)
            {
                <a class="fcnum view-bet-list-new-game" match-id="@item.MatchId" bet-type="88" betlist-type="BettypeMatch" is-live="0" bet-team="a" href="javascript:void(0);">
                    @TotalBetHelper.FormatNegativeNumber(item.Warrior_3rdBall)
                </a>
            }
        </td>
        <td>
            @if (item.BetCount_OU1stBall != 0)
            {
                <a class="fcnum view-bet-list" match-id="@item.MatchId" bet-type="81" betlist-type="BettypeMatch" is-live="0" href="javascript:void(0);">
                    @TotalBetHelper.FormatNegativeNumber(item.Over_1stBall - item.Under_1stBall)
                </a>
            }
        </td>
        <td>
            @if (item.BetCount_OE1stBall != 0)
            {
                <a class="fcnum view-bet-list" match-id="@item.MatchId" bet-type="83" betlist-type="BettypeMatch" is-live="0" href="javascript:void(0);">
                    @TotalBetHelper.FormatNegativeNumber(item.Odd_1stBall - item.Even_1stBall)
                </a>
            }
        </td>
        <td>
            @if (item.BetCount_OULastBall != 0)
            {
                <a class="fcnum view-bet-list" match-id="@item.MatchId" bet-type="82" betlist-type="BettypeMatch" is-live="0" href="javascript:void(0);">
                    @TotalBetHelper.FormatNegativeNumber(item.Over_LastBall - item.Under_LastBall)
                </a>
            }
        </td>
        
        <td>
            @if (item.BetCount_OELastBall != 0)
            {
                <a class="fcnum view-bet-list" match-id="@item.MatchId" bet-type="84" betlist-type="BettypeMatch" is-live="0" href="javascript:void(0);">
                    @TotalBetHelper.FormatNegativeNumber(item.Odd_LastBall - item.Even_LastBall)
                </a>
            }
        </td>
        
        <td>
            @if (item.BetCount_OUNext != 0)
            {
                <a class="fcnum view-bet-list" match-id="@item.MatchId" bet-type="85" betlist-type="BettypeMatch" is-live="1" href="javascript:void(0);">
                    @TotalBetHelper.FormatNegativeNumber(item.Over_Next - item.Under_Next)
                </a>
            }
        </td>
        <td>
            @if (item.BetCount_OENext != 0)
            {
                <a class="fcnum view-bet-list" match-id="@item.MatchId" bet-type="86" betlist-type="BettypeMatch" is-live="1" href="javascript:void(0);">
                    @TotalBetHelper.FormatNegativeNumber(item.Odd_Next - item.Even_Next)
                </a>
            }
        </td>
        <td>
            @if (item.BetCount_HighLow != 0)
            {
                <a class="fcnum view-bet-list" match-id="@item.MatchId" bet-type="87" betlist-type="BettypeMatch" is-live="1" href="javascript:void(0);">
                    @TotalBetHelper.FormatNegativeNumber(item.High - item.Low)
                </a>
            }
        </td>
        <td>
            @if (item.BetCount_NextCombo_OverOdd != 0)
            {
                <a class="fcnum view-bet-list-new-game" match-id="@item.MatchId" bet-type="89" betlist-type="BettypeMatch" is-live="1" bet-team="1:1" href="javascript:void(0);">
                    @TotalBetHelper.FormatNegativeNumber(item.NextCombo_OverOdd)
                </a>
            }
        </td>
        <td>
            @if (item.BetCount_NextCombo_UnderOdd != 0)
            {
                <a class="fcnum view-bet-list-new-game" match-id="@item.MatchId" bet-type="89" betlist-type="BettypeMatch" is-live="1" bet-team="2:1" href="javascript:void(0);">
                    @TotalBetHelper.FormatNegativeNumber(item.NextCombo_UnderOdd)
                </a>
            }
        </td>
        <td>
            @if (item.BetCount_NextCombo_OverEven != 0)
            {
                <a class="fcnum view-bet-list-new-game" match-id="@item.MatchId" bet-type="89" betlist-type="BettypeMatch" is-live="1" bet-team="1:2" href="javascript:void(0);">
                    @TotalBetHelper.FormatNegativeNumber(item.NextCombo_OverEven)
                </a>
            }
        </td>
        
        <td>
            @if (item.BetCount_NextCombo_UnderEven != 0)
            {
                <a class="fcnum view-bet-list-new-game" match-id="@item.MatchId" bet-type="89" betlist-type="BettypeMatch" is-live="1" bet-team="2:2" href="javascript:void(0);">
                    @TotalBetHelper.FormatNegativeNumber(item.NextCombo_UnderEven)
                </a>
            }
        </td>
        <td>
            @if (item.BetCount_OEFullTime != 0)
            {
                <a class="fcnum view-bet-list" match-id="@item.MatchId" bet-type="86" betlist-type="BettypeMatch" is-live="0" href="javascript:void(0);">
                    @TotalBetHelper.FormatNegativeNumber(item.Odd_FullTime - item.Even_FullTime)
                </a>
            }
        </td>
        <td>
            @if (item.BetCount_NumberGroupLive != 0)
            {
                <a class="fcnum view-bet-list" match-id="@item.MatchId" bet-type="90" betlist-type="BettypeMatch" is-live="1" href="javascript:void(0);">
                    @TotalBetHelper.FormatNegativeNumber(item.NumberGroupLive)
                </a>
            }
        </td>
        <td>
            @if (item.BetCount_NumberGroupPre != 0)
            {
                <a class="fcnum view-bet-list" match-id="@item.MatchId" bet-type="90" betlist-type="BettypeMatch" is-live="0" href="javascript:void(0);">
                    @TotalBetHelper.FormatNegativeNumber(item.NumberGroupPre)
                </a>
            }
        </td>
    </tr>  
}

@RazorHelper.RefreshCountDown("NumberGame", 60, 0)

<table class="tblRpt c" style="width: 100%">
    <thead>
        <tr class="RptHeader">
            <td rowspan="2">
                #
            </td>
            <td rowspan="2">
                @Resources.Lang.events
            </td>
            <td colspan="2">
                @Resources.Lang.warrior
            </td>
            <td colspan="2">
                @Resources.Lang.lbl1stBall
            </td>
            <td colspan="2">
                @Resources.Lang.lastball
            </td>
            <td colspan="3">
                @Resources.Lang.nextBall
            </td>
            <td colspan="4">
                @Resources.Lang.nextcombo
            </td>
            <td rowspan="2" title="@Resources.Lang.lblFTOddEven">
                @Resources.Lang.lblFTOE
            </td>
            <td colspan="2">
                @Resources.Lang.numberGroup
            </td>
        </tr>
        <tr class="RptHeader02">
            <td>
                @Resources.Lang.warrior2ndBall
            </td>
            <td>
                @Resources.Lang.warrior3rdBall
            </td>
            <td title="@Resources.Lang.lblOverUnder">
                @Resources.Lang.lblOU
            </td>
            <td title="@Resources.Lang.lblOddEven">
                @Resources.Lang.lblOE
            </td>
            <td title="@Resources.Lang.lblOverUnder">
                @Resources.Lang.lblOU
            </td>
            <td title="@Resources.Lang.lblOddEven">
                @Resources.Lang.lblOE
            </td>                                        
            <td title="@Resources.Lang.lblOverUnder">
                @Resources.Lang.lblOU
            </td>
            <td title="@Resources.Lang.lblOddEven">
                @Resources.Lang.lblOE
            </td>
            <td>
                @Resources.Lang.highlow
            </td>
            <td title="@Resources.Lang.lblOverOdd">
                @Resources.Lang.lblOO
            </td>
            <td title="@Resources.Lang.lblUnderOdd">
                @Resources.Lang.lblUO
            </td>
            <td title="@Resources.Lang.lblOverEven">
                @Resources.Lang.lblOvE
            </td>
            <td title="@Resources.Lang.lblUnderEven">
                @Resources.Lang.lblUE
            </td>         
            <td>
                @Resources.Lang.LiveGame
            </td>
            <td>
                @Resources.Lang.PreGame
            </td>  
        </tr>
    </thead>
    <tbody>
        @if (Model != null && Model.Any())
        {
            int rowIndex = 0;
            int currentLeagueId = 0;

            foreach (var item in Model)
            {
                rowIndex++;

                @ShowLeague(currentLeagueId, item)
                @ShowMatch(rowIndex, item)

                currentLeagueId = item.LeagueId;
            }
        }
        else
        {
            @RazorHelper.ShowNoInfo(colspan: 18)
        }
    </tbody>
</table>

@section scripts
{
    <script src="~/Views/TotalBets/Resources/TotalBets.js" type="text/javascript"></script>
    <script type="text/javascript">
        $(function () {
            totalBets.InitViewBetListGame();
            totalBets.InitViewBetListNewGame();
        });
    </script>    
}