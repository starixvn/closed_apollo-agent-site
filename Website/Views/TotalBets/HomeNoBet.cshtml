@using Apollo.Age.TotalBets.ViewModels
@{
    Layout = "~/Views/TotalBets/Shared/_Layout.cshtml";
    ViewBag.Title = Resources.Lang.lblHomeDrawAwayNoBet;
}

@model IEnumerable<HomeNoBetViewModel>

@helper ShowLeague(int currentLeagueId, HomeNoBetViewModel item)
{
    if (currentLeagueId != item.LeagueId)
    { 
        <!--LeagueContents-->
        <tr class="league">
            <td colspan="6">
                @item.LeagueName
            </td>
        </tr>
    }            
}

@helper ShowMatch(int index, HomeNoBetViewModel item)
{
    var classRow = string.Empty;
    if (item.LiveIndicator)
    {
        classRow = "class=live";
    }
    else
    {
        if(index%2==0)
        {
            classRow = "class=alt";
        }
    }
    
    <tr @classRow>
        <td class="c">
            @index
        </td>
        @ShowTime(item)
        <td>
            @item.HomeTeam -vs- @item.AwayTeam
        </td>
        <td class="r">
            @if(item.BetCount_HNB != 0)
            {
                <a class="fcnum view-bet-list" match-id="@item.MatchId" bet-type="121" betlist-type="BettypeMatch" href="javascript:void(0);">
                    @TotalBetHelper.FormatNumber(item.Home_Odds_HNB - item.Away_Odds_HNB)    
                </a>
            }
            
        </td>
        <td class="r">
            @if(item.BetCount_DNB != 0)
            {
                <a class="fcnum view-bet-list" match-id="@item.MatchId" bet-type="25" betlist-type="BettypeMatch" href="javascript:void(0);">
                    @TotalBetHelper.FormatNumber(item.Home_Odds_DNB - item.Away_Odds_DNB)
                </a>
            }
        </td>
        <td class="r">
            @if(item.BetCount_ANB != 0)
            {
                <a class="fcnum view-bet-list" match-id="@item.MatchId" bet-type="122" betlist-type="BettypeMatch" href="javascript:void(0);">
                    @TotalBetHelper.FormatNumber(item.Home_Odds_ANB - item.Away_Odds_ANB)
                </a>
            }
        </td>
    </tr>        
}

@helper ShowTime(HomeNoBetViewModel item)
    {
    <td class="c bl_time">
        @if (item.LiveIndicator)
        {
            @Html.Raw(item.LiveHomeScore + " - " + item.LiveAwayScore)
            <br />
            <i class="red-num">@Resources.Lang.lblLive</i>
        }
        else
        {
            @Html.Raw(item.ShowTime)
        }
    </td>
}

@RazorHelper.RefreshCountDown("HomeNoBet", 15, 0)
<table class="tblRpt">
    <thead>
        <tr>
            <td rowspan="2" style="width: 20px;">
                #
            </td>
            <td rowspan="2" style="width: 110px;">
                @Resources.Lang.time
            </td>
            <td rowspan="2" style="width: 366px;">
                @Resources.Lang.events
            </td>
            <td colspan="3">
                @Resources.Lang.fulltime
            </td>
        </tr>
        <tr class="RptHeader02">
            <td style="width: 100px;">
                @Resources.Lang.lblHomeNoBet
            </td>
            <td style="width: 100px;">
                @Resources.Lang.lblDrawNoBet
            </td>
            <td style="width: 100px;">
                @Resources.Lang.lblAwayNoBet
            </td>
        </tr>
    </thead>
    <tbody>
        @if (Model != null && Model.Any())
        {
            int rowIndex = 0;
            int currentLeagueId = 0;

            foreach (var item in Model)
            {
                rowIndex++;

                @ShowLeague(currentLeagueId, item)
                @ShowMatch(rowIndex, item)

                currentLeagueId = item.LeagueId;
            }
        }
        else
        {
            @RazorHelper.ShowNoInfo(colspan: 6)
        }
    </tbody>
</table>

@section scripts
{
    <script src="~/Views/TotalBets/Resources/TotalBets.js" type="text/javascript"></script>
    <script type="text/javascript">
        $(function () {
            totalBets.InitViewBetList();
        });
    </script>    
}
