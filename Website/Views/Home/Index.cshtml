@{
    ViewBag.Title = "Default Page";
}
@section css
{
    <link href="~/Views/Account/Resources/MiniAccount.less" rel="stylesheet" type="text/css" />
    <link href="~/Views/Home/Resources/Index.less" rel="stylesheet" type="text/css" />
}
<div class="header">
    <iframe src="~/Account/TopBar" id="frHeader" name="frHeader" width="100%" height="100%"
        frameborder="0" scrolling="no"></iframe>
</div>
<div class="menu">
    @Html.Action("MiniMenu", "Account")
    <iframe src="~/Account/Menu" id="menu" name="menu" width="100%" height="99%" frameborder="0"
        scrolling="no"></iframe>
</div>
<div class="mainpage">
    <div id="btn-mini-menu" class="collapse" title="@Apollo.Age.Resources.Lang.Collapse">
    </div>
    <iframe src="~/Message/Portal" id="main" name="main" width="100%" height="99%" frameborder="0">
    </iframe>
</div>
@section scripts
{
    <script src="~/_GlobalResources/Js/jquery.js" type="text/javascript"></script>
    <script src="~/_GlobalResources/Js/jquery.cookie.js" type="text/javascript"></script>
    <script type="text/javascript">
		head.js("@Url.Content("~/Views/Home/Resources/Default.js")");
        var LANGUAGES = function () {
        return {
            Collapse: "@Apollo.Age.Resources.Lang.Collapse",
            Expand: "@Apollo.Age.Resources.Lang.Expand"
            };
        } ();
    </script>
}
