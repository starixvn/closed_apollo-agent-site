@model ICurrentSession
@{
	ViewBag.Title = "Index";

	string headerClass = Model.IsInternalSignIn ? "header int" : "header";
	string menuClass = Model.IsInternalSignIn ? "menu int" : "menu";
	string mainPageClass = Model.IsInternalSignIn ? "mainpage int" : "mainpage";
}
@section css
{
	<link href="~/Views/Account/Resources/MiniAccount.less" rel="stylesheet" type="text/css" />
	<link href="~/Views/Home/Resources/Index.less" rel="stylesheet" type="text/css" />
}

<div class="@headerClass">
	<iframe src="~/Account/TopBar" id="frHeader" name="frHeader" width="100%" height="100%" frameborder="0" scrolling="no"></iframe>
</div>
<div class="@menuClass">
	@Html.Action("MiniMenu", "Account")
	<iframe src="~/Account/Menu" id="menu" name="menu" width="100%" height="99%" frameborder="0" scrolling="no"></iframe>
</div>
<div class="@mainPageClass">
	<div id="btn-mini-menu" class="collapse" title="Resource.Minimize"></div>
	<iframe src="~/Message/Portal" id="main" name="main" width="100%" height="99%" frameborder="0"></iframe>
</div>

@section scripts
{
    <script src="~/_GlobalResources/Js/jquery.cookie.js" type="text/javascript"></script>
	<script src="~/Views/Home/Resources/Default.js" type="text/javascript"></script>
    <script type="text/javascript">
        var LANGUAGES = function () {
        return {
            Collapse: "@Apollo.Age.Resources.Lang.Collapse",
            Expand: "@Apollo.Age.Resources.Lang.Expand"
            };
        } ();
    </script>
}
