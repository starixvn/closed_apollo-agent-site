@{
	ViewBag.Title = "Default Page";
}
@section css
{
	<link href="~/_GlobalResources/Css/Index.less" rel="stylesheet" type="text/css" />
}

<div class="header">
	<iframe src="~/Account/TopBar" id="frHeader" name="frHeader"
		width="100%" height="100%" frameborder="0" scrolling="no"></iframe>
</div>
<div class="menu">
	<iframe src="~/Account/Menu" id="menu" name="menu"
		width="100%" height="99%" frameborder="0" scrolling="no"></iframe>
</div>
<div class="mainpage">
	<iframe src="~/Message/Portal" id="main" name="main"
		width="100%" height="99%" frameborder="0"></iframe>
</div>

@section scripts
{
	<script type="text/javascript">
		head.js("@Url.Content("~/Views/Home/Resources/Default.js")");
	</script>
}