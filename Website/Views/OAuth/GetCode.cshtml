@using Apollo.Age.Integration.Configurations;
@model Apollo.Age.Integration.Models.AuthModel
@{
    Layout = null;
}
<!DOCTYPE html>
<html>
<head>
    <title></title>
</head>
<body>
    @if (Model != null && Model.IsValid)
    {       
        // Sso sucessfully                 
        @Html.Hidden("url", Url.Content(OAuthSettings.Settings.DefaultUrl));
    }
    else
    {
        @Html.Hidden("url", Url.Content("~/OAuth/Error?error_code=" + Model.ErrorCode));
    }
    <script src="~/_GlobalResources/Js/jquery.js" type="text/javascript"></script>
    <script type="text/javascript">
        $(function () {
            if (window.parent != undefined) {
                window.parent.location.href = $("#url").val();
            }
        });
    </script>
</body>
</html>
