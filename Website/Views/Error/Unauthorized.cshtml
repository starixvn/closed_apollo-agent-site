@{
	Layout = null;
	string title = Apollo.Age.Resources.Lang.UnauthorizedMsg;
}
<!DOCTYPE html>
<html>
<head>
	<title>@title</title>
	<style type="text/css">
		body {
		    background: #fff;
		    margin: 0;
		    padding: 0;
		    font-family: 'Segoe UI Light', 'Segoe UI', Arial, Sans-Serif;
		}
		h1 {
		    border: 1px dashed #333;
		    font-weight: normal;
		    text-align: center;
		    font-size: 2em;
		    margin: 50px auto;
		    padding-bottom: 10px;
		    width: 850px;
		}
	</style>
</head>
<body>
	<h1>@title</h1>

	<script src="~/_GlobalResources/Js/jquery.js" type="text/javascript"></script>
	<script src="~/_GlobalResources/Js/Core.js?ver=3" type="text/javascript"></script>
	<script src="~/Views/Error/Resources/Unauthorized.js?ver=1" type="text/javascript"></script>

	@*@Scripts.Render("~/scripts/unauthjs")*@
</body>
</html>