@using Apollo.Age.Reports.Models
@using Apollo.Age.Reports.Core
@model IEnumerable<MatchResultModel>
<table class="tblRpt">
    <thead>
        <tr class="RptHeader">
            <td style="width: 90px" columnname="kickofftime">
                @Resources.Lang.kickofftime
            </td>
            <td>
                @Resources.Lang.match
            </td>
            <td style="width: 50px;">
                @Resources.Lang.Q1
            </td>
            <td style="width: 50px;">
                @Resources.Lang.Q2
            </td>
            <td style="width: 50px;">
                @Resources.Lang.Q3
            </td>
            <td style="width: 50px;">
                @Resources.Lang.Q4
            </td>
            <td style="width: 50px;">
                @Resources.Lang.OT
            </td>
            <td style="width: 70px;">
                @Resources.Lang.firsthalfscore
            </td>
            <td class="nowrap" style="width: 70px;">
                @Resources.Lang.finalscore
            </td>
            <td class="nowrap" style="width: 60px;">
                @Resources.Lang.status
            </td>
        </tr>
    </thead>
    <tbody>
        @if (Model != null && Model.Any())
        {
            var currentLeagueId = 0;

            foreach (var item in Model)
            {
                var eventStatus = string.Empty;
                var betStatus = string.Empty;

                var finalHomeScore = 0;
                var finalAwayScore = 0;
                var firstHalfHomeScore = 0;
                var firstHalfAwayScore = 0;

                var homeTeam = string.Empty;
                var awayTeam = string.Empty;

                var Q1Away = "-";
                var Q1Home = "-";
                var Q2Away = "-";
                var Q2Home = "-";
                var Q3Away = "-";
                var Q3Home = "-";
                var Q4Away = "-";
                var Q4Home = "-";
                var OTAway = string.Empty;
                var OTHome = string.Empty;
                eventStatus = item.EventStatus.ToLower();

                if (eventStatus != "refund ft")
                {
                    betStatus = item.BetStatus;
                    finalHomeScore = item.FinalHomeScore;
                    finalAwayScore = item.FinalAwayScore;
                    firstHalfHomeScore = item.HalfTimeHomeScore;
                    firstHalfAwayScore = item.HalfTimeAwayScore;

                    if (finalHomeScore > finalAwayScore)
                    {
                        homeTeam = "<b>" + item.HomeTeam + (item.IsNeutral ? Resources.Lang.IsNeutral : string.Empty) + "</b>";
                        awayTeam = item.AwayTeam;
                    }
                    else if (finalHomeScore < finalAwayScore)
                    {
                        homeTeam = item.HomeTeam;
                        awayTeam = "<b>" + item.AwayTeam + "</b>";
                    }
                    else
                    {
                        homeTeam = item.HomeTeam;
                        awayTeam = item.AwayTeam;
                    }

                    //23-12,26-11,17-13,15-15
                    string[] listOfBetStatus = betStatus.Split(',');
                    if (listOfBetStatus.Count() > 1)
                    {
                        Q1Home = listOfBetStatus[0].Split('-')[0];
                        Q1Away = listOfBetStatus[0].Split('-')[1];

                        Q2Home = listOfBetStatus[1].Split('-')[0];
                        Q2Away = listOfBetStatus[1].Split('-')[1];

                        Q3Home = listOfBetStatus[2].Split('-')[0];
                        Q3Away = listOfBetStatus[2].Split('-')[1];

                        Q4Home = listOfBetStatus[3].Split('-')[0];
                        Q4Away = listOfBetStatus[3].Split('-')[1];

                        if (listOfBetStatus.Count() > 4)
                        {

                            OTHome = listOfBetStatus[4].Split('-')[0];
                            OTAway = listOfBetStatus[4].Split('-')[1];

                        }
                    }

                }

                if (currentLeagueId != item.LeagueId)
                {
                    currentLeagueId = item.LeagueId;
            <tr class="league">
                <td colspan="10">
                    @item.LeagueName
                </td>
            </tr>
                }

            <tr class="c">
                <td rowspan="2">
                    @item.KickoffTime
                </td>
                <td class="l">
                    @Html.Raw(homeTeam)
                </td>
                <td>
                    @Q1Home
                </td>
                <td>
                    @Q2Home
                </td>
                <td>
                    @Q3Home
                </td>
                <td>
                    @Q4Home
                </td>
                <td>
                    @OTHome
                </td>
                <td>
                    @firstHalfHomeScore
                </td>
                <td>
                    @finalHomeScore
                </td>
                <td rowspan="2">
                    @item.EventStatusTranslation
                </td>
            </tr>
            <tr class="c">
                <td class="l">
                    @Html.Raw(awayTeam)
                </td>
                <td>
                    @Q1Away
                </td>
                <td>
                    @Q2Away
                </td>
                <td>
                    @Q3Away
                </td>
                <td>
                    @Q4Away
                </td>
                <td>
                    @OTAway
                </td>
                <td>
                    @firstHalfAwayScore
                </td>
                <td>
                    @finalAwayScore
                </td>
            </tr>

            }
        }
        else
        {
            @RazorHelper.ShowNoInfo(colspan: 10);
        }
    </tbody>
</table>