@using Apollo.Age.Reports.Models
@using Apollo.Age.Reports.Core
@model IEnumerable<MatchResultModel>
<table class="tblRpt">
    <thead>
        <tr class="RptHeader">
            <td style="width: 90px" columnname="kickofftime">
                @Resources.Lang.kickofftime
            </td>
            <td>
                @Resources.Lang.match
            </td>
            <td style="width: 50px;">
                @Resources.Lang.Q1
            </td>
            <td style="width: 50px;">
                @Resources.Lang.Q2
            </td>
            <td style="width: 50px;">
                @Resources.Lang.Q3
            </td>
            <td style="width: 50px;">
                @Resources.Lang.Q4
            </td>
            <td style="width: 50px;">
                @Resources.Lang.OT
            </td>
            <td style="width: 70px;">
                @Resources.Lang.firsthalfscore
            </td>
            <td class="nowrap" style="width: 70px;">
                @Resources.Lang.finalscore
            </td>
            <td class="nowrap" style="width: 60px;">
                @Resources.Lang.status
            </td>
        </tr>
    </thead>
    <tbody>
        @if (Model != null && Model.Any())
        {
            var currentLeagueId = 0;
            foreach (var item in Model)
            {
                if (currentLeagueId != item.LeagueId)
                {
                    currentLeagueId = item.LeagueId;
            <tr class="league">
                <td colspan="10">
                    @item.LeagueName
                </td>
            </tr>
                }

            <tr>
                <td rowspan="2">
                    @item.KickoffTime
                </td>
                <td>
                    @item.HomeTeam
                </td>
                <td>
                </td>
                <td>
                </td>
                <td>
                </td>
                <td>
                </td>
                <td>
                </td>
                <td>
                </td>
                <td>
                </td>
                <td>
                </td>
            </tr>
            <tr>
                <td>
                    @item.AwayTeam
                </td>
                <td>
                </td>
                <td>
                </td>
                <td>
                </td>
                <td>
                </td>
                <td>
                </td>
                <td>
                </td>
                <td>
                </td>
                <td>
                </td>
            </tr>

            }
        }
        else
        {
            @RazorHelper.ShowNoInfo(colspan: 10);
        }
    </tbody>
</table>