@using Apollo.Age.Reports.Models
@using Apollo.Age.Reports.Core
@model IEnumerable<MatchResultModel>
<table class="tblRpt">
    <thead>
        <tr class="RptHeader">
            <td style="width: 90px" columnname="kickofftime">
                @Resources.Lang.kickofftime
            </td>
            <td>
                @Resources.Lang.match
            </td>
            <td style="width: 50px;">
                @Resources.Lang.Q1
            </td>
            <td style="width: 50px;">
                @Resources.Lang.Q2
            </td>
            <td style="width: 50px;">
                @Resources.Lang.Q3
            </td>
            <td style="width: 50px;">
                @Resources.Lang.Q4
            </td>
            <td style="width: 50px;">
                @Resources.Lang.OT
            </td>
            <td style="width: 70px;">
                @Resources.Lang.firsthalfscore
            </td>
            <td class="nowrap" style="width: 70px;">
                @Resources.Lang.finalscore
            </td>
            <td class="nowrap" style="width: 60px;">
                @Resources.Lang.status
            </td>
        </tr>
    </thead>
    <tbody>
        @if (Model != null && Model.Any())
        {
            var currentLeagueId = 0;

            foreach (var item in Model)
            {
                var eventStatus = string.Empty;
                var betStatus = string.Empty;

                var finalHomeScore = string.Empty;
                var finalAwayScore = string.Empty;
                var firstHalfHomeScore = string.Empty;
                var firstHalfAwayScore = string.Empty;

                var homeTeam = string.Empty;
                var awayTeam = string.Empty;
                List<string> homeSet = new List<string>() { "-", "-", "-", "-", "-" };
                List<string> awaySet = new List<string>() { "-", "-", "-", "-", "-" };

                var OTAway = string.Empty;
                var OTHome = string.Empty;

                eventStatus = item.EventStatus.ToLower();

                if (eventStatus == Apollo.Age.Reports.Core.Constants.REFUND)
                {
                    finalHomeScore = finalAwayScore = firstHalfHomeScore = firstHalfAwayScore = @Resources.Lang.lblNA;
                }
                else if (eventStatus == Apollo.Age.Reports.Core.Constants.REFUND_FT)
                {
                    finalHomeScore = finalAwayScore = @Resources.Lang.lblNA;
                    firstHalfHomeScore = item.HalfTimeHomeScore.ToString();
                    firstHalfAwayScore = item.HalfTimeAwayScore.ToString();
                }
                else if (eventStatus == Apollo.Age.Reports.Core.Constants.REFUND_HT)
                {
                    finalHomeScore = item.FinalHomeScore.ToString();
                    finalAwayScore = item.FinalAwayScore.ToString();
                    firstHalfHomeScore = firstHalfAwayScore = @Resources.Lang.lblNA;

                }
                else
                {
                    finalHomeScore = item.FinalHomeScore.ToString();
                    finalAwayScore = item.FinalAwayScore.ToString();
                    firstHalfHomeScore = item.HalfTimeHomeScore.ToString();
                    firstHalfAwayScore = item.HalfTimeAwayScore.ToString();
                }
                
                if (item.FinalHomeScore > item.FinalAwayScore)
                {
                    homeTeam = "<b>" + item.HomeTeam + "</b>";
                    awayTeam = item.AwayTeam;
                }
                else if (item.FinalHomeScore < item.FinalAwayScore)
                {
                    homeTeam = item.HomeTeam;
                    awayTeam = "<b>" + item.AwayTeam + "</b>";
                }
                else
                {
                    homeTeam = item.HomeTeam;
                    awayTeam = item.AwayTeam;
                }

                if (eventStatus != Apollo.Age.Reports.Core.Constants.REFUND_FT)
                {
                    betStatus = item.BetStatus.ToLower();

                    //23-12,26-11,17-13,15-15
                    if (!string.IsNullOrWhiteSpace(betStatus) && betStatus.IndexOf(',') >= 0)
                    {
                        string[] listOfBetStatus = betStatus.Split(',');
                        string[] sets = null;
                        int i = 0;
                        foreach (var itemBetStatus in listOfBetStatus)
                        {
                            sets = itemBetStatus.Split('-');
                            homeSet[i] = sets[0];
                            awaySet[i] = sets[1];
                            i++;
                        }

                        if (listOfBetStatus.Count() > 4)
                        {
                            OTHome = listOfBetStatus[4].Split('-')[0];
                            OTAway = listOfBetStatus[4].Split('-')[1];
                        }
                    }

                }

                if (currentLeagueId != item.LeagueId)
                {
                    currentLeagueId = item.LeagueId;
            <tr class="league">
                <td colspan="10">
                    @item.LeagueName
                </td>
            </tr>
                }

            <tr class="c">
                <td rowspan="2">
                    @item.KickoffTime
                </td>
                <td class="l">
                    @Html.Raw(homeTeam)
                </td>
                <td>
                    @homeSet[0]
                </td>
                <td>
                    @homeSet[1]
                </td>
                <td>
                    @homeSet[2]
                </td>
                <td>
                    @homeSet[3]
                </td>
                <td>
                    @OTHome
                </td>
                <td>
                    @firstHalfHomeScore
                </td>
                <td>
                    @finalHomeScore
                </td>
                <td rowspan="2">
                    @item.EventStatusTranslation
                </td>
            </tr>
            <tr class="c">
                <td class="l">
                    @Html.Raw(awayTeam)
                </td>
                <td>
                    @awaySet[0]
                </td>
                <td>
                    @awaySet[1]
                </td>
                <td>
                    @awaySet[2]
                </td>
                <td>
                    @awaySet[3]
                </td>
                <td>
                    @OTAway
                </td>
                <td>
                    @firstHalfAwayScore
                </td>
                <td>
                    @finalAwayScore
                </td>
            </tr>

            }
        }
        else
        {
            @RazorHelper.ShowNoInfo(colspan: 10);
        }
    </tbody>
</table>