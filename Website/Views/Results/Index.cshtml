@using Apollo.Age.Reports.Models;
@using Fanex.Age.Utility;
@using Sunplus.Agent.Model.Entities;
@{
    Page.Title = "Resource.Result";
    Layout = "~/Views/Reports/Shared/_Layout.cshtml";
}
@model Apollo.Age.Reports.ViewModels.ReportResultViewModel
@using (Html.BeginForm())
{
    <div id="content_main">
        <div id="box_header">
            @Html.DatePicker("date", Model.EventDate, minDate: Model.BalanceUpDay, maxDate: DateTime.Now.Date)
            <input id="btnSubmit" value="Resouces.Generate" type="submit" />
            <input id="btnToday" value="@DateTime.Now.Date.ToString()" type="submit" />
            <input id="btnYesterday" value="@DateTime.Now.AddDays(-1).Date.ToString()" type="submit"/>
        </div>
        @if (Model.SportList.Any())
        { 
        
                
            <span>{static:Resources.Lang.sport} </span>
                
            <span>
                @Html.DropDownList("ddlSport", Model.SportSelectListItem)
            </span>

            <span>{static:Resources.Lang.league} </span>
            <span id="panelLeague">
                <select name="ddlLeague" id="ddlLeague">
                    <option value="0">   </option>
                </select>
            </span>          
            <br />
            <div id="resultContainer">
            </div>          
        }
    </div>
}
@Html.Hidden("ApoRoot", Url.Content("~/"))
<script src="~/_GlobalResources/Js/jquery.js" type="text/javascript"></script>
<script src="~/_GlobalResources/Js/jquery-ui.js" type="text/javascript"></script>
<script src="~/_GlobalResources/Js/Core.js" type="text/javascript"></script>
<script src="~/Views/Results/Resources/ReportResult.js" type="text/javascript"></script>
