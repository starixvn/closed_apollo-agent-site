@using Apollo.Age.Reports.Models
@using Apollo.Age.Reports.Core
@model IEnumerable<MatchResultModel>
<table class="tblRpt">
    <thead>
        <tr class="RptHeader">
            <td style="width: 90px" columnname="kickofftime">
                @Apollo.Age.Resources.Lang.kickofftime
            </td>
            <td>
                @Apollo.Age.Resources.Lang.match
            </td>
            <td style="width: 50px;">
                @Apollo.Age.Resources.Lang.S1
            </td>
            <td style="width: 50px;">
                @Apollo.Age.Resources.Lang.S2
            </td>
            <td style="width: 50px;">
                @Apollo.Age.Resources.Lang.S3
            </td>
            <td style="width: 50px;">
                @Apollo.Age.Resources.Lang.S4
            </td>
            <td style="width: 50px;">
                @Apollo.Age.Resources.Lang.S5
            </td>
            <td style="width: 50px;">
                @Apollo.Age.Resources.Lang.totalpoint
            </td>
            <td class="nowrap" style="width: 70px;">
                @Apollo.Age.Resources.Lang.totalset
            </td>
            <td class="nowrap" style="width: 60px;">
                @Apollo.Age.Resources.Lang.status
            </td>
        </tr>
    </thead>
    <tbody>
        @if (Model != null && Model.Any())
        {
            var currentLeagueId = 0;

            var betStatus = string.Empty;
            var eventStatus = string.Empty;

            var finalHomeScore = 0;
            var finalAwayScore = 0;

            var homeTeam = string.Empty;
            var awayTeam = string.Empty;

            List<string> homeSets = null;
            List<string> awaySets = null;

            var totalPointAway = string.Empty;
            var totalPointHome = string.Empty;
            
            foreach (var item in Model)
            {
                 betStatus = string.Empty;
                 eventStatus = string.Empty;

                 finalHomeScore = 0;
                 finalAwayScore = 0;

                 homeTeam = string.Empty;
                 awayTeam = string.Empty;

                 homeSets = new List<string> { "-", "-", "-", "-", "-" };
                 awaySets = new List<string> { "-", "-", "-", "-", "-" };

                 totalPointAway = string.Empty;
                 totalPointHome = string.Empty;

                betStatus = item.BetStatus;
                finalHomeScore = item.FinalHomeScore;
                finalAwayScore = item.FinalAwayScore;

                if (finalHomeScore > finalAwayScore)
                {
                    homeTeam = "<b>" + item.HomeTeam + "</b>";
                    awayTeam = item.AwayTeam;
                }
                else if (finalHomeScore < finalAwayScore)
                {
                    homeTeam = item.HomeTeam;
                    awayTeam = "<b>" + item.AwayTeam + "</b>";
                }
                else
                {
                    homeTeam = item.HomeTeam;
                    awayTeam = item.AwayTeam;
                }

                if (!string.IsNullOrWhiteSpace(betStatus) && betStatus.IndexOf(',') >= 0)
                {

                    string[] listOfBetStatus = betStatus.Split(',');
                    var i = 0;
                    string[] itemsBetStatus = null;
                    var totalGameHome = 0;
                    var totalGameAway = 0;
                    foreach (var x in listOfBetStatus)
                    {
                        itemsBetStatus = x.Split('-');
                        homeSets[i] = itemsBetStatus[0];
                        awaySets[i] = itemsBetStatus[1];

                        totalGameHome += Convert.ToInt32(homeSets[i]);
                        totalGameAway += Convert.ToInt32(awaySets[i]);
                        i++;

                    }
                    totalPointHome = totalGameHome > 0 ? totalGameHome.ToString() : string.Empty;
                    totalPointAway = totalGameAway > 0 ? totalGameAway.ToString() : string.Empty;

                }

                if (currentLeagueId != item.LeagueId)
                {
                    currentLeagueId = item.LeagueId;
            <tr class="league">
                <td colspan="10">
                    @item.LeagueName
                </td>
            </tr>
                }

            <tr class="c">
                <td rowspan="2">
                    @item.KickoffTime
                </td>
                <td class="l">
                    @Html.Raw(homeTeam)
                </td>
                <td>
                    @homeSets[0]
                </td>
                <td>
                    @homeSets[1]
                </td>
                <td>
                    @homeSets[2]
                </td>
                <td>
                    @homeSets[3]
                </td>
                <td>
                    @homeSets[4]
                </td>
                <td>
                    @totalPointHome
                </td>
                <td>
                    @finalHomeScore
                </td>
                <td rowspan="2">
                    @item.EventStatusTranslation
                </td>
            </tr>
            <tr class="c">
                <td class="l">
                    @Html.Raw(awayTeam)
                </td>
                <td>
                    @awaySets[0]
                </td>
                <td>
                    @awaySets[1]
                </td>
                <td>
                    @awaySets[2]
                </td>
                <td>
                    @awaySets[3]
                </td>
                <td>
                    @awaySets[4]
                </td>
                <td>
                    @totalPointAway
                </td>
                <td>
                    @finalAwayScore
                </td>
            </tr>

            }
        }
        else
        {
            @RazorHelper.ShowNoInfo(colspan: 10);
        }
    </tbody>
</table>