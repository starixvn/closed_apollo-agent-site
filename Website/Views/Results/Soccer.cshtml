@using Apollo.Age.Reports.Models
@using Apollo.Age.Reports.Core
@using Apollo.Age

@model IEnumerable<MatchResultModel>

<table class="tblRpt">
    <thead>
        <tr class="RptHeader">
            <td style="width: 90px">
                @Resources.Lang.kickofftime
            </td>
            <td>
                @Resources.Lang.match
            </td>
            <td style="width: 70px;">
                @Resources.Lang.firsthalfscore
            </td>
            <td class="nowrap" style="width: 70px;">
                @Resources.Lang.finalscore
            </td>
            <td class="nowrap" style="width: 60px;">
                @Resources.Lang.status
            </td>
        </tr>
    </thead>
    <tbody>
        @if (Model != null && Model.Any())
        {
            int rowIndex = 0;
            int currentLeagueId = 0;

            foreach (var item in Model)
            {
                rowIndex++;

                @ShowLeague(currentLeagueId, item)
                @ShowMatch(rowIndex, item)

                currentLeagueId = item.LeagueId;
            }
        }
        else
        { 
            @RazorHelper.ShowNoInfo(colspan: 5);
        }
    </tbody>
</table>

@helper ShowLeague(int currentLeagueId, MatchResultModel item)
{
    if (currentLeagueId != item.LeagueId)
    { 
        <tr class="league">
            <td colspan="6">
                @item.LeagueName
            </td>
        </tr>
    }
}

@helper ShowMatch(int index, MatchResultModel item)
    {
        var classRow = string.Empty;
        if (index % 2 == 0)
        {
            classRow = "class=alt";
        }
    
    <tr @classRow>
        <td rowspan="2">
            @Formater.FullDateFormat2Line item.KickoffTime
        </td>
        <td>
            @if (item.FinalHomeScore > item.FinalAwayScore)
            {
                <b>
                    @item.HomeTeam
                </b>
            }
            else
            {
                @item.HomeTeam
            }
            
            @FirstAndLastGoal(item, isRowHome: true)

        </td>

        @BindScore(item, isRowHome: true)

        <td rowspan="2">
            @Html.Raw(item.EventStatus)
        </td>
    </tr>
    <tr>
        <td>
            @if (item.FinalHomeScore < item.FinalAwayScore)
            {
                <b>
                    @item.AwayTeam
                </b>
            }
            else
            {
                @item.AwayTeam
            }

            @if (!string.IsNullOrEmpty(item.BetStatus) && item.BetStatus.Contains(":"))
            {

            }

            @FirstAndLastGoal(item, isRowHome: false)

        </td>
        @BindScore(item, isRowHome: false)
    </tr>
}

@helper FirstAndLastGoal(MatchResultModel item, bool isRowHome)
    {
        // Base on [BetStatus] to get First/Last Goal
        // Example [BetStatus] = "FL:1-2"

        if (!string.IsNullOrEmpty(item.BetStatus) && item.BetStatus.Contains(":"))
        {
            var valueArr = item.BetStatus.Split(':');
            if (string.Compare(valueArr[0], "FL", true) == 0)
            {
                var firstGoal = valueArr[1].Split('-')[0];
                var lastGoal = valueArr[1].Split('-')[1];

                if (isRowHome)
                {
                    if (firstGoal == "1")
                    {
                    <div class="first_goal">&nbsp;</div>
                    }
                    if (lastGoal == "1")
                    {
                    <div class="last_goal">&nbsp;</div>
                    }
                }
                else
                {
                    if (firstGoal == "2")
                    {
                    <div class="first_goal">&nbsp;</div>
                    }
                    if (lastGoal == "2")
                    {
                    <div class="last_goal">&nbsp;</div>
                    }
                }
            }
        }
}

@helper BindScore(MatchResultModel item, bool isRowHome)
{
    if (item.EventStatus == Apollo.Age.Reports.Core.Constants.REFUND)
    {
        <td>
            @Resources.Lang.lblNA
        </td>
        <td>
            @Resources.Lang.lblNA
        </td>
    }
    else if (item.EventStatus == Apollo.Age.Reports.Core.Constants.REFUND_FT)
    {
        if (isRowHome)
        {
            <td>
                @item.HalfTimeHomeScore
            </td>
            <td>
                @item.FinalHomeScore
            </td>
        }
        else
        {
            <td>
                @Resources.Lang.lblNA
            </td>
            <td>
                @Resources.Lang.lblNA
            </td>
        }
    }
    else if (item.EventStatus == Apollo.Age.Reports.Core.Constants.REFUND_HT)
    {
        if (isRowHome)
        {
            <td>
                @Resources.Lang.lblNA
            </td>
            <td>
                @Resources.Lang.lblNA
            </td>
        }
        else
        {
            <td>
                @item.HalfTimeAwayScore
            </td>
            <td>
                @item.FinalAwayScore
            </td>
        }
    }
    else
    {
        if (isRowHome)
        {
            <td>
                @item.HalfTimeHomeScore
            </td>
            <td>
                @item.FinalHomeScore
            </td>
        }
        else
        {
            <td>
                @item.HalfTimeAwayScore
            </td>
            <td>
                @item.FinalAwayScore
            </td>
        }
    }
}