@using Apollo.Age.Reports.Models
@model IEnumerable<MatchResultModel>
@helper ShowLeague(int currentLeagueId, MatchResultModel item)
    {
    if (currentLeagueId != item.LeagueId)
    { 
    <!--LeagueContents-->
    <tr class="league">
        <td colspan="6">
            @item.LeagueName
        </td>
    </tr>
    }            
}
@helper ShowMatch(int index, MatchResultModel item)
{
    var classRow = string.Empty;
    if (index % 2 == 0)
    {
        classRow = "class=alt";
    }
    
    <tr @classRow>
        <td rowspan="2">
            @item.KickoffTime
        </td>
        <td>
            @if (item.FinalHomeScore > item.FinalAwayScore)
            {
                <b>
                    @item.HomeTeam
                </b>
            }
            else
            {
                @item.HomeTeam
            }
            
            @if(item.IsHomeFirstGoal)
            {
                <div class="first_goal">&nbsp;</div>
            }

            @if(item.IsHomeLastGoal)
            {
                <div class="last_goal">&nbsp;</div>
            }
        </td>
        <td>
            {HTHomeScore}
        </td>
        <td>
            {FTHomeScore}
        </td>
        <td rowspan="2">
            @Html.Raw(item.EventStatus)
        </td>
    </tr>
    <tr>
        <td>
            @if (item.FinalHomeScore < item.FinalAwayScore)
            {
                <b>
                    @item.AwayTeam
                </b>
            }
            else
            {
                @item.AwayTeam
            }

            @if(!string.IsNullOrEmpty(item.BetStatus) && item.BetStatus.Contains(":"))
            {
                
            }

            @if(item.IsAwayFirstGoal)
            {
                <div class="first_goal">&nbsp;</div>
            }

            @if(item.IsAwayLastGoal)
            {
                <div class="last_goal">&nbsp;</div>
            }
        </td>
        <td>
            {HTAwayScore}
        </td>
        <td>
            {FTAwayScore}
        </td>
    </tr>
}

<table class="tblRpt">
    <thead>
        <tr class="RptHeader">
            <td style="width: 90px" columnname="kickofftime">
                @Resources.Lang.kickofftime
            </td>
            <td>
                @Resources.Lang.match
            </td>
            <td style="width: 70px;">
                @Resources.Lang.firsthalfscore
            </td>
            <td class="nowrap" style="width: 70px;">
                @Resources.Lang.finalscore
            </td>
            <td class="nowrap" style="width: 60px;">
                @Resources.Lang.status
            </td>
        </tr>
    </thead>
    <tbody>
        @if (Model != null && Model.Any())
        {
            int rowIndex = 0;
            int currentLeagueId = 0;

            foreach (var item in Model)
            {
                rowIndex++;

                item.SetFirstAndLastGoal();
                @ShowLeague(currentLeagueId, item)
                @ShowMatch(rowIndex, item)

                currentLeagueId = item.LeagueId;
            }
        }
        else
        { 
            @RazorHelper.ShowNoInfo(colspan: 5);
        }
    </tbody>
</table>
