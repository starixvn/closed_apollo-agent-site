@using Apollo.Age.Reports.Models;
@using Apollo.Age.Reports.ViewModels;
@{
	Layout = "~/Views/Reports/Shared/_Layout.cshtml";
	ViewBag.Title = Apollo.Age.Resources.Lang.lblMatchResult;
}
@model MatchResultViewModel
@section css {
	<link href="~/Views/Results/Resources/Results.less" rel="stylesheet" type="text/css" />
}
@using (Html.BeginForm())
{
	<div id="box_header">
		<div class="row">
			<div class="cell">
				<div class="label">
					<label for="EventDate">@Apollo.Age.Resources.Lang.date</label>
				</div>
				<div class="editor">
					@Html.DatePicker("EventDate", Model.EventDate, minDate: Model.BalanceUpDay, maxDate: DateTime.Now.Date)
                    <div class="img-calendar"></div>
				</div>
			</div>
			<div class="cell">
				<div class="editor">
					<input id="btnSubmit" value="@Apollo.Age.Resources.Lang.Generate" type="submit" class="btn" />
					<input id="btnToday" value="@Formater.ShortDateFormat(DateTime.Now)" type="submit" class="btn" />
					<input id="btnYesterday" value="@Formater.ShortDateFormat(DateTime.Now.AddDays(-1))" type="submit" class="btn"/>
				</div>
			</div>
		</div>
		@if (Model.SportList != null && Model.SportList.Any())
		{
			<div class="row">
				<div class="cell">
					<div class="label">
						<label for="ddlSport">@Apollo.Age.Resources.Lang.sport</label>
					</div>
					<div class="editor">
						@Html.DropDownList("ddlSport", Model.SportSelectListItem)
					</div>
				</div>
				<div class="cell">
					<div class="label">
						<label for="ddlLeague">@Apollo.Age.Resources.Lang.league</label>
					</div>
					<div class="editor">
						@Html.DropDownList("ddlLeague",
						new List<SelectListItem> { new SelectListItem { Text = string.Empty, Value = "0" } },
						new { style = "width: 500px" })
					</div>
				</div>
			</div>
		}
	</div>

    if (Model.SportList != null && Model.SportList.Any())
    {
	    <div id="resultContainer"></div>
    }
    else
    {
        <div class="no-data">@Apollo.Age.Resources.Lang.noInfo</div>
    }
}
@section scripts
{
	<script src="~/Views/Results/Resources/Match.js" type="text/javascript"></script>
}