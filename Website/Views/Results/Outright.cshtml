@using Apollo.Age.Reports.Models;
@using Apollo.Age.Reports.ViewModels;
@{
	Layout = "~/Views/Reports/Shared/_Layout.cshtml";
	ViewBag.Title = Apollo.Age.Resources.Lang.lblOutrightResult;
}
@model OutrightResultViewModel
@section css {
	<link href="~/Views/Results/Resources/Results.less" rel="stylesheet" type="text/css" />
}
@using (Html.BeginForm())
{
	<div id="box_header">
		<div class="row">
			<div class="cell">
				<div class="label">
					<label for="FromDate">@Apollo.Age.Resources.Lang.from</label>
				</div>
				<div class="editor">
					@Html.DatePicker("FromDate", Model.FromDate, minDate: Model.BalanceUpDay, maxDate: DateTime.Now.Date)
					<div class="img-calendar"></div>
				</div>
				<div class="label">
					<label for="ToDate">@Apollo.Age.Resources.Lang.to</label>
				</div>
				<div class="editor">
					@Html.DatePicker("ToDate", Model.ToDate, minDate: Model.BalanceUpDay, maxDate: DateTime.Now.Date)
					<div class="img-calendar"></div>
				</div>
			</div>
			<div class="cell">
				<div class="editor">
					<input id="btnSubmit" value="@Apollo.Age.Resources.Lang.Generate" type="submit" class="btn" />
					<input id="btnToday" value="@Apollo.Age.Resources.Lang.today" type="submit" 
						class="btn" title="@Formater.ShortDateFormat(DateTime.Now)"/>
					<input id="btnYesterday" value="@Apollo.Age.Resources.Lang.yesterday" type="submit" 
						class="btn" title="@Formater.ShortDateFormat(DateTime.Now.AddDays(-1))"/>

					<input type="hidden" name="todayValue" id="todayValue" value="@Formater.ShortDateFormat(DateTime.Now)"/>
					<input type="hidden" name="yesterdayValue" id="yesterdayValue" value="@Formater.ShortDateFormat(DateTime.Now.AddDays(-1))"/>
				</div>
			</div>
		</div>
		@if (Model.SportList != null && Model.SportList.Any())
		{
			<div class="row">
				<div class="cell">
					<div class="label">
						<label for="ddlSport">@Apollo.Age.Resources.Lang.sport</label>
					</div>
					<div class="editor">
						@Html.DropDownList("ddlSport", Model.SportSelectListItem)
					</div>
				</div>
				<div class="cell">
					<div class="label">
						<label for="ddlLeague">@Apollo.Age.Resources.Lang.league</label>
					</div>
					<div class="editor">
						@Html.DropDownList("ddlLeague",
						new List<SelectListItem> { new SelectListItem { Text = string.Empty, Value = "0" } },
						new { style = "width: 500px" })
					</div>
				</div>
			</div>
		}
	</div>

		if (Model.SportList != null && Model.SportList.Any())
		{
			<div id="resultContainer">
			</div>
		}
		else
		{
			<div class="no-data">@Apollo.Age.Resources.Lang.noInfo</div>
		}
}
@section scripts
{
	<script src="~/Views/Results/Resources/Outright.js" type="text/javascript"></script>
}