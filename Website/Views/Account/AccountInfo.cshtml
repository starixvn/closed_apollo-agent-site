@using Apollo.Age.Account.Models;
@using Apollo.Age;
@model CustomerInfoModel
@{
    Layout = "~/Views/Account/Shared/_Layout.cshtml";
}
<ul id="tab-menu">
    <li class="tab-menu"><a id="lk-menu-tab" href="javascript:;" target="menu"><i class="icon-align-justify">
    </i>@Apollo.Age.Resources.Lang.mainmenu</a> </li>
    <li class="tab-tree"><a id="lk-tree-tab" href="javascript:;" target="menu"><i class="icon-user">
    </i>@Apollo.Age.Resources.Lang.userinfo</a> </li>
    <li class="tab-acc active"><a><i class="icon-search"></i>@Apollo.Age.Resources.Lang.search</a>
    </li>
</ul>
<div id="wrapper">
    <div class="search-box">
        <div class="clearfix">
            @SearchBox()
        </div>
        @if (Model != null)
        {
            if (Model.CustId > 0)
            {
            <table class="cust-info">
                <tbody>
                    <tr>
                        @if (Model.IsMember)
                        {
                            <td class="agent-lbl">
                                @Apollo.Age.Resources.Lang.lblMember:
                            </td>
                        }
                        else
                        {
                            <td class="agent-lbl">
                                @Apollo.Age.Resources.Lang.agent:
                            </td>
                        }
                        <td class="agent-name">
                            @Model.Username
                        </td>
                    </tr>
                    <tr>
                        @if (Model.IsMember)
                        {
                            <td class="parent-lbl">
                                @Apollo.Age.Resources.Lang.agent:
                            </td>
                        }
                        else
                        {
                            <td class="parent-lbl">
                                @Apollo.Age.Resources.Lang.lblParentname:
                            </td>
                        }
                        <td class="parent-name">
                            @if (!Model.IsMember && (Model.ActorAgentId == Model.CustId || Model.Level == WebConstants.MAIN_SHAREHOLDER_LEVEL))
                            {
                                @Model.ParentName
                            }
                            else
                            {
                                if (Model.ActorAgentId != Model.ParentId)
                                {
                                <a href="javascript:;" id="agentDownlineLink" aid="@Model.ParentId"
                                        title="@Apollo.Age.Resources.Lang.txtShowUpline" alt="@Apollo.Age.Resources.Lang.txtShowUpline">
                                    <div id="ddl-agents">
                                        <ul class="agent-list">
                                        </ul>
                                    </div>
                                </a>
                                }
                                <a class="view-agentinfo" href="javascript:;" target="menu"
                                    agent-id='@Model.ParentId' agent-name='@Model.ParentName'>@Model.ParentName
                                </a>
                            }
                        </td>
                    </tr>
                </tbody>
            </table>
            }
            else
            {
            <div class="errMsg">@Apollo.Age.Resources.Lang.usernamenotexisted</div>
            }
        }
    </div>
    @if (Model != null)
    {
        if (Model.CustId > 0)
        {
        <div class="clearfix">
            @if (!Model.IsMember)
            {
                if (Model.HasAgentDownline)
                {
                <a class="lnk-agent-list"
                            target="main" href="~/Account/AgentList?agentid=@Model.CustId">
                    @Apollo.Age.Resources.Lang.lblAgentList
                </a>
                }
                if (Model.HasMemberDownline && Model.Level > WebConstants.SHAREHOLDER_LEVEL)
                {
                <a class="lnk-member-list"
                            target="main" href="~/Account/MemberList?agentid=@Model.CustId">
                    @Apollo.Age.Resources.Lang.lblPlayerList
                </a>
                }
            }
            @if (Model.IsMember)
            {
                <a class="lnk-betlist" target="main" href="~/_BetList/BetListOnMember.aspx?custId=@Model.CustId&username=@Model.Username&type=accountinfo">
                    @Apollo.Age.Resources.Lang.BetList
                </a>
            }
        </div>
        <div id="agent-setting">
            <ul class="tabs">
                <li id="custsettings" class="current"><a class="show-section" agent-id="@Model.CustId" href="javascript:void(0);">
                    <span>@Apollo.Age.Resources.Lang.setting</span> </a></li>
                @if (!Model.IsMember)
                {
                    <li id="agentsTab"><a class="show-section" agent-id="@Model.CustId" href="javascript:void(0);">
                        <span>@Apollo.Age.Resources.Lang.lblAgents</span> </a></li>
                    if (Model.Level > WebConstants.SHAREHOLDER_LEVEL)
                    {
                    <li id="membersTab"><a class="show-section" agent-id="@Model.CustId" href="javascript:void(0);">
                        <span>@Apollo.Age.Resources.Lang.lblMembers</span> </a></li>
                    }
                }
            </ul>
            <div class="content">
                <div id="custsettings-content">
                    @if (Model.IsMember)
                    {
                        var group = Model.Group == null ? string.Empty : Model.Group.ToUpper();
                        <a class="lnk-setting" target="main"
                            href="~/CustomerSetting/EditMemberSetting?memberId=@Model.CustId&userName=@Model.Username&showHeader=true&userGroup=@group&agentId=@Model.ParentId">
                            @if (Model.IsMaster)
                            {
                                @Apollo.Age.Resources.Lang.lblEditSB
                            }
                            else
                            {
                                @Apollo.Age.Resources.Lang.ViewSportsbook
                            }
                        </a>

                        <a class="lnk-setting" target="main" href="~/CustomerSetting/MemberShare?memberId=@Model.CustId&userName=@Model.Username">
                            @Apollo.Age.Resources.Lang.ViewShare
                        </a>

                        <a class="lnk-setting" target="main"
                            href="~/CustomerSetting/ViewCommission?id=@Model.CustId&isMember=@Model.IsMember.ToString()">
                            @Apollo.Age.Resources.Lang.ViewCommission
                        </a>
                    }
                    else
                    {
                        if (Model.ActorAgentId == Model.CustId)
                        {
                        <a class="lnk-setting" target="main" href="~/CustomerSetting/MySetting">
                            @Apollo.Age.Resources.Lang.lblViewAllSetting
                        </a>
                        }
                        else
                        {
                        <a class="lnk-setting" target="main"
                                href="~/CustomerSetting/EditAgentSetting?agentId=@Model.CustId&userName=@Model.Username&agentLevel=@Model.Level&showHeader=true">
                            @if (Model.IsMaster)
                            {
                                @Apollo.Age.Resources.Lang.lblEditSB
                            }
                            else
                            {
                                @Apollo.Age.Resources.Lang.ViewSportsbook
                            }
                        </a>
                        }

                        <a class="lnk-setting" target="main" href="~/CustomerSetting/AgentShare?agentId=@Model.CustId&userName=@Model.Username">
                            @Apollo.Age.Resources.Lang.ViewShare
                        </a>
                        <a class="lnk-setting" target="main"
                            href="~/CustomerSetting/ViewCommission?id=@Model.CustId&isMember=@Model.IsMember.ToString()">
                            @Apollo.Age.Resources.Lang.ViewCommission
                        </a>
                    }
                </div>
                <div id="agentsTab-content">
                    @if (Model.HasAgentDownline)
                    {
                        <iframe id='frmDownlineList' name='frmDownlineList'
                            frameborder="0" src='~/Account/AgentTreeList?agentid=@Model.CustId'></iframe>
                    }
                    else
                    {
                        <div class="no-data">@Apollo.Age.Resources.Lang.noInfo</div>
                    }
                </div>
                <div id="membersTab-content">
                </div>
            </div>
        </div>
        }
    }
</div>
@section foot
{
    <script src="~/_GlobalResources/Js/jquery-ui.js" type="text/javascript"></script>
    <script src="~/_GlobalResources/Js/Core.js" type="text/javascript"></script>
    <script src="~/Views/Account/Resources/AccountInfo.js" type="text/javascript"></script>
    <script src="~/Views/Account/Resources/Menu.js" type="text/javascript"></script>
}
@helper SearchBox()
    {
        if (Model == null)
        {
    @Html.DropDownList("IsMember", new List<SelectListItem> {
            new SelectListItem { Value = "false", Text = Apollo.Age.Resources.Lang.lblAgent },
            new SelectListItem { Value = "true", Text = Apollo.Age.Resources.Lang.lblMember }
        }, new { id = "ddlIsMember" })

    <input maxlength="50" id="txtUsername" type="text"
            value="@Apollo.Age.Resources.Lang.enterusername" name="userName" />
        }
        else
        {
    @Html.DropDownListFor(m => m.IsMember, new List<SelectListItem> {
            new SelectListItem { Value = "false", Text = Apollo.Age.Resources.Lang.lblAgent },
            new SelectListItem { Value = "true", Text = Apollo.Age.Resources.Lang.lblMember }
        }, new { id = "ddlIsMember" })

    <input maxlength="50" id="txtUsername" type="text"
            value="@Model.Username" name="userName" />
        }
    <button type="button" class="btn search-button">
        <i class="icon-search"></i>
    </button>
    <input id="enterUsernameValue" type="hidden" value="@Apollo.Age.Resources.Lang.enterusername"/>
}