@using Apollo.Age.Account.ViewModels
@{
	ViewBag.Title = "View Commission";
	Layout = "~/Views/Account/Shared/_ViewSettingLayout.cshtml";
	int index = 0;
}
@model ViewCommissionViewModel

@using (Html.BeginForm())
{
<div id="box_header">
	<div class="row">
		<div class="cell">
			<div class="editor">
				@Html.DropDownListFor(m => m.IsMember, new List<SelectListItem>
					{
						new SelectListItem { Value = "false", Text = Resources.Lang.agent },
						new SelectListItem { Value = "true", Text = Resources.Lang.member }
					})
				@Html.TextBoxFor(m => m.Username, new { style = "width: 200px" })
				<input type="submit" id="btnSubmit" class="btn" value="@Resources.Lang.submit" />
			</div>
		</div>
	</div>
</div>
}

<table class="tbl-cust-setting no-border-bottom" style="width: auto">
	<thead>
		<tr>
			<th></th>
			<th>@Resources.Lang.group A (%)</th>
			<th>@Resources.Lang.group B (%)</th>
			<th>@Resources.Lang.group C (%)</th>
			<th>@Resources.Lang.group D (%)</th>
			<th>1x2 (%)</th>
			<th>@Resources.Lang.Others (%)</th>
		</tr>
	</thead>
	<tbody>
	@if (Model.CommissionList != null && Model.CommissionList.Any())
	{
		int lastIndex = Model.CommissionList.Count();

		foreach (var comm in Model.CommissionList)
		{
			string rowClass = index++ % 2 == 0 ? "class='alt'" : string.Empty;

		<tr @Html.Raw(rowClass)>
			<td class="em-row l">@comm.Username</td>
			@if (index == lastIndex && Model.IsMember)
			{
			<td>
				@if (Model.Group.ToLower() == "a")
				{
					@RazorHelper.FormatComm(comm.DiscountA * 100)
				}
			</td>
			<td>
				@if (Model.Group.ToLower() == "b")
				{
					@RazorHelper.FormatComm(comm.DiscountB * 100)
				}
			</td>
			<td>
				@if (Model.Group.ToLower() == "c")
				{
					@RazorHelper.FormatComm(comm.DiscountC * 100)
				}
			</td>
			<td>
				@if (Model.Group.ToLower() == "d")
				{
					@RazorHelper.FormatComm(comm.DiscountD * 100)
				}
			</td>
			}
			else
			{
			<td>@RazorHelper.FormatComm(comm.DiscountA * 100)</td>
			<td>@RazorHelper.FormatComm(comm.DiscountB * 100)</td>
			<td>@RazorHelper.FormatComm(comm.DiscountC * 100)</td>
			<td>@RazorHelper.FormatComm(comm.DiscountD * 100)</td>
			}
			<td>@RazorHelper.FormatComm(comm.Discount1x2 * 100)</td>
			<td>@RazorHelper.FormatComm(comm.DiscountOthers * 100)</td>
		</tr>
		}
	}
 else
 {
		@RazorHelper.ShowNoInfo(7)
	}
	</tbody>
</table>

@section scripts
{
    <script src="~/_GlobalResources/Js/jquery-ui.js" type="text/javascript"></script>
    <script src="~/Views/Account/Resources/ViewComm.js" type="text/javascript"></script>
}