@using Fanex.CustSetting.ViewData
@{
    ViewBag.Title = string.Format("View Commission [{0}]", ViewBag.Username);
    Layout = "~/Views/Account/Shared/_ViewSettingLayout.cshtml";
}
@model CommissionSetting

<table class="tbl-cust-setting">
    <thead>
        <tr>
            <th></th>
            <th>Group A</th>
            <th>Group B</th>
            <th>Group C</th>
            <th>Group D</th>
            <th>1x2</th>
            <th>Other</th>
        </tr>
    </thead>
    <tbody>
    @for (int i = 0; i < 6; i++)
    {
        var comm1 = Model.CommissionItems[0];
        var comm2 = Model.CommissionItems[1];
        var comm3 = Model.CommissionItems[2];
        
        <tr>
            <td>Agent Name</td>
            <td>@RazorHelper.FormatNumber(comm1.DiscountA, numDecimals: 2, showZero: true)</td>
            <td>@RazorHelper.FormatNumber(comm1.DiscountB, numDecimals: 2, showZero: true)</td>
            <td>@RazorHelper.FormatNumber(comm1.DiscountC, numDecimals: 2, showZero: true)</td>
            <td>@RazorHelper.FormatNumber(comm1.DiscountD, numDecimals: 2, showZero: true)</td>
            <td>@RazorHelper.FormatNumber(comm3.DiscountA, numDecimals: 2, showZero: true)</td>
            <td>@RazorHelper.FormatNumber(comm2.DiscountA, numDecimals: 2, showZero: true)</td>
        </tr>
    }
    </tbody>
</table>