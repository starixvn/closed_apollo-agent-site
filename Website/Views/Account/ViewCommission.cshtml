@{
    ViewBag.Title = "View Commission";
    Layout = "~/Views/Account/Shared/_ViewSettingLayout.cshtml";
    int index = 1;
}
@model IEnumerable<CustomerCommissionModel>

<table class="tbl-cust-setting">
    <thead>
        <tr>
            <th></th>
            <th>Group A</th>
            <th>Group B</th>
            <th>Group C</th>
            <th>Group D</th>
            <th>1x2</th>
            <th>Other</th>
        </tr>
    </thead>
    <tbody>
    @foreach(var comm in Model)
    {
        string rowClass = index++ % 2 == 0 ? "class='alt'" : string.Empty;
        
        <tr @Html.Raw(rowClass)>
            <td>@comm.Username</td>
            <td>@RazorHelper.FormatNumber(comm.DiscountA, numDecimals: 2, showZero: true)</td>
            <td>@RazorHelper.FormatNumber(comm.DiscountB, numDecimals: 2, showZero: true)</td>
            <td>@RazorHelper.FormatNumber(comm.DiscountC, numDecimals: 2, showZero: true)</td>
            <td>@RazorHelper.FormatNumber(comm.DiscountD, numDecimals: 2, showZero: true)</td>
            <td>@RazorHelper.FormatNumber(comm.Discount1x2, numDecimals: 2, showZero: true)</td>
            <td>@RazorHelper.FormatNumber(comm.DiscountOthers, numDecimals: 2, showZero: true)</td>
        </tr>
    }
    </tbody>
</table>