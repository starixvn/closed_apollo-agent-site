@using Apollo.Age.Entities;
@{
    ViewBag.Title = "Agent List";
    ViewBag.HeaderTitle = Resources.Lang.lblAgentListOf;
    Layout = "~/Views/Account/Shared/_LayoutAccountList.cshtml";
}
@model List<Agent>
@section css
{
    <link href="~/_GlobalResources/Js/Fanex.Grid/Fanex.Grid.less" rel="stylesheet" type="text/css" />
    <link href="~/_GlobalResources/Js/Fanex.Grid/Fanex.Pagination.less" rel="stylesheet"
        type="text/css" />
}
@RazorHelper.Navigation(Model)
<div class="table-header">
    <ul class="sub-nav">
        <li class="active">@Resources.Lang.lblAgentList</li>
        <li><span class="line"></span><a href="#" id="quickLinkCustomerList">@Resources.Lang.lblPlayerList</a></li>
    </ul>
</div>
<div id="gridId" class="freegrid  content-grid" agentid='@ViewBag.CurrentAgentId'>
</div>
@section scripts
{
    <script language="javascript" type="text/javascript">
        var LANGUAGES = function ($) {
            return {
                Username: "@Resources.Lang.usernameEdited",
                Status: "@Resources.Lang.status",
                Edit: "@Resources.Lang.edit",
                NumberOfAgent: "@Resources.Lang.lblAgent",
                NumberOfMember: "@Resources.Lang.lblMember",
                GroupA: "@Resources.Lang.lblGroupa",
                GroupB: "@Resources.Lang.lblGroupb",
                GroupC: "@Resources.Lang.lblGroupc",
                GroupD: "@Resources.Lang.lblGroupd",
                Commission: "@Resources.Lang.commission",
                SoccerShare: "@Resources.Lang.lblSoccerPT",
                OneXTwo: "@Resources.Lang.lbl1x2",
                Other: "@Resources.Lang.other",
                Handicap: "@Resources.Lang.hdp",
                OverUnder: "@Resources.Lang.lblOU",
                HandicapLive: "@Resources.Lang.hdpLive",
                OverUnderLive: "@Resources.Lang.ovLive",
                NumberGame: "@Resources.Lang.numbergame",

            };
        } (jQuery);
    </script>
    <script src="~/_GlobalResources/Js/Fanex.Grid/moment.min.js" type="text/javascript"></script>
    <script src="~/_GlobalResources/Js/Fanex.Grid/numeral.js" type="text/javascript"></script>
    <script src="~/_GlobalResources/Js/Fanex.Grid/Fanex.Grid.js" type="text/javascript"></script>
    <script src="~/_GlobalResources/Js/Fanex.Grid/Fanex.Pagination.js" type="text/javascript"></script>
    <script src="~/Views/Account/Resources/AgentList.js" type="text/javascript"></script>
}