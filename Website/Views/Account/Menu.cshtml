@model ICurrentSession
@{
    Layout = "~/Views/Account/Shared/_Layout.cshtml";
    var menu = ViewBag.RootNode; 
}
<ul id="tab-menu">
    <li class="tab-menu active"><a><i class="icon-align-justify"></i>Menu</a> </li>
    <li class="tab-tree"><a href="@Url.Action("TreeViewList")" target="menu"><i class="icon-user">
    </i>Account</a> </li>
    <li class="tab-acc"><a href="@Url.Action("AccountInfo")" target="menu"><i class="icon-search">
    </i>Search</a> </li>
</ul>
<ul id="menu">
    @foreach (SiteMapNode item in menu.ChildNodes)
    {
        if (!Model.IsSuper || (Model.IsSuper && item.Title != "totalbets"))
        {
            string activeClass = Convert.ToBoolean(item["active"]) ? "active" : string.Empty;
        
        <li class="menu-item @activeClass">
            <a class="menu-item-title">@this.GlobalLangResources(item.Title)</a>
            @if (item.HasChildNodes)
            {               
                <div class="submenu">
                    @foreach (SiteMapNode subItem in item.ChildNodes)
                    {
                        int bettypeId = 0;
                        string title = string.Empty;

                        // show memberlist when user's level >= 3
                        var level = Convert.ToInt32(item["Level"]);
                        if (level == 0 || Model.AgentLevel >= level)
                        {
                            if (subItem.Title.Contains("bettype")
                                && Int32.TryParse(subItem.Title.Substring(7), out bettypeId)) // get from RemotingRef
                            {
                                title = CacheRef.GetBettype(bettypeId);
                            }
                            else
                            {
                                title = this.GlobalLangResources(subItem.Title);
                            }
                        }        
                        <a href="@subItem.Url" target="main">@title</a>
                    }
                </div>
                
            }
        </li>
        }
    }
</ul>
@section foot {
    <script src="~/Views/Account/Resources/Menu.js" type="text/javascript"></script>
}
