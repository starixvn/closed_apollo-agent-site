@using Apollo.Age.Account.ViewModels
@using Fanex.Age.Utility

@{
    ViewBag.Title = "Member Share";
    Layout = "~/Views/Account/Shared/_ViewSettingLayout.cshtml";
    int index = 1;
}

@model MemberShareViewModel

<div id="box_header">
    <div class="row">
        <div class="cell">
            <div class="editor">
                @if (Model.SportList.Any())
                {
                        @Html.LabelFor(m => m.SportType, @Resources.Lang.SportType)
                        @Html.DropDownListFor(m => m.SportType, Model.SportSelectListItem, new { id = "ddlSportType" })
                }
    
                @if (Model.BetTypeList.Any())
                {
                        @Html.LabelFor(m => m.BetType, @Resources.Lang.bettype)
                        @Html.DropDownListFor(m => m.BetType, Model.BetTypeSelectListItem, new { id = "ddlBetType" })
                }
                
                @Html.DropDownListFor(m => m.IsMember, new List<SelectListItem> {
                    new SelectListItem { Value = "0", Text = Resources.Lang.lblAgent },
                    new SelectListItem { Value = "1", Text = Resources.Lang.lblMember }
                }, new { id = "ddlIsMember" })
                @Html.TextBoxFor(m => m.Username, new { id = "txtUsername" })
    
                <input id="btnSubmit" class="btn" type="button" value="@Resources.Lang.submit" />
            </div>
        </div>
    </div>
</div>

<table class="tbl-cust-setting no-border-bottom">
    <thead>
        <tr>
            <th>
            </th>
            <th>
                @Resources.Lang.TakenShareText
            </th>
            <th>
                @Resources.Lang.MaxGivenShare
            </th>
            <th>
                @Resources.Lang.MinGivenShare
            </th>
            <th>
                @Resources.Lang.ShareTakenOnMember
            </th>
        </tr>
    </thead>
    <tbody>
        @if (Model.MemberShareModelList != null && Model.MemberShareModelList.Any())
        {
            foreach (var item in Model.MemberShareModelList)
            {
                string rowClass = index++ % 2 != 0 ? "class='alt'" : string.Empty;
                
                <tr @Html.Raw(rowClass)>
                    <td class="em-row l">
                        @item.Username
                    </td>
                    <td class="r">
                        @Formater.DecFormat(item.TakenShare / 100, decDigits: 2)
                    </td>
                    <td class="r">
                        @Formater.DecFormat(item.MaxGiven / 100, decDigits: 2)
                    </td>
                    <td class="r">
                        @Formater.DecFormat(item.MinGiven / 100, decDigits: 2)
                    </td>
                    <td class="r">
                        @Formater.DecFormat(item.TakenShareMember / 100, decDigits: 2)
                    </td>
                </tr>
            }
        }
        else
        {
             @RazorHelper.ShowNoInfo(5) 
        }
    </tbody>
</table>