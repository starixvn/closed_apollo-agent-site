@{
    Layout = "~/Views/Account/Shared/_LayoutLogLogin.cshtml";
}
@model IEnumerable<AgentLogLoginModel>

@foreach (var item in Model)
{    
    <div class="list-item">
        <div class="log-item">
            <div class="item-name">Access Time:</div>
            <div class="item-value">@item.LogDate</div>
        </div>
        <div class="log-item">
            <div class="item-name">Ip:</div>
            <div class="item-value"><a href="http://legacytools.dnsstuff.com/tools/ipall.ch?tool_id=67&token=&toolhandler_redirect=0&ip=' + @item.Ip + '&j=1">@item.Ip</a></div>
        </div>
        <div class="log-item">
            <div class="item-name">Domain:</div>
            <div class="item-value">@item.DomainName</div>
        </div>
        <div class="log-item">
            <div class="item-name">Browser:</div>
            <div class="item-value">@item.BrowserName</div>
        </div>
        <div class="log-item">
            <div class="item-name">Platform:</div>
            <div class="item-value">@item.Platform</div>
        </div>
        <div class="log-item">
            <div class="item-name">Action:</div>
            <div class="item-value">@item.Doing</div>
        </div>  
    </div>    
}
