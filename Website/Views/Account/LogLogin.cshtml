@{
    Layout = "~/Views/Account/Shared/_LayoutLogLogin.cshtml";
}
@model IEnumerable<AgentLogLoginModel>

@foreach (var item in Model)
{    
    <div style="width:100%; text-align:left">
    <span>Access Time: </span><span>@item.LogDate</span><br />
    <span>Ip: </span><span> <a href="http://legacytools.dnsstuff.com/tools/ipall.ch?tool_id=67&token=&toolhandler_redirect=0&ip=' + @item.Ip + '&j=1">@item.Ip</a></span><br />
    <span>Domain: </span><span>@item.DomainName</span><br />
    <span>Browser: </span><span>@item.BrowserName</span><br />
    <span>Platform: </span><span>@item.Platform</span><br />
    <span>Action: </span><span>@item.Doing</span><br />    
    </div>
    <div style="height:1px; width:70%; background-color:#000;"></div>
    
}