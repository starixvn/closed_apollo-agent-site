<!DOCTYPE html>
<html lang="en-us">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <title>@ViewBag.Title</title>
    <link href="~/Views/Account/Resources/ViewSetting.less" rel="stylesheet" type="text/css" />

    @RenderSection("css", required: false)
</head>
<body>
    @RazorHelper.Piwik()
    <div id="page_main">
        <div id="header_main">
            @ViewBag.Title
        </div>
        <div id="content_main">
            @RenderBody()
        </div>
    </div>
    @Html.Hidden("ApoRoot", Url.Content("~/"))
    <script src="~/_GlobalResources/Js/jquery.js" type="text/javascript"></script>
    <script src="~/_GlobalResources/Js/Core.js" type="text/javascript"></script>
    @RenderSection("scripts", required: false)
</body>
</html>