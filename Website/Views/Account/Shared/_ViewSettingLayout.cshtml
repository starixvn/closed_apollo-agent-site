<!DOCTYPE html>
<html lang="en-us">
<head>
	<meta charset="utf-8" />
	<meta name="viewport" content="width=device-width" />
	<title>@ViewBag.Title</title>
	<link href="~/_GlobalResources/Css/jquery-ui-1.10.2/apollo/jquery-ui.min.css" rel="stylesheet" type="text/css" />
	<link href="~/Views/Account/Resources/ViewSetting.less" rel="stylesheet" type="text/css" />
	@RenderSection("css", required: false)
</head>
<body>
	
	<div id="page_main">
		<div id="header_main">
			@ViewBag.Title
		</div>
		<div id="content_main">
			@RenderBody()
		</div>
	</div>
	@Html.Hidden("ApoRoot", Url.Content("~/"))
	@Scripts.Render("~/scripts/viewsettingjs")
	@RenderSection("scripts", required: false)
</body>
</html>