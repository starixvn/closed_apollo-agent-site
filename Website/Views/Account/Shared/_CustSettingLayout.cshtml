<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <title>@ViewBag.Title - Total Bets</title>
    <link href="~/Views/Account/Resources/CustSettingEngine/Core.less?ver=1" rel="stylesheet"
        type="text/css" />
    <link href="~/Views/Account/Resources/CustSettingEngine/CoreOverride.less" rel="stylesheet"
        type="text/css" />
    @RenderSection("css", required: false)
</head>
<body>
    @RazorHelper.Piwik()
    <div id="page_main">
        <div id="header_main">
            @ViewBag.Title
        </div>
        <div id="content_main">
            <div class="setting-mode">
                <span id="simple-mode" class="deactive-mode">Simple Mode</span> | <span class="active-mode" id="advanced-mode"> Advance Mode</span>
            </div>
            <div id="settingContainer">
                @RenderBody()
            </div>
            <div class="btnLeft">
                <button id="btnSubmitFooter" class="btn" style="display:none;">
                    @Resources.Lang.update</button>
            </div>
        </div>
    </div>
    @Html.Hidden("ApoRoot", Url.Content("~/"))
    <script src="~/_GlobalResources/Js/jquery.js" type="text/javascript"></script>
    <script src="~/_GlobalResources/Js/Core.js" type="text/javascript"></script>
    <script src="~/_GlobalResources/Js/noty/jquery.noty.min.js" type="text/javascript"></script>
    <script src="~/_GlobalResources/Js/BlockUI/jquery.blockUI.js" type="text/javascript"></script>
    <script src="~/Views/Account/Resources/CustSettingEngine/Core.js" type="text/javascript"></script>
    <script src="~/Views/Account/Resources/CustSettingEngine/PTSetting.js" type="text/javascript"></script>
    <script src="~/Views/Account/Resources/CustSettingEngine/BettingLimit.js" type="text/javascript"></script>
    <script src="~/Views/Account/Resources/CustSettingEngine/BetType.js" type="text/javascript"></script>
    <script src="~/Views/Account/Resources/CustSettingEngine/BetTypeGroup.js" type="text/javascript"></script>
    <script src="~/Views/Account/Resources/CustSettingEngine/CommissionSetting.js" type="text/javascript"></script>
    <script src="~/CustomerSetting/LanguageObject" type="text/javascript"></script>
    @RenderSection("scripts", required: false)
</body>
</html>
