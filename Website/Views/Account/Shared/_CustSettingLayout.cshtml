<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <title>@ViewBag.Title - Total Bets</title>
    <link href="~/Views/Account/Resources/CustSettingEngine/Core.css" rel="stylesheet" type="text/css" />
    <link href="~/_Components/ErrorMsg/ErrorMsg.less" rel="stylesheet" type="text/css" />
    @RenderSection("css", required: false)
</head>
<body>
    <table border="0" cellpadding="0" cellspacing="0" width="100%" id="diverrmsg" style="display: none;">
        <tr>
            <td id="msg_1_1" class="emsg_1_1">&nbsp;</td>
            <td id="msg_1_2" class="emsg_1_2">&nbsp;</td>
            <td id="msg_1_3" class="emsg_1_3">&nbsp;</td>
        </tr>
        <tr>
            <td id="msg_2_1" valign="top" class="emsg_2_1">&nbsp;</td>
            <td valign="top" id="spmsgerr" class="msgerr"></td>
            <td id="msg_2_2" class="emsg_2_2">&nbsp;</td>
        </tr>
        <tr>
            <td id="msg_3_1" class="emsg_3_1">&nbsp;</td>
            <td id="msg_3_2" class="emsg_3_2">&nbsp;</td>
            <td id="msg_3_3" class="emsg_3_3">&nbsp;</td>
        </tr>
    </table>
    <div id="settingContainer">
       @RenderBody()
    </div>
    <div class="btnLeft">
        <button id="btnSubmitFooter" class="btnMain">
            @Resources.Lang.update</button>
    </div>
    

    @Html.Hidden("ApoRoot", Url.Content("~/"))

    <script src="~/_GlobalResources/Js/jquery.js" type="text/javascript"></script>
    <script src="~/_GlobalResources/Js/Core.js" type="text/javascript"></script>
    <script src="~/_Components/ErrorMsg/ErrorMsg.js" type="text/javascript"></script>
    <script src="~/Views/Account/Resources/CustSettingEngine/Core.js" type="text/javascript"></script>
    <script src="~/Views/Account/Resources/CustSettingEngine/PTSetting.js" type="text/javascript"></script>
    <script src="~/Views/Account/Resources/CustSettingEngine/BettingLimit.js" type="text/javascript"></script>
    <script src="~/Views/Account/Resources/CustSettingEngine/BetType.js" type="text/javascript"></script>
    <script src="~/Views/Account/Resources/CustSettingEngine/BetTypeGroup.js" type="text/javascript"></script>
    <script src="~/Views/Account/Resources/CustSettingEngine/CommissionSetting.js" type="text/javascript"></script>
    @RenderSection("scripts", required: false)
</body>
</html>