<head>
    <title>@Page.Title</title>
    <link href="~/Views/Account/Resources/treeview.css" rel="stylesheet" type="text/css" />
    <link href="~/Views/Account/Resources/Account.less" rel="Stylesheet" type="text/css" />
    @RenderSection("css", required: false)
</head>
<!-- Piwik -->
<script type="text/javascript">
    var pkBaseURL = ( ( "https:" == document.location.protocol ) ? "https://10.18.200.204:7777/" : "http://10.18.200.204:7777/" );
    document.write( unescape( "%3Cscript src='" + pkBaseURL + "piwik.js' type='text/javascript'%3E%3C/script%3E" ) );
</script>
<script type="text/javascript">
    try {
        var piwikTracker = Piwik.getTracker( pkBaseURL + "piwik.php", 5 );
        piwikTracker.trackPageView();
        piwikTracker.enableLinkTracking();
    } catch ( err ) { }
</script>
<noscript>
    <p>
        <img src="http://10.18.200.204:7777/piwik.php?idsite=5" style="border: 0" alt="" /></p>
</noscript>
<!-- End Piwik Tracking Code -->
<body class="downlineTreview-bg">
    @RenderBody()
    @Html.Hidden("ApoRoot", Url.Content("~/"))
    <script src="~/_GlobalResources/Js/jquery.js" type="text/javascript"></script>
    <script src="~/_GlobalResources/Js/jquery.cookie.js" type="text/javascript"></script>
    <script src="~/Views/Account/Resources/jquery.treeview.js" type="text/javascript"></script>
    <script src="~/Views/Account/Resources/jquery.treeview.async.js" type="text/javascript"></script>
    @RenderSection("foot", required: false)
</body>
</html>