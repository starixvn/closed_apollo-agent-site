<!DOCTYPE html>
<html lang="en-us">
<head>
    <title>@ViewBag.Title</title>
    <link href="~/_GlobalResources/Css/jquery-ui-1.10.2/apollo/jquery-ui.min.css" rel="stylesheet"
        type="text/css" />
    @RenderSection("css", required: false)
</head>
<body>
    <div id="box_header">
        <div>
            @Resources.Lang.username</div>
        <div>
            <input type="text" autocomplete="off" id="txtUserName" name="txtUserName" class="text_italic"
                style="width: 145px;" /></div>
        <div>
            <input type="button" value="Submit" id="Search"></div>
    </div>
    @RenderBody()
    <div id="menuedit" style="display: none; border: 1px solid #000; background-color: Gray">
        <div>
            <a href="#" id="commission">@Resources.Lang.commission</a></div>
        <div>
            <a href="#" id="betsetting">@Resources.Lang.lblBetSetting</a></div>
    </div>
    <script src="~/_GlobalResources/Js/jquery.js" type="text/javascript"></script>
    <script src="~/_GlobalResources/Js/Core.js" type="text/javascript"></script>
    @RenderSection("scripts", required: false)
</body>
</html>