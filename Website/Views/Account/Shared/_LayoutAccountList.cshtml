<!DOCTYPE html>
<html lang="en-us">
<head>
    <title>@ViewBag.Title</title>
    <link href="~/_GlobalResources/Css/jquery-ui-1.10.2/apollo/jquery-ui.min.css" rel="stylesheet"
        type="text/css" />
    <link href="~/Views/Account/Resources/CustomerList.less" rel="stylesheet" type="text/css" />
    @RenderSection("css", required: false)
</head>
<body>
    <div id="page_main">
        <div id="header_main">
            <div class="header-title">@ViewBag.HeaderTitle <span id="currUsername"></span>
            </div>
            <div class="edit-setting">
            </div>
        </div>
        <div id="content_main">
            <div id="box_header">
                <div class="boxHeader-element">
                    <label>@Resources.Lang.username</label>
                    <input type="text" autocomplete="off" id="txtUserName" value="@Resources.Lang.enterusername" name="txtUserName" class="text_italic"/>
                    <input type="button" value="Submit" id="Search" class="btn">
                </div>
            </div>
            @RenderBody()
            <ul id="menuedit" class="edit-menu">
                <li><a href="#" id="commission">@Resources.Lang.commission</a></li>
                <li><a href="#" id="betsetting">@Resources.Lang.lblBetSetting</a></li>
            </ul>
        </div>
    </div>
    @Html.Hidden("ApoRoot", Url.Content("~/"))
    <script language="javascript" type="text/javascript">
        var BASELANGUAGES = function () {
            return {
                EnterUsername: "@Resources.Lang.enterusername"

            };
        } ();
    </script>
    <script src="~/_GlobalResources/Js/jquery.js" type="text/javascript"></script>
    <script src="~/_GlobalResources/Js/Core.js" type="text/javascript"></script>
    <script src="~/_GlobalResources/Js/BlockUI/jquery.blockUI.js" type="text/javascript"></script>
    <script src="~/Views/Account/Resources/AccountList.js" type="text/javascript"></script>
    @RenderSection("scripts", required: false)
</body>
</html>