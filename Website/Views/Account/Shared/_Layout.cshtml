<!DOCTYPE html>
<html lang="en-us">
    <head>
        <title>@ViewBag.Title</title>
        <link href="~/Views/Account/Resources/Account.less" rel="stylesheet" type="text/css" />

        @RenderSection("head", required: false)
    </head>
    <body>
        <ul id="tab-menu">
            <li class="active">
                <a><i class="icon-align-justify"></i>Menu</a>
            </li>
            <li>
                <a href="@Url.Action("AccountInfo")" target="menu">
                    <i class="icon-user"></i>Account</a>
            </li>
            <li>
                <a href="@Url.Action("AgentTreeList")" target="menu">
                    <i class="icon-align-left"></i>Members</a>
            </li>
        </ul>
        @RenderBody()

    <script src="~/_GlobalResources/Js/jquery.js" type="text/javascript"></script>
    <script src="~/_GlobalResources/Js/Core.js" type="text/javascript"></script>
    <script src="~/Views/Account/Resources/AutoComplete.js" type="text/javascript"></script>
    <script src="~/Views/Account/Resources/Menu.js" type="text/javascript"></script>
    <script src="~/Views/Account/Resources/Account.js" type="text/javascript"></script>

    @RenderSection("foot", required: false)
    @RenderSection("scripts", required: false)
    </body>
</html>