<!DOCTYPE html>
<html lang="en-us">
    <head>
        <title>@ViewBag.Title</title>
        <link href="~/Views/Account/Resources/Account.less" rel="stylesheet" type="text/css" />

        @RenderSection("head", required: false)
    </head>
    <body>
        <ul id="tab-menu">
            <li class="tab-menu active" tid="1">
                <a href="@Url.Action("Menu")" target="menu">
                    <i class="icon-align-justify"></i>Menu</a>
            </li>
            <li class="tab-acc" tid="2">
                <a href="@Url.Action("AccountInfo")" target="menu">
                    <i class="icon-user"></i>Account</a>
            </li>
            <li class="tab-mem" tid="3">
                <a href="@Url.Action("AgentTreeList")" target="menu">
                    <i class="icon-align-left"></i>Members</a>
            </li>
        </ul>
        @RenderBody()

    <script src="~/_GlobalResources/Js/jquery.js" type="text/javascript"></script>
    <script src="~/_GlobalResources/Js/jquery.cookie.js" type="text/javascript"></script>
    <script src="~/_GlobalResources/Js/Core.js" type="text/javascript"></script>    

    <script type="text/javascript">

        $(document).ready(function () {
            var tabMenu = $('#tab-menu'),
                tid = $.cookie('age-active-tab');

            // activate selected tab
            if (tid) {
                tabMenu.children('li').each(function () {
                    var tab = $(this);

                    if (tab.attr('tid') == tid) {
                        tab.addClass('active').siblings('li').removeClass('active');
                    }
                });
            }

            // save selected tab using cookie
            tabMenu.on('click', 'li', function () {
                var tab = $(this);

                if (tab.hasClass('active')) return false;

                $.cookie('age-active-tab', tab.attr('tid'), { path: '/' });
            })
        });

    </script>

    @RenderSection("foot", required: false)
    @RenderSection("scripts", required: false)
    </body>
</html>