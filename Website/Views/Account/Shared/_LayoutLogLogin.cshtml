<!DOCTYPE html>
<html lang="en-us">
<head>
    <title>@ViewBag.Title</title>
    <script src="~/_GlobalResources/Js/head.min.js" type="text/javascript"></script>
    <link href="~/Views/Account/Resources/LogLogin.less" rel="stylesheet" type="text/css" />
    @RenderSection("head", required: false)
</head>
<body>
    <div id="page_main">
        <div id="header_main">
            Login Log
        </div>
        <div id="content_main">
             @RenderBody()
        </div>
    </div>   
    @Html.Hidden("ApoRoot", Url.Content("~/"))
    <script src="~/_GlobalResources/Js/jquery.js" type="text/javascript"></script>
    <script src="~/_GlobalResources/Js/jquery.cookie.js" type="text/javascript"></script>
    <script src="~/_GlobalResources/Js/Core.js" type="text/javascript"></script>
    @RenderSection("foot", required: false)
</body>
</html>