@model ICurrentSession
@{
	Layout = null;
}
<!DOCTYPE html>
<html>
<head>
	<title>Header</title>
	<link href="~/_GlobalResources/Css/Agent.less" rel="stylesheet" type="text/css" />
	<link href="~/Views/Account/Resources/Header.less" rel="stylesheet" type="text/css" />
</head>
<body>
	@if (Model != null)
	{
		<div id="news_main">
			@if (Model.IsInternalSignIn)
			{
			<div class="login-bg clearfix">
				<div class="login-info">
					<span class="username">@Model.Username<span> (@Model.AgentName)</span></span>
					<a href="#" onclick="APOLLO.signOut()">@Apollo.Age.Resources.Lang.SignOut</a>
				</div>
			</div>
			}
			<div id="text_news_out">
				<div id="text_news" onclick="Change2Menu('Message/NewMessage?PageQuery=normal', this)">
					<div id="scroller" class="news-scroller">
						<a id="topnews" href="javascript:;"></a>
					</div>
				</div>
				<span id="button_top" class="icon-envelope" onclick="Change2Menu('Message/NewMessage?PageQuery=private', this)">
					<a id="privateMsgLnk">&nbsp;&nbsp;(0)</a> </span><a class="home-page" href="~/Message/Portal"
						target="main"><span class="icon-home icon-white"></span></a>
			</div>
		</div>

		<input type="hidden" id="ApoRoot" value="@Url.Content("~/")" />
		<input type="hidden" id="ctime" value="@DateTime.Now.AddHours(12).ToString("H-m-s-tt")" />
		<input type="hidden" id="cdate" value="@DateTime.Now.AddHours(12).ToString("MMM dd,yyyy 'GMT'+8")" />
		<input type="hidden" id="userid" value="@Model.UserId" />
     	<input type="hidden" id="adminid" value="@Model.AdminId" />
     	<input type="hidden" id="agentid" value="@Model.AgentId" />
     

		<script src="~/_GlobalResources/Js/jquery.js" type="text/javascript"></script>
        <script src="~/_GlobalResources/Js/jquery.signalR-1.1.0.min.js" type="text/javascript"></script>
        <script src="~/signalr/hubs" type="text/javascript"></script>
		<script src="~/_GlobalResources/Js/Core.js" type="text/javascript"></script>
     
		<script src="~/Views/Account/Resources/header.js" type="text/javascript"></script>
         <script type="text/javascript">
             var LANGUAGES = {
                AlerSignonMessage : "@Apollo.Age.Resources.Lang.stringSessionLogged"
             };
         </script>
    }
</body>
</html>