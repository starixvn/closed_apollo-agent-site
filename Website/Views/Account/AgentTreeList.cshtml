@{
    Layout = "~/Views/Account/Shared/_LayoutTreeView.cshtml";
}
<ul id="treeview_list" class="tree-tab" agent-id="@ViewBag.AgentId">   
</ul>

@section foot {
    <script type="text/javascript">
        $(document).ready(function () {
            var treeList = $("#treeview_list"),
                agentId = treeList.attr("agent-id"),
                appRoot = "@Url.Content("~/")";

            treeList.treeview({
                url: appRoot + "Account/GetDataByNode",
                link: "<a href='" + appRoot + "Account/AgentInfo?agentid={0}&username={1}' target='menu'> {2} </a>",
                agentId: agentId
            });
        });
    </script>
}