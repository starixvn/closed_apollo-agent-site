@{
    Layout = "~/Views/Account/Shared/_LayoutTreeView.cshtml";
}
<ul id="treeview_list" class="tree-tab" agent-id="@ViewBag.AgentId">   
</ul>

@section foot {
    <script type="text/javascript">
        $(document).ready(function () {
            var treeList = $("#treeview_list"),
                custId = treeList.attr("agent-id"),
                appRoot = "@Url.Content("~/")";

            treeList.treeview({
                url: appRoot + "Account/GetDataByNote",
                link: "<a href='" + appRoot + "Account/AccountInfo?IsMember=0&custid={0}&txtUsername={1}' target='menu'> {2} </a>",
                custid: custId
            });
        });
    </script>
}