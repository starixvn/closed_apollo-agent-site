@{
    Layout = "~/Views/Account/Shared/_LayoutTreeView.cshtml";
}
<ul id="treeview_list" class="tree-tab" agent-id="@ViewBag.AgentId">   
</ul>

@section foot {
    <script type="text/javascript">
        $(document).ready(function () {
            $("#treeview_list").treeview({
                url: "../GetDataByNote",
                link: "<a href='../AccountInfo?IsMember=0&custid={0}&txtUsername={1}' target='menu'> {2} </a>",
                custid: $("#treeview_list").attr("agent-id")
            });
        });
    </script>
}