@{
    ViewBag.Title = Resources.Lang.lblEditSetting + ViewBag.UserName;
    Layout = "~/Views/Account/Shared/_CustSettingLayout.cshtml";
    var agentId = ViewBag.AgentId ?? 0;
}
<div id="commissionSettingContainer">
</div>
<div id="bettingLimitContainer">
</div>
<div id="ptContainer">
</div>
@section scripts
{
    <script type="text/javascript">
        var agentId = @(agentId);
    </script>
    <script src="~/CustomerSetting/GetAgentSetting?agentId=@(agentId)&agentLevel=@(ViewBag.AgentLevel)" type="text/javascript"></script>
    <script src="~/Views/Account/Resources/EditSetting.js" type="text/javascript"></script>
}
