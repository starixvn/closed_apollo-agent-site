@{
	Layout = "~/Views/Account/Shared/_Layout.cshtml";
}

@section head {
	<link href="~/Views/Account/Resources/treeview.css" rel="stylesheet" type="text/css" />
}

<ul id="tab-menu">
	<li class="tab-menu">
		<a href="@Url.Action("Menu")" target="menu">
			<i class="icon-align-justify"></i>Menu</a>
	</li>
	<li class="tab-tree active">
		<a>
			<i class="icon-user"></i>Account</a>
	</li>
	<li class="tab-acc">
		<a href="@Url.Action("AccountInfo")" target="menu"><i class="icon-search"></i>Search</a>
	</li>
</ul>

<div id="wrapper">
	<ul id="agent-list" class="tree-sub" agent-id="@ViewBag.AgentId"></ul>
</div>

@section foot {
	<script type="text/javascript">
		head.js(
			"@Url.Content("~/Views/Account/Resources/jquery.treeview.js")",
			"@Url.Content("~/Views/Account/Resources/jquery.treeview.async.js")",
			function() {
				window.onload = function() {
					var agentList = $("#agent-list"),
						agentId = agentList.attr("agent-id"),
						appRoot = "@Url.Content("~/")";

					agentList.treeview({
						url: appRoot + "Account/GetDataByNode",
						link: "<a href='" + appRoot + "Account/AgentList?AgentId={0}' target='main'>{1}</a>",
						agentId: agentId
					});
				};
			}
		);
	</script>
}