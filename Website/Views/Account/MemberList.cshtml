@using Apollo.Age.Entities;
@{
    ViewBag.Title = Resources.Lang.lblPlayerList;
    ViewBag.HeaderTitle = Resources.Lang.lblMemberListOf;
    var titleFormat = ViewBag.IsMaster == true ? Resources.Lang.lblEditMemberSetting : Resources.Lang.lblViewMemberSetting;
    titleFormat = string.Format(titleFormat, string.Empty);
    var agenttitleFormat = ViewBag.IsMaster == true ? Resources.Lang.lblEditAgentSetting : Resources.Lang.lblViewAgentSetting;
    agenttitleFormat = string.Format(agenttitleFormat, string.Empty);
    Layout = "~/Views/Account/Shared/_LayoutAccountList.cshtml";
}
@model List<Agent>
@section css
{
    <link href="~/_GlobalResources/Js/Fanex.Grid/Fanex.Grid.less" rel="stylesheet" type="text/css" />
    <link href="~/_GlobalResources/Js/Fanex.Grid/Fanex.Pagination.less" rel="stylesheet"
        type="text/css" />
}
@RazorHelper.Navigation(Model)
<div class="tab-header">
    <ul>
        <li><a href="#" id="quickLinkAgentList">@Resources.Lang.lblAgentList</a></li>
        <li id="current"><a href="#">@Resources.Lang.lblPlayerList</a></li>
    </ul>
</div>
<div id="gridId" class="freegrid  content-grid" agentid="@Model.Last().Id" username="@Model.Last().Username" agentlevel="@Model.Last().Level">
</div>
@section scripts
{
    <script language="javascript" type="text/javascript">
        var DEFAULTS = function () {
            return {
                IsMaster: "@ViewBag.IsMaster"
            };
        } ();
        var LANGUAGES = function ($) {
            return {
                Username: "@Resources.Lang.usernameEdited",
                Status: "@Resources.Lang.status",
                BetStatus: "@Resources.Lang.betstatus",
                Edit: "@Resources.Lang.edit",
                Group: "@Resources.Lang.group",
                AgentCommission: "@Resources.Lang.AgentCommission",
                MemberCommission: "@Resources.Lang.memberCommission",
                SoccerShare: "@Resources.Lang.lblSoccerPT",
                OneXTwo: "@Resources.Lang.lbl1x2",
                Other: "@Resources.Lang.other",
                Stopped: "@Resources.Lang.stopped",
                Locked: "@Resources.Lang.locked",
                Active: "@Resources.Lang.lblActive",
                SoccerDeadballHDPTakenShare: "@Resources.Lang.soccerdeadballhdptakenshare",
                EditSetting: "@Resources.Lang.lblEditSetting",
                ViewSetting: "@Resources.Lang.lblViewSetting",
                PopUpTitle: "@titleFormat",
                PopUpAgentTitle: "@agenttitleFormat"
            };
        } (jQuery);
    </script>
    <script src="~/_GlobalResources/Js/Fanex.Grid/moment.min.js" type="text/javascript"></script>
    <script src="~/_GlobalResources/Js/Fanex.Grid/numeral.js" type="text/javascript"></script>
    <script src="~/_GlobalResources/Js/Fanex.Grid/Fanex.Grid.js" type="text/javascript"></script>
    <script src="~/_GlobalResources/Js/Fanex.Grid/Fanex.Pagination.js" type="text/javascript"></script>
    <script src="~/Views/Account/Resources/MemberList.js" type="text/javascript"></script>
}