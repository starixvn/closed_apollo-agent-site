@{
    Layout = "~/Views/Account/Shared/_Layout.cshtml";
}
@section head {
    <link href="~/Views/Account/Resources/treeview.css" rel="stylesheet" type="text/css" />
}
<ul id="tab-menu">
    <li class="tab-menu"><a id="lk-menu-tab" href="javascript:;" target="menu"><i class="icon-align-justify">
    </i>@Apollo.Age.Resources.Lang.mainmenu</a> </li>
    <li class="tab-tree active"><a><i class="icon-user"></i>@Apollo.Age.Resources.Lang.userinfo</a>
    </li>
    <li class="tab-acc"><a id="lk-acc-tab" href="javascript:;" target="menu"><i class="icon-search">
    </i>@Apollo.Age.Resources.Lang.search</a> </li>
</ul>
@if ((bool)(ViewBag.HasAgentDownline))
{
    <div id="wrapper">
        <ul id="agent-list" class="tree-sub" agent-id="@ViewBag.AgentId">
        </ul>
    </div>

    @section foot {
        <script src="~/Views/Account/Resources/Menu.js" type="text/javascript"></script>
        <script type="text/javascript" src="~/Views/Account/Resources/jquery.treeview.js"></script>
        <script type="text/javascript" src="~/Views/Account/Resources/jquery.treeview.async.js"></script>
        <script type="text/javascript">
            $(document).ready(function () {
                var agentList = $("#agent-list"),
                    agentId = agentList.attr("agent-id"),
                    appRoot = "@Url.Content("~/")";

                agentList.treeview({
                    url: appRoot + "Account/GetDataByNode",
                    link: "<a href='" + appRoot + "Account/AgentList?agentid={0}' target='main'>{1}</a>",
                    agentId: agentId
                });
            })
        </script>
    }
}
else
{
    <div class="no-data">@Apollo.Age.Resources.Lang.noInfo</div>
    @section foot {
        <script src="~/Views/Account/Resources/Menu.js" type="text/javascript"></script>
    }
}
