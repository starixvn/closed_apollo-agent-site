@{
    Layout = "~/Views/Account/Shared/_Layout.cshtml";
}
<ul id="treeview_list" class="tree-sub">   
</ul>
<input id="agentId" type="hidden" value="@ViewBag.AgentId"/>

@section foot {
    <script type="text/javascript" src="~/Views/Account/Resources/jquery.treeview.js"></script>
    <script type="text/javascript" src="~/Views/Account/Resources/jquery.treeview.async.js"></script>
    <script type="text/javascript">
        $(document).ready(function () {
            $("#treeview_list").treeview({
                url: "TreeNodeData",
                link: "<a href='../_MemberInfo/CustomerList/AgentList.aspx?custid={0}&us={1}' target='main'> {2} </a>",
                custid: $("#agentId").val()
            });
        });
    </script>
}