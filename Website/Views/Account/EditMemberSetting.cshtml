@{
	var titleFormat = ViewBag.IsMaster == true ? Resources.Lang.lblEditMemberSetting : Resources.Lang.lblViewMemberSetting ;
	ViewBag.UserName = ViewBag.UserName ?? string.Empty;
	ViewBag.Title = string.Format(titleFormat, ViewBag.UserName);
	Layout = "~/Views/Account/Shared/_CustSettingLayout.cshtml";
	var memberId = ViewBag.MemberId ?? 0;
}
<div id="commissionSettingContainer">
</div>
<div id="bettingLimitContainer">
</div>
<div id="ptContainer">
</div>

@RazorHelper.Info(
	@<div class="member-setting-instruction">
		<ul>
			<li>Commission Group: 4 groups, namely A, B, C and D. Each group has different values
				for min and max commission.</li>
			<li>Member Commission: the commission rates offered to a member on specific bet types
				or a group of bet types.</li>
			<li>HDP, OU, OE (%): the commission rate offered on the bet types Handicap (HDP), Over/Under
				(OU) and Odd/Even (OE).</li>
			<li>1x2 Comm (%): the commission rate offered on the bet type 1x2.</li>
			<li>Other Comm (%): the commission rate offered on other bet types that are not HDP,
				OU, OE and 1x2.</li>
			<li>[x - y]: input range. If K is the entered amount, then K must be: x <= K <= y.</li>
		</ul>
		<p>
			<span class="note">Note:</span> only allow two numbers after the decimal point. For instance, 100.25 is a
			valid input, but 100.555 is not.
		</p>
	</div>,
	"commission-info-button",
	Resources.Lang.CommissionSettingInstructions,
	Resources.Lang.ClickToViewInstructions
)

@RazorHelper.Info(
	@<div class="member-setting-instruction">
		<ul>
			<li>Commission Group: 4 groups, namely A, B, C and D. Each group has different values
				for min and max commission.</li>
			<li>Member Commission: the commission rates offered to a member on specific bet types
				or a group of bet types.</li>
			<li>HDP, OU, OE (%): the commission rate offered on the bet types Handicap (HDP), Over/Under
				(OU) and Odd/Even (OE).</li>
			<li>1x2 Comm (%): the commission rate offered on the bet type 1x2.</li>
			<li>Other Comm (%): the commission rate offered on other bet types that are not HDP,
				OU, OE and 1x2.</li>
			<li>[x - y]: input range. If K is the entered amount, then K must be: x <= K <= y.</li>
		</ul>
		<p>
			<span class="note">Note:</span> only allow two numbers after the decimal point. For instance, 100.25 is a
			valid input, but 100.555 is not.
		</p>
	</div>,
	"bet-limit-info-button",
	Resources.Lang.BetSettingInstructions,
	Resources.Lang.ClickToViewInstructions
)

@section scripts
{
	<script type="text/javascript">
		var memberId = @(memberId);
	</script>

	<script src="~/_GlobalResources/Js/jquery-ui.js" type="text/javascript"></script>
	<script src="~/CustomerSetting/GetMemberSetting?memberId=@(memberId)&ugroup=@(ViewBag.UserGroup)&agentId=@(ViewBag.CurentParentAgentId)" type="text/javascript"></script>
	<script src="~/Views/Account/Resources/EditSetting.js" type="text/javascript"></script>
}
