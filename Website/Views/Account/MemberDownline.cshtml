@using Apollo.Age.Web.Pager;
@model IPagedList<Apollo.Age.Entities.Member>
@{
    Layout = "~/Views/Account/Shared/_Layout.cshtml";
}

<ul id="members-list">
    @if (Model.Any())
    {
        foreach (var member in Model)
        {
            <li>
                <a href='~/Account/MemberInfo?custid=@member.Id&username=@member.Username' target='menu'>
                    @member.Username
                </a>
            </li> 
        }
    }
    else
    {
        <li>
            <div class="no-data">@Resources.Lang.noInfo</div>
        </li> 
    }
</ul>

@if (Model.Any())
{
    <div class="pager">
        @Html.Pager(Model.PageSize, Model.PageNumber, Model.TotalItemCount)
    </div>
}
