@using Apollo.Age.Forecast.ViewModels
@{
    Layout = null;
}
@helper ShowTime(Forecast1X2ViewModel fcItem)
{
   if (fcItem.liveindicator)
    {
        @Html.Raw(fcItem.livehomescore + " - " + fcItem.liveawayscore + "&nbsp;&nbsp;&nbsp;&nbsp;<i><font style='color:red;'>" + Resources.Lang.lblLive + "</font></i>")
    }
   else
   {
        @Html.Raw(fcItem.ShowTime)
   }    
}
@model IEnumerable<Forecast1X2ViewModel>
@{
    if(Model != null && Model.Any())
    {
        
        foreach (Forecast1X2ViewModel fcItem in Model)
        {
            <!--RowContent-->
            <tr class="league">
                <td colspan="5">
                    @fcItem.HomeTeam -vs- @fcItem.AwayTeam
                </td>
            </tr>
            <tr class="c">
                <td colspan="2">
                    @ShowTime(fcItem)
                </td>
                <td class="bold">
                    1
                </td>
                <td class="bold" style="background-color: #ffefde">
                    X
                </td>
                <td class="bold">
                    2
                </td>
            </tr>
            <tr class="c">
                <td style="width: 39%">
                    @Resources.Lang.fulltime
                </td>
                <td style="width: 1%">
                    <a class="btnInfo view-bet-list" match-id="@fcItem.MatchID" bet-type="5" href="javascript:void(0)"></a>
                </td>
                <td class="bold" style="width: 20%">
                    @TotalBetHelper.FormatPositiveNumber(fcItem.HomeWinLost, showZero: true)
                </td>
                <td class="bold" style="width: 20%">
                    @TotalBetHelper.FormatPositiveNumber(fcItem.DrawWinLost, showZero: true)
                </td>
                <td class="bold" style="width: 20%">
                    @TotalBetHelper.FormatPositiveNumber(fcItem.AwayWinLost, showZero: true)
                </td>
            </tr>
            <tr class="c">
                <td style="width: 39%">
                    @Resources.Lang.halftime
                </td>
                <td style="width: 1%">
                    <a class="btnInfo view-bet-list" match-id="@fcItem.MatchID" bet-type="15" href="javascript:void(0)"></a>
                </td>
                <td class="bold" style="width: 20%">
                    @TotalBetHelper.FormatPositiveNumber(fcItem.HalfTimeHomeWinLost, showZero: true)
                </td>
                <td class="bold" style="width: 20%">
                    @TotalBetHelper.FormatPositiveNumber(fcItem.HalfTimeDrawWinLost, showZero: true)
                </td>
                <td class="bold" style="width: 20%">
                    @TotalBetHelper.FormatPositiveNumber(fcItem.HalfTimeAwayWinLost, showZero: true)
                </td>
            </tr>
        }
    }
    else
    {
        @RazorHelper.ShowNoInfo(colspan: 8)
    }
}
