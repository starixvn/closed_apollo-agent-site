@using Apollo.Age.Forecast.ViewModels
@{
    Layout = null;
}
@model IEnumerable<Forecast1X2ViewModel>
@{
    if(Model != null && Model.Any())
    {
        
        foreach (Forecast1X2ViewModel fcItem in Model)
        {
            <!--RowContent-->
            <tr class="league">
                <td colspan="5">
                    @fcItem.HomeTeam -vs- @fcItem.AwayTeam
                </td>
            </tr>
            <tr class="c">
                <td colspan="2">
                    @{
                        if(fcItem.liveindicator)
                        {
                            @Html.Raw(fcItem.livehomescore + " - " + fcItem.liveawayscore + "&nbsp;&nbsp;&nbsp;&nbsp;<i><font style='color:red;'>" + Resources.Lang.lblLive + "</font></i>")
                        }
                        else
                        {
                            @Html.Raw(fcItem.ShowTime)
                        }
                    }
                </td>
                <td class="bold">
                    1
                </td>
                <td class="bold" style="background-color: #ffefde">
                    X
                </td>
                <td class="bold">
                    2
                </td>
            </tr>
            <tr class="c">
                <td style="width: 39%">
                    @Resources.Lang.fulltime
                </td>
                <td style="width: 1%">
                    <a class="btnInfo view-bet-list" match-id="@fcItem.MatchID" bet-type="5" href="javascript:void(0)"></a>
                </td>
                <td class="bold" style="width: 20%">
                    @TotalBetHelper.FormatPositiveNumber(fcItem.hl, showZero: true)
                </td>
                <td class="bold" style="width: 20%">
                    @TotalBetHelper.FormatPositiveNumber(fcItem.dl, showZero: true)
                </td>
                <td class="bold" style="width: 20%">
                    @TotalBetHelper.FormatPositiveNumber(fcItem.al, showZero: true)
                </td>
            </tr>
            <tr class="c">
                <td style="width: 39%">
                    @Resources.Lang.halftime
                </td>
                <td style="width: 1%">
                    <a class="btnInfo view-bet-list" match-id="@fcItem.MatchID" bet-type="15" href="javascript:void(0)"></a>
                </td>
                <td class="bold" style="width: 20%">
                    @TotalBetHelper.FormatPositiveNumber(fcItem.ht_hl, showZero: true)
                </td>
                <td class="bold" style="width: 20%">
                    @TotalBetHelper.FormatPositiveNumber(fcItem.ht_dl, showZero: true)
                </td>
                <td class="bold" style="width: 20%">
                    @TotalBetHelper.FormatPositiveNumber(fcItem.ht_al, showZero: true)
                </td>
            </tr>
        }
    }
    else
    {
        @RazorHelper.ShowNoInfo(colspan: 8)
    }
}
