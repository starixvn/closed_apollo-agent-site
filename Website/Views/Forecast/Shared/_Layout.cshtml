
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <title>@ViewBag.Title - Forecast</title>
    
    <link href="~/_GlobalResources/Css/jquery-ui-1.10.2/apollo/jquery-ui.min.less" rel="stylesheet" type="text/css" />
    <link href="~/_Components/RefreshCountDown/RefreshCountDown.less" rel="Stylesheet" type="text/css" />
    @RenderSection("css", required: false)
</head>
<body>
    <div id="page_main">
        <div id="header_main">
            <span id="leagueName">
            @ViewBag.Title
            </span>
        </div>
        @RenderBody()
    </div>
    <script src="~/_GlobalResources/Js/jquery.js" type="text/javascript"></script>
    <script src="~/_GlobalResources/Js/jquery-ui-1.10.2/dialog.min.js" type="text/javascript"></script>
    <script src="~/_GlobalResources/Js/Core.js" type="text/javascript"></script>
    <script src="~/_Components/AGEWnd/AGEWnd.js" type="text/javascript"></script>
    <script src="~/_Components/RefreshCountDown/RefreshCountDown.js" type="text/javascript"></script>

    <script type="text/javascript">
        window.rootUrl = '@Url.Content("~")';
    </script>
    @RenderSection("scripts", required: false)
</body>
</html>