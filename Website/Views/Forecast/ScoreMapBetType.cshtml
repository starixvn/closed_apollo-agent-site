@using Apollo.Age.Forecast.ViewModels
@using Apollo.Age.Forecast.Models
@{
    int haftBetType = 6;
    Layout = null;
    int liveBetType =ViewBag.LiveBetType;
    int deadBallBetType = ViewBag.DeadBallBetType;
    
}
@helper RenderBetTypeList(List<ScoreMapBetType> betTypes, int haftBetType, bool isLive, int liveBetType, int deadBallBetType)
{
    int nextCloseIndex = 0;
    for (int i = 0; i < betTypes.Count; i++)
    {
        
        if (i % haftBetType == 0)
        {
            nextCloseIndex = i + haftBetType;
            @:<tr>
        }
        
        @RenderBetType(betTypes[i], isLive, liveBetType, deadBallBetType)
        
        if (i == nextCloseIndex)
        {
            @:</tr>
        }
    }
    
}
@helper RenderBetType(ScoreMapBetType betType, bool isLive, int liveBetType, int deadBallBetType)
{
    string checkedString = string.Empty;
    if (isLive && liveBetType != 0 && (liveBetType == betType.TypeId || liveBetType == betType.Id1st))
    {
        checkedString = "checked='checked'";
    }
    else if(isLive == false && deadBallBetType != 0 && (deadBallBetType == betType.TypeId || deadBallBetType == betType.Id1st))
    {
        checkedString = "checked='checked'";
    }
    <td>
        <input id="bt_@(isLive ? "L" + betType.IsLive : "D" + betType.IsDead)_@(betType.TypeId)" class="@(isLive ? "bet-type-live" : "bet-type-deadball")" type="checkbox" value="@(betType.TypeId + "," + betType.Id1st)" @(checkedString) />
        <label for="bt_@(isLive ? "L" + betType.IsLive : "D" + betType.IsDead)_@(betType.TypeId)">
            @(betType.BetTypeName)
        </label>
    </td>
}
@model ScoreMapBetTypeViewModel
<table class="tblRpt check-list">
    <tr>
        <td>
            <label class="bold" for="chkAllL">
                <input type="checkbox" id="chkAllL" />
                @Resources.Lang.lblLiveBall
            </label>
        </td>
        <td id="Td1">
            <table class="reference">
                @{
                    if (Model.LiveBetTypes.Any())
                    {
                        @RenderBetTypeList(Model.LiveBetTypes, haftBetType, true, liveBetType, deadBallBetType)
                    }
                }
            </table>
        </td>
    </tr>
    <tr>
        <td>
            <label class="bold" for="chkAllD">
                <input type="checkbox" id="chkAllD" />
                @Resources.Lang.lblDeadball
            </label>
        </td>
        <td id="Td2">
            <table class="reference">
                 @{
                    if (Model.DeadBallBetTypes.Any())
                    {
                        @RenderBetTypeList(Model.DeadBallBetTypes, haftBetType, false, liveBetType, deadBallBetType)
                    }
                }
            </table>
        </td>
    </tr>
</table>
