@{
    Layout = "~/Views/Forecast/Shared/_Layout.cshtml";
    ViewBag.Title = Resources.Lang.lblForecast;
}
@section css
{
    <link href="~/Views/Forecast/Resources/FC.less" rel="Stylesheet" type="text/css" />
}
    @RazorHelper.RefreshCountDown("ForeCast1X2", 15, 0,"UpdateForecastValue();")
    
    <div id="forecast-body"></div>    

@section scripts {
    <script src="~/_Components/RefreshCountDown/RefreshCountDown.js" type="text/javascript"></script>
    <script type="text/javascript">
        var matchId = @(ViewBag.MatchId);
        var betType = @(ViewBag.BetType);
        var currentScore = @(ViewBag.CurrentScore);
        var leagueName = '@(ViewBag.LeagueName)';
    </script>
    <script src="~/Views/Forecast/Resources/FCByMatch.js" type="text/javascript"></script>
}