@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <title>@Resources.Lang.lblForecast</title>
    
    <link href="~/_GlobalResources/Css/jquery-ui-1.10.2/apollo/jquery-ui.min.less" rel="stylesheet" type="text/css" />
    <link href="~/_Components/RefreshCountDown/RefreshCountDown.less" rel="Stylesheet" type="text/css" />
    <link href="~/_Forecast/Resources/FC.less" rel="Stylesheet" type="text/css" />

</head>
<body>
    @RazorHelper.RefreshCountDown("ForeCast1X2", 15, 0,"UpdateForecastValue();")
    <div style="clear:both;"></div>
    <div id="forecast-body">
        
    </div>
    <script src="~/_GlobalResources/Js/jquery-1.9.1.min.js" type="text/javascript"></script>
    <script src="~/_GlobalResources/Js/jquery-ui-1.10.2/dialog.min.js" type="text/javascript"></script>
    <script src="~/_GlobalResources/Js/Core.js" type="text/javascript"></script>
    <script src="~/_Components/AGEWnd/AGEWnd.js" type="text/javascript"></script>
    <script src="~/_Components/RefreshCountDown/RefreshCountDown.js" type="text/javascript"></script>
    @*<script src="~/_Forecast/Resources/FC.js" type="text/javascript"></script>*@
    <script type="text/javascript">
        window.rootUrl = '@(Url.Content("~"))';
        var matchId = @(ViewBag.MatchId);
        var betType = @(ViewBag.BetType);
        var currentScore = @(ViewBag.CurrentScore);
    </script>
    <script src="~/Views/Forecast/Resources/FCByMatch.js" type="text/javascript"></script>

