@using Apollo.Age.Forecast.Models
@{
    Layout = null;
}
@model IEnumerable<ScoreMapMatch>
<div id="BoxMatchWL">
    <div class="poup-title">
        <div id="iconSelMatch">@Resources.Lang.SelectMatch</div>
        <div class="message">
            <table border="0" cellpadding="0" cellspacing="0" width="40%" id="tblMsgMatch" style="display: none;">
                <tr>
                    <td class="emsg_1_1">
                        &nbsp;
                    </td>
                    <td class="emsg_1_2">
                        &nbsp;
                    </td>
                    <td class="emsg_1_3">
                        &nbsp;
                    </td>
                </tr>
                <tr>
                    <td valign="top" class="emsg_2_1">
                        &nbsp;
                    </td>
                    <td valign="top" id="msgMatchErr" class="msgerr">
                    </td>
                    <td class="emsg_2_2">
                        &nbsp;
                    </td>
                </tr>
                <tr>
                    <td class="emsg_3_1">
                        &nbsp;
                    </td>
                    <td class="emsg_3_2">
                        &nbsp;
                    </td>
                    <td class="emsg_3_3">
                        &nbsp;
                    </td>
                </tr>
            </table>
        </div>
        <div id="closeBoxMatch"></div>
    </div>
    <div class="boderBoxMatch">
        <div class="ContentMatchWL">
            <!--ContentMatch-->
            <ul class="ListMatch">
                @{
                    if (Model != null && Model.Any())
                    {
                        <li>
                            <input class="hand" type="checkbox" id="chLCheckAll">
                            <label class="hand" for="chLCheckAll"><b>@Resources.Lang.all</b></label>
                        </li>
                        foreach (var match in Model)
                        {
                            <li>
                                <input class="hand match-item" type="checkbox" id="chL@(match.MatchId)" value="@(match.MatchId)" />
                                <label class="hand" for="chL@(match.MatchId)">@(match.MatchName)</label>
                            </li>
                        }

                    }
                }
            </ul>
            <!--/ContentMatch-->
        </div>
        <div align="center" style="padding-top: 5px">
            <input type="button" class="btn" id="dSubmitInMatch" value="@Resources.Lang.select">
        </div>
    </div>
</div>
