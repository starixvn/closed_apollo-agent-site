@using Apollo.Age.Forecast.ViewModels
@{
    Layout = "~/Views/Forecast/Shared/_Layout.cshtml";
    ViewBag.Title = Resources.Lang.lblForecast;
    IEnumerable<LeagueViewModel> leagues = (IEnumerable<LeagueViewModel>)ViewBag.Leagues;
}
<div id="content_main">
    @RazorHelper.RefreshCountDown("ForeCastHandicapOU", 15, 0)
    <div style="clear: both;">
    </div>
    <div id="box_header">
        <table>
            <tr>
                <td>
                    <b>@Resources.Lang.league</b>
                </td>
                <td id="selLeague">
                    <select id='ddlLeague' name='ddlLeague' style="width: 280px">
                        @{
                            foreach (var league in leagues)
                            {
                            <option value="@league.LeagueId">@league.LeagueName</option>
                            }
                        }
                    </select>
                </td>
            </tr>
        </table>
    </div>
    <!--/LimitLeagueList-->
    <table class="tblRpt">
        <thead>
            <tr class="RptHeader">
                <td colspan="2">
                    @Resources.Lang.lblTeam
                </td>
                <td colspan="3">
                    @Resources.Lang.lblHandicapFC
                </td>
                <td colspan="3">
                    @Resources.Lang.lblOverUnder
                </td>
            </tr>
        </thead>
        <tbody id="forecast-body">
            @*Load Ajax*@
        </tbody>
    </table>
</div>
@section scripts
{
    <script src="~/Views/Forecast/Resources/FCHandicapOU.js" type="text/javascript"></script>
}
