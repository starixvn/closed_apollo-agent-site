@using Apollo.Age.Forecast.Models
@{
    Layout = "~/Views/Forecast/Shared/_Layout.cshtml";
    ViewBag.Title = Resources.Lang.lblScoreMap;
    var leagues = (IEnumerable<LeagueModel>)ViewBag.Leagues;
    var showLeaguesStyle = leagues == null ? "display:none;" : string.Empty;
    var matchIds = ViewBag.MatchIds;
    var liveBetTypes = ViewBag.LiveBetTypes;
    var deadBallBetTypes = ViewBag.DeadBallBetTypes;
}
@section css
{
    <link type="text/css" rel="Stylesheet" href="~/Views/Forecast/Resources/ScoreMap.less" />
}
<div id="content_main">
    <div id="box_header" class="clearfix">
        <div style="@(showLeaguesStyle)">
            @{
                if (leagues != null && leagues.Any())
                {
                <div class="row">
                    <div class="cell">
                        <div class="label">
                            <label for="ddlLeague">@Resources.Lang.league</label>
                        </div>
                        <div class="editor">
                           <select id="ddlLeague" name="ddlLeague" style="position: relative;">
                                @foreach (var league in leagues)
                                {
                                    <option value="@(league.LeagueId)">@(league.LeagueName)</option>
                                }
                            </select>
                        </div>
                        <div class="editor">
                            <input type="button" class="btn" id="dSelMatch" value="@Resources.Lang.SelectMatch">
                        </div>
                        <div title="@Resources.Lang.RefreshLeagues" class="iconRefresh clearfix" id="RefreshLeagues">
                        </div>  
                    </div>                    
                </div>               
                }
                else
                {
                    <label>There is no @Resources.Lang.league availble!</label>
                }
            }
        </div>
        <div id="tblLiveDead">
            <div id="bet-type-container" class="clearfix">
            </div>
            <div class="btn-submit clearfix">
                <input type="button" value="@Resources.Lang.submit" id="dSubmit" class="btn" />
                <span id="loadingSubmit"></span>
            </div>
        </div>
    </div>
    <div id="diverrmsg">
        <span id="spmsgerr" class="msgerr"></span>
    </div>
    <div id="mainContent" @*style="width: {mWidth}"*@>
    </div>
    <div id="BoxMatchWL" style="display: none;">
    </div>
</div>
<input id="match-ids" type="hidden" value="@(matchIds)" />
<input id="bet-types-live" type="hidden" value="@(liveBetTypes)" />
<input id="bet-types-dead" type="hidden" value="@(deadBallBetTypes)" />
@section scripts
{
    <script type="text/javascript">
        var plsChooseBetType = "@(Resources.Lang.plsChooseBetType)";
        var plsChooseMatch = "@(Resources.Lang.plsChooseMatch)";
    </script>
    <script src="~/Views/Forecast/Resources/ScoreMap.js" type="text/javascript"></script>
}
