@using Apollo.Age.Forecast.ViewModels
@{
    Layout = "~/Views/Forecast/Shared/_Layout.cshtml";
    ViewBag.Title = Resources.Lang.lblScoreMap;
}
<div id="content_main" class="pull-left" style="width: 100%">
      <!--LimitLeagueList-->
            <div id="box_header">
                <table style="{display}">
                    <tr>
                        <td>
                            <b>@Resources.Lang.league</b>
                        </td>
                        <td id="selLeague">
                            {LeagueList}
                        </td>
                        <td>
                            <div title="{static:Resources.Lang.RefreshLeagues}" class="btnRefresh" id="RefreshLeagues">&nbsp;</div>
                        </td>
                        <td>
                            <input type="button" class="btn" id="dSelMatch" value="@Resources.Lang.SelectMatch">
                        </td>
                        <td>
                            <span class="pull-left" id="loading"></span>
                        </td>
                    </tr>
                </table>
                <div id="tblLiveDead" style="{displayLiveDead}">
                    <div id="bet-type-container"></div>
                    <p>
                        <input type="button" value="@Resources.Lang.submit" id="dSubmit" class="btn" />
                        <span id="loadingSubmit"></span>
                    </p>
                </div>
            </div>            
            <!--/LimitLeagueList-->
            <div id="mainContent" style="width: {mWidth}">
                <!--ScoreMap-->
                <div id="RefreshContent{matchId}" style="padding-top:6px">
                    {MainTable}
                </div>
                <!--/ScoreMap-->
            </div>
</div>
@section scripts
{
    <script src="~/Views/Forecast/Resources/ScoreMap.js" type="text/javascript"></script>
}
