@using Apollo.Age.Forecast.ViewModels
@{
    Layout = null;
}
@model IEnumerable<ScoreMapResultViewModel>
@{
    if (Model != null && Model.Any())
    {
        foreach (var result in Model)
        {

    <div id="RefreshContent@(result.MatchId)" class="paddingTopMatch clearfix">
        <div class="title-scoremap">
            <span class="collapse-expand lnkGroup span-expand">
                @result.HomeName -vs- @result.AwayName
            </span>
            <span title="@Resources.Lang.refresh" class="refresh-scoremap lnkRefresh refresh-button"
                id="lnkRefresh@(result.MatchId)" match-id="@(result.MatchId)"></span>
        </div>
        <div class="scoreMap" id="scoreMap@(result.MatchId)">
            <table class="tblRpt" id="tblSM@(result.MatchId)">
                <thead>
                    <tr class="vsmHomeWay" align="center">
                        <th rowspan="2" class="smTitle">
                            @Resources.Lang.away
                        </th>
                        <th colspan="7" class="smTitle">
                            @Resources.Lang.home
                        </th>
                    </tr>
                    <tr class="vsm">
                        <th width="13%">
                            0
                        </th>
                        <th width="13%">
                            1
                        </th>
                        <th width="13%">
                            2
                        </th>
                        <th width="13%">
                            3
                        </th>
                        <th width="13%">
                            4
                        </th>
                        <th width="13%">
                            5
                        </th>
                        <th width="13%">
                            6
                        </th>
                    </tr>
                </thead>
                <tbody>
                    @{
                        if(result.HasData)
                        {
                            var total = result.ScoreMatrix.GetLength(1);
                            for (int i = 0; i < total; i++)
                            {
                                <tr class="vScoreMap" align="center">
                                    <td class="vsm">
                                        @(i)
                                    </td>
                                    @{
                                    
                                        for (int j = 0; j < total; j++)
                                        {
                                            <td class='csm'>
                                                @RazorHelper.FormatPositiveNumber(result.ScoreMatrix[i,j], 0, true)
                                            </td>
                                        }
                                    
                                        }
                                </tr>
                            }
                        }
                    
                        }
                </tbody>
            </table>
        </div>
    </div>
        }
    }
}
