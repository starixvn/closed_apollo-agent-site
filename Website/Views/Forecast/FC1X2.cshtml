@using Apollo.Age.Forecast.Models
@{
    Layout = "~/Views/Forecast/Shared/_Layout.cshtml";
    ViewBag.Title = Apollo.Age.Resources.Lang.lbl1x2;

    var leagues = (IEnumerable<LeagueModel>)ViewBag.Leagues;
    int matchId = ViewBag.MatchId != null ? (int)ViewBag.MatchId : 0;
    int betType = ViewBag.BetType != null ? (int)ViewBag.BetType : 0;
    string initLeagueName = ViewBag.LeagueName;
    var leagueId = ViewBag.LeagueId ?? 0;
}
@section css
{
    <link href="~/Views/Forecast/Resources/FC.less" rel="Stylesheet" type="text/css" />
}
@section refreshcountdown
{
    @RazorHelper.RefreshCountDown("ForeCast1X2", 15, 0, "UpdateForecast1x2Value();")
}
@if (matchId == 0)
{

    <div class="box-header">
        <div class="row">
            <div class="cell">
                @if (leagues != null && leagues.Any())
                {
                    <div class="label">
                        <label for="ddlLeague">@Apollo.Age.Resources.Lang.league</label>
                    </div>
                    <div class="editor">
                        <select id='ddlLeague' name='ddlLeague' style="width: 280px">
                            @{
                    var selectedString = string.Empty;
                    foreach (var league in leagues)
                    {
                        if (league.LeagueId == leagueId)
                        {
                            selectedString = "selected='selected'";
                        }
                        else
                        {
                            selectedString = string.Empty;
                        }
                                <option value="@league.LeagueId" @(selectedString) >@league.LeagueName</option>
                    }
                            }
                        </select>
                    </div>
                }
                else
                {
                    <label>
                        There is no @Apollo.Age.Resources.Lang.league availble!</label>
                }
            </div>
        </div>
    </div>

}
@if (matchId != 0 || (leagues != null && leagues.Any()))
{
    <table class="tblRpt">
        <thead>
            <tr>
                <th colspan="2">
                    @Apollo.Age.Resources.Lang.lblTeam
                </th>
                <th colspan="3">
                    @Apollo.Age.Resources.Lang.lbl1x2
                </th>
            </tr>
        </thead>
        <tbody id="forecast-body">
            @*Ajax Content*@
        </tbody>
    </table>
}
@section scripts
{
    <script type="text/javascript">
        var matchId = @(matchId);
        var betType = @(betType);
        var initLeagueName = '@(initLeagueName)';
    </script>
    <script src="~/_Components/RefreshCountDown/RefreshCountDown.js" type="text/javascript"></script>
    <script src="~/Views/Forecast/Resources/FC1X2.js" type="text/javascript"></script>
}