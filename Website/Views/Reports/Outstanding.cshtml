@using Apollo.Age.Reports.ViewModels;
@using Fanex.Age.Utility;
@using Sunplus.Agent.Model.Entities;
@{
    ViewBag.Title = Resources.Lang.outstanding;
    Layout = "~/Views/Reports/Shared/_Layout.cshtml";
}
@section css
{
    <link href="~/_GlobalResources/Js/Fanex.Grid/Fanex.Grid.less" rel="stylesheet" type="text/css" />
}
@model IEnumerable<OutstandingViewModel>
<div id="divMain">
    <table id="tbl-rpt" class="tblRpt" cellspacing="1" cellpadding="0" style="width: 100%;
        display: table">
        <thead>
            <tr>
                <td colspan="5" id="navigation">
                    @{
                        IEnumerable<AgentDownlinePathViewModel> AgentDownlinePath = (IEnumerable<AgentDownlinePathViewModel>)ViewBag.AgentDownlinePath;
                        <div class="boxNavigation" id="divnavigation">
                            @foreach (AgentDownlinePathViewModel item in AgentDownlinePath)
                            {

                                if (!AgentDownlinePath.IsLast(item))
                                {
                                <a href="#" onclick="REPORTS.viewAgent(@item.Id)">@item.Username</a>
                                <img alt="" height="12" width="12" src="~/_MemberInfo/CustomerList/Resources/Images/breadcrumb.gif" />
                                }
                                else
                                {
                                <span>@item.Username</span>
                                }
                            }
                        </div>
                    }
                </td>
            </tr>
            <tr>
                <td rowspan="2" class="RptHeader02" style="width: 200px;">
                </td>
                <td colspan="2" class="RptHeader02" style="width: 170px;">
                    @Resources.Lang.sportBook
                </td>
                <td colspan="2" class="RptHeader02" style="width: 170px;">
                    @Resources.Lang.numbergame
                </td>
            </tr>
            <tr>
                <td class="RptHeader02" style="width: 170px;">
                    @Resources.Lang.outstanding
                </td>
                <td class="RptHeader02" style="width: 170px;">
                    @Resources.Lang.ShareAmount
                </td>
                <td class="RptHeader02" style="width: 170px;">
                    @Resources.Lang.outstanding
                </td>
                <td class="RptHeader02" style="width: 170px;">
                    @Resources.Lang.ShareAmount
                </td>
            </tr>
        </thead>
        @if (Model != null && Model.Any())
        {
            var agentOutStanding = Model.SingleOrDefault(x => x.IsAgent == 1);
            var memberOutstandig = Model.SingleOrDefault(x => x.IsAgent == 0);
            if (agentOutStanding != null)
            {
            <tr>
                <td>
                    <a href="#" id="AgentOutstanding" agentid="@Request.QueryString["agentid"]" >@Resources.Lang.lblAgentOutstanding</a>
                </td>
                <td class="r">
                    @Formater.FormatNumber20(agentOutStanding.Outstanding, "en-US")
                </td>
                <td class="r">
                    @Formater.FormatNumber20(agentOutStanding.ShareAmount, "en-US")
                </td>
                <td class="r">
                    @Formater.FormatNumber20(agentOutStanding.GameOutstanding, "en-US")
                </td>
                <td class="r">
                    @Formater.FormatNumber20(agentOutStanding.GameShareAmount, "en-US")
                </td>
            </tr>
            }
            if (memberOutstandig != null)
            {
            <tr>
                <td>
                    <a href="#" id="MemberOutstanding" agentid="@Request.QueryString["agentid"]" >@Resources.Lang.lblMemberOutstanding</a>
                </td>
                <td class="r">
                    @Formater.FormatNumber20(memberOutstandig.Outstanding, "en-US")
                </td>
                <td class="r">
                    @Formater.FormatNumber20(memberOutstandig.ShareAmount, "en-US")
                </td>
                <td class="r">
                    @Formater.FormatNumber20(memberOutstandig.GameOutstanding, "en-US")
                </td>
                <td class="r">
                    @Formater.FormatNumber20(memberOutstandig.GameShareAmount, "en-US")
                </td>
            </tr>
            }
            <tr class="RptFooter">
                <td>
                    @Resources.Lang.total
                </td>
                <td class="r">
                    @Formater.FormatNumber20(Model.Sum(x => x.Outstanding), "en-US")
                </td>
                <td class="r">
                    @Formater.FormatNumber20(Model.Sum(x => x.ShareAmount), "en-US")
                </td>
                <td class="r">
                    @Formater.FormatNumber20(Model.Sum(x => x.GameOutstanding), "en-US")
                </td>
                <td class="r">
                    @Formater.FormatNumber20(Model.Sum(x => x.GameShareAmount), "en-US")
                </td>
            </tr>
        }
        else
        {
            <tr>
                <td colspan="5">@Resources.Lang.noInfo
                </td>
            </tr>
        }
    </table>
</div>
<div id="divDetail" style="margin-top: 20px;">
</div>
<div id="gridId" class="freegrid  content-grid" style="margin-top: 20px; display: none;">
</div>
@section scripts
{
    <script src="~/_GlobalResources/Js/Fanex.Grid/moment.min.js" type="text/javascript"></script>
    <script src="~/_GlobalResources/Js/Fanex.Grid/numeral.js" type="text/javascript"></script>
    <script src="~/_GlobalResources/Js/Fanex.Grid/Fanex.Grid.js" type="text/javascript"></script>
}