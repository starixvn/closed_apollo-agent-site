@using Apollo.Age.Reports.ViewModels;
@using Apollo.Age.Reports.Models;
@using Fanex.Age.Utility;
@using Sunplus.Agent.Model.Entities;
@{
    ViewBag.Title = Resources.Lang.outstanding;
    Layout = "~/Views/Reports/Shared/_Layout.cshtml";
}
@section css
{
    <link href="~/_GlobalResources/Js/Fanex.Grid/Fanex.Grid.less" rel="stylesheet" type="text/css" />
}
@model OutstandingViewModel
@{
    if (Model.DownlinePath != null && Model.DownlinePath.Any())
    {
    @RazorHelper.Navigation(Model.DownlinePath.ToList(), true)
    }
}
<div id="agentOutstanding">
    <table class="tblRpt no-full-screen">
        <thead>
            <tr>
                <th rowspan="2" style="width: 150px;">
                    @Resources.Lang.agent
                </th>
                <th colspan="2" style="width: 200px;">
                    @Resources.Lang.sportBook
                </th>
                <th colspan="2" style="width: 200px; display: none">
                    @Resources.Lang.numbergame
                </th>
            </tr>
            <tr>
                <th style="width: 200px;">
                    @Resources.Lang.outstanding
                </th>
                <th style="width: 200px;">
                    @Resources.Lang.ShareAmount
                </th>
                <th style="width: 200px; display: none">
                    @Resources.Lang.outstanding
                </th>
                <th style="width: 200px; display: none">
                    @Resources.Lang.ShareAmount
                </th>
            </tr>
        </thead>
        @if (Model.ListOutStanding != null && Model.ListOutStanding.Any())
        {
            decimal outStandingTotal = 0;
            decimal shareAmountTotal = 0;
            decimal gameOutstandingTotal = 0;
            decimal gameShareAmountTotal = 0;
            int i = 1;
            string rowClass = string.Empty;
            <tbody>
                @foreach (OutstandingModel item in Model.ListOutStanding)
                {
                    outStandingTotal += item.Outstanding;
                    shareAmountTotal += item.ShareAmount;
                    gameOutstandingTotal += item.GameOutstanding;
                    gameShareAmountTotal += item.GameShareAmount;
                    rowClass = i++ % 2 == 0 ? string.Empty : "class='alt'";

                    if (item.IsAgent)
                    {
                    <tr @Html.Raw(rowClass)>
                        <td>
                            <a href="#" name="viewagent" agentid="@item.UserId" title="@Resources.Lang.lblViewAgentDownline">@item.UserName</a>
                        </td>
                        <td class="r">
                            @Formater.FormatNumber20(item.Outstanding, "en-US")
                        </td>
                        <td class="r">
                            @Formater.FormatNumber20(item.ShareAmount, "en-US")
                        </td>
                        <td class="r" style="display: none">
                            @Formater.FormatNumber20(item.GameOutstanding, "en-US")
                        </td>
                        <td class="r" style="display: none">
                            @Formater.FormatNumber20(item.GameShareAmount, "en-US")
                        </td>
                    </tr>
                    }
                    else
                    {
                    <tr @Html.Raw(rowClass)>
                        <td>
                            <a href="#" id="MemberOutstanding" agentid="@Model.CurrentAgentId"  title="@Resources.Lang.lblViewMemberOutstanding">@Resources.Lang.lblMemberOutstanding</a>
                        </td>
                        <td class="r">
                            @Formater.FormatNumber20(item.Outstanding, "en-US")
                        </td>
                        <td class="r">
                            @Formater.FormatNumber20(item.ShareAmount, "en-US")
                        </td>
                        <td class="r" style="display: none">
                            @Formater.FormatNumber20(item.GameOutstanding, "en-US")
                        </td>
                        <td class="r" style="display: none">
                            @Formater.FormatNumber20(item.GameShareAmount, "en-US")
                        </td>
                    </tr>
                    }
                }
            </tbody>
                if (Model.AgentLevel != 0)
                {
            <tfoot>
                <tr class="total">
                    <td>
                        @Resources.Lang.total
                    </td>
                    <td class="r">
                        @Formater.FormatNumber20(outStandingTotal, "en-US")
                    </td>
                    <td class="r">
                        @Formater.FormatNumber20(shareAmountTotal, "en-US")
                    </td>
                    <td class="r" style="display: none">
                        @Formater.FormatNumber20(gameOutstandingTotal, "en-US")
                    </td>
                    <td class="r" style="display: none">
                        @Formater.FormatNumber20(gameShareAmountTotal, "en-US")
                    </td>
                </tr>
            </tfoot>
                }
        }
        else
        {
            @RazorHelper.ShowNoInfo(3)
        }
    </table>
</div>
<div id="gridId" class="freegrid  content-grid" style="display: none">
</div>
@section scripts
{
    <script language="javascript" type="text/javascript">
        var LANGUAGES = function () {
            return {
                SportBook: "@Resources.Lang.sportBook",
                NumberGame: "@Resources.Lang.numbergame",
                Outstanding: "@Resources.Lang.outstanding",
                ShareAmount: "@Resources.Lang.ShareAmount",
                Member: "@Resources.Lang.lblMember",
                ViewBetlist: "@Resources.Lang.lblViewBetlist"
            };
        } ();
    </script>
    <script src="~/_GlobalResources/Js/Fanex.Grid/moment.min.js" type="text/javascript"></script>
    <script src="~/_GlobalResources/Js/Fanex.Grid/numeral.js" type="text/javascript"></script>
    <script src="~/_GlobalResources/Js/Fanex.Grid/Fanex.Grid.js" type="text/javascript"></script>
}