@using Apollo.Age.Reports.ViewModels
@using Fanex.Age.Utility
@{
    ViewBag.Title = Resources.Lang.memberwinloss;
    Layout = "~/Views/Reports/Shared/_Layout.cshtml";
    int i = 1;
    string rowClass = string.Empty;
}

@model MemberWinLossViewModel

<div id="box_header">
    <div class="row">
        @{
            var maxDate = DateTime.Now;
            var minDate = maxDate.AddDays(1 - maxDate.Day).AddMonths(-3);
        }
        <div class="cell">
            <div class="label">
                @Html.LabelFor(m => m.FromDate, @Resources.Lang.from)         
            </div>
            <div class="editor">
               @Html.DatePickerFor(m => m.FromDate, minDate, maxDate)
            </div>
        </div>
        <div class="cell">
            <div class="label">
               @Html.LabelFor(m => m.ToDate, @Resources.Lang.to)   
            </div>
            <div class="editor">
                @Html.DatePickerFor(m => m.ToDate, minDate, maxDate)
            </div>
        </div>
        <div class="cell">
            <div class="editor">
                <input id="btnSubmit" class="btn" type="button" value="@Resources.Lang.Generate" />
            </div>
        </div>
    </div>
</div>

@if (Model.DownlinePath != null && Model.DownlinePath.Any())
{
    @RazorHelper.Navigation(Model.DownlinePath)
}

<table class="tblRpt">
    <thead>
        <tr>
            <th rowspan="2">
                @Resources.Lang.lblMember
            </th>
            <th rowspan="2">
                @Resources.Lang.lblSoccerPT
            </th>
            <th colspan="2">
                @Resources.Lang.turnover
            </th>
            <th colspan="3">
                @Resources.Lang.lblMember
            </th>
            <th colspan="3">
                @Model.AgentName
            </th>
            <th rowspan="2">
                @Resources.Lang.UplineTotal
            </th>
        </tr>
        <tr>
            <th>
                @Resources.Lang.total
            </th>
            <th>
                @Resources.Lang.Actual
            </th>
            <th>
                @Resources.Lang.lblWinLoss
            </th>
            <th>
                @Resources.Lang.lblComm
            </th>
            <th>
                @Resources.Lang.total
            </th>
            <th>
                @Resources.Lang.lblWinLoss
            </th>
            <th>
                @Resources.Lang.lblComm
            </th>
            <th>
                @Resources.Lang.total
            </th>
        </tr>
    </thead>
    @if (Model.MemberWinLossList != null && Model.MemberWinLossList.Any())
    {
        var list = Model.MemberWinLossList;
        decimal totalTurnover = 0;
        decimal totalActual = 0;
        decimal totalMWinLoss = 0;
        decimal totalMComm = 0;
        decimal totalMTotal = 0;
        decimal totalAWinLoss = 0;
        decimal totalAComm = 0;
        decimal totalATotal = 0;
        decimal totalUpline = 0;        
            
        <tbody>
        @foreach (var item in list)
        {
            totalTurnover += item.Turnover;
            totalActual += item.ActualTO;
            totalMWinLoss += item.WinLoss;
            totalMComm += item.MemComm;
            totalMTotal += item.MemTotal;
            totalAWinLoss += item.AWinLoss;
            totalAComm += item.AComm;
            totalATotal += item.ATotal;
            totalUpline += item.UplineTotal;
            rowClass = i++ % 2 == 0 ? "class='alt'" : string.Empty;
                
            <tr @Html.Raw(rowClass)>
                <td>
                    <a href="~/_BetList/BetListOnMember.aspx?custId=@item.MemberId&username=@item.MemberName&fromDate=@Formater.ShortDateFormat(Model.FromDate)&toDate=@Formater.ShortDateFormat(Model.ToDate)&type=report">
                        @item.MemberName
                    </a>
                </td>
                <td class="r">
                    @item.SoccerShare
                </td>
                <td class="r">
                    @RazorHelper.FormatNumber(item.Turnover, 2, true)
                </td>
                <td class="r">
                    @RazorHelper.FormatNumber(item.ActualTO, 2, true)
                </td>
                <td class="r">
                    @RazorHelper.FormatNumber(item.WinLoss, 2, true)
                </td>
                <td class="r">
                    @RazorHelper.FormatNumber(item.MemComm, 2, true)
                </td>
                <td class="r bold">
                    @RazorHelper.FormatNumber(item.MemTotal, 2, true)
                </td>
                <td class="r">
                    @RazorHelper.FormatNumber(item.AWinLoss, 2, true)
                </td>
                <td class="r">
                    @RazorHelper.FormatNumber(item.AComm, 2, true)
                </td>
                <td class="r bold">
                    @RazorHelper.FormatNumber(item.ATotal, 2, true)
                </td>
                <td class="r bold">
                    @RazorHelper.FormatNumber(item.UplineTotal, 2, true)
                </td>
            </tr>
        }
        </tbody>
        <tfoot>
            <tr class="total">
                <td> 
                    @Resources.Lang.total 
                </td>
                <td>
                </td>
                <td class="r">
                    @RazorHelper.FormatNumber(totalTurnover, 2, true)
                </td>
                <td class="r">
                    @RazorHelper.FormatNumber(totalActual, 2, true)
                </td>
                <td class="r">
                    @RazorHelper.FormatNumber(totalMWinLoss, 2, true)
                </td>
                <td class="r">
                    @RazorHelper.FormatNumber(totalMComm, 2, true)
                </td>
                <td class="r">
                    @RazorHelper.FormatNumber(totalMTotal, 2, true)
                </td>
                <td class="r">
                    @RazorHelper.FormatNumber(totalAWinLoss, 2, true)
                </td>
                <td class="r">
                    @RazorHelper.FormatNumber(totalAComm, 2, true)
                </td>
                <td class="r">
                    @RazorHelper.FormatNumber(totalATotal, 2, true)
                </td>
                <td class="r">
                    @RazorHelper.FormatNumber(totalUpline, 2, true)
                </td>
            </tr>
        </tfoot>
    }
    else
    {
        @RazorHelper.ShowNoInfo(11) 
    }
    
</table>

@section scripts
{
    <script src="~/_GlobalResources/Js/noty/jquery.noty.min.js" type="text/javascript"></script>
    <script src="~/Views/Reports/Resources/WinLoss.js" type="text/javascript"></script>
    <script type="text/javascript">
        var LANGUAGES = function () {
            return {
                MessageValidateDate: "@Resources.LangMsg.ValidateFromToDate"
            };
        } ();
    </script>
}