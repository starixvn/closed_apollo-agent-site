@using Apollo.Age.Reports.ViewModels
@{
    ViewBag.Title = Apollo.Age.Resources.Lang.memberwinloss;
    Layout = "~/Views/Reports/Shared/_Layout.cshtml";
    int i = 1;
    string rowClass = string.Empty;
}
@model MemberWinLossViewModel
<div id="box_header">
    <div class="row">
        @{
            var maxDate = DateTime.Now;
            var minDate = maxDate.AddDays(1 - maxDate.Day).AddMonths(-3);
        }
        <div class="cell">
            <div class="label">
                @Html.LabelFor(m => m.FromDate, @Apollo.Age.Resources.Lang.from)
            </div>
            <div class="editor">
                @Html.DatePickerFor(m => m.FromDate, minDate, maxDate)
                <img src="~/_GlobalResources/Css/img/cal/calendar_10.png" class="img-calendar">
            </div>
        </div>
        <div class="cell">
            <div class="label">
                @Html.LabelFor(m => m.ToDate, @Apollo.Age.Resources.Lang.to)
            </div>
            <div class="editor">
                @Html.DatePickerFor(m => m.ToDate, minDate, maxDate)
                <img src="~/_GlobalResources/Css/img/cal/calendar_10.png" class="img-calendar">
            </div>
        </div>
        <div class="cell">
            <div class="editor">
                <input id="btnSubmit" class="btn" type="button" value="@Apollo.Age.Resources.Lang.Generate" />
            </div>
        </div>
    </div>
</div>
@if (Model.DownlinePath != null && Model.DownlinePath.Any())
{
    @RazorHelper.Navigation(Model.DownlinePath)
}
<table class="tblRpt">
    <thead>
        <tr>
            <th rowspan="2">
                @Apollo.Age.Resources.Lang.lblMember
            </th>
            <th rowspan="2">
                @Apollo.Age.Resources.Lang.lblSoccerPT
            </th>
            <th colspan="2">
                @Apollo.Age.Resources.Lang.turnover
            </th>
            <th colspan="3">
                @Apollo.Age.Resources.Lang.lblMember
            </th>
            <th colspan="3">
                @Model.AgentName
            </th>
            <th rowspan="2">
                @Apollo.Age.Resources.Lang.UplineTotal
            </th>
        </tr>
        <tr>
            <th>
                @Apollo.Age.Resources.Lang.total
            </th>
            <th>
                @Apollo.Age.Resources.Lang.Actual
            </th>
            <th>
                @Apollo.Age.Resources.Lang.lblWinLoss
            </th>
            <th>
                @Apollo.Age.Resources.Lang.lblComm
            </th>
            <th>
                @Apollo.Age.Resources.Lang.total
            </th>
            <th>
                @Apollo.Age.Resources.Lang.lblWinLoss
            </th>
            <th>
                @Apollo.Age.Resources.Lang.lblComm
            </th>
            <th>
                @Apollo.Age.Resources.Lang.total
            </th>
        </tr>
    </thead>
    @if (Model.MemberWinLossList != null && Model.MemberWinLossList.Any())
    {
        var list = Model.MemberWinLossList;
        decimal totalTurnover = 0;
        decimal totalActual = 0;
        decimal totalMWinLoss = 0;
        decimal totalMComm = 0;
        decimal totalMTotal = 0;
        decimal totalAWinLoss = 0;
        decimal totalAComm = 0;
        decimal totalATotal = 0;
        decimal totalUpline = 0;

        <tbody>
            @foreach (var item in list)
            {
                totalTurnover += item.Turnover;
                totalActual += item.ActualTO;
                totalMWinLoss += item.WinLoss;
                totalMComm += item.MemComm;
                totalMTotal += item.MemTotal;
                totalAWinLoss += item.AWinLoss;
                totalAComm += item.AComm;
                totalATotal += item.ATotal;
                totalUpline += item.UplineTotal;
                rowClass = i++ % 2 == 0 ? string.Empty : "class='alt'";

                <tr @Html.Raw(rowClass)>
                    <td>
                        <a href="~/_BetList/BetListOnMember.aspx?custId=@item.MemberId&username=@item.MemberName&fromDate=@Formater.ShortDateFormat(Model.FromDate)&toDate=@Formater.ShortDateFormat(Model.ToDate)&type=report">
                            @item.MemberName
                        </a>
                    </td>
                    <td class="r">
                        @Formater.FormatNumber20(item.SoccerShare / 100.00, Formater.CULT_NAME_ENG)
                    </td>
                    <td class="r">
                        @Formater.FormatNumber20(item.Turnover, Formater.CULT_NAME_ENG)
                    </td>
                    <td class="r">
                        @Formater.FormatNumber20(item.ActualTO, Formater.CULT_NAME_ENG)
                    </td>
                    <td class="r">
                        @Formater.FormatNumber20(item.WinLoss, Formater.CULT_NAME_ENG)
                    </td>
                    <td class="r">
                        @Formater.FormatNumber20(item.MemComm, Formater.CULT_NAME_ENG)
                    </td>
                    <td class="r bold">
                        @Formater.FormatNumber20(item.MemTotal, Formater.CULT_NAME_ENG)
                    </td>
                    <td class="r">
                        @Formater.FormatNumber20(item.AWinLoss, Formater.CULT_NAME_ENG)
                    </td>
                    <td class="r">
                        @Formater.FormatNumber20(item.AComm, Formater.CULT_NAME_ENG)
                    </td>
                    <td class="r bold">
                        @Formater.FormatNumber20(item.ATotal, Formater.CULT_NAME_ENG)
                    </td>
                    <td class="r bold">
                        @Formater.FormatNumber20(item.UplineTotal, Formater.CULT_NAME_ENG)
                    </td>
                </tr>
            }
        </tbody>
        <tfoot>
            <tr class="total">
                <td>
                    @Apollo.Age.Resources.Lang.total
                </td>
                <td>
                </td>
                <td class="r">
                    @Formater.FormatNumber20(totalTurnover, Formater.CULT_NAME_ENG)
                </td>
                <td class="r">
                    @Formater.FormatNumber20(totalActual, Formater.CULT_NAME_ENG)
                </td>
                <td class="r">
                    @Formater.FormatNumber20(totalMWinLoss, Formater.CULT_NAME_ENG)
                </td>
                <td class="r">
                    @Formater.FormatNumber20(totalMComm, Formater.CULT_NAME_ENG)
                </td>
                <td class="r">
                    @Formater.FormatNumber20(totalMTotal, Formater.CULT_NAME_ENG)
                </td>
                <td class="r">
                    @Formater.FormatNumber20(totalAWinLoss, Formater.CULT_NAME_ENG)
                </td>
                <td class="r">
                    @Formater.FormatNumber20(totalAComm, Formater.CULT_NAME_ENG)
                </td>
                <td class="r">
                    @Formater.FormatNumber20(totalATotal, Formater.CULT_NAME_ENG)
                </td>
                <td class="r">
                    @Formater.FormatNumber20(totalUpline, Formater.CULT_NAME_ENG)
                </td>
            </tr>
        </tfoot>
    }
    else
    {
        @RazorHelper.ShowNoInfo(11)
    }
</table>
@section scripts
{
    <script src="~/_GlobalResources/Js/noty/jquery.noty.min.js" type="text/javascript"></script>
    <script src="~/Views/Reports/Resources/WinLoss.js" type="text/javascript"></script>
    <script type="text/javascript">
        var LANGUAGES = function () {
            return {
                MessageValidateDate: "@Apollo.Age.Resources.LangMsg.ValidateFromToDate"
            };
        } ();
    </script>
}