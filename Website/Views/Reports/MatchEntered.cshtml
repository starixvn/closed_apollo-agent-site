@using Apollo.Age.Reports.ViewModels

@{
	ViewBag.Title = Resources.Lang.agentwinloss;
	Layout = "~/Views/Reports/Shared/_Layout.cshtml";
}

@model List<MatchEnteredViewModel>

<div id="box_header">
	<div class="row">
		@{
			var maxDate = DateTime.Now;
			var minDate = maxDate.AddDays(1 - maxDate.Day).AddMonths(-3);
		}
		<div class="cell">
			<div class="label">
				<label for="dateFrom"> @Resources.Lang.from </label>       
			</div>
			<div class="editor">
			   @Html.DatePicker("FromDate", maxDate, minDate, maxDate)
               <img src="~/_GlobalResources/Css/img/cal/calendar_10.png" class="img-calendar">
			</div>
		</div>
		<div class="cell">
			<div class="label">
			   <label for="dateFrom"> @Resources.Lang.to </label>   
			</div>
			<div class="editor">
				@Html.DatePicker("ToDate", maxDate, minDate, maxDate)
                <img src="~/_GlobalResources/Css/img/cal/calendar_10.png" class="img-calendar">
			</div>
		</div>
		<div class="cell">
			<div class="editor">
				<input id="btnSubmit" class="btn" type="button" value="@Resources.Lang.Generate" />
			</div>
		</div>
	</div>
</div>

<table class="tblRpt" style="width:auto; min-width: 700px;">
    <thead>
        <tr>
            <td rowspan="2">
                @Resources.Lang.Sports 
            </td>
            <td colspan="2">
                @Formater.ShortDateFormat(DateTime.Now.AddDays(-1))
            </td>
            <td colspan="2">
                @Formater.ShortDateFormat(DateTime.Now)
            </td>
        </tr>
        <tr>
            <td style="width:120px;">
                @Resources.Lang.entered
            </td>
            <td style="width:120px;">
                @Resources.Lang.nonentered
            </td>
            <td style="width:120px;">
                @Resources.Lang.entered
            </td>
            <td style="width:120px;">
                @Resources.Lang.nonentered
            </td>
        </tr>
    </thead>
    <tbody>
        @if (Model != null && Model.Any())
        {
            int i = 1;
            string rowClass = string.Empty;
            
            foreach (var item in Model)
            {
                rowClass = i++ % 2 == 0 ? string.Empty : "class='alt'";
                <tr @Html.Raw(rowClass)>
                    <td>
                        @item.SportTypeName
                    </td>
                    <td class="fcnum r">
                        @item.YesterdayEntered
                    </td>
                    <td class="fcnum r">
                        @item.YesterdayNonEntered
                    </td>
                    <td class="fcnum r">
                        @item.TodayEntered
                    </td>
                    <td class="fcnum r">
                        @item.TodayNonEntered
                    </td>
                </tr>
            }
        }
        else
        {
            @RazorHelper.ShowNoInfo(5) 
        }
    </tbody>
</table>

@RazorHelper.PageInfo(
	@<div style="width: 600px; height: 600px">
		@ViewBag.Title INFO
	</div>
	, title: ViewBag.Title as string
	, tipTitle: "Click to view Agent WinLoss INFO"
)

@section scripts
{
	<script src="~/_GlobalResources/Js/noty/jquery.noty.min.js" type="text/javascript"></script>
	<script src="~/Views/Reports/Resources/WinLoss.js" type="text/javascript"></script>
	<script type="text/javascript">
		var LANGUAGES = function () {
			return {
				MessageValidateDate: "@Resources.LangMsg.ValidateFromToDate"
			};
		} ();
	</script>
}