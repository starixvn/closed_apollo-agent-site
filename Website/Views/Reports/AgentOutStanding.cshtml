@using Apollo.Age.Reports.ViewModels;
@using Fanex.Age.Utility;
@model IEnumerable<OutstandingViewModel>
<table id="tbl-rpt" class="tblRpt" cellspacing="1" cellpadding="0" style="width: 100%;
    display: table">
    <thead>
        <tr>
            <td rowspan="2" class="RptHeader02">
                @Resources.Lang.agent
            </td>
            <td colspan="2" class="RptHeader02">
                @Resources.Lang.sportBook
            </td>
            <td colspan="2" class="RptHeader02">
                @Resources.Lang.numbergame
            </td>
        </tr>
        <tr>
            <td class="RptHeader02">
                @Resources.Lang.outstanding
            </td>
            <td class="RptHeader02">
                @Resources.Lang.ShareAmount
            </td>
            <td class="RptHeader02">
                @Resources.Lang.outstanding
            </td>
            <td class="RptHeader02">
                @Resources.Lang.ShareAmount
            </td>
        </tr>
    </thead>
    @if (Model != null && Model.Any())
    {

        foreach (OutstandingViewModel item in Model)
        {
        <tr>
            <td>
                <a href="#" onclick="REPORTS.viewAgent(@item.AgentId);">
                    @item.UserName
                </a>
            </td>
            <td class="r">
                @Formater.FormatNumber20(item.Outstanding, "en-US")
            </td>
            <td class="r">
                @Formater.FormatNumber20(item.ShareAmount, "en-US")
            </td>
            <td class="r">
                @Formater.FormatNumber20(item.GameOutstanding, "en-US")
            </td>
            <td class="r">
                @Formater.FormatNumber20(item.GameShareAmount, "en-US")
            </td>
        </tr>
        }

        <tr class="RptFooter">
            <td>
                @Resources.Lang.total
            </td>
            <td class="r">
                @Formater.FormatNumber20(Model.Sum(x => x.Outstanding), "en-US")
            </td>
            <td class="r">
                @Formater.FormatNumber20(Model.Sum(x => x.ShareAmount), "en-US")
            </td>
            <td class="r">
                @Formater.FormatNumber20(Model.Sum(x => x.GameOutstanding), "en-US")
            </td>
            <td class="r">
                @Formater.FormatNumber20(Model.Sum(x => x.GameShareAmount), "en-US")
            </td>
        </tr>
    }
    else
    {
        <tr>
            <td colspan="5">@Resources.Lang.noInfo
            </td>
        </tr>
    }
</table>