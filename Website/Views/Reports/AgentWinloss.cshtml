@using Apollo.Age.Reports.ViewModels
@using Fanex.Age.Utility
@{
    ViewBag.Title = Resources.Lang.agentwinloss;
    Layout = "~/Views/Reports/Shared/_Layout.cshtml";
}

@model AgentWinLossViewModel

@if (Model.DownlinePath != null)
{
    if (Model.DownlinePath.Any())
    {
        @RazorHelper.Navigation(Model.DownlinePath)
    }
}
<div id="box_header">
    <div class="filter-submit">
         <div class="inline-control">
            @Html.LabelFor(m => m.FromDate, @Resources.Lang.from)
            @Html.DatePickerFor(m => m.FromDate)
         </div> 
         <div class="inline-control">
            @Html.LabelFor(m => m.ToDate, @Resources.Lang.to)
            @Html.DatePickerFor(m => m.ToDate)
         </div>       
         <input id="btnSubmit" class="btn" type="button" value="@Resources.Lang.Generate" />
    </div>
</div>

<table class="tblRpt">
@if (Model.IsSuper)
{
    <thead>
        <tr>
            <th rowspan="2">
                @Resources.Lang.AgentLevel1
            </th>
            <th rowspan="2">
                @Resources.Lang.lblSoccerPT
            </th>
            <th colspan="2">
                @Resources.Lang.turnover
            </th>
            <th colspan="3">
                @Resources.Lang.company
            </th>
        </tr>
        <tr>
            <th>
                @Resources.Lang.total
            </th>
            <th>
                @Resources.Lang.Actual
            </th>
            <th>
                @Resources.Lang.lblWinLoss
            </th>
            <th>
                @Resources.Lang.lblComm
            </th>
            <th>
                @Resources.Lang.total
            </th>
        </tr>
    </thead>
    <tbody>
        @if (Model.AgentWinLossList != null && Model.AgentWinLossList.Any())
        {
            var list = Model.AgentWinLossList;
            foreach (var item in list)
            {
                <tr>
                    <td>
                        <a href="~/Reports/AgentWinLoss?id=@item.AgentId&name=@item.AgentName&fromDate=@Model.FromDate&toDate=@Model.ToDate">
                            @item.AgentName
                        </a>
                    </td>
                    <td class="r">
                        @item.SoccerShare
                    </td>
                    <td class="r">
                        @RazorHelper.FormatNumber(item.Turnover, numDecimals: 2, showZero: true)
                    </td>
                    <td class="r">
                        @RazorHelper.FormatNumber(item.ActualTO, numDecimals: 2, showZero: true)
                    </td>
                    <td class="r">
                        @RazorHelper.FormatNumber(item.AWinLoss, numDecimals: 2, showZero: true)
                    </td>
                    <td class="r">
                        @RazorHelper.FormatNumber(item.AComm, numDecimals: 2, showZero: true)
                    </td>
                    <td class="r bold">
                        @RazorHelper.FormatNumber(item.ATotal, numDecimals: 2, showZero: true)
                    </td>
                </tr>
            }
        }
        else
        {
            @RazorHelper.ShowNoInfo(7) 
        }
    </tbody>
}
else
{
    <thead>
        <tr>
            <th rowspan="2">
            </th>
            <th rowspan="2">
                @Resources.Lang.lblSoccerPT
            </th>
            <th colspan="2">
                @Resources.Lang.turnover
            </th>
            <th rowspan="2">
                @Resources.Lang.GrossTotal
            </th>
            <th colspan="3">
                @Model.AgentName
            </th>
            <th rowspan="2">
                @Resources.Lang.UplineTotal
            </th>
        </tr>
        <tr>
            <th>
                @Resources.Lang.total
            </th>
            <th>
                @Resources.Lang.Actual
            </th>
            <th>
                @Resources.Lang.lblWinLoss
            </th>
            <th>
                @Resources.Lang.lblComm
            </th>
            <th>
                @Resources.Lang.total
            </th>
        </tr>
    </thead>
    
    if(Model.AgentWinLossList != null && Model.AgentWinLossList.Any())
    {
        var list = Model.AgentWinLossList;
        decimal totalTurnover = 0;
        decimal totalActual = 0;
        decimal totalGross = 0;
        decimal totalAWinLoss = 0;
        decimal totalAComm = 0;
        decimal totalATotal = 0;
        decimal totalUpline = 0;
            
        <tbody>
        @foreach (var item in list)
        {
            totalTurnover += item.Turnover;
            totalActual += item.ActualTO;
            totalGross += item.GrossTotal;
            totalAWinLoss += item.AWinLoss;
            totalAComm += item.AComm;
            totalATotal += item.ATotal;
            totalUpline += item.UplineTotal;
                
            <tr>
                @if (item.IsAgent)
                {
                    <td>
                        <a href="~/Reports/AgentWinLoss?id=@item.AgentId&name=@item.AgentName&fromDate=@Formater.ShortDateFormat(Model.FromDate)&toDate=@Formater.ShortDateFormat(Model.ToDate)">
                            @item.AgentName
                        </a>
                    </td>
                }
                else
                {
                    <td>
                        <a href="~/Reports/MemberWinLoss?agentId=@Model.AgentId&agentName=@Model.AgentName&fromDate=@Formater.ShortDateFormat(Model.FromDate)&toDate=@Formater.ShortDateFormat(Model.ToDate)">
                            @Resources.Lang.lblMemberWinLoss
                        </a>
                    </td>
                }
                <td class="r">
                    @item.SoccerShare
                </td>
                <td class="r">
                    @RazorHelper.FormatNumber(item.Turnover, numDecimals: 2, showZero: true)
                </td>
                <td class="r">
                    @RazorHelper.FormatNumber(item.ActualTO, numDecimals: 2, showZero: true)
                </td>
                <td class="r bold">
                    @RazorHelper.FormatNumber(item.GrossTotal, numDecimals: 2, showZero: true)
                </td>
                <td class="r">
                    @RazorHelper.FormatNumber(item.AWinLoss, numDecimals: 2, showZero: true)
                </td>
                <td class="r">
                    @RazorHelper.FormatNumber(item.AComm, numDecimals: 2, showZero: true)
                </td>
                <td class="r bold">
                    @RazorHelper.FormatNumber(item.ATotal, numDecimals: 2, showZero: true)
                </td>
                <td class="r bold">
                    @RazorHelper.FormatNumber(item.UplineTotal, numDecimals: 2, showZero: true)
                </td>
            </tr>
        }
        </tbody>
        <tfoot>
            <tr class="total">
                <td> 
                    @Resources.Lang.total 
                </td>
                <td>
                </td>
                <td class="r">
                    @RazorHelper.FormatNumber(totalTurnover, numDecimals: 2, showZero: true)
                </td>
                <td class="r">
                    @RazorHelper.FormatNumber(totalActual, numDecimals: 2, showZero: true)
                </td>
                <td class="r">
                    @RazorHelper.FormatNumber(totalGross, numDecimals: 2, showZero: true)
                </td>
                <td class="r">
                    @RazorHelper.FormatNumber(totalAWinLoss, numDecimals: 2, showZero: true)
                </td>
                <td class="r">
                    @RazorHelper.FormatNumber(totalAComm, numDecimals: 2, showZero: true)
                </td>
                <td class="r">
                    @RazorHelper.FormatNumber(totalATotal, numDecimals: 2, showZero: true)
                </td>
                <td class="r">
                    @RazorHelper.FormatNumber(totalUpline, numDecimals: 2, showZero: true)
                </td>
            </tr>
        </tfoot>
    }
    else
    {
        @RazorHelper.ShowNoInfo(9)
    }
}

</table>

@section scripts
{
    <script src="~/Views/Reports/Resources/WinLoss.js" type="text/javascript"></script>
}