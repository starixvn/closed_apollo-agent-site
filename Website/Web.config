<?xml version="1.0"?>

<configuration>
    <configSections>
        <section name="Fanex.Data.DbSettingProvider" type="Fanex.Data.Configuration.DbSettingProviderConfigurationSection, Fanex.Data"/>
        <section name="Fanex.Logging" type="Fanex.Logging.Configuration.LoggingSettings, Fanex.Logging"/>
        <section name="dotless" type="dotless.Core.configuration.DotlessConfigurationSectionHandler, dotless.Core"/>
        <section name="Apollo.Age.OAuthSettings" type="Apollo.Age.Integration.Configurations.OAuthSettings, Apollo.Age.Integration" />
    </configSections>
    <Fanex.Data.DbSettingProvider default="XmlDbSettingProvider">
        <providers>
            <add name="XmlDbSettingProvider" type="Fanex.Data.Configuration.XmlDbSettingProvider, Fanex.Data" resourcePath="~/App_Data/SpNames.xml" enableWatching="1"/>
        </providers>
    </Fanex.Data.DbSettingProvider>
    <Fanex.Logging msmqPath="FormatName:DIRECT=TCP:10.18.200.209\private$\entlib" defaultCategory="Apollo-Agent-Local"/>
    <Apollo.Age.OAuthSettings
        AppId = "sdyhrtdbHf73FdewK9"
        AppSecret = "hryfheb7Bjdwd9253Ndyu2NbBhd"
        AuthorizeUrl= "http://oauth.acsdev.net/scoauth/oauth/authorize"
        TokenUrl = "http://oauth.acsdev.net/scoauth/oauth/token"
      RedirectUri = "http://localhost/oauth/getcode"
        TgpScriptSrc= "http://demo.acsdev.net/partner/Content/tgp_auth-0.0.2.js" />

    <startup>

        <supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.0"/>
    </startup>
    <appSettings file="Web.AppSettings.config">

        <!--MVC-->
        <add key="webpages:Version" value="2.0.0.0"/>
        <add key="ClientValidationEnabled" value="true"/>
        <add key="UnobtrusiveJavaScriptEnabled" value="true"/>
        <add key="PreserveLoginUrl" value="true"/>
        <!--MVC-->
        <add key="webpages:Enabled" value="true"/>
    </appSettings>
    <connectionStrings configSource="Web.ConnectionString.config"/>
    <system.web>
        <machineKey validationKey="DBD341D2E939399A19F6A977A91447BB784B473FD8EAFC272440BA1BE85289C39F681921F05F8DC08E452A7292F986B311ADADD23C7D3DE0B6A0999E0B4D792C" decryptionKey="A6925D7BFBEAD2B3FF1D5C54F862447209527FD7DD70B043AEB4CEBCB0BBF7E4" validation="SHA1" decryption="AES"/>
        <httpRuntime executionTimeout="600" maxRequestLength="2000000000" maxUrlLength="200" maxQueryStringLength="2097151" requestValidationMode="2.0" requestPathInvalidCharacters=""/>
        <compilation debug="true" targetFramework="4.0">
            <assemblies>
                <add assembly="System.Data.Entity, Version=4.0.0.0, Culture=neutral, PublicKeyToken=B77A5C561934E089"/>
                <add assembly="System.Web.DataVisualization, Version=4.0.0.0, Culture=neutral, PublicKeyToken=31BF3856AD364E35"/>
                <add assembly="System.Windows.Forms, Version=4.0.0.0, Culture=neutral, PublicKeyToken=B77A5C561934E089"/>
                <!--MVC-->
                <add assembly="System.Web.Abstractions, Version=4.0.0.0, Culture=neutral, PublicKeyToken=31BF3856AD364E35"/>
                <add assembly="System.Web.Helpers, Version=2.0.0.0, Culture=neutral, PublicKeyToken=31BF3856AD364E35"/>
                <add assembly="System.Web.Routing, Version=4.0.0.0, Culture=neutral, PublicKeyToken=31BF3856AD364E35"/>
                <add assembly="System.Web.Mvc, Version=4.0.0.0, Culture=neutral, PublicKeyToken=31BF3856AD364E35"/>
                <add assembly="System.Web.WebPages, Version=2.0.0.0, Culture=neutral, PublicKeyToken=31BF3856AD364E35"/>
                <add assembly="System.Web.Razor, Version=2.0.0.0, Culture=neutral, PublicKeyToken=31BF3856AD364E35"/>
                <!--MVC-->
            </assemblies>
        </compilation>
        <authentication mode="Forms">
            <!--<forms loginUrl="~/_Authorization/SignIn.aspx" path="/" defaultUrl="~/Index.aspx"
             cookieless="UseDeviceProfile" name=".AGENTFORMSAUTH" protection="All"/>-->
            <forms loginUrl="~/Auth/SignIn" path="/" defaultUrl="~/Index.aspx"
                 cookieless="UseDeviceProfile" name=".AGENTFORMSAUTH" protection="All"/>
        </authentication>
        <authorization>
            <deny users="?"/>
            <allow users="*"/>
        </authorization>
        <customErrors mode="Off" defaultRedirect="~/Error.aspx"/>
        <sessionState mode="StateServer" timeout="120" cookieless="false"/>
        <globalization fileEncoding="utf-8" requestEncoding="utf-8" responseEncoding="utf-8"/>
        <trace enabled="false" localOnly="false" traceMode="SortByTime"/>
        <httpHandlers>
            <add path="*.less" verb="GET" type="dotless.Core.LessCssHttpHandler, dotless.Core"/>
        </httpHandlers>
        <pages validateRequest="false" controlRenderingCompatibilityVersion="4.0" clientIDMode="AutoID">
            <namespaces>
                <add namespace="System.Web.Helpers"/>
                <add namespace="System.Web.Mvc"/>
                <add namespace="System.Web.Mvc.Ajax"/>
                <add namespace="System.Web.Mvc.Html"/>
                <add namespace="System.Web.Routing"/>
                <add namespace="System.Web.WebPages"/>
            </namespaces>
        </pages>
    </system.web>

  <location path="_Authorization/Handlers/SignOut.ashx">
        <system.web>
            <authorization>
                <allow users="*"/>
            </authorization>
        </system.web>
    </location>
  <location path="sso.aspx">
        <system.web>
            <authorization>
                <allow users="*"/>
            </authorization>
        </system.web>
    </location>
  <location path="oauth/index">
        <system.web>
            <authorization>
                <allow users="*"/>
            </authorization>
        </system.web>
    </location>
  <location path="oauth/getcode">
        <system.web>
            <authorization>
                <allow users="*"/>
            </authorization>
        </system.web>
    </location>
    <location path="_Authorization/SignIn.aspx">
        <system.web>
            <authorization>
                <allow users="*"/>
            </authorization>
        </system.web>
    </location>
    <location path="_Authorization/Login.aspx">
        <system.web>
            <authorization>
                <allow users="*"/>
            </authorization>
        </system.web>
    </location>
    <location path="_Authorization/Resources">
        <system.web>
            <authorization>
                <allow users="*"/>
            </authorization>
        </system.web>
    </location>
    <location path="_GlobalResources">
        <system.web>
            <authorization>
                <allow users="*"/>
            </authorization>
        </system.web>
    </location>
    <system.webServer>
        <validation validateIntegratedModeConfiguration="false"/>
        <modules>
            <add name="TplCore" type="TplCore.Web.HttpHeaderModule"/>
        </modules>
        <security>
            <requestFiltering>
                <requestLimits maxAllowedContentLength="30000000" maxUrl="260" maxQueryString="30000000"/>
            </requestFiltering>
        </security>
        <!--<defaultDocument>
      <files>
        <add value="index.aspx" />
      </files>
    </defaultDocument>-->
        <handlers>
            <add name="dotless" path="*.less" verb="GET" type="dotless.Core.LessCssHttpHandler,dotless.Core" resourceType="File" preCondition=""/>
            <remove name="ExtensionlessUrlHandler-ISAPI-4.0_32bit"/>
            <remove name="ExtensionlessUrlHandler-ISAPI-4.0_64bit"/>
            <remove name="ExtensionlessUrlHandler-Integrated-4.0"/>
            <add name="ExtensionlessUrlHandler-ISAPI-4.0_32bit" path="*." verb="GET,HEAD,POST,DEBUG,PUT,DELETE,PATCH,OPTIONS" modules="IsapiModule" scriptProcessor="%windir%\Microsoft.NET\Framework\v4.0.30319\aspnet_isapi.dll" preCondition="classicMode,runtimeVersionv4.0,bitness32" responseBufferLimit="0"/>
            <add name="ExtensionlessUrlHandler-ISAPI-4.0_64bit" path="*." verb="GET,HEAD,POST,DEBUG,PUT,DELETE,PATCH,OPTIONS" modules="IsapiModule" scriptProcessor="%windir%\Microsoft.NET\Framework64\v4.0.30319\aspnet_isapi.dll" preCondition="classicMode,runtimeVersionv4.0,bitness64" responseBufferLimit="0"/>
            <add name="ExtensionlessUrlHandler-Integrated-4.0" path="*." verb="GET,HEAD,POST,DEBUG,PUT,DELETE,PATCH,OPTIONS" type="System.Web.Handlers.TransferRequestHandler" preCondition="integratedMode,runtimeVersionv4.0"/>
        </handlers>
    </system.webServer>
    <dotless minifyCss="false" cache="true" web="false"/>
    <runtime>
        <assemblyBinding xmlns="urn:schemas-microsoft-com:asm.v1">
            <dependentAssembly>
                <assemblyIdentity name="NPOI" publicKeyToken="0df73ec7942b34e1" culture="neutral"/>
                <bindingRedirect oldVersion="0.0.0.0-1.2.4.0" newVersion="1.2.5.0"/>
            </dependentAssembly>
        </assemblyBinding>
    </runtime>
</configuration>