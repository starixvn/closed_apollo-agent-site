namespace Fanex.Age.UI.Reports.Monitor
{
    using System;
    using System.Collections.Generic;
    using System.Data;
    using System.Text;
    using System.Web;
    using System.Web.UI;
    using Fanex.BetList.Age.BetListHTMLBuilderExt;
    using Fanex.BetList.Age.DTO;
    using Fanex.BetList.Age.ExtTemplate;
    using Fanex.BetList.Core.Builder;
    using Fanex.BetList.Core.Entities;
    using Fanex.BetList.Core.Factories;
    using Fanex.BetList.Core.TicketHelper;
    using Sunplus.Agent.Model.BL.Forecast;
    using Sunplus.Agent.Model.BL.Reports;
    using Sunplus.Agent.Model.Entities;

    public partial class MonitorBetList_Page : Reports_Page
    {
        private int betTypeGroup = 0, sportTypeGroup = 0, limitRowCount = 10;
        private long transId = 0;

        public string TransIdCookieKey
        {
            get
            {
                string name = string.Join(null, new string[] { CurrentUserSession.CustId.ToString(), "lastTransId", CurrentUserSession.UserId.ToString() });
                return Sunplus.Agent.Utilities.Encryption.CfsEnCode(name, 6);
            }
        }

        public override void RenderContent(HtmlTextWriter writer)
        {
            DataTable bets = View as DataTable;
            Header1_Template betlistHeader = new Header1_Template();
            betlistHeader.Super.Hide();
            betlistHeader.Master.Hide();
            betlistHeader.Agent.Hide();
            betlistHeader.Winloss.Hide();

            StringBuilder content = new StringBuilder();
            Fanex.BetList.Age.ExtTemplate.OpenBetList_Template betlistOpenTag = new Fanex.BetList.Age.ExtTemplate.OpenBetList_Template();

            content.Append(betlistOpenTag);
            content.Append(betlistHeader);
            content.Append("<tbody>");            

            bool isShowScoremap = true;
            bool isAdminCanViewVNIP = UserSession.Current.IsAdminCanViewVNIP;

            ITicketHelper ticketHelper = new TicketHelper();
            BetListHTMLFactory factory = new BetListHTMLFactory();
            BetListHTMLBuilder builder = factory.CreateBuilder();

            ForecastBO bo = new ForecastBO(UserSession.Current.NetSessionId);
            List<int> lstScoremap = bo.GetListBetTypeScoreMap();

            IList<ITicket> lastBetTickets = TicketTransformer.Transform(bets);
            bets.Dispose();

            int index = 0;
            GetCachePropertyById funcGetOddsTypeName = CacheRef.GetOddsTypeName;

            foreach (ITicket ticket in lastBetTickets)
            {
                if (lstScoremap.Contains(ticket.BetTypeId))
                {
                    isShowScoremap = true;
                }
                else
                {
                    isShowScoremap = false;
                }

                index++;
                ticketHelper.Index = index;

                builder.Append(string.Format("<tr id='r{0}'>", ticket.TransId))
                           .AddNo(index, "<td class='w-order'>", "</td>")
                           .AddMember(ticket, "<td class='c'>", "</td>")
                           .AddTrans(ticket, "<td class='c nonbreak'>", "</td>")
                           .AddChoice(ticket, ticketHelper, null, "<td class='r bl_evt'><div>", "</div></td>", isShowScoremap)
                           .AddOdds(ticket, null, "<td class='bl_underdog'>", "</td>", funcGetOddsTypeName)
                           .AddStake(ticket, "<td class='bl_underdog'>", "</td>")
                           .AddStatus(ticket, ticketHelper, null, "<td class='c'>", "</td>", isAdminCanViewVNIP);

            }

            content.Append(builder.GetBetList());
            content.Append("</tbody></table>");

            writer.Write(content.ToString());
        }

        public override void ProcessRequest(ref System.Collections.Hashtable p)
        {
            int.TryParse(this.Request["sportTypeGroup"], out this.sportTypeGroup);
            int.TryParse(this.Request["betTypeGroup"], out this.betTypeGroup);
            int.TryParse(this.Request["limitRowCount"], out this.limitRowCount);

            long.TryParse(Request.Cookies[this.TransIdCookieKey] != null ? Request.Cookies[this.TransIdCookieKey].Value : "0", out this.transId);
        }

        public override object InvokeData(System.Collections.Hashtable p)
        {
            ReportsBO report = new ReportsBO(CurrentUserSession.NetSessionId);

            DataTable bets = null;
            try
            {
                bets = report.GetLastBetList(this.sportTypeGroup, this.betTypeGroup, this.transId, this.limitRowCount);
            }
            catch
            {
                throw new HttpException("Our server is too busy at the moment so this function is turned off temporarily. Please try again later and sorry for the inconvenience.");
            }

            int c = bets.Rows.Count;
            if (c > 0)
            {
                this.transId = Convert.ToInt64(bets.Rows[c - 1]["transid"]) - 1; // Get last top rows
            }

            HttpCookie cookie = new HttpCookie(this.TransIdCookieKey, this.transId.ToString());
            Response.Cookies.Set(cookie);

            return bets;
        }
    }
}