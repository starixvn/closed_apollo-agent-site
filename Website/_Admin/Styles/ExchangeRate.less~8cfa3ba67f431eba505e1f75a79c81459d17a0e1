#content_title {
    background-color: #FFEFDE;
}
#content_title .export-excel {
    float: right;
    padding: 0;
}
#content_title .export-excel input[type=image] {
    cursor: pointer;
    outline: none;
    margin-left: 10px;
}
#tbl-rpt tr.even {
    background-color: #FAF9EE;
}
#tbl-rpt tr.odd {
    background-color: #F6F8F9;
}
#tbl-rpt tr.even:hover, #tbl-rpt tr.odd:hover {
    background-color: #FBF0B9;
}
#tbl-rpt td {
    padding: 4px 8px;
}
.btn-edit {
    cursor: pointer;
}

#dialog-edit.loading {
    background: url(img/loading.gif) no-repeat center 2px;
}

#dialog-edit table {
    border-collapse: collapse;
    margin-top: 10px;
}
#dialog-edit table label { cursor: pointer }
#dialog-edit input[type=text],
#dialog-edit input[type=number] {
    width: 80px;
    height: 18px;
    margin-right: 5px;
    padding: 2px;
}
#dialog-edit #editor-desc { width: 160px }
#dialog-edit .submit-area {
    margin-top: 10px;
    padding: 10px 0;
    border-top: 1px solid #ccc;
}

.input-validation-error {
    border: 1px solid red;
}