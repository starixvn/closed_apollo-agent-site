/// <summary>
/// Function key.
/// </summary>
public static class ApolloFunctionKeys
{
<#
    SqlConnection conn = new SqlConnection(connectionString);

    string command = string.Format("SELECT DISTINCT FunctionKey FROM [Function]");

    SqlCommand comm = new SqlCommand(command, conn);

    conn.Open();

    SqlDataReader reader = comm.ExecuteReader();

    while(reader.Read())
    {#>
    public const string <#= reader["FunctionKey"].ToString() #> = "<#= reader["FunctionKey"].ToString() #>";
<#}#>
}
<#  
    reader.Close();
    conn.Close();
#>
