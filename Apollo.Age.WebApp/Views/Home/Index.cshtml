@model ICurrentSession
@{
    ViewBag.Title = "Index";
    string headerClass = string.Empty;
    string menuClass = string.Empty;
    string mainPageClass = string.Empty;

    if (Model != null)
    {
        headerClass = Model.IsInternalSignIn ? "header int" : "header";
        menuClass = Model.IsInternalSignIn ? "menu int" : "menu";
        mainPageClass = Model.IsInternalSignIn ? "mainpage int" : "mainpage";
    }
}

@section css
{
    @Styles.Render("~/css/index")
}
<div class="@headerClass">
    <iframe src="~/Account/TopBar" id="frHeader" name="frHeader" frameborder="0" scrolling="no">
    </iframe>
</div>
<div class="@menuClass">
    @Html.Action("MiniMenu", "Account")
    <iframe id="menu" name="menu"></iframe>
</div>
<div class="@mainPageClass">
    <div id="btn-mini-menu" class="collapse" title="@Apollo.Age.Resources.Lang.Collapse">
    </div>
    <iframe id="main" name="main" frameborder="0"></iframe>
</div>
@section scripts
{
    @Scripts.Render("~/scripts/homejs")
    <script type="text/javascript">
        var LANGUAGES = function () {
            return {
                Collapse: "@Apollo.Age.Resources.Lang.Collapse",
                Expand: "@Apollo.Age.Resources.Lang.Expand"
            };
        } ();
    </script>
}
