@model ICurrentSession
@{
    ViewBag.Title = "Index";

    string headerClass = Model.IsInternalSignIn ? "header int" : "header";
    string menuClass = Model.IsInternalSignIn ? "menu int" : "menu";
    string mainPageClass = Model.IsInternalSignIn ? "mainpage int" : "mainpage";
}
@section css
{
    <link href="~/views/home/resources/index.less" rel="stylesheet" type="text/css" />
}
<div class="@headerClass">
    <iframe src="~/Account/TopBar" id="frHeader" name="frHeader" frameborder="0" scrolling="no"></iframe>
</div>
<div class="@menuClass">
    @Html.Action("MiniMenu", "Account")
    <iframe id="menu" name="menu"></iframe>
</div>
<div class="@mainPageClass">
    <div id="btn-mini-menu" class="collapse" title="@Apollo.Age.Resources.Lang.Collapse"></div>
    <iframe id="main" name="main" frameborder="0">
    </iframe>
</div>
@section scripts
{
    @Scripts.Render("~/scripts/homejs")
    <script type="text/javascript">


        var LANGUAGES = function () {
            return {
                Collapse: "@Apollo.Age.Resources.Lang.Collapse",
                Expand: "@Apollo.Age.Resources.Lang.Expand"
            };
        } ();
    </script>
}
