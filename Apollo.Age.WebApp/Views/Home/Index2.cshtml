@model Dictionary<string, string>
<span>Safe Code: @Fanex.Common.Cryptography.CfsEnCrypt("1234aa")</span>
<table class="tblRpt">
	<thead>
		<tr>
			<th>Key</th>
			<th>English (US)</th>
			<th>Chinese (Traditional)</th>
		</tr>
	</thead>
	<tbody>
	@if (Model != null && Model.Any())
	{
		foreach (var entry in Model)
		{
		<tr>
			<td>@entry.Key</td>
			<td>@entry.Value</td>
			<td></td>
		</tr>
		}
	}
	</tbody>
</table>

@if (Model != null && Model.Any())
{
	<script type="text/javascript">

		alert(@Model.Count());

	</script>
}