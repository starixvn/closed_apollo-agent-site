@{
    ViewBag.Title = "PagerPlugin";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<link href="~/_GlobalResources/Js/Pager/jquery.sbpager.less" rel="stylesheet" type="text/css" />
@Scripts.Render("~/scripts/homejs")
<script src="~/_GlobalResources/Js/Pager/jquery.sbpager.js" type="text/javascript"></script>
<script type="text/javascript">
    $(function () {
        $('#pager').sbPager({
            currentPage:0,
            itemPerPage: 10,
            totalItem: 120,
            //numPageDisplay: 8,
            callback: function (currentPage) {
                alert('page ' + currentPage + ' is clicked');
            }
        });
    });
</script>

<div id="pager" class="sbpager"></div>

