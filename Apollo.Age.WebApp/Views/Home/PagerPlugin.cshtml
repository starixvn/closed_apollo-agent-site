@{
    ViewBag.Title = "PagerPlugin";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<link href="~/_GlobalResources/Js/Pager/jquery.sbpager.less" rel="stylesheet" type="text/css" />
@Scripts.Render("~/scripts/homejs")
<script src="~/_GlobalResources/Js/Pager/jquery.sbpager.js" type="text/javascript"></script>
<script type="text/javascript">
    $(function () {
        $('#pager').sbPager({
            currentPage: 0,
            itemPerPage: 10,
            totalItem: 800,
            //numPageDisplay: 8,
            callback: function (currentPage) {
                alert('page ' + currentPage + ' is clicked');
            }
        });
        $('#btnGetCurrentPage').click(function () {
            alert($('#pager').sbPager("getCurrentPage"));
        });
        $('#btnSetCurrentPage').click(function () {
            $('#pager').sbPager("setCurrentPage", 9);
        });
    });
</script>

<div id="pager" class="sbpager"></div>
<input type="button" value="Get CurrentPage" id="btnGetCurrentPage" />
<input type="button" value="Set CurrentPage" id="btnSetCurrentPage" />
