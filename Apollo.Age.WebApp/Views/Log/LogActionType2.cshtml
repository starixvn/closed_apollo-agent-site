@using Apollo.Age.Account.Core;
@using Fanex.CustSetting.ViewData;
@using Apollo.Age.Resources
@{   
    var list = (List<DiscountModel>)Model;
    var oldGroup = string.IsNullOrWhiteSpace(ViewBag.OldGroup) ? Lang.lblNA : ViewBag.OldGroup;
    var group = ViewBag.Group;
}
@if (!ReferenceEquals(list, null) && list.Any())
{
    if (!string.IsNullOrWhiteSpace(oldGroup) || !string.IsNullOrWhiteSpace(group))
    {
    <table class="tblRpt">
        <tr class="colW bg-green">
            <td class="colW1">
                @Lang.group
            </td>
            <td class="colW1" colspan="2">
                @Lang.membercomm
            </td>
        </tr>
        <tr>
            <td class="colW2" rowspan="3">
                @if (oldGroup != group)
                { 
                    <span class="valuechanged">@group</span>
                    <div class="line">
                    </div>
                    <span class="valueold">@oldGroup</span>
                  
                }
                else
                { 
                    <span class="valueold">@oldGroup</span>
                }
            </td>
            <td class="colW">
                @Lang.lblAsianHDC_OU_OE (%)
            </td>
            <td class="colW2 no-border-right">
                @foreach (var item in list)
                {
                    if (item.BetType == (int)BetTypes.Handicap)
                    {
                    @ToString(item.OldGroupA, item.GroupA);
                    }
                }
            </td>
        </tr>
        <tr>
            <td class="colW">
                @Lang.lbl1x2Comm (%)
            </td>
            <td class="colW2 no-border-right">
                @foreach (var item in list)
                {
                    if (item.BetType == (int)BetTypes.FT_1X2)
                    {
                    @ToString(item.OldGroupA, item.GroupA);
                    }
                }
            </td>
        </tr>
        <tr>
            <td class="colW">
                @Lang.lblOtherComm (%)
            </td>
            <td class="colW2 no-border-right">
                @foreach (var item in list)
                {
                    if (item.BetType == (int)BetTypes.Correct_Score)
                    {
                    @ToString(item.OldGroupA, item.GroupA);
                    }
                }
            </td>
        </tr>
    </table>
    }
    else
    {

        var groupNormal = new DiscountModel();
        var group1x2 = new DiscountModel();
        var groupOthers = new DiscountModel();

        foreach (var item in list)
        {
            switch (item.BetType)
            {
                case (int)BetTypes.Handicap:
                    groupNormal = item;
                    break;
                case (int)BetTypes.Correct_Score:
                    groupOthers = item;
                    break;
                case (int)BetTypes.FT_1X2:
                    group1x2 = item;
                    break;
            }
        }
    
    <table class="tblRpt">
        <tr class="no-border-top">
            <td class="colW">
                @Lang.lblGroupa (%)
            </td>
            <td class="colW2">
                @ToString(groupNormal.OldGroupA, groupNormal.GroupA)
            </td>
            <td class="colW3 left-text">
                @Lang.lblGroupc (%)
            </td>
            <td class="colW2">
                @ToString(groupNormal.OldGroupC, groupNormal.GroupC)
            </td>
            <td class="colW2 left-text">
                @Lang.lbl1x2Comm (%)
            </td>
            <td class="colW2 no-border-right">
                @ToString(group1x2.OldGroupA, group1x2.GroupA)
            </td>
        </tr>
        <tr class="have-border-bottom">
            <td class="colW3 left-text">
                @Lang.lblGroupb (%)
            </td>
            <td class="colW2">
                @ToString(groupNormal.OldGroupB, groupNormal.GroupB)
            </td>
            <td class="colW3 left-text">
                @Lang.lblGroupd (%)
            </td>
            <td class="colW2">
                @ToString(groupNormal.OldGroupD, groupNormal.GroupD)
            </td>
            <td class="colW2 left-text">
                @Lang.lblOtherComm (%)
            </td>
            <td class="colW2 no-border-right">
                @ToString(groupOthers.OldGroupA, groupOthers.GroupA)
            </td>
        </tr>
    </table>
    }
}
@helper ToString(decimal? oldValue, decimal newValue)
    {
        string strOld = oldValue != null ? Formater.DecFormat((decimal)oldValue * 100, 2).ToString() : Lang.lblNA;
        string strNew = Formater.DecFormat(newValue * 100, 2).ToString();

        if (oldValue != newValue)
        { 
    <span class="valuechanged" title="@Lang.OldValue : @strOld">@strNew</span>           
    <span>| </span><span class="valueold">@strOld</span>           
        }
        else
        { <span class="valueold">@strOld</span>
        }
}