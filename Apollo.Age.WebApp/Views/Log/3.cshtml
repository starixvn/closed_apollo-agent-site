@using System.Xml.Linq
@using Fanex.CustSetting.Core
@using Apollo.Age.Resources
@{    
    var oldData = Model.OldData;
    var data = Model.Data;
    var xmlBetSetting = _Configuration.BettingLimitSportNameConfig;

    var list = new Dictionary<string, BetSettingModel>();

    if (!string.IsNullOrWhiteSpace(oldData))
    {
        var xmlData = XDocument.Parse(oldData);
        var betSetting = xmlData.Descendants("z");

        foreach (var item in betSetting)
        {
            var model = new BetSettingModel
            {
                SportType = Convert.ToInt32(item.Attribute("s").Value),
                BetType = Convert.ToInt32(item.Attribute("b").Value),
                OldMinBet = Convert.ToDecimal(item.Attribute("mib").Value),
                MinBet = Convert.ToDecimal(item.Attribute("mib").Value),
                OldMaxBet = Convert.ToDecimal(item.Attribute("mab").Value),
                MaxBet = Convert.ToDecimal(item.Attribute("mab").Value),
                OldMaxPerMatch = Convert.ToDecimal(item.Attribute("mam").Value),
                MaxPerMatch = Convert.ToDecimal(item.Attribute("mam").Value)
            };

            string key = string.Format("{0}_{1}", model.SportType.ToString(), model.BetType.ToString());

            list.Add(key, model);
        }
    }

    if (!string.IsNullOrWhiteSpace(data))
    {
        var xmlData = XDocument.Parse(data);
        var betSetting = xmlData.Descendants("z");

        foreach (var item in betSetting)
        {
            var model = new BetSettingModel
            {
                SportType = Convert.ToInt32(item.Attribute("s").Value),
                BetType = Convert.ToInt32(item.Attribute("b").Value),
                MinBet = Convert.ToDecimal(item.Attribute("mib").Value),
                MaxBet = Convert.ToDecimal(item.Attribute("mab").Value),
                MaxPerMatch = Convert.ToDecimal(item.Attribute("mam").Value),
            };

            string key = string.Format("{0}_{1}", model.SportType.ToString(), model.BetType.ToString());

            if (list.ContainsKey(key))
            {
                list[key].MinBet = model.MinBet;
                list[key].MaxBet = model.MaxBet;
                list[key].MaxPerMatch = model.MaxPerMatch;
            }
        }
    }
    
}
@if (!ReferenceEquals(list, null) && list.Any())
{
    var itemBetSetting = xmlBetSetting.Descendants("Name");
    <table class="tblRpt">
        <tr class="no-border-top bg-gray">
            <td class="colW1">
            </td>
            <td class="colW1">
                @Lang.lblMinBet
            </td>
            <td class="colW1">
                @Lang.lblMaxBet
            </td>
            <td class="colW1">
                @Lang.lblMaxPerMatch
            </td>
            <td class="colW1">
            </td>
            <td class="colW1 no-border-right">
            </td>
        </tr>
        @foreach (var itemBet in itemBetSetting)
        {
            var sportId = itemBet.Attribute("sportId").Value;
            var betTypeId = itemBet.Attribute("betTypeId").Value;
            var resourcekey = itemBet.Attribute("resourcekey").Value;
            var key = string.Format("{0}_{1}", sportId, betTypeId);
            var item = list[key];
            <tr>
                <td class="colW">
                    @Html.Resource(resourcekey)
                </td>
                <td class="colW2">
                    @ToString(item.OldMinBet, item.MinBet)
                </td>
                <td class="colW2">
                    @ToString(item.OldMaxBet, item.MaxBet)
                </td>
                <td class="colW2">
                    @ToString(item.OldMaxPerMatch, item.MaxPerMatch)
                </td>
                <td class="colW2">
                </td>
                <td class="colW2 no-border-right">
                </td>
            </tr>
        }
    </table>
}
@helper ToString(decimal oldValue, decimal newValue)
    {
        string strOld = Math.Round(oldValue, 0).ToString("#,#");
        string strNew = Math.Round(newValue, 0).ToString("#,#");

        if (oldValue != newValue)
        { 
    <span class="valuechanged" title="@Lang.OldValue : @strOld">@strNew</span>
    <span>| </span><span class="valueold">@strOld</span>
            
        }
        else
        { <span class="valueold">@strOld</span>
        }            
}