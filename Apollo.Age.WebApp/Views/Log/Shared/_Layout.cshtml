<!DOCTYPE html>
<html lang="en-us">
<head>
	<meta charset="utf-8" />
	<title>@ViewBag.Title</title>
	<meta name="viewport" content="width=device-width" />
	@Styles.Render("~/css/viewlog")
	@RenderSection("head", required: false)
</head>
<body>
	<div id="page_main">
		<div id="header_main">
			@ViewBag.Title
		</div>
		<div id="content_main">
			@RenderBody()
		</div>
	</div>
	@Html.Hidden("ApoRoot", Url.Content("~/")) 
	@Html.Partial("_ApoRes")

	<script type="text/javascript">
		LogOpts = {
			MonthsInYear: [
				"@Lang.January",
				"@Lang.February",
				"@Lang.March",
				"@Lang.April",
				"@Lang.May",
				"@Lang.June",
				"@Lang.July",
				"@Lang.August",
				"@Lang.September",
				"@Lang.October",
				"@Lang.November",
				"@Lang.December"
			]
		};
	</script>

	@Scripts.Render("~/scripts/logjs")
	@RenderSection("foot", required: false)
</body>
</html>
