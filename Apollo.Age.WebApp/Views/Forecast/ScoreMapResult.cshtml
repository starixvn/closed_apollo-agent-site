@using Apollo.Age.Forecast.Models
@{
	Layout = null;
}
@model IEnumerable<ScoreMapMatchResultModel>
@if (Model != null && Model.Any())
{
	foreach (var result in Model)
	{
	<div id="RefreshContent@(result.MatchId)" class="paddingTopMatch clearfix">
		<div class="title-scoremap">
			<span class="collapse-expand lnkGroup span-expand">
				@result.HomeName -vs- @result.AwayName
			</span>
			<span title="@Apollo.Age.Resources.Lang.refresh" class="refresh-scoremap lnkRefresh refresh-button"
				id="lnkRefresh@(result.MatchId)" match-id="@(result.MatchId)"></span>
		</div>
		<div class="scoreMap" id="scoreMap@(result.MatchId)">
			<table class="tblRpt" id="tblSM@(result.MatchId)">
				<thead>
					<tr class="vsmHomeWay" style="text-align: center">
						<th rowspan="2" class="smTitle">
							@Apollo.Age.Resources.Lang.away
						</th>
						<th colspan="7" class="smTitle">
							@Apollo.Age.Resources.Lang.home
						</th>
					</tr>
					<tr class="vsm">
						<th style="width: 13%" class="hover-0">
							0
						</th>
						<th style="width: 13%" class="hover-1">
							1
						</th>
						<th style="width: 13%" class="hover-2">
							2
						</th>
						<th style="width: 13%" class="hover-3">
							3
						</th>
						<th style="width: 13%" class="hover-4">
							4
						</th>
						<th style="width: 13%" class="hover-5">
							5
						</th>
						<th style="width: 13%" class="hover-6">
							6
						</th>
					</tr>
				</thead>
				<tbody>
				@if (result.HasData)
				{
					var total = result.ScoreMatrix.GetLength(1);
					string rowClass = string.Empty;

					for (int i = 0; i < total; i++)
					{
						rowClass = i % 2 == 0 ? "alt" : string.Empty;

					<tr class="vScoreMap @rowClass">
						<td class="vsm">@(i)</td>
						@for (int j = 0; j < total; j++)
						{
						<td class='csm' class-hover="hover-@(j)">
							@RazorHelper.FormatPositiveNumber(result.ScoreMatrix[i, j], 2, true)
						</td>
						}
					</tr>
					}
				}
				else
				{
					@RazorHelper.ShowNoInfo(colspan: 8)
				}
				</tbody>
			</table>
		</div>
	</div>
	}
}
else
{
	<div id="tblMsgMatch" style="display: block">
		<span id="msgMatchErr" class="msgerr">@Apollo.Age.Resources.Lang.noInfo</span>
	</div>
}