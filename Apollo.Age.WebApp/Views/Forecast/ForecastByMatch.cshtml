@{
    Layout = "~/Views/Forecast/Shared/_Layout.cshtml";
    ViewBag.Title = Apollo.Age.Resources.Lang.lblForecast;
    var currentMainShareHolderId = ViewBag.CurrentMainShareHolderId ?? 0;
}
@section css
{
    <link href="~/Views/Forecast/Resources/FC.less" rel="Stylesheet" type="text/css" />
}
@RazorHelper.RefreshCountDown("ForeCast1X2", 15, 0, "UpdateForecastValue();")
<div id="forecast-body">
</div>
@section scripts {
    <script type="text/javascript">
        var DEFAULT_OBJECT = function(){
            return {
                matchId: @(ViewBag.MatchId),
                betType: @(ViewBag.BetType),
                currentScore: @(ViewBag.CurrentScore),
                leagueName: '@(ViewBag.LeagueName)',
                currentMainShareHolderId: @(currentMainShareHolderId)
            };
        }();
    </script>
    <script src="~/Views/Forecast/Resources/FCByMatch.js" type="text/javascript"></script>
}