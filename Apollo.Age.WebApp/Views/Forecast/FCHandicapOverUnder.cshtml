@using Apollo.Age.Forecast.Models
@{
    Layout = "~/Views/Forecast/Shared/_Layout.cshtml";
    ViewBag.Title = Apollo.Age.Resources.Lang.lblHOUL;

    IEnumerable<LeagueModel> leagues = (IEnumerable<LeagueModel>)ViewBag.Leagues;
    string leagueName = ViewBag.LeagueName;
    var leagueId = ViewBag.LeagueId ?? 0;
    var fcHDPList = (IEnumerable<ForecastHandicapOUModel>)ViewBag.FCHDPList;
}
@section css
{
    <link href="~/views/forecast/resources/fc.less" rel="Stylesheet" type="text/css" />
}
@section refreshcountdown
{
    @RazorHelper.RefreshCountDown("ForeCastHandicapOU", new int[1] { 180 }, "UpdateForecastHDValue();")
}
<div class="box-header selectLeague">
    <div class="row">
        <div class="cell">
            @if (leagues != null && leagues.Any())
            {
                <div class="label">
                    <label for="ddlLeague">@Apollo.Age.Resources.Lang.league</label>
                </div>
                <div class="editor" id="selLeague">
                    <select id='ddlLeague' name='ddlLeague' style="width: 280px">
                        @{
                var selectedString = string.Empty;
                foreach (var league in leagues)
                {
                    if (league.LeagueId == leagueId)
                    {
                        selectedString = "selected='selected'";
                    }
                    else
                    {
                        selectedString = string.Empty;
                    }
                            <option value="@league.LeagueId" @(selectedString) >@league.LeagueName</option>
                }
                        }
                    </select>
                </div>
            }
            else
            {
                <label>
                    @Apollo.Age.Resources.Lang.noInfo</label>
            }
        </div>
    </div>
</div>
@if ((leagues != null && leagues.Any()) || leagueId > 0)
{
    <table class="tblRpt">
        <thead>
            <tr class="RptHeader">
                <td colspan="2">
                    @Apollo.Age.Resources.Lang.homeaway
                </td>
                <td colspan="3">
                    @Apollo.Age.Resources.Lang.lblHandicapFC
                </td>
                <td colspan="3">
                    @Apollo.Age.Resources.Lang.lblOverUnder
                </td>
            </tr>
        </thead>
        <tbody id="forecast-body">
            @Html.Partial("FCHandicapOverUnderMatches", fcHDPList)
        </tbody>
    </table>
}
@section scripts
{
    <script type="text/javascript">
        var DEFAULT_OBJECT = function () {
            return {
                leagueName: '@(leagueName)'
            };
        }();
    </script>
    <script src="~/views/forecast/resources/fchandicapou.js" type="text/javascript"></script>
}