@using Apollo.Age.Forecast.Models
@{
    Layout = "~/Views/Forecast/Shared/_Layout.cshtml";
    ViewBag.Title = Lang.lbl1x2;

    var leagues = (IEnumerable<LeagueModel>)ViewBag.Leagues;
    int matchId = ViewBag.MatchId != null ? (int)ViewBag.MatchId : 0;
    int betType = ViewBag.BetType != null ? (int)ViewBag.BetType : 0;
    string initLeagueName = ViewBag.LeagueName;
    var leagueId = ViewBag.LeagueId ?? 0;
    var fc1X2List = (IEnumerable<Forecast1X2Model>)ViewBag.FC1X2List;
    var isShowRefreshNow = (bool)ViewBag.IsShowRefreshNow;
	var selectedString = string.Empty;
}
@section css
{
    <link href="~/views/forecast/resources/fc.less" rel="Stylesheet" type="text/css" />
}
@section refreshcountdown
{
    @RazorHelper.RefreshCountDown("ForeCast1X2", null, "UpdateForecast1x2Value();", isShowRefreshNow)
}
@if (matchId == 0)
{
    <div class="box-header selectLeague">
        <div class="row">
            <div class="cell">
                @if (leagues != null && leagues.Any())
                {
                    <div class="label">
                        <label for="ddlLeague">@Lang.league</label>
                    </div>
                    <div class="editor">
                        <select id='ddlLeague' name='ddlLeague' style="width: 280px">
                    @foreach (var league in leagues)
                    {
						selectedString = league.LeagueId == leagueId ? "selected='selected'" : string.Empty;
                        <option value="@league.LeagueId" @(selectedString) >@league.LeagueName</option>
                    }
                        </select>
                    </div>
                }
                else
                {
                    <label> @Lang.noInfo </label>
                }
            </div>
        </div>
    </div>
}
@if (matchId != 0 || (leagues != null && leagues.Any()))
{
    <table class="tblRpt fc1x2">
        <thead>
            <tr>
                <th colspan="2">
                    @Lang.homeaway
                </th>
                <th colspan="3">
                    @Lang.lbl1x2
                </th>
            </tr>
        </thead>
        <tbody id="forecast-body">
    @if (matchId == 0)
    {
        @Html.Partial("FC1X2Matches", fc1X2List)
    }
        </tbody>
    </table>
}
@section scripts
{
    <script type="text/javascript">
        var DEFAULT_OBJECT = function(){
            return {
                matchId: @(matchId),
                betType: @(betType),
                initLeagueName: '@(initLeagueName)'
            };
        }();
    </script>
    <script src="~/views/forecast/resources/fc1x2.js" type="text/javascript"></script>
}