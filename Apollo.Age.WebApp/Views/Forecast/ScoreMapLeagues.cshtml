@using Apollo.Age.Forecast.Models
@{
    Layout = null;
    var currentLeagueSelected = (int?)ViewBag.CurrentLeagueId;
}
@model IEnumerable<LeagueModel>
<select id="ddlLeague" name="ddlLeague" style="position: relative;">
@if (Model != null && Model.Any())
{
    foreach (var league in Model)
    {
        <option value="@(league.LeagueId)" 
        @if(currentLeagueSelected != null && currentLeagueSelected.Value == league.LeagueId)
        {
            @:selected="selected"
        }
            >@(league.LeagueName)</option>
    }
}
</select>
