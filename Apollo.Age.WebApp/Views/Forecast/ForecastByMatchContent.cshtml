@using Apollo.Age.Forecast.Models
@using Apollo.Age.Enumerations;
@{
    var oddsByMatch = (MatchOddsModel)ViewBag.TopOddsByMatch ?? new MatchOddsModel();
    var betType = (int)ViewBag.BetType;
    var currentScore = (int)ViewBag.CurrentScore;
    var matchId = (int)ViewBag.MatchId;
    var hasDownlineDetailsPermission = ViewBag.HasDownlineDetailsPermission != null ? (bool)ViewBag.HasDownlineDetailsPermission : false;
    Layout = null;    
}
@model ForecastMatchWinLostModel
@helper RenderTitle(int betType)
    {
        switch (betType)
        {
            case (int)BetTypes.Handicap:
    @(Apollo.Age.Resources.Lang.lblHandicapFC)
break;
            case (int)BetTypes.Over_Under:
    @(Apollo.Age.Resources.Lang.lblOverUnder)
break;
            case (int)BetTypes._1st_Handicap:
    @(Apollo.Age.Resources.Lang.lbl1stHdp)
break;
            case (int)BetTypes._1st_Over_Under:
    @(Apollo.Age.Resources.Lang.lbl1stOU)
break;
        }
}
@helper RenderForecastPoint(int matchId, int betType, int currentScore)
    {
        bool isHDPOr1stHDP = betType == (int)BetTypes.Handicap || betType == (int)BetTypes._1st_Handicap;
        int indexCount = isHDPOr1stHDP ? 11 : 16;
        int endIndex = isHDPOr1stHDP ? currentScore + 5 : 15;
        int selectedIndex = currentScore;
        string boldSpan = "<span style='text-decoration:none;color:#FF0000;font-weight:bold;'>{0}</span>";

        for (int i = 0; i < indexCount; i++)
        {
    <a class="view-other-forecast" bet-type="@betType" forecast-point="@endIndex" href='javascript:void(0);'>
        @if (endIndex == selectedIndex)
        {
            @Html.Raw(string.Format(boldSpan, endIndex))
        }
        else
        {
            @(endIndex)
        }
    </a>
    @:&nbsp;
        endIndex--;
        }
}
@helper RenderToggleLink(int matchId, int betType)
    {
        int toggleBettype = 0;
        string toggleText = string.Empty;

        switch (betType)
        {
            case (int)BetTypes.Handicap:
                toggleBettype = (int)BetTypes.Over_Under;
                toggleText = Apollo.Age.Resources.Lang.lblViewOverUnderForecast;
                break;
            case (int)BetTypes.Over_Under:
                toggleBettype = (int)BetTypes.Handicap;
                toggleText = Apollo.Age.Resources.Lang.lblViewHandicapForecast;
                break;
            case (int)BetTypes._1st_Handicap:
                toggleBettype = (int)BetTypes._1st_Over_Under;
                toggleText = Apollo.Age.Resources.Lang.lblView1stOverUnderForecast;
                break;
            case (int)BetTypes._1st_Over_Under:
                toggleBettype = (int)BetTypes._1st_Handicap;
                toggleText = Apollo.Age.Resources.Lang.lblView1stHandicapForecast;
                break;
        }

    <a toggle-bet-type="@toggleBettype" class="forecast_toggle_link toggle-link"  href='javascript:void(0);'>
        @(toggleText)</a>
}
@helper RenderBetListLink(int matchId, int betType, bool hasDownlineDetailsPermission = true)
    {
        if (Model != null
            && hasDownlineDetailsPermission)
        {
    <a match-id="@matchId" bet-type="@betType" class="forecast_betlist_link view-bet-list" href="javascript:void(0);">
        @Apollo.Age.Resources.Lang.lblBetLists</a>
        }        
}
@helper RenderForecastInfo(int betType, int currentScore)
    {
        int startIndex = betType == (int)BetTypes.Handicap || betType == (int)BetTypes._1st_Handicap ? currentScore - 2 : currentScore;
        if (Model != null)
        {
    <tr class="even_row" align="center">
        <td>
            @(startIndex + 4)
        </td>
        <td>
            @(startIndex + 3)
        </td>
        <td>
            @(startIndex + 2)
        </td>
        <td>
            @(startIndex + 1)
        </td>
        <td>
            @(startIndex)
        </td>
    </tr>
    <tr class="even_row" align="center">
        <td>
            @RazorHelper.FormatPositiveNumber(Model.Value4, numDecimals: 2, showZero: true)
        </td>
        <td>
            @RazorHelper.FormatPositiveNumber(Model.Value3, numDecimals: 2, showZero: true)
        </td>
        <td>
            @RazorHelper.FormatPositiveNumber(Model.Value2, numDecimals: 2, showZero: true)
        </td>
        <td>
            @RazorHelper.FormatPositiveNumber(Model.Value1, numDecimals: 2, showZero: true)
        </td>
        <td>
            @RazorHelper.FormatPositiveNumber(Model.Value0, numDecimals: 2, showZero: true)
        </td>
    </tr>
        }
        else
        {
    <tr class="no_info">
        <td colspan="5">
            @Apollo.Age.Resources.Lang.noInfo
        </td>
    </tr>
        }
}
<table class="tblRpt" cellpadding="0" cellspacing="1" border="0" style="width: 100%;">
    <thead>
        <tr class="RptHeader">
            <th align="center">
                @Apollo.Age.Resources.Lang.homeaway
            </th>
            <th align="center">
                @Apollo.Age.Resources.Lang.lblScore
            </th>
        </tr>
    </thead>
    <tbody>
        <tr class="even_row c">
            <td>
                @oddsByMatch.HomeTeam
                <br />
                @oddsByMatch.AwayTeam
            </td>
            <td>
                @oddsByMatch.LiveHomeScore
                <br />
                @oddsByMatch.LiveAwayScore
            </td>
        </tr>
    </tbody>
</table>
<br />
@{
    <table class="tblRpt default-tbl" cellpadding="0" cellspacing="1" border="0" style="width: 100%;">
        <tr class="even_row" align="center">
            <td bgcolor="#cccccc">
                <b>@RenderTitle(betType)</b>
            </td>
            <td colspan="4">
                @RenderForecastPoint(matchId, betType, currentScore)
            </td>
        </tr>
        @RenderForecastInfo(betType, currentScore)
        <tr class="even_row">
            <td colspan="5">
                <!--BetListLink-->
                @RenderBetListLink(matchId, betType, hasDownlineDetailsPermission)
                <!--/BetListLink-->
                @RenderToggleLink(matchId, betType)
            </td>
        </tr>
    </table>

}
