@{
	Layout = "~/Views/Instruction/Shared/_Layout.cshtml";
}

<div class="instruction-content">
	<p>
		<img src="~/Views/Account/Resources/CustSettingEngine/Images/copyUnChecked.png" alt="" />
		this icon is used to copy the values preset for Share Setting of a popular bet type such as Soccer - Dead Ball/Handicap and apply them to other bet types
	</p>
	<ul>
		<li>% Downline: the maximum share amount which can be given to a main shareholder.</li>
		<li>% Min Downline: the minimum share amount which a main shareholder and its down-line agents must cover.</li>
        <li>[x - y]: input range. If K is the entered amount, then K must be: x &lt;= K &lt;= y.</li>
	</ul>
	<p>
		<span class="note">Note:</span> only allow two numbers after the decimal point. For instance, 10.25 is a valid input, but 10.555 is not.
	</p>
</div>