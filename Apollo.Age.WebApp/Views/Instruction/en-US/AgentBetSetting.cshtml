@{
	Layout = "~/Views/Instruction/Shared/_Layout.cshtml";
}
<div class="instruction-content">
	<p>
		Single Bet Min, Single Bet Max and Single Game for each product (Sport type) are defined here. In Simple mode, settings applied to Soccer will be applied to other products as well.
	</p>
	<ul>
		<li>Single Bet Min: the minimum stake allowed on a bet. ">= X" means Input must be greater than or equal to X.</li>
		<li>Single Bet Max: the maximum stake allowed on a bet. "<= X" means Input must be less than or equal to X.</li>
		<li>Single Game: the maximum stake allowed on a match. "<= X" means Input must be less than or equal to X</li>
	</ul>
	<p>
		<span class="note">Note:</span> decimal numbers are not allowed. For instance, 100.25 is an invalid input.
	</p>
</div>