@{
	Layout = "~/Views/Instruction/Shared/_Layout.cshtml";
}
<div class="instruction-content">
	<p>
		Single Game, Single Bet and Single Bet Min for each product (Sport type) are defined here.<br />
		<img src="~/Views/Account/Resources/CustSettingEngine/Images/copyUnChecked.png" alt="" />
		This icon is used to copy the values set for Bet Setting of Soccer and apply them
		to other sports
	</p>
	<ul>
        <li>Single Game: the maximum stake allowed on a match.</li>
        <li>Single Bet: the maximum stake allowed on a bet.</li>
		<li>Single Bet Min: the minimum stake allowed on a bet.</li>
		
		
	</ul>
	<p>
		<span class="note">Note:</span> decimal numbers are not allowed. For instance, 100.25 is an invalid input.
	</p>
</div>