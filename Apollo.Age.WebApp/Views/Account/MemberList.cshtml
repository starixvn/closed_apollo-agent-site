@using Apollo.Age.Entities;
@{
    ViewBag.Title = Apollo.Age.Resources.Lang.lblPlayerList;
    ViewBag.HeaderTitle = Apollo.Age.Resources.Lang.lblMemberListOf;
    var titleFormat = ViewBag.IsMaster == true ? Apollo.Age.Resources.Lang.lblEditMemberSetting : Apollo.Age.Resources.Lang.lblViewMemberSetting;
    titleFormat = string.Format(titleFormat, string.Empty);
    var agenttitleFormat = ViewBag.IsMaster == true ? Apollo.Age.Resources.Lang.lblEditAgentSetting : Apollo.Age.Resources.Lang.lblViewAgentSetting;
    agenttitleFormat = string.Format(agenttitleFormat, string.Empty);
    Layout = "~/Views/Account/Shared/_LayoutAccountList.cshtml";
}
@model List<Agent>
@section css
{
    <link href="~/_globalresources/js/fanex.grid/fanex.grid.less" rel="stylesheet" type="text/css" />
    <link href="~/_globalresources/js/fanex.grid/fanex.pagination.less" rel="stylesheet"
        type="text/css" />
}
@RazorHelper.Navigation(Model)

<div id="gridId" class="freegrid  content-grid" firstAgentId="@Model.First().Id" agentid="@Model.Last().Id" username="@Model.Last().Username" agentlevel="@Model.Last().Level">
</div>
@section scripts
{
    <script language="javascript" type="text/javascript">
        var DEFAULTS = function () {
            return {
                IsMaster: @(ViewBag.IsMaster ? "true" : "false")
            };
        } ();
        var LANGUAGES = function ($) {
            return {
                Username: "@Apollo.Age.Resources.Lang.enterusername",
                Status: "@Apollo.Age.Resources.Lang.status",
                BetStatus: "@Apollo.Age.Resources.Lang.betstatus",
                Edit: "@(ViewBag.IsMaster ? Apollo.Age.Resources.Lang.edit : Apollo.Age.Resources.Lang.view) ",
                Group: "@Apollo.Age.Resources.Lang.group",
                AgentCommission: "@Apollo.Age.Resources.Lang.AgentCommission",
                MemberCommission: "@Apollo.Age.Resources.Lang.memberCommission",
                SoccerShare: "@Apollo.Age.Resources.Lang.lblSoccerPT",
                OneXTwo: "@Apollo.Age.Resources.Lang.lbl1x2",
                Other: "@Apollo.Age.Resources.Lang.other",
                Stopped: "@Apollo.Age.Resources.Lang.stopped",
                Locked: "@Apollo.Age.Resources.Lang.locked",
                Active: "@Apollo.Age.Resources.Lang.lblActive",
                SoccerDeadballHDPTakenShare: "@Apollo.Age.Resources.Lang.soccerdeadballhdptakenshare",
                EditSetting: "@Apollo.Age.Resources.Lang.lblEditSetting",
                ViewSetting: "@Apollo.Age.Resources.Lang.lblViewSetting",
                PopUpTitle: "@titleFormat",
                PopUpAgentTitle: "@agenttitleFormat",
                AgentList : "@Apollo.Age.Resources.Lang.lblAgentList",
                MemberList : "@Apollo.Age.Resources.Lang.lblPlayerList",
                CLock: "@Apollo.Age.Resources.Lang.lblCLock",
                GoToPage: "@Apollo.Age.Resources.Lang.gotopage",
                Items: "@Apollo.Age.Resources.Lang.Items ",
                Of: "@Apollo.Age.Resources.Lang.of ",
                To: "~",
                Displaying: "@Apollo.Age.Resources.Lang.Displaying ",
                PageSize: "@Apollo.Age.Resources.Lang.pagesize "
            };
        } (jQuery);
    </script>
    <script src="~/_globalresources/js/fanex.grid/moment.min.js" type="text/javascript"></script>
    <script src="~/_globalresources/js/fanex.grid/numeral.js" type="text/javascript"></script>
    <script src="~/_globalresources/js/fanex.grid/fanex.grid.js" type="text/javascript"></script>
    <script src="~/_globalresources/js/fanex.grid/fanex.pagination.js" type="text/javascript"></script>
    <script src="~/views/account/resources/memberlist.js" type="text/javascript"></script>
}