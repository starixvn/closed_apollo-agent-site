@{
    ViewBag.Title = Apollo.Age.Resources.Lang.lblEditSetting + ViewBag.UserName;

    Layout = "~/Views/Account/Shared/_CustSettingLayout.cshtml";
}
<div id="commissionSettingContainer">
</div>
<div id="bettingLimitContainer">
</div>
<div id="ptContainer">
</div>
@section scripts
{
    <script src="~/customersetting/getpositiontaking?targetCustId=@(ViewBag.CustId)&agentLevel=@(ViewBag.AgentLevel)&agentId=@(ViewBag.CurentParentAgentId)" type="text/javascript"></script>
    <script src="~/views/account/resources/editpositiontaking.js" type="text/javascript"></script>
    <script src="~/customersetting/GetCommissionSetting?targetCustId=@(ViewBag.CustId)&agentLevel=@(ViewBag.AgentLevel)&ugroup=@(ViewBag.UserGroup)&agentId=@(ViewBag.CurentParentAgentId)" type="text/javascript"></script>
    <script src="~/views/account/resources/editcommission.js" type="text/javascript"></script>
    <script src="~/customersetting/getbetlimit?targetCustId=@(ViewBag.CustId)&agentLevel=@(ViewBag.AgentLevel)&agentId=@(ViewBag.CurentParentAgentId)" type="text/javascript"></script>
    <script src="~/views/account/resources/editbetLimit.js" type="text/javascript"></script>
    <script src="~/views/account/resources/editsetting.js" type="text/javascript"></script>
}