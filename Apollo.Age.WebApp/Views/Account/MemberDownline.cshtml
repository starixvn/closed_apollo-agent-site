@using Apollo.Age.Web.Pager;
@model IPagedList<Apollo.Age.Entities.Member>
@{
    Layout = "~/Views/Account/Shared/_Layout.cshtml";
    ViewBag.Title = @Lang.memberList;

    var hasDownlineDetailsPermission = ViewBag.HasDownlineDetailsPermission != null ? (bool)ViewBag.HasDownlineDetailsPermission : false;

    var classNameNoPermission = hasDownlineDetailsPermission ? "view-memberinfo" : "";
}
<ul id="members-list">
    @if (Model.Any())
    {
        foreach (var member in Model)
        {            
        <li>
            @if (hasDownlineDetailsPermission)
            { <a class='@classNameNoPermission' href='javascript:;' data-memberid='@member.Id' data-membername='@member.Username' target='menu'>
                @member.Username
            </a>}
            else
            {
                @member.Username
            }</li>
        }
    }
    else
    {
        <li>
            <div class="no-data">@Apollo.Age.Resources.Lang.NoneMember</div>
        </li>
    }
</ul>
<div class="line-pager">
</div>
@if (Model.Any())
{
    <div class="pager">
        @Html.Pager(Model.PageSize, Model.PageNumber, Model.TotalItemCount)
    </div>
}
@section foot {
    <script src="~/views/account/resources/downlineinfo.js" type="text/javascript"></script>
    <script type="text/javascript">
        $(document).ready(function () {
            DOWNLINE.initMemberdownline();
        });
    </script>
}
