<!DOCTYPE html>
<html lang="en-us">
<head>
    <title>@ViewBag.Title</title>
    <link href="~/views/account/resources/loglogin.less" rel="stylesheet" type="text/css" />
    @RenderSection("head", required: false)
</head>
<body>
    <div id="page_main">
        <div id="header_main">
            Login Log
        </div>
        <div id="content_main">
             @RenderBody()
        </div>
    </div>   
    @Html.Hidden("ApoRoot", Url.Content("~/"))
	@Html.Partial("_ApoRes")
    @Scripts.Render("~/scripts/logloginjs")
    @RenderSection("foot", required: false)
</body>
</html>