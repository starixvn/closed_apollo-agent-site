<!DOCTYPE html>
<html lang="en-us">
<head>
    <title>@ViewBag.Title</title>
    @Styles.Render("~/css/log-login")
    @RenderSection("head", required: false)
</head>
<body>
    <div id="page_main">
        <div id="header_main">
            Login Log
        </div>
        <div id="content_main">
            @RenderBody()
        </div>
    </div>
    @Html.Hidden("ApoRoot", Url.Content("~/"))
    @Html.Partial("_ApoRes")
    @Scripts.Render("~/scripts/logloginjs")
    @RenderSection("foot", required: false)
</body>
</html>
