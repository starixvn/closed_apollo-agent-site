@{
    var isShowHeader = ViewBag.IsShowHeader ?? false;
    var isMaster = ViewBag.IsMaster ?? false;
    var isSimpleMode = ViewBag.IsSimpleMode ?? true;
    var fromLeftMenu = ViewBag.FromLeftMenu ?? false;
}
<!DOCTYPE html>
<html lang="en-us">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <title>@ViewBag.Title</title>
    @Styles.Render("~/css/custsettinglayout")
    @RenderSection("css", required: false)
</head>
<body>
    <div id="page_main">
        @if (isShowHeader)
        {
            <div id="header_main" class="
            @if (isMaster)
            {
                @: frozen-header-main
            }">
                @ViewBag.Title
            </div>
        }
        <div id="content_main">
            <div class="setting-mode 
            @if (isMaster)
            {
                if (isShowHeader)
                {
                    @: frozen-mode-no-popup
                }
                else
                {
                    @: frozen-mode
                }
            }
            ">
                <span id="simple-mode" class="deactive-mode">@Apollo.Age.Resources.Lang.simplemode</span>
                | <span class="active-mode" id="advanced-mode">@Apollo.Age.Resources.Lang.lblAdvancedMode</span>
                @if (isMaster)
                {
                    <button id="btnSubmitHeader" class="btn" style="display: none;">
                        @Apollo.Age.Resources.Lang.update</button>
                }
            </div>
            @if (!isMaster)
            {
                <div id="settingContainer">
                    @RenderBody()
                </div>
            }
            else
            {
                
                <div id="settingContainer" class="
                @if (isShowHeader)
                {
                    @: setting-container-frozen-no-popup
                }
                else
                {
                    @: setting-container-frozen
                }
                ">
                    <div class="edit-setting-warning">
                        @Apollo.Age.Resources.Lang.lblWarningEditSetting</div>
                    @RenderBody()
                </div>
                if (ViewBag.IsMaster)
                {
                <div class="btnLeft">
                    <button id="btnSubmitFooter" class="btn">
                        @Apollo.Age.Resources.Lang.update</button>
                </div>
                }
            }
        </div>
    </div>
    <div id="forgery-token-div" style="display: none;">
        @Html.AntiForgeryToken()
    </div>
    @Html.Hidden("ApoRoot", Url.Content("~/"))
    @Html.Partial("_ApoRes")
    @Scripts.Render("~/scripts/custsettingjs")
    <script type="text/javascript">
		var DEFAULT_LAYOUT = function () {
			return {
				isSimpleMode : @(isSimpleMode ? "true" : "false"),
				noChangeMessage: "@(Apollo.Age.Resources.Lang.noChangeToUpdate)",
                fromLeftMenu: @(fromLeftMenu ? "true" : "false")
			};
		}();
		var Language =
		{
			MIN_BET: "@(Apollo.Age.Resources.Lang.lblMinBet)",
			MAX_BET: "@(Apollo.Age.Resources.Lang.lblMaxBet)",
			MAX_PER_MATCH: "@(Apollo.Age.Resources.Lang.lblMaxPerMatch)",
			MAX_PER_BALL: "@(Apollo.Age.Resources.Lang.maxperball)",
			DEAD_BALL: "@(Apollo.Age.Resources.Lang.lblDeadball)",
			LIVE: "@(Apollo.Age.Resources.Lang.lblLive)",
			DEAD_BALL_VN: "@(Apollo.Age.Resources.Lang.lblDeadball)",
			LIVE_VN: "@(Apollo.Age.Resources.Lang.lblLive)",
			MIN_POSITION: "@(Apollo.Age.Resources.Lang.lblMinGivenShare)",
			MAX_POSITION: "@(Apollo.Age.Resources.Lang.lblMaxGivenShare)",
			SIMPLE_MODE_MAX_POSITION: "@(Apollo.Age.Resources.Lang.lblGivenShare)",
			SIMPLE_MODE_PRESET_POSITION: "@(Apollo.Age.Resources.Lang.lblTakenShare)",
			PRESET_POSITION: "@(Apollo.Age.Resources.Lang.lblMaxTakenShare)",
			POSITION_TAKING: "@(Apollo.Age.Resources.Lang.positiontaking)",
			COPY_FROM: "@(Apollo.Age.Resources.Lang.copyFrom)",
			COPY_ALL_OTHER_POSITION_TAKING_FROM: "@(Apollo.Age.Resources.Lang.copyAllPositionTakingFrom)",
			COPY_ALL_POSITION_TAKING_FROM: "@(Apollo.Age.Resources.Lang.copyPositionTakingFrom)",
			COPY_ALL_BETTING_LIMIT_FROM: "@(Apollo.Age.Resources.Lang.copyAllBetSettingFromExcludingNG)",
			COPY_ALL_HINT: "@(Apollo.Age.Resources.Lang.copyAllHint)",
			OTHER_BET_TYPE_OF: "@(Apollo.Age.Resources.Lang.otherBetTypesOf)",
			INCORRECT_MIN_BET: "@(Apollo.Age.Resources.Lang.alertIncorrectMinBet)",
			INCORRECT_MAX_BET: "@(Apollo.Age.Resources.Lang.alertIncorrectMaxBet)",
			INCORRECT_MAX_PER_MATCH: "@(Apollo.Age.Resources.Lang.alertIncorrectMaxPerMatch)",
			INCORRECT_MAX_PER_BALL: "@(Apollo.Age.Resources.Lang.alertIncorrectMaxPerBall)",
			MIN_BET_LOWER_THAN_MIN_MAX_BET: "@(Apollo.Age.Resources.Lang.minBetShouldBeLessThanOrEqualToMaxBet)",
			MIN_BET_LOWER_THAN_MIN_MAX_PER_MATCH_BET: "@(Apollo.Age.Resources.Lang.minBetShouldBeLessThanOrEqualToMaxPerMatch)",
			MAX_BET_LOWER_THAN_MIN_MAX_PER_MATCH_BET: "@(Apollo.Age.Resources.Lang.maxBetShouldBeLessThanOrEqualToMaxPerMatch)",
			MIN_BET_GREATER_THAN_MIN_MIN_BET: '@(string.Format("{0} {1}", Apollo.Age.Resources.Lang.lblalertMinbetCompare, "{0}"))',
			MAX_BET_LOWER_THAN_MAX_MAX_BET: '@(string.Format("{0} {1}", Apollo.Age.Resources.Lang.lblalerMaxbetCompare, "{0}"))',
			MAX_PER_MATCH_LOWER_THAN_MAX_PER_MATCH_MAX_BET: '@(Apollo.Age.Resources.Lang.lblalertMaxPerMatchCompare.Replace("{1}", "{0}"))',
			MAX_PER_BALL_LOWER_THAN_MAX_PER_BALL_MAX_BET: '@(Apollo.Age.Resources.Lang.lblalertMaxPerBallCompare.Replace("{1}", "{0}"))',
			MIN_BET_LOWER_THAN_MIN_MAX_PER_BALL: '@(Apollo.Age.Resources.Lang.minBetShouldBeLessThanOrEqualToMaxPerBall)',
			//	WANT_TO_UPDATE_ALL_MEMBER_POSITION_TAKING: "Do you want to update all member's position taking to:",
			YES: "@(Apollo.Age.Resources.Lang.lblYes)",
			NO: "@(Apollo.Age.Resources.Lang.lblNo)",
			BASKETBALL: "@(Apollo.Age.Resources.Lang.Basketball)",
			SOCCER: "@(Apollo.Age.Resources.Lang.soccer)",
			POSITION_SETTING_HEADER: "@(Apollo.Age.Resources.Lang.lblShareSetting)",
			POSITION_SETTING_SIMPLE_MODE_HEADER: "@(Apollo.Age.Resources.Lang.lblShareSettingSimpleMode)",
			BET_SETTING_HEADER: "@(Apollo.Age.Resources.Lang.lblBetSetting)",
			COMMISSION_SETTING_HEADER: "@(Apollo.Age.Resources.Lang.lblCommissionSetting)",
			//// commission setting text
			GROUP_A: "@(Apollo.Age.Resources.Lang.lblGroupa) (%) ",
			GROUP_B: "@(Apollo.Age.Resources.Lang.lblGroupb) (%) ",
			GROUP_C: "@(Apollo.Age.Resources.Lang.lblGroupc) (%) ",
			GROUP_D: "@(Apollo.Age.Resources.Lang.lblGroupd) (%) ",
			_1X2: "@(Apollo.Age.Resources.Lang.lbl1x2Comm) (%) ",
			OTHERS_COM: "@(Apollo.Age.Resources.Lang.lblOtherComm) (%) ",
			NUMBER_GAME: "@(Apollo.Age.Resources.Lang.numbergame)",
			ASIAN_HDC_OU_OE: "@(Apollo.Age.Resources.Lang.lblAsianHDC_OU_OE) (%)",
			MEMBER_GROUP: "@(Apollo.Age.Resources.Lang.lblCommissionGroup)",
			COMM_FOR_AGENT: "",
			COMM_FOR_MEMBER: "@(Apollo.Age.Resources.Lang.lblMemberCommission)",
			GROUP: "@(Apollo.Age.Resources.Lang.group)",
			AGENT_SHARE: "@(Apollo.Age.Resources.Lang.lblAgentShare)",
			SPORT_BOOK: "@(Apollo.Age.Resources.Lang.sportBook)",
			SIMPLE_MODE_MAX_POSITION: "@(Apollo.Age.Resources.Lang.lblGivenShare)",
			SIMPLE_MODE_PRESET_POSITION: "@(Apollo.Age.Resources.Lang.lblTakenShare)",
			INVALID_RANGE: "@(Apollo.Age.Resources.Lang.lblInvalidValueRange)",
			OUTRANGE_SIMPLE_MODE_ERROR: "@(Apollo.Age.Resources.Lang.lblPleaseCheckConstrainMaxMin)",
			INVALID_INPUT_DECIMAIL_POINT: "@(Apollo.Age.Resources.Lang.lblInvalidInputDecimals)"
		};
    </script>
    @RenderSection("scripts", required: false)
</body>
</html>
