<!DOCTYPE html>
<html lang="en-us">
<head>
	<meta charset="utf-8" />
	<meta name="viewport" content="width=device-width" />
	<title>@ViewBag.Title</title>
    @Styles.Render("~/css/viewcustsetting")
	@RenderSection("css", required: false)
</head>
<body>
	
	<div id="page_main">
		<div id="header_main">
			@ViewBag.Title
		</div>
		<div id="content_main">
			@RenderBody()
		</div>
	</div>
	@Html.Hidden("ApoRoot", Url.Content("~/"))
	@Html.Partial("_ApoRes")
	@RenderSection("scripts", required: false)
</body>
</html>