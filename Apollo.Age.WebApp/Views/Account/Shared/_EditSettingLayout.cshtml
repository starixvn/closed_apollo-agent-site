@{
    var isSimpleMode = ViewBag.IsSimpleMode ?? true;
    var reload = ViewBag.Reload ?? false;
    var fromLeftMenu = ViewBag.FromLeftMenu ?? false;
    var isMaster = ViewBag.IsMaster ?? false;
    var allowEdit = ViewBag.AllowEdit ?? true;
}
<!DOCTYPE html>
<html lang="en-us">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <title>@ViewBag.Title</title>
    @Styles.Render("~/css/editsettinglayout")
    @RenderSection("css", required: false)
</head>
<body>
    @RenderSection("header", required: false)
    <div style="clear:both;"></div>
    <div id="edit-warning" class="edit-setting-warning clear" style="display: none;">@Lang.lblWarningEditSetting</div>
    <div id="page_main" class="settingContainer">
        @RenderBody()
        <table id="tbl-edit" class="tbl-contain-button" style="display:none;">
            <tbody>
                <tr>
                    <td>
                        <input id="btnSubmitFooter" type="button" class="btn" value="@Lang.lblconfirm" />
                        <input id="btnCancelFooter" type="button" class="btn" value="@Lang.Cancel" style="@(fromLeftMenu ? "display:none;" : string.Empty)" />
                    </td>
                </tr>
            </tbody>
        </table>
    </div>
    <div id="forgery-token-div" style="display: none;">
        @Html.AntiForgeryToken()
    </div>
    @Html.Hidden("ApoRoot", Url.Content("~/"))
    @Html.Partial("_ApoRes")
    
    <script type="text/javascript">
		var DEFAULT_LAYOUT = function () {
			return {
				isSimpleMode : @(isSimpleMode ? "true" : "false"),
                reload: @(reload ? "true" : "false"),
                fromLeftMenu: @(fromLeftMenu ? "true" : "false"),
				noChangeMessage: "@(Lang.noChangeToUpdate)",
                isMaster: @(isMaster ? "true" : "false"),
                allowEdit: @(allowEdit ? "true" : "false")
			};
		}();

		var Language =
		{
			MIN_BET: "@(Lang.lblMinBet)",
			MAX_BET: "@(Lang.lblMaxBet)",
			MAX_PER_MATCH: "@(Lang.lblMaxPerMatch)",
			MAX_PER_BALL: "@(Lang.maxperball)",
			DEAD_BALL: "@(Lang.lblDeadball)",
			LIVE: "@(Lang.lblEditSettingLive)",
			DEAD_BALL_VN: "@(Lang.lblDeadball)",
			LIVE_VN: "@(Lang.lblEditSettingLive)",
			MIN_POSITION: "@(Lang.lblEditMinPosition):",
			MAX_POSITION: "@(Lang.lblEditMaxPosition):",
			SIMPLE_MODE_MAX_POSITION: "@(Lang.lblEditMaxPosition):",
			SIMPLE_MODE_PRESET_POSITION: "@(Lang.lblEditPresetPosition):",
			PRESET_POSITION: "@(Lang.lblEditPresetPosition):",
			POSITION_TAKING: "@(Lang.positiontaking):",
			COPY_FROM: "@(Lang.copyFrom)",
			COPY_ALL_OTHER_POSITION_TAKING_FROM: "@(Lang.copyAllPositionTakingFrom)",
			COPY_ALL_POSITION_TAKING_FROM: "@(Lang.copyPositionTakingFrom)",
			COPY_ALL_BETTING_LIMIT_FROM: "@(Lang.copyAllBetSettingFromExcludingNG)",
			COPY_ALL_HINT: "@(Lang.copyAllHint)",
			OTHER_BET_TYPE_OF: "@(Lang.otherBetTypesOf)",
			INCORRECT_MIN_BET: "@(Lang.alertIncorrectMinBet)",
			INCORRECT_MAX_BET: "@(Lang.alertIncorrectMaxBet)",
			INCORRECT_MAX_PER_MATCH: "@(Lang.alertIncorrectMaxPerMatch)",
			INCORRECT_MAX_PER_BALL: "@(Lang.alertIncorrectMaxPerBall)",
			MIN_BET_LOWER_THAN_MIN_MAX_BET: "@(Lang.minBetShouldBeLessThanOrEqualToMaxBet)",
			MIN_BET_LOWER_THAN_MIN_MAX_PER_MATCH_BET: "@(Lang.minBetShouldBeLessThanOrEqualToMaxPerMatch)",
			MAX_BET_LOWER_THAN_MIN_MAX_PER_MATCH_BET: "@(Lang.maxBetShouldBeLessThanOrEqualToMaxPerMatch)",
			MIN_BET_GREATER_THAN_MIN_MIN_BET: '@(string.Format("{0} {1}", Lang.lblalertMinbetCompare, "{0}"))',
			MAX_BET_LOWER_THAN_MAX_MAX_BET: '@(string.Format("{0} {1}", Lang.lblalerMaxbetCompare, "{0}"))',
			MAX_PER_MATCH_LOWER_THAN_MAX_PER_MATCH_MAX_BET: '@(Lang.lblalertMaxPerMatchCompare.Replace("{1}", "{0}"))',
			MAX_PER_BALL_LOWER_THAN_MAX_PER_BALL_MAX_BET: '@(Lang.lblalertMaxPerBallCompare.Replace("{1}", "{0}"))',
			MIN_BET_LOWER_THAN_MIN_MAX_PER_BALL: '@(Lang.minBetShouldBeLessThanOrEqualToMaxPerBall)',
			//	WANT_TO_UPDATE_ALL_MEMBER_POSITION_TAKING: "Do you want to update all member's position taking to:",
			YES: "@(Lang.lblYes)",
			NO: "@(Lang.lblNo)",
			BASKETBALL: "@(Lang.Basketball)",
			SOCCER: "@(Lang.soccer)",
			POSITION_SETTING_HEADER: "@(Lang.lblShareSetting)",
			POSITION_SETTING_SIMPLE_MODE_HEADER: "@(Lang.lblShareSettingSimpleMode)",
			BET_SETTING_HEADER: "@(Lang.lblBetSetting)",
			COMMISSION_SETTING_HEADER: "@(Lang.lblCommissionSetting)",
			//// commission setting text
			GROUP_A: "@(Lang.lblGroupa) (%) ",
			GROUP_B: "@(Lang.lblGroupb) (%) ",
			GROUP_C: "@(Lang.lblGroupc) (%) ",
			GROUP_D: "@(Lang.lblGroupd) (%) ",
			_1X2: "@(Lang.lbl1x2Comm) (%) ",
			OTHERS_COM: "@(Lang.lblOtherComm) (%) ",
			NUMBER_GAME: "@(Lang.numbergame)",
			ASIAN_HDC_OU_OE: "@(Lang.lblAsianHDC_OU_OE) (%)",
			MEMBER_GROUP: "@(Lang.lblCommissionGroup)",
			COMM_FOR_AGENT: "",
			COMM_FOR_MEMBER: "@(Lang.lblMemberCommission)",
			GROUP: "@(Lang.group)",
			AGENT_SHARE: "@(Lang.lblAgentShare):",
			SPORT_BOOK: "@(Lang.sportBook)",
			INVALID_RANGE: "@(Lang.lblInvalidValueRange)",
			OUTRANGE_SIMPLE_MODE_ERROR: "@(Lang.lblPleaseCheckConstrainMaxMin)",
			INVALID_INPUT_DECIMAIL_POINT: "@(Lang.lblInvalidInputDecimals)",
            CONFIRM_WRITE_AGENT: "@(Lang.ConfirmWriteAgent)",
            CONFIRM_WRITE_MEMBER: "@(Lang.ConfirmWriteMember)",
            PERCENT_IN_MEMBER: "@(Lang.PercentInMember):",
            UPDATE_MULTIPLE_SUCCESS: "@(Lang.lblUpdateSuccessMultiple)",
            UPDATE_ERROR: "@(Lang.lblUpdateError)",
            UPLINE_SETTING:"@(Lang.lblUplineSetting)",
            MIN: "@(Lang.lblMin)",
            MAX: "@(Lang.lblMax)",
            UPLINE_SETTINGTEXT:"@(Lang.lblUplineSettingText):",
            NOT_ALLOW_EDIT_MESSAGE: "@(Lang.NotAllowEditSettingInPeakHours)",
            BET_SETTING_LIMIT_MESSAGE:"@(LangMsg.MessageBetSettingLimit)",
            BET_SETTING_LIMIT_MIN_SINGBET_MESSAGE:"@(LangMsg.MessageSingBetMinLimit)",
            BET_SETTING_LIMIT_MIN_SINGGAME_MESSAGE:"@(LangMsg.MessageSingGameMinLimit)"
		};
    </script>
    @RenderSection("scripts", required: false)
</body>
</html>
