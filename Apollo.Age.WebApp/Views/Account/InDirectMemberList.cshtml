@using Apollo.Age.Entities
@using Apollo.Age.Resources
@using Apollo.Age.Configurations
@model CustomerListCriteria
@{
    ViewBag.Title = Apollo.Age.Resources.Lang.lblPlayerList;
    ViewBag.HeaderTitle = Apollo.Age.Resources.Lang.lblMemberListOf;
    var titleFormat = ViewBag.IsMaster == true ? Apollo.Age.Resources.Lang.lblEditMemberSetting : Apollo.Age.Resources.Lang.lblViewMemberSetting;
    titleFormat = string.Format(titleFormat, string.Empty);
    var agenttitleFormat = ViewBag.IsMaster == true ? Apollo.Age.Resources.Lang.lblEditAgentSetting : Apollo.Age.Resources.Lang.lblViewAgentSetting;
    agenttitleFormat = string.Format(agenttitleFormat, string.Empty);
    Layout = "~/Views/Account/Shared/_LayoutAccountList.cshtml";
    var parentId = ViewBag.ParentId != null ? ViewBag.ParentId : -1;
    var isMaster = (bool)ViewBag.IsMaster;
    //var isSuper = ViewBag.IsSupper ?? false;
    var driectAgentList = ViewBag.DirectAgentList != null ? (List<Agent>)ViewBag.DirectAgentList : new List<Agent>();
    var backLink = HttpUtility.UrlEncode(Url.Content(string.Format("~/account/indirectmemberlist?parentAgentId={0}&agentId={1}", parentId, Model.AgentId)));
    var memberList = ViewBag.MemberList != null ? (List<MemberListModel>)ViewBag.MemberList : new List<MemberListModel>();
    var firstMember = memberList.FirstOrDefault() ?? new MemberListModel();
    var hasAgentDownline = ViewBag.HasAgentDownline != null ? (bool)ViewBag.HasAgentDownline : false;
    var agentList = ViewBag.AgentList != null ? (List<Agent>)ViewBag.AgentList : new List<Agent>();
    var allowFundOut = (bool)ViewBag.AllowFundOut;
    //var actorAgentUsername = ViewBag.ActorAgentUsername ?? string.Empty;
    var agentUsername = ViewBag.AgentUserName ?? string.Empty;
    var agentLevel = (int)ViewBag.AgentLevel; 
    
}
@using (Html.BeginForm())
{       
    <div id="function-bar">
        <div class="item">
            <label>@Lang.member</label>:
            <select class="za_select" id="UplineAgentId" name="UplineAgentId">
                @foreach (var item in driectAgentList)
                {
                    if (item.Id == Model.AgentId)
                    { 
                    <option value="@item.Id" selected="selected">@item.Username</option>
                    }
                    else
                    {
                    <option value="@item.Id">@item.Username</option>
                    }
                }
            </select>
            @Html.DropDownListFor(m => m.Status, new List<SelectListItem> {
                                    new SelectListItem { Value = "0", Text = Lang.all },
					                new SelectListItem { Value = ((int)CustomerStatus.Active).ToString(), Text = Lang.lblActive },
					                new SelectListItem { Value = ((int)CustomerStatus.Stopped).ToString(), Text = Lang.stopped },
                                    new SelectListItem { Value = ((int)CustomerStatus.Locked).ToString(), Text = Lang.locked },
                                    new SelectListItem { Value = ((int)CustomerStatus.CLock).ToString(), Text = Lang.lblCLock }
				                }, new { @class = "za_select" })
        </div>
        <div class="item">
            --<label>@Lang.OrderBy</label>:
            @Html.DropDownListFor(m => m.OrderBy, new List<SelectListItem> {
					                new SelectListItem { Value = "1", Text = Lang.enterusername },					                
				                }, new { @class = "za_select" })
            @Html.DropDownListFor(m => m.OrderType, new List<SelectListItem> {
					                new SelectListItem { Value = "1", Text = Lang.ASC },					                
                                    new SelectListItem { Value = "2", Text = Lang.DES }
				                }, new { @class = "za_select" })
        </div>
        @if (!ReferenceEquals(memberList, null) && memberList.Any())
        { 
            <div class="item">
                --<label>@Lang.Page</label>:
                @Html.DropDownListFor(m => m.PageIndex, (List<SelectListItem>)ViewBag.ListPage, new { @class = "za_select" })
                <input type="hidden" value="@Model.OldPageIndex" name="OldPageIndex" id="OldPageIndex" />
                &nbsp;/<label>@Model.NumPages&nbsp;@Lang.Pages</label>
            </div>
        }
        <div class="item">
            @Html.TextBoxFor(m => m.UserName, new { @class = "za_text" })
            <input type="submit" class="za_button" value="@Lang.SearchMember" id="submit">
        </div>
        @if (hasAgentDownline)
        {
            <div class="item">
                -- <a href="~/Account/IndirectAgentList?parentAgentId=@parentId&amp;agentId=@Model.AgentId">@Lang.lblAgents</a>
            </div>
        }
@*<img src="/_GlobalResources/Images/top_04.png" alt="">*@
        <div class="end">
        </div>
    </div>     
    @Html.HiddenFor(m => m.AgentId)
    @Html.HiddenFor(m => m.ParentAgentId)   
}
@if (!ReferenceEquals(memberList, null) && memberList.Any())
{
<div id="divEditMultiple" class="action edit-multiple-indirect-link">
    
     @if(!AppSettings.DisableEditOnMember)
     {
         <a href="javascript:;" class="edit-link">
        @if (isMaster)
        {
            @Lang.edit
        }
        else
        {
            @Lang.lblview
        }</a> 
         @:&nbsp;/&nbsp; 
    }
    <a href="javascript:void(0);" id="viewDetailMultiple" data-edit-multiple-link="@Url.Content("~/CustomerSetting/ViewMemberDetails")?agentId=@(Model.AgentId)">@Lang.Detail</a>
     @if (!AppSettings.DisableEditOnMember)
     {
    <div class="list">
        <ul class="menu-list">
            @if (agentList.Any())
            {
                foreach (var itemAgent in agentList)
                {
                    if (itemAgent.Level > AgentLevel.Super)
                    { 
                <li><a class="edit-multiple-member" href="javascript:void(0);" data-edit-multiple-link="@Url.Content("~/CustomerSetting/EditMemberPositionTaking")?agentId=@itemAgent.Id&amp;backLink=@backLink&amp;agentUsername=@itemAgent.Username">@itemAgent.Username</a></li>	 
                    }
                }

            }
        </ul>
    </div>
     }
</div>
}
<table id="tblMemberList" class="tblRpt memberList">
    @if (!ReferenceEquals(memberList, null) && memberList.Any())
    {
        <thead>
            <tr>
                <td class="width-140">
                    <input type="checkbox" id="cbAllMember" />
                </td>
                <td>
                    @RazorHelper.RenderAgentListHeader(agentLevel, true)
                </td>
                <td>
                    @Lang.member
                </td>
                <td class="width-80">
                    @Lang.status
                </td>
                <td class="width-80">
                    @Lang.betstatus
                </td>
                <th class="width-80">@Lang.SportCredit
                </th>
                <td class="width-140">
                    @Lang.Feature
                    <div class="edit-member-share">
                     <a class="lnk-setting" target="main" href="~/CustomerSetting/EditMemberPositionTaking?memberId=@memberList[0].MemberId&amp;agentId=@Model.AgentId&amp;userName=@memberList[0].Username&amp;agentUsername=@agentUsername&amp;backLink=@backLink&amp;agentUsername=@agentUsername">
                            @if (isMaster)
                            {
                                @Apollo.Age.Resources.Lang.lblEditMemberShare
                            }
                            else
                            {
                                @Apollo.Age.Resources.Lang.lblViewMemberShare
                            }
                            </a>
                            </div>
                </td>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in memberList)
            {
                <tr class="m_cen">
                    <td>
                        <input type="checkbox" class="cb-edit-multiple" value="@item.MemberId" data-member-username="@item.Username" />
                    </td>
                    <td>
                        @ViewBag.AgentUsername
                    </td>
                    <td>
                        @item.Username
                    </td>
                    <td>
                        @Html.Raw(item.Status.ToStringStatus(item.UplineStatus))
                    </td>
                    <td>
                        @Html.Raw(item.BetStatus.ToStringStatus(item.UplineBetStatus))
                    </td>
                    <td>
                        @* @if (allowFundOut && item.CashBalance > 0)
                        {
                            <span id="fundout" class="fundout" data-membername="@item.Username" data-memberid="@item.MemberId" data-sportcredit="@item.CashBalance">@Formater.DecFormat(item.CashBalance, 2)</span>
                        }
                        else
                        {
                            @Formater.DecFormat(item.CashBalance, 2)
                        }*@
                        @Formater.DecFormat(item.CashBalance, 2)
                    </td>
                    <td class="text-center nowrap">
                        <div class="action">
                        @if (!AppSettings.DisableEditOnMember)
                        {
                            <a href="javascript:;" class="edit-link">
                                @if (isMaster)
                                {
                                    @Lang.edit
                                }
                                else
                                {
                                    @Lang.lblview
                                }</a> 
                            @:&nbsp;/&nbsp; 
                            }
                            <a href="~/CustomerSetting/ViewMemberDetails?memberId=@item.MemberId&amp;agentId=@Model.AgentId&amp;userName=@item.Username">@Lang.Detail</a>
                            @if (!AppSettings.DisableEditOnMember)
                            {
                            <div class="list">
                                <ul class="menu-list">
                                    @if (agentList.Any())
                                    {
                                        foreach (var itemAgent in agentList)
                                        {
                                            if (itemAgent.Level > AgentLevel.Super)
                                            { 
                                        <li><a href="~/CustomerSetting/EditMemberPositionTaking?memberId=@item.MemberId&amp;agentId=@itemAgent.Id&amp;userName=@item.Username&amp;backLink=@backLink&amp;agentUsername=@itemAgent.Username">@itemAgent.Username</a></li>	 
                                            }
                                        }

                                    }
                                </ul>
                            </div>
                            }
                        </div>
                    </td>
                </tr>
            }
        </tbody>
    }
    else
    {
        <thead>
            <th class="none-result">
                @Lang.NoneMember
            </th>
        </thead>
    }
</table>
@section scripts
{
    <script type="text/javascript">
        $(document).ready(function () {
            $('.za_select').change(function () {
                $('#submit').click();
            });
        });
    </script>
}
