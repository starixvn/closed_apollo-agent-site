@using Apollo.Age.Account.Models;
@using Apollo.Age;
@using Apollo.Age.Entities;
@using Apollo.Age.Configurations;
@model CustomerInfoModel
@{
    Layout = "~/Views/Account/Shared/_Layout.cshtml";
    ViewBag.Title = Lang.AccountSearch;
    var topMember = (MemberListModel)ViewBag.TopMember;
    var customerSettingPermission = ViewBag.CustomerSettingPermission != null ? (byte)ViewBag.CustomerSettingPermission : -1;
    var permissionControl = ViewBag.PermissionControl != null ? (byte)ViewBag.PermissionControl : -1;
    var depositDrawPermission = ViewBag.DepositDrawPermission != null ? (byte)ViewBag.DepositDrawPermission : -1;
    var shadowPermissionControl = ViewBag.ShadowPermissionControl != null ? (byte)ViewBag.ShadowPermissionControl : -1;
    var viewLogPermission = ViewBag.ViewLogPermission != null ? (byte)ViewBag.ViewLogPermission : -1;
    var hasDownlineDetailsPermission = ViewBag.DownlineDetailsPolicy != null ? (byte)ViewBag.DownlineDetailsPolicy >= (byte)Policy.Query : false;
    var agentLevelId = new int[4];
}
<table id="tab-menu">
    <tr>
        <td>
            <a id="lk-tree-tab" href="javascript:;" target="menu"><i class="icon-user"></i>
                @Lang.userinfo</a>
        </td>
        <td class="active">
            <a><i class="icon-search"></i>@Lang.AccountSearch</a>
        </td>
    </tr>
</table>
<div id="wrapper">
    <div class="search-box">
        <div class="clearfix">
            @SearchBox()
        </div>
        @if (Model != null)
        {
            if (Model.CustId > 0)
            {
            <table class="cust-info">
                <tbody>
                    <tr>
                        @if (Model.IsMember)
                        {
                            <td class="agent-lbl">
                                @Lang.member:
                            </td>
                        }
                        else
                        {
                            @RenderAgentLevelName(Model.Level, "agent-lbl")
                        }
                        <td class="agent-name">
                            @Model.Username
                        </td>
                    </tr>
                    @if (Model.AgentPathList != null && Model.AgentPathList.Any())
                    {
                        var item = new Agent();
                        var count = Model.AgentPathList.Count > 4 ? 4 : Model.AgentPathList.Count; //4: is only show 4 level
                        for (int i = 0; i < count; i++)
                        {
                            item = Model.AgentPathList[i];
                            agentLevelId[i] = item.Id;
                        <tr>
                            @RenderAgentLevelName(item.Level, "parent-lbl")
                            <td class="parent-name">
                                @if (item.Level == AgentLevel.Super)
                                {
                                    @item.Username
                                }
                                else
                                {
                                    <a class="view-agentinfo" href="#" target="menu"
									        data-agentid="@item.Id" data-agentname="@item.Username">@item.Username
                                    </a>
                                }
                            </td>
                        </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            @if (Model.IsMember)
                            {
                                <td class="parent-lbl">
                                    @Lang.agent:
                                </td>
                            }
                            else
                            {
                                @RenderAgentLevelName((Model.Level - 1), "parent-lbl")
                            }
                            <td class="parent-name">
                                @if (!Model.IsMember && (Model.ActorAgentId == Model.CustId))
                                {
                                    @Model.ParentName
                                }
                                else
                                {
                                    if (Model.ActorAgentId != Model.ParentId)
                                    {
                                    <a href="javascript:;" id="agentDownlineLink" data-agentid="@Model.ParentId" title="@Lang.txtShowUpline">
                                        <div id="ddl-agents">
                                            <ul class="agent-list">
                                            </ul>
                                        </div>
                                    </a>
                                    }
                                    <a class="view-agentinfo" href="javascript:;" target="menu"
										data-agentid="@Model.ParentId" data-agentname="@Model.ParentName">@Model.ParentName
                                    </a>
                                }
                            </td>
                        </tr>
                    }
                    @if (Model.AgentPathList != null && Model.AgentPathList.Any() && Model.AgentPathList.Count > 4)
                    {
                        <tr>
                            <td class="parent-lbl">
                            </td>
                            <td class="parent-name">
                                <a href="javascript:void(0)" id="agentDownlineLink" data-agentid="@Model.AgentPathList[4].Id">
                                    @Lang.more &#187;
                                    <div id="ddl-agents">
                                        <ul class="agent-list">
                                        </ul>
                                    </div>
                                </a>
                            </td>
                        </tr>

                    }
                </tbody>
            </table>
            }
            else
            {
            <div class="errMsg">@Lang.usernamenotexisted</div>
            }
        }
    </div>
    @if (Model != null)
    {
        if (Model.CustId > 0)
        {
        <div class="clearfix btn-list">
            @if (!Model.IsMember)
            {
                if (Model.HasAgentDownline)
                {
                    if (Model.ActorAgentId == Model.CustId)
                    {
                <a class="lnk-agent-list" target="main" href="~/Account/AgentList">
                    @Lang.lblAgents
                </a>
                    }
                    else
                    {
                <a class="lnk-agent-list" target="main"
							href="~/Account/IndirectAgentList?parentAgentId=@Model.ParentId&amp;agentid=@Model.CustId">
                    @Lang.lblAgents
                </a>
                    }
                }
                if (Model.HasMemberDownline && Model.Level > AgentLevel.Shareholder)
                {
                    if (Model.ActorAgentId == Model.CustId)
                    {
                <a class="lnk-member-list" target="main" href="~/Account/MemberList">
                    @Lang.memberList
                </a>
                    }
                    else
                    {
                <a class="lnk-member-list" target="main" href="~/Account/IndirectMemberList?parentAgentId=@Model.ParentId&amp;agentid=@Model.CustId">
                    @Lang.memberList
                </a>
                    }
                }
            }
            else
            {
                <a class="lnk-betlist" target="main" href="~/BetList/AccountInfo?custId=@Model.CustId&username=@Model.Username">
                    @Lang.lblBetLists
                </a>
            }
        </div>

        <div class="status-box">
            <table class="status-info">
                <tbody>
                    <tr>
                        <td>
                            Account Status
                        </td>
                        <td class="info-data">
                            @Model.Status.ToStringStatus(Model.UplineStatus)
                        </td>
                    </tr>
                    <tr>
                        <td>
                            Bet Status
                        </td>
                        <td class="info-data">
                            @Model.BetStatus.ToStringStatus(Model.UplineBetStatus)
                        </td>
                    </tr>
                    @if (Model.Level >= AgentLevel.Shareholder)
                    {
                        <tr>
                            <td>
                                @Lang.SportCredit
                            </td>
                            <td class="info-data">
                                @Formater.DecFormat(@Model.UserBalance, 2)
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        <div id="agent-setting">
            <ul class="tabs">
                <li id="custsettings" class="current"><a class="show-section" data-agentid="@Model.CustId" href="javascript:void(0);">
                    <span>@Lang.setting</span></a></li>
                @if (!Model.IsMember)
                {
                    <li id="agentsTab"><a class="show-section" data-agentid="@Model.CustId" href="javascript:void(0);">
                        <span>@Lang.lblAgents</span></a></li>
                    if (Model.Level > AgentLevel.Shareholder)
                    {
                    <li id="membersTab"><a class="show-section" data-agentid="@Model.CustId" href="javascript:void(0);">
                        <span>@Lang.memberList</span></a></li>
                    }
                }
            </ul>
            <div class="content">
                <div id="custsettings-content">
                    @if (Model.IsMember)
                    {
                        var group = Model.Group == null ? string.Empty : Model.Group.ToUpper();
                        if (!AppSettings.DisableEditOnMember)
                        {
                        <a class="edit-link" href="javascript:;">
                            @if (Model.IsMaster)
                            {
                                @Lang.edit
                            }
                            else
                            {
                                @Lang.lblview
                            }
                        </a>
                        <div class="list">
                            <ul class="menu-list">
                                @if (Model.AgentPathList.Any())
                                {
                                    var listAgent = Model.AgentPathList.OrderBy(t => t.Level);
                                    foreach (var itemAgent in listAgent)
                                    {
                                        if (itemAgent.Level > AgentLevel.Super)
                                        {
                                    <li><a href="~/CustomerSetting/EditMemberPositionTaking?memberId=@Model.CustId&amp;agentId=@itemAgent.Id&amp;userName=@Model.Username&amp;fromLeftMenu=true&amp;reload=true&amp;agentUsername=@itemAgent.Username" target="main">@itemAgent.Username</a></li>
                                        }
                                    }
                                }
                            </ul>
                        </div>
                        }

                        <a class="lnk-setting" target="main" href="~/CustomerSetting/ViewMemberDetails?memberId=@Model.CustId&amp;agentId=@Model.ParentId&amp;userName=@Model.Username&amp;fromLeftMenu=true">
                            @Lang.ViewDetails
                        </a>
                        <a class="lnk-setting" target="main" href="~/CustomerSetting/MemberShare?memberId=@Model.CustId&amp;userName=@Model.Username">
                            @Lang.Share
                        </a>
                        <a class="lnk-setting" target="main"
							href="~/CustomerSetting/ViewCommission?id=@Model.CustId&amp;isMember=@Model.IsMember.ToString()">
                            @Lang.lblComm
                        </a>

                        <a class="lnk-setting" target="main" href="~/Log/ViewLog?IsAgent=false&Username=@Model.Username">
                            @Lang.viewlog
                        </a>
                    }
                    else
                    {
                        if (customerSettingPermission >= (byte)Policy.Query)
                        {
                            if (Model.ActorAgentId != Model.CustId)
                            {
                        <a class="lnk-setting" target="main"
							    href="~/CustomerSetting/EditAgentPositionTaking?agentId=@Model.CustId&amp;agentLevel=@Model.Level&amp;userName=@Model.Username&amp;fromLeftMenu=true&amp;reload=true">
                            @if (Model.IsMaster && customerSettingPermission == (byte)Policy.Edit)
                            {
                                @Lang.edit
                            }
                            else
                            {
                                @Lang.lblview
                            }
                        </a>
                            }
                        <a class="lnk-setting" target="main" href="~/CustomerSetting/ViewAgentDetails?agentId=@Model.CustId&amp;agentLevel=@Model.Level&amp;userName=@Model.Username&amp;fromLeftMenu=true">
                            @Lang.ViewDetails
                        </a>
                            if (Model.Level > AgentLevel.Shareholder && hasDownlineDetailsPermission)
                            {
                        <a class="lnk-setting" target="main"
                            href="~/CustomerSetting/EditAllMemberShare?agentId=@Model.CustId&amp;fromLeftMenu=true&amp;reload=true&amp;agentUsername=@Model.Username">
                            @Lang.lblMemberShare
                        </a>
                            }
                        <a class="lnk-setting" target="main" href="~/CustomerSetting/AgentShare?agentId=@Model.CustId&amp;userName=@Model.Username">
                            @Lang.Share
                        </a>
                        <a class="lnk-setting" target="main"
						href="~/CustomerSetting/ViewCommission?id=@Model.CustId&amp;isMember=@Model.IsMember.ToString()">
                            @Lang.lblComm
                        </a>
                        }
                        if (viewLogPermission >= (byte)Policy.Query)
                        {
                        <a class="lnk-setting" target="main" href="~/Log/ViewLog?IsAgent=true&Username=@Model.Username">
                            @Lang.viewlog
                        </a>
                        }
                        if (permissionControl >= (byte)Policy.Query)
                        {
                        <a class="lnk-setting" target="main" href="~/PermissionUserControl/AssignPermissionControl?grandParentAgentId=@(agentLevelId[1] != 0 ? agentLevelId[1] : agentLevelId[0])&parentAgentId=@Model.ParentId&agentuserid=@Model.CustId">
                            @Lang.Permission
                        </a>
                        }
                        if (shadowPermissionControl >= (byte)Policy.Query)
                        {
                        <a class="lnk-setting" target="main" href="~/PermissionUserControl/AgentUserList?agentid=@Model.CustId&username=@Model.Username">
                            @Lang.ShadowPermission
                        </a>
                        }
                    }
                    @*These links are invisible for Main Shareholder level*@
                    @if (depositDrawPermission == (byte)Policy.Edit)
                    {
                        if (Model.Level >= AgentLevel.Shareholder)
                        {
                        <a class="lnk-setting" target="main" href="~/Account/DepositAgent?parentAgentId=@Model.ParentId&agentId=@Model.CustId&username=@Model.Username&agentLevel=@(Model.Level - 1)">
                            @Lang.Deposit
                        </a>
                        <a class="lnk-setting" target="main" href="~/Account/DrawAgent?agentId=@Model.CustId&username=@Model.Username">
                            @Lang.Draw
                        </a>
                        }
                        else if (Model.IsMember)
                        {
                        <a class="lnk-setting" target="main" href="~/Account/DepositMember?agentId=@Model.ParentId&custId=@Model.CustId&username=@Model.Username">
                            @Lang.Deposit
                        </a>
                        <a class="lnk-setting" target="main" href="~/Account/DrawMember?custId=@Model.CustId&username=@Model.Username">
                            @Lang.Draw
                        </a>
                        }
                    }
                </div>
                <div id="agentsTab-content">
                    @if (Model.HasAgentDownline)
                    {
                        <div id="agent-treeview">
                        </div>
                    }
                    else
                    {
                        <div class="no-data">@Lang.NoneAgent</div>
                    }
                </div>
                <div id="membersTab-content">
                </div>
            </div>
        </div>
        }
    }
</div>
@helper SearchBox()
    {
        if (Model == null)
        {
    @Html.DropDownList("IsMember", new List<SelectListItem> {
			new SelectListItem { Value = "false", Text = Lang.agent },
			new SelectListItem { Value = "true", Text = Lang.member }
		}, new { id = "ddlIsMember" })
    <input maxlength="50" id="txtUsername" type="text" value="@Lang.enterusername" name="userName" />
        }
        else
        {
    @Html.DropDownListFor(m => m.IsMember, new List<SelectListItem> {
			new SelectListItem { Value = "false", Text = Lang.agent },
			new SelectListItem { Value = "true", Text = Lang.member }
		}, new { id = "ddlIsMember" })
    <input maxlength="50" id="txtUsername" type="text" value="@Model.Username" name="userName" />
        }
    <button type="button" class="btn search-button">
        <i class="icon-search"></i>
    </button>
    <input id="enterUsernameValue" type="hidden" value="@Lang.enterusername" />
}
@helper RenderAgentLevelName(int agentLevel, string classObject = "")
    {
        var keyLang = string.Empty;
        var langAgent = Constants.AgentLevelDictionary.Where(t => t.Key == agentLevel).SingleOrDefault();
        if (langAgent.Value == null)
        {
            // is not exits in Constants.AgentLevelDictionary is it's Agent (key = 4)
            keyLang = Constants.AgentLevelDictionary[4];
        }
        else
        {
            keyLang = langAgent.Value;
        }

    <td class="@classObject">
        @Html.Resource(keyLang):
    </td>
}