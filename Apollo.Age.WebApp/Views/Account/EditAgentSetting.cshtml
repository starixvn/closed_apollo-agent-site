@using Apollo.Age.Resources;
@{
    var titleFormat = ViewBag.IsMaster == true ? Apollo.Age.Resources.Lang.lblEditAgentSetting : Apollo.Age.Resources.Lang.lblViewAgentSetting;
    var userName = ViewBag.UserName ?? string.Empty;
    ViewBag.Title = string.Format(titleFormat, ViewBag.userName);
    Layout = "~/Views/Account/Shared/_EditSettingLayout.cshtml";
    var fromLeftMenu = ViewBag.FromLeftMenu ?? false;
    var agentId = ViewBag.AgentId ?? 0;
    var isMaster = ViewBag.IsMaster ?? false;
    string backLink = string.Format(Url.Content("~/CustomerSetting/ViewAgentDetails") + "/?agentId={0}&agentLevel={1}&userName={2}&fromLeftMenu={3}", agentId, ViewBag.AgentLevel, userName, fromLeftMenu);
    var MaxBetLimit = Convert.ToInt32(ViewBag.MaxBetLimit);
}
@section header
{
    <div id="function-bar">
        <div class="item detail-information">
            @Lang.AgencyDetailEdit 
            @(isMaster ? Lang.edit.ToLower() : string.Empty)
            &nbsp;&nbsp;&nbsp;&nbsp;-- <strong>@userName</strong> @*-- <a
            href="javascript:void(0);" id="simple-mode" style="display: none;">@Lang.simplemode</a><a
                href="javascript:void(0);" id="advanced-mode">@Lang.lblAdvancedMode</a>*@
        </div>
        @*<img src="/_GlobalResources/Images/top_04.png" class="end-function-bar">*@
        <div class="end"></div>
    </div>
}
@Html.Hidden("backUrl", backLink)
@if (MaxBetLimit != 0)
{
<div id="betSettingInformationMessage" class="edit-setting-warning clear"> @(LangMsg.MessageBetSettingLimit) <span id="maxbetlimit">@MaxBetLimit</span> </div>
}
<div id="commissionSettingContainer" class="clear">
</div>
<div id="bettingLimitContainer">
</div>
@Html.Action("Index", "Instruction", new
{
    key = "AgentCommissionSetting",
    trigger = "agent-commission-info-button",
    title = Lang.CommissionSettingInstructions,
    tipTitle = Lang.ClickToViewInstructions
})
@Html.Action("Index", "Instruction", new
{
    key = "AgentBetSetting",
    trigger = "agent-bet-limit-info-button",
    title = Lang.BetSettingInstructions,
    tipTitle = Lang.ClickToViewInstructions
})
@Html.Action("Index", "Instruction", new
{
    key = "AgentCommissionSettingAdv",
    trigger = "agent-commission-info-button-adv",
    title = Lang.CommissionSettingInstructions,
    tipTitle = Lang.ClickToViewInstructions
})
@Html.Action("Index", "Instruction", new
{
    key = "AgentBetSettingAdv",
    trigger = "agent-bet-limit-info-button-adv",
    title = Lang.BetSettingInstructions,
    tipTitle = Lang.ClickToViewInstructions
})
@Html.Action("Index", "Instruction", new
{
    key = "MainShareHolderBetSetting",
    trigger = "mainshareholder-bet-limit-info-button",
    title = Lang.BetSettingInstructions,
    tipTitle = Lang.ClickToViewInstructions
})
@Html.Action("Index", "Instruction", new
{
    key = "MainShareHolderBetSettingAdv",
    trigger = "mainshareholder-bet-limit-info-button-adv",
    title = Lang.BetSettingInstructions,
    tipTitle = Lang.ClickToViewInstructions
})
@Html.Action("Index", "Instruction", new
{
    key = "MainShareHolderCommissionSetting",
    trigger = "mainshareholder-commission-info-button",
    title = Lang.CommissionSettingInstructions,
    tipTitle = Lang.ClickToViewInstructions
})
@Html.Action("Index", "Instruction", new
{
    key = "MainShareHolderCommissionSettingAdv",
    trigger = "mainshareholder-commission-info-button-adv",
    title = Lang.CommissionSettingInstructions,
    tipTitle = Lang.ClickToViewInstructions
})
@section scripts
{
    <script type="text/javascript">
        var DEFAULT_OBJECT = function()
        {
            return {
               agentId: @(agentId)
            };
        }();
    </script>
    <script src="~/customersetting/getagentsetting?agentId=@(agentId)&agentLevel=@(ViewBag.AgentLevel)" type="text/javascript"></script>
    
    @Scripts.Render("~/scripts/editsettingjs")
}
