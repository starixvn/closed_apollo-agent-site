@{
    Layout = "~/Views/Account/Shared/_LayoutLogLogin.cshtml";
}
@model IEnumerable<AgentLogLoginModel>

@foreach (var item in Model)
{
    var lableTime= Lang.lbllastaccessed;
    if (Model.FirstOrDefault().Logid == item.Logid)
    {
        lableTime = Lang.lblaccesstime;
        <div class="current-session clear">
            @Lang.lblcurrentsession
        </div>
    }
    <div class="list-item">
        <div class="log-item">
            <div class="item-name">@lableTime</div>
            <div class="item-value date">@Formater.FormatDateTimeEn12(item.LogDate)</div>
        </div>
        <div class="log-item">
            <div class="item-name">@Lang.lblip</div>
            <div class="item-value"><a target="_blank" href="http://legacytools.dnsstuff.com/tools/ipall.ch?tool_id=67&token=&toolhandler_redirect=0&ip=@item.Ip&j=1">@item.Ip</a></div>
        </div>
        <div class="log-item">
            <div class="item-name">@Lang.lbldomain</div>
            <div class="item-value">@item.DomainName</div>
        </div>
        <div class="log-item">
            <div class="item-name">@Lang.lblbrowser</div>
            <div class="item-value">@item.BrowserName</div>
        </div>
        <div class="log-item">
            <div class="item-name">@Lang.lblplatform</div>
            <div class="item-value">@item.Platform</div>
        </div>
        <div class="log-item">
            <div class="item-name">@Lang.lblaction</div>
            <div class="item-value">@item.Doing</div>
        </div>  
    </div>    
}
