@{
    Layout = "~/Views/Account/Shared/_LayoutTreeView.cshtml";
    ViewBag.Title = @Lang.Agents;

    var hasDownlineDetailsPermission = ViewBag.HasDownlineDetailsPermission != null ? (bool)ViewBag.HasDownlineDetailsPermission : false;

    var classNameNoPermission = hasDownlineDetailsPermission ? "view-agentinfo" : "";
}
<ul id="treeview_list" class="tree-tab" data-agentid="@ViewBag.AgentId">
</ul>
@section foot {
    <script type="text/javascript">
        $(document).ready(function () {
            $.blockUI.defaults.css.left = "10px";
            $(document).ajaxStart($.blockUI);
            var treeList = $("#treeview_list"),
                agentId = treeList.attr("data-agentid");

            treeList.treeview({
                url: MENU.apoRoot + "Account/GetDataByNode",
                link: "<a class='@classNameNoPermission' href='javascript:;'" + "data-agentid='{0}' data-agentname={1} target='menu'> {2} </a>",
                agentId: agentId,
                showRoot: false
            });

            DOWNLINE.initAgentdownline();
            $(document).ajaxStop($.unblockUI);
        });
    </script>
}
