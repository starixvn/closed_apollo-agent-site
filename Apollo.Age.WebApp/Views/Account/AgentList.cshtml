@using Apollo.Age.Entities;
@using Apollo.Age.Web;
@using Apollo.Age
@using Apollo.Age.Resources
@model AgentListCriteria
@{
    ViewBag.Title = Apollo.Age.Resources.Lang.lblAgentList;
    ViewBag.HeaderTitle = Apollo.Age.Resources.Lang.lblAgentListOf;
    var titleFormat = ViewBag.IsMaster == true ? Apollo.Age.Resources.Lang.lblEditAgentSetting : Apollo.Age.Resources.Lang.lblViewAgentSetting;
    titleFormat = string.Format(titleFormat, string.Empty);

    var agentList = ViewBag.AgentList != null ? (List<AgentListModel>)ViewBag.AgentList : new List<AgentListModel>();
    Layout = "~/Views/Account/Shared/_LayoutAccountList.cshtml";
}
@using (Html.BeginForm())
{       
    <table width="780" cellpadding="0" border="0" cellspacing="0">
        <tbody>
            <tr>
                <td class="m_tline">
                    <table cellpadding="0" border="0" cellspacing="0">
                        <tbody>
                            <tr>
                                <td nowrap="nowrap">
                                    &nbsp;&nbsp;@Lang.agent&nbsp;:&nbsp;
                                </td>
                                <td>
                                    @Html.DropDownListFor(m => m.Status, new List<SelectListItem> {
					                new SelectListItem { Value = "1", Text = Lang.lblActive },
					                new SelectListItem { Value = "2", Text = Lang.Close },
                                    new SelectListItem { Value = "3", Text = Lang.Suspended }
				                }, new { @class = "za_select" })
                                </td>
                                <td nowrap="nowrap">
                                    &nbsp;--&nbsp;@Lang.OrderBy&nbsp;:&nbsp;
                                </td>
                                <td>
                                    @Html.DropDownListFor(m => m.OrderBy, new List<SelectListItem> {
					                new SelectListItem { Value = "1", Text = Lang.enterusername },					                
				                }, new { @class = "za_select" })
                                </td>
                                <td>
                                    @Html.DropDownListFor(m => m.OrderType, new List<SelectListItem> {
					                new SelectListItem { Value = "1", Text = Lang.ASC },					                
                                    new SelectListItem { Value = "2", Text = Lang.DES }
				                }, new { @class = "za_select" })
                                </td>
                                @if (!ReferenceEquals(agentList, null) && agentList.Any())
                                { 
                                    <td nowrap="nowrap">
                                        &nbsp;--&nbsp;@Lang.Page&nbsp;:&nbsp;
                                    </td>
                                    <td>
                                        @Html.DropDownListFor(m => m.PageIndex, (List<SelectListItem>)ViewBag.ListPage, new { @class = "za_select" })
                                        <input type="hidden" value="@Model.OldPageIndex" name="OldPageIndex" id="OldPageIndex" />
                                    </td>
                                    <td nowrap="nowrap">
                                        &nbsp;/&nbsp;@Model.NumPages&nbsp;@Lang.Pages
                                    </td>
                                }
                                <td>
                                    &nbsp;
                                    @Html.TextBoxFor(m => m.UserName, new { @class = "za_text" })
                                    &nbsp;
                                    <input type="submit" class="za_button" value="@Lang.SearchAgency" id="submit">
                                </td>
                            </tr>
                        </tbody>
                    </table>
                </td>
                <td width="30">
                    <span class="borderFilter"></span>
                </td>
            </tr>
            <tr>
                <td height="4" colspan="2">
                </td>
            </tr>
        </tbody>
    </table>    
    @Html.HiddenFor(m => m.AgentId)    
}
<table width="880" cellpadding="0" border="0" bgcolor="#976061" cellspacing="1" class="m_tab">
    <tbody>
        <tr bgcolor="#86C0A6" class="m_title_suag">
            <td width="80">
                @Lang.enterusername
            </td>
            <td width="60">
                @Lang.agent
            </td>
            <td width="70">
                @Lang.member
            </td>
            <td width="60">
                @Lang.condition
            </td>
            <td width="60">
                @Lang.BetCondition
            </td>
            <td width="80">
                @Lang.Feature
            </td>
        </tr>
        @if (!ReferenceEquals(agentList, null) && agentList.Any())
        {
            foreach (var item in agentList)
            {
            <tr class="m_cen">
                <td>
                    @item.Username
                </td>
                <td>
                    @if (item.NumberOfAgent != 0)
                    { 
                        <span class="m_tab">@Html.ActionLink(item.NumberOfAgent.ToString(), "InDirectAgentList",
                        new { parentAgentId = Model.AgentId, agentId = item.AgentId })</span>
                    }
                    else
                    {
                        <span>0</span>
                    }
                </td>
                <td>
                    @if (item.NumberOfMember != 0)
                    { 
                        <span class="m_tab">@Html.ActionLink(item.NumberOfMember.ToString(), "InDirectMemberList",
                        new { parentAgentId = Model.AgentId, agentId = item.AgentId })</span>
                    }
                    else
                    {
                        <span>0</span>
                    }
                </td>
                <td>
                    @Html.Raw(item.Status.ToStringStatus(item.UplineStatus))
                </td>
                <td>
                    @Html.Raw(item.BetStatus.ToStringStatus(item.UplineBetStatus))
                </td>
                <td align="left">
                    &nbsp; <span class="m_tab"><a href="#">@Lang.edit</a>&nbsp;/&nbsp; <a href="#">@Lang.lblDetails</a>
                    </span>
                </td>
            </tr>
            }
        }
    </tbody>
</table>
@section scripts
{
    <script type="text/javascript">
        $(document).ready(function () {
            $('.za_select').change(function () {
                $('#submit').click();
            });
        });
    </script>
}
