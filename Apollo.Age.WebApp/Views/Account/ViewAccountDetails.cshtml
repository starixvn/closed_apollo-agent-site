@using Fanex.CustSetting.ViewData;
@using Apollo.Age.Account.Core;
@using Apollo.Age.Resources;
@{
    ViewBag.Title = "View Agent Details";
    var comSetting = (CommissionSetting)ViewBag.CommissionSetting;
    var betSetting = (IList<BettingLimit>)ViewBag.BetSetting;
    var isViewOnMember = (bool)ViewBag.IsViewOnMember;
    var custId = (int)ViewBag.CustId;
    var userName = (string)ViewBag.UserName ?? string.Empty;
    var editLink = string.Empty;
    var canEdit = (bool)ViewBag.CanEdit;
    var isViewMySetting = (bool)ViewBag.IsViewMySetting;
    var fromLeftMenu = ViewBag.FromLeftMenu ?? false;
    if (isViewOnMember)
    {
        editLink = Url.Content(string.Format("~/CustomerSetting/EditMemberSetting?memberId={0}&userName={1}&agentId={2}&fromLeftMenu={3}", custId, userName, ViewBag.AgentId, fromLeftMenu));
    }
    else
    {
        editLink = Url.Content(string.Format("~/CustomerSetting/EditAgentSetting?agentId={0}&userName={1}&agentLevel={2}&fromLeftMenu={3}", custId, userName, ViewBag.AgentLevel, fromLeftMenu));
    }
    string backLink = ViewBag.BackLink ?? string.Empty;
    Layout = "~/Views/Account/Shared/_ViewDetailsLayout.cshtml";
    var betTypesHeader = new List<string>
        {
                            Lang.HandicapOverUnderOddEven, 
                            Lang.RBHandicapRBOverUnder, 
                            Lang._1x2RB1x2, 
                            Lang.OtherBetType, 
                            Lang.RBOtherBetType,
                            Lang.MixSportParlay,
                            Lang.lblOutRight
                    };
}
@Html.Hidden("BackLink", backLink)
@helper RenderSportBlock(bool isViewOnMember, CommissionSetting commissionSetting, BettingLimit betLimit, IList<string> betTypes)
    {
    
    <table class="tb-cust-setting">
        <thead>
            <tr>
                <th rowspan="2">
                    @betLimit.Name
                </th>
                <th class="@(isViewOnMember ? "member" : string.Empty)" colspan="@(isViewOnMember ? 0 : 4)">
                    @Lang.lblCommission
                </th>
                <th colspan="3">
                    @Lang.BetLimit
                </th>
            </tr>
            <tr>
                @if (isViewOnMember)
                {
                    <th style="width: 2%;">
                        @commissionSetting.UserGroup.ToUpper()
                    </th>
                }
                else
                {
                    <th style="width: 40px;">
                        @Lang.lblA
                    </th>
                    <th style="width: 40px;">
                        @Lang.lblB
                    </th>
                    <th style="width: 40px;">
                        @Lang.lblC
                    </th>
                    <th style="width: 40px;">
                        @Lang.lblD
                    </th>
                }
                <th style="width: 125px;">@Lang.SingleGame
                </th>
                <th style="width: 125px;">@Lang.MaxSingleBet
                </th>
                <th style="width: 125px;">@Lang.MinSingleBet
                </th>
                
            </tr>
        </thead>
        <tbody>
            @{
                int index = 0;
                foreach (var item in betTypes)
                {
                    index++;
                <tr>
                    <td class="first-cell">
                        @item
                    </td>
                    @if (index > 2 || (betLimit.SportId == 99 && betLimit.BetTypeId == 9))
                    {
                        if (isViewOnMember)
                        {
                        @:<td>
                                }

                        else
                        {
                        @:<td colspan="4">
                                }
                                    
                        @: 0</td>
                            
                    }
                    else
                    {
                        if (isViewOnMember)
                        {
                        <td>
                        @Formater.DecFormat(commissionSetting.CommissionItems[0].Discount, 2)
                        </td>
                        }
                        else
                        {
                        <td>
                        @Formater.DecFormat(commissionSetting.CommissionItems[0].DiscountA, 2)
                        </td>
                        <td>
                        @Formater.DecFormat(commissionSetting.CommissionItems[0].DiscountB, 2)
                        </td>
                        <td>
                        @Formater.DecFormat(commissionSetting.CommissionItems[0].DiscountC, 2)
                        </td>
                        <td>
                        @Formater.DecFormat(commissionSetting.CommissionItems[0].DiscountD, 2)
                    </td>
                        }
                    }
                    <td> @Math.Round(betLimit.MaxPerMatch) </td> 
                    <td> @Math.Round(betLimit.MaxBet) </td>
                    <td> @Math.Round(betLimit.MinBet) </td>
                </tr>
                        
                }
                    
            }
        </tbody>
    </table>
    
}
<div id="function-bar">
    <div class="item detail-information">
        @(isViewOnMember ? Lang.MemberDetailEdit : Lang.AgencyDetailEdit)
        @*@(canEdit ? Lang.edit.ToLower() : string.Empty)*@
        &nbsp;&nbsp;&nbsp;&nbsp;-- @Lang.enterusername: <strong>@userName</strong>
        @{
            
            if (!isViewMySetting)
            {
                if (canEdit)
                {
                    @:&nbsp;&nbsp;-- <a href="@editLink">@Lang.edit </a>
                }
        
                if (!fromLeftMenu)
                {
                    @:&nbsp;&nbsp;-- <a href="javascript:void(0);" id="back-link">@Lang.back</a>
                }
            }
        
        }
        
    </div>
    <img src="/_GlobalResources/Images/top_04.png" class="end-function-bar" title="" />
</div>
@*<div class="detail-information">
    @(isViewOnMember ? Lang.MemberDetailEdit : Lang.AgencyDetailEdit)
    -- @Lang.enterusername : <strong>@userName</strong>
    @if (!isViewMySetting)
    {
        if (canEdit)
        {
        @:-- <a href="@editLink">@Lang.edit </a>
        }
        @:-- <a href="javascript:void(0);" id="back-link">@Lang.back
            }
    </a>
</div>*@
<div class="view-detail-container">
    @if (betSetting != null && betSetting.Any())
    {
        BettingLimit outrightBetLimit = new BettingLimit();
        IList<string> currentBetTypes = null;
        foreach (BettingLimit betLimit in betSetting)
        {
            currentBetTypes = new List<string>();
            switch (betLimit.SportId)
            {
                case (int)SportTypes.Soccer:
                    currentBetTypes = betTypesHeader.Take(5).ToList();
                    outrightBetLimit.MinBet = betLimit.MinBet;
                    outrightBetLimit.MaxBet = betLimit.MaxBet;
                    outrightBetLimit.MaxPerMatch = betLimit.MaxPerMatch;
                    break;
                case (int)SportTypes.BasketBall:
                case (int)SportTypes.FootBall:
                case (int)SportTypes.Tennis:
                case (int)SportTypes.BaseBall:
                case (int)SportTypes.Golf:
                case (int)SportTypes.Motorsports:
                    currentBetTypes.Add(betTypesHeader[0]);
                    currentBetTypes.Add(betTypesHeader[1]);
                    currentBetTypes.Add(betTypesHeader[3]);
                    break;
                case (int)SportTypes.OtherSports:
                    if (betLimit.BetTypeId == 1)
                    {
                        currentBetTypes = betTypesHeader.Take(4).ToList();
                    }
                    else
                    {
                        currentBetTypes.Add(betTypesHeader[5]);
                        outrightBetLimit.BetTypeId = betLimit.BetTypeId;
                        outrightBetLimit.SportId = betLimit.SportId;
                        outrightBetLimit.Name = Lang.lblOutRight;
                    }
                    break;
            }
        @RenderSportBlock(isViewOnMember, comSetting, betLimit, currentBetTypes)
        }
        currentBetTypes = new List<string>{
                betTypesHeader[6]
            };
        @RenderSportBlock(isViewOnMember, comSetting, outrightBetLimit, currentBetTypes)
    }
</div>
@section scripts
{
    @Scripts.Render("~/scripts/viewaccountdetails")
}
