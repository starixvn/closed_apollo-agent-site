@{
	var titleFormat = ViewBag.IsMaster == true ? Apollo.Age.Resources.Lang.lblEditMemberSetting : Apollo.Age.Resources.Lang.lblViewMemberSetting;
	ViewBag.UserName = ViewBag.UserName ?? string.Empty;
	ViewBag.Title = string.Format(titleFormat, ViewBag.UserName);
	Layout = "~/Views/Account/Shared/_CustSettingLayout.cshtml";
	var memberId = ViewBag.MemberId ?? 0;
}
<div id="commissionSettingContainer"></div>
<div id="bettingLimitContainer"></div>
<div id="ptContainer"></div>

@Html.Action("Index", "Instruction", new {
	key = "MemberCommissionSetting",
	trigger = "member-commission-info-button",
	title =  Apollo.Age.Resources.Lang.CommissionSettingInstructions,
	tipTitle = Apollo.Age.Resources.Lang.ClickToViewInstructions
})

@Html.Action("Index", "Instruction", new {
	key = "MemberBetSetting",
    trigger = "member-bet-limit-info-button",
	title = Apollo.Age.Resources.Lang.BetSettingInstructions,
	tipTitle = Apollo.Age.Resources.Lang.ClickToViewInstructions
})

@Html.Action("Index", "Instruction", new {
	key = "MemberShareSetting",
    trigger = "member-share-setting-info-button",
    title = Apollo.Age.Resources.Lang.shareSettingInstruction,
	tipTitle = Apollo.Age.Resources.Lang.ClickToViewInstructions
})

@Html.Action("Index", "Instruction", new {
	key = "MemberCommissionSettingAdv",
    trigger = "member-commission-info-button-adv",
	title =  Apollo.Age.Resources.Lang.CommissionSettingInstructions,
	tipTitle = Apollo.Age.Resources.Lang.ClickToViewInstructions
})

@Html.Action("Index", "Instruction", new {
	key = "MemberBetSettingAdv",
    trigger = "member-bet-limit-info-button-adv",
    title = Apollo.Age.Resources.Lang.BetSettingInstructions,
	tipTitle = Apollo.Age.Resources.Lang.ClickToViewInstructions
})

@Html.Action("Index", "Instruction", new {
	key = "MemberShareSettingAdv",
    trigger = "member-share-setting-info-button-adv",
	title = Apollo.Age.Resources.Lang.shareSettingInstruction,
	tipTitle = Apollo.Age.Resources.Lang.ClickToViewInstructions
})

@section scripts
{
	<script type="text/javascript">
        var DEFAULT_OBJECT = function(){
            return {
                memberId : @(memberId)
            };
        }();
	</script>
	<script src="~/customersetting/getmembersetting?memberId=@(memberId)&ugroup=@(ViewBag.UserGroup)&agentId=@(ViewBag.CurentParentAgentId)" type="text/javascript"></script>
	<script src="~/views/account/resources/editsetting.js" type="text/javascript"></script>
}