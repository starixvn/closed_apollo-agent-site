@using Apollo.Age
@using Apollo.Age.Account.ViewModels
@model CreditBalanceViewModel
@{
    Layout = "Shared/_CreditLayout.cshtml";
    ViewBag.Title = Lang.Deposit;
}
<div id="function-bar">
    <div class="item detail-information">
        <span>
            @string.Format("{0} - {1}", @Lang.Deposit, @Model.Username)
        </span><a href="@Model.BackLink">--@Lang.back</a>
    </div>
    <div class="end">
    </div>
</div>
<div class="clear-both">
</div>
@Html.Hidden("back-link", @Model.BackLink)
@using (Html.BeginForm(null, null, FormMethod.Post, new { id = "credit-form" }))
{
    @Html.Hidden("agent-id", @Model.CustomerId)

    <table class="credit-balance">
        <tbody>
            <tr>
                <td class="lbl-amount">
                    @Html.Label("lbl-amount", @Lang.DepositAmount)
                </td>
                <td>
                    @Html.TextBox("amount", string.Empty, new { data_min = 0, data_max = Model.MaxAmount })
                    @Html.Label(string.Empty, @Model.MaxAmount == 0 ? @Lang.DepositNotAvailable : "<= " + @Model.MaxAmount.ToString("#,###.##"))
                </td>
            </tr>
            <tr class="btn-action">
                <td colspan="2">
                    <input id="deposit-agent-submit" type="button" value="@Lang.SubmitCredit" class="btn" />
                </td>
            </tr>
        </tbody>
    </table>
    <div id="msg">
    </div>
}