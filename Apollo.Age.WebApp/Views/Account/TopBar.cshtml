@model ICurrentSession
@{
	Layout = null;
}
<!DOCTYPE html>
<html>
<head>
	<title>Header</title>
	<link href="~/_globalresources/css/agent.less" rel="stylesheet" type="text/css" />
	<link href="~/views/account/resources/header.less" rel="stylesheet" type="text/css" />
</head>
<body>
	@if (Model != null)
 {
		<div id="news_main">
			<div class="login-bg clearfix">
				<div class="left">
				</div>
				<div class="right">
					<div class="login-info clearfix">
						<div class="username">@Apollo.Age.Resources.Lang.lblLogin--@Model.Username<span> (@Model.AdminName)</span></div>
						<a id="signout" class="logout" href="#">@Apollo.Age.Resources.Lang.SignOut</a>
					</div>
					<div class="toolbar">
						<ul>
							<li><span class="menu-list">[Wagers]</span>
								<ul class="sub-menu">
									<li><a href="#">S.C</a></li>
									<li><a href="#">B.K / NFL / RUGBY</a></li>
									<li><a href="#">T.N</a></li>
									<li><a href="#">V.B / BDM / TT</a></li>
									<li><a href="#">B.S</a></li>
									<li><a href="#">Other</a></li>
								</ul>
							</li>
							<li><span class="menu-list">[EM Wagers]</span>
								<ul class="sub-menu">
									<li><a href="#">S.C-EM</a></li>
									<li><a href="#">B.K / NFL / RUGBY-EM</a></li>
									<li><a href="#">T.N-EM</a></li>
									<li><a href="#">V.B / BDM / TT-EM</a></li>
									<li><a href="#">B.S-EM</a></li>
									<li><a href="#">Other-EM</a></li>
								</ul>
							</li>
							<li><a href="#">[Outright]</a></li>
							<li id="account-link">[Accounts]</li>
							<li><a href="#">[Report]</a></li>
							<li id="result-link"><a href="~/results/match" target="main">[Result]</a></li>
							<li><a href="#">[Hidden URL Tool]</a></li>
							<li><a href="#">[Announcement]</a></li>
						</ul>
					</div>
				</div>
			</div>
			<div id="function-bar" style="visibility: hidden">
				@{ string[] sportTypes = { "Soccer", "BK/NFL/RUGBY", "Tennis", "VB/BDM/TT", "Baseball", "Other", "Outright", "S Outright" };
				<ul class="menu">
					<li><a href="#">Yesterday</a></li>
					<li>Game:</li>
					@foreach (string sport in sportTypes)
					{
					<li><a href="#">[@(sport)]</a></li>
					}
				</ul>
				}
				<ul class="pager">
					<li>PAGE:</li>
					<li class="current"><a href="#">01</a></li>
					@for (int i = 2; i < 6; i++)
					{
						<li><a href="#">@(i < 10 ? string.Format("0{0}", i) : i.ToString())</a></li>
					}
				</ul>
			</div>

			@Html.Hidden("IsAllowMultipleSignIn", @Apollo.Age.Configurations.AppSettings.AllowMultipleSignIn.ToString().ToLower())
			@*<div id="text_news_out">
				<div id="text_news" onclick="Change2Menu('Message/NewMessage?PageQuery=normal', this)">
					<div id="scroller" class="news-scroller">
						<a id="topnews" href="javascript:;"></a>
					</div>
				</div>
				<span id="button_top" class="icon-envelope" onclick="Change2Menu('Message/NewMessage?PageQuery=private', this)">
					<a id="privateMsgLnk">&nbsp;&nbsp;(0)</a> </span><a class="home-page" href="~/Message/Portal"
						target="main"><span class="icon-home icon-white"></span></a>
			</div>*@
		</div>

		<input type="hidden" id="ApoRoot" value="@Url.Content("~/")" />
		<input type="hidden" id="ctime" value="@DateTime.Now.AddHours(12).ToString("H-m-s-tt")" />
		<input type="hidden" id="cdate" value="@DateTime.Now.AddHours(12).ToString("MMM dd,yyyy 'GMT'+8")" />  
		<script src="~/_globalresources/js/jquery.js" type="text/javascript"></script>		
		<script src="~/_globalresources/js/core.js" type="text/javascript"></script>	 
		<script src="~/views/account/resources/header.js" type="text/javascript"></script>
		<script type="text/javascript">
			 var DEFAULTS = {
				 IsInternalLogin: @Model.IsInternalSignIn.ToString().ToLower(),
				 IsAllowMultipleSignIn: @Apollo.Age.Configurations.AppSettings.AllowMultipleSignIn.ToString().ToLower()
						 
			 };
			 var LANGUAGES = {
				AlerSignonMessage : "@Apollo.Age.Resources.Lang.stringSessionLogged"
			 };
		</script>
	}
</body>
</html>