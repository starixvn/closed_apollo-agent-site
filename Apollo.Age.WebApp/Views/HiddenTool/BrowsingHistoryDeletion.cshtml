@using Apollo.Age.Resources
@{
    Layout = "~/Views/HiddenTool/Shared/_Layout.cshtml";
}
<div class="hidden-tool">
    <h1>
        為什麼要使用動態保密代理伺服器</h1>
    <ol class="list-info txtRed">
        <li><span>安裝本軟件可防止他人查詢你電腦時，預先清除相關敏感資料。</span> </li>
        <li><span>安裝本軟件可讓你真正達到，絕對的保密，絕對的隱私，除了自己以外，不會有第二者得知你上過 那些網站。</span> </li>
        <li><span>這個軟件不會清除“我的最愛”中的記錄。</span> </li>
    </ol>
    <h2>
        隱藏網址工具 -- 安裝步驟</h2>
    <div class="item">
        <span class="title txtRed">步驟1</span>. 下載完成後，會顯示清理工具的安裝畫面。點擊“Next”繼續安裝。
        <br>
        <img src="~/Views/HiddenTool/Resources/images/01.gif" height="398" width="509">
    </div>
    <div class="item">
        <span class="title txtRed">步驟2</span>. 在以下顯示的畫面上選擇“I accept the agreement”，然後點擊“Next”。<br>
        <img src="~/Views/HiddenTool/Resources/images/02.gif" height="399" width="509">
    </div>
    <div class="item">
        <span class="title txtRed">步驟3</span>. 選擇安裝時所需要存放的文件夾或是使用原來的設定。點擊“Next”後繼續安裝。<br>
        <img src="~/Views/HiddenTool/Resources/images/03.gif" height="398" width="508">
    </div>
    <div class="item">
        <span class="title txtRed">步驟4</span>. 點擊“Next”繼續安裝。<br>
        <img src="~/Views/HiddenTool/Resources/images/04.gif" height="398" width="508">
    </div>
    <div class="item">
        <span class="title txtRed">步驟5</span>. 取消“Create a desktop icon”的選項，然後點擊“Next”繼續下一個步驟。<br>
        <img src="~/Views/HiddenTool/Resources/images/05.gif" height="396" width="507">
    </div>
    <div class="item">
        <span class="title txtRed">步驟6</span>. 確認所有的資訊，然後點擊“Install”開始安裝。<br>
        <img src="~/Views/HiddenTool/Resources/images/06.gif" height="396" width="508">
    </div>
    <div class="item">
        <span class="title txtRed">步驟7</span>. 安裝程序正在進行中。<br>
        <img src="~/Views/HiddenTool/Resources/images/07.gif" height="396" width="507">
    </div>
    <div class="item">
        <span class="title txtRed">步驟8</span>. 安裝完成後，會顯示出一個訊息視窗，取消“View the help file”的選項。<br>
        <span class="title txtRed">步驟9</span>. 點擊“Finish”就會完成安裝程序。 <br>
        <img src="~/Views/HiddenTool/Resources/images/08.gif" height="398" width="507">
    </div>
    <div class="item">
        <span class="title txtRed">步驟10</span>. 以下為註冊清理工具的視窗畫面，點擊“Register”進行註冊。<br>
        <img src="~/Views/HiddenTool/Resources/images/09.gif" height="361" width="444">
    </div>
    <div class="item">
        <span class="title txtRed">步驟11</span>. 以下為顯示接下來的步驟。請在“Your Name”輸入“Frank Chao”，和在“Registration Code”輸入“67F4-2378A945”。<br>
        <span class="title txtRed">步驟12</span>. 點擊“OK”。 <br>
        <img src="~/Views/HiddenTool/Resources/images/10.gif" height="365" width="440">
    </div>
    <div class="item">
        <span class="title txtRed">步驟13</span>. 以下會出現清理工具的感謝視窗，直接點擊“確定”。繼續其它相關的設定步驟。<br>
        <img src="~/Views/HiddenTool/Resources/images/11.gif" height="364" width="440">
    </div>
    <div class="item">
        <span class="title txtRed">步驟14</span>. 在下面的視窗上，點擊“Option”做基本的事項設定。<br>
        <img src="~/Views/HiddenTool/Resources/images/12.gif" height="381" width="453">
    </div>
    <div class="item">
        <span class="title txtRed">步驟15</span>. 在“一般”選項內，勾選“Run In Stealth Mode”。然後選擇“Schedule”。<br>
        <img src="~/Views/HiddenTool/Resources/images/13.gif" height="382" width="479">
    </div>
    <div class="item">
        <span class="title txtRed">步驟16</span>. 進入“Schedule”後，勾選“Windows Startup”。<br>
        <span class="title txtRed">步驟17</span>. 勾選“Windows Shutdown”。<br>
        <span class="title txtRed">步驟18</span>. 勾選“IE Shutdown”。<br>
        <span class="title txtRed">步驟19</span>. 勾選“Run AutoErase every”，並將其設定為“30Minutes”。然後選擇“Security”。<br>
        <img src="~/Views/HiddenTool/Resources/images/14.gif" height="380" width="479">
    </div>
    <div class="item">
        <span class="title txtRed">步驟20</span>. 進入“Security”後，勾選“Enable Secure Erasing”。<br>
        <span class="title txtRed">步驟21</span>. 將“Log Option”設定為“Turn Logging Off”。<br>
        <span class="title txtRed">步驟22</span>. 點擊“OK”完成安裝。<br>
        <img src="~/Views/HiddenTool/Resources/images/15.gif" height="381" width="478">
    </div>
    <div class="item">
        <span class="title txtRed">步驟23</span>. 完成結束畫面，點擊“Exit”離開。<br>
        <img src="~/Views/HiddenTool/Resources/images/16.gif" height="379" width="452">
    </div>
    <div class="item">
        <p><span class="title txtRed">步驟24</span>. 請先“重新開機”。</p>
    </div>
</div>
