@model IEnumerable<AnnouncementModel>
@{
    Layout = null;
    var userLang = ViewBag.UserLang as string;
    var modeDate = ViewBag.ModeDate as string;
}
<link href="~/views/message/resources/Announcement.less" rel="Stylesheet" type="text/css" />
@using (Html.BeginForm("Announcement", "Message", FormMethod.Get))
{ 
    <table border="0" cellspacing="0" cellpadding="0" class="persist-area his_body">
        <thead class="persist-header">
            <tr>
                <td class="box_title" colspan="3">
                    Announcement
                </td>
            </tr>
            <tr class="m_title_date">
                <td width="50%" class="page" colspan="2">
                    <span>@Html.ActionLink("All", "Announcement", new { modeDate = 0 })</span> / <span>@Html.ActionLink("Today", "Announcement", new { modeDate = 1 })</span>
                    / <span>@Html.ActionLink("Yesterday", "Announcement", new { modeDate = 2 })</span>/
                    <span>@Html.ActionLink("Before Yesterday", "Announcement", new { modeDate = 3 })</span>
                </td>
                <td width="50%" align="right" class="search">
                    @Html.TextBox("content", "", new { @class = "ccroll_input" })
                    <input type="submit" class="ccroll_btn" value="Search">
                </td>
            </tr>
            <tr class="m_title_his">
                <td width="40">
                    No.
                </td>
                <td width="70">
                    Times
                </td>
                <td class="his_info">
                    News
                </td>
            </tr>
        </thead>
        <tbody>
            @{
    if (Model != null && Model.Any())
    {
        var index = 0;

        foreach (var msg in Model)
        {
            index++;
                <tr class="m_cen">
                    <td width="40" align="center">@index
                    </td>
                    <td width="70" align="center">
                        @msg.PostTime.ToLongTimeString()
                    </td>
                    <td class="his_info">
                        @msg.GetFullContent(userLang)
                    </td>
                </tr>
        }
    }
            }
        </tbody>
    </table>
    @Html.Hidden("modeDate", modeDate)
}
@Scripts.Render("~/scripts/messagejs")
