<!DOCTYPE html>
<html lang="en-us">
<head>
	<meta charset="utf-8" />
	<title>@ViewBag.Title</title>
	<meta name="viewport" content="width=device-width" />
	<link href="~/_GlobalResources/Css/jquery-ui-1.10.2/apollo/jquery-ui.min.css" rel="stylesheet" type="text/css" />
	@RenderSection("head", required: false)    
</head>
<body>
	<div id="page_main">
		<div id="header_main">
			@ViewBag.Title
		</div>
		<div id="content_main">
			@RenderBody()
		</div>
	</div>
	@Html.Hidden("ApoRoot", Url.Content("~/"))
	@Scripts.Render("~/scripts/messagejs")
	@RenderSection("foot", required: false)
</body>
</html>