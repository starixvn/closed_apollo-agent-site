@using Apollo.Age.Web.Mvc
@using Apollo.Age.Resources
@model GetMessageCriteria
@{    
    Layout = "~/Views/Message/Shared/_Layout.cshtml";
    ViewBag.Title = Lang.MessageHistory;

    var listMessage = (List<MessageModel>)ViewBag.Messages ?? new List<MessageModel>();
    var normal = string.Empty;
    var special = string.Empty;
    var pri = string.Empty;
    var color = string.Empty;
    var minDate = DateTime.Now.AddMonths(-3);
    var maxDate = DateTime.Now;
    var lang = ViewBag.UserLang;
    var isShowMessageLevel = Convert.ToBoolean(ViewBag.IsShowMessageLevel);

    switch (Model.PageQuery)
    {
        case Constants.Normal:
            normal = "id=current";
            break;
        case Constants.Special:
            special = "id=current";
            color = "Red";
            break;
        case Constants.AllSpecial:
            special = "id=current";
            color = "Red";
            break;
        case Constants.Private:
            color = "Green";
            pri = "id=current";
            break;
        default:
            normal = "id=current";
            break;
    }
}
@section head {
    @Styles.Render("~/css/new-message")
}
<table class="m_tab_ed">
    <tbody>
        <tr>
            <td class="text-right">
                @Lang.news：
            </td>
            <td class="width-520" id="topnews">
            </td>
            <td class="text-center">
                <a href="javascript:void(0);" id="announcement-link">@Lang.announcement </a>
            </td>
        </tr>
        <tr>
            <td colspan="3" class="bg-green">
                &nbsp;
            </td>
        </tr>
        @if (isShowMessageLevel)
        {
            <tr>
                <td class="text-right">
                    @Lang.news：
                </td>
                <td class="width-520" id="topnewsbylevel">
                </td>
                <td class="text-center">
                    <a href="javascript:void(0);" id="announcementLevel-link">@Lang.announcementlevel
                    </a>
                </td>
            </tr>
        
            <tr>
                <td colspan="3" class="bg-green">
                    &nbsp;
                </td>
            </tr>
        }
    </tbody>
</table>
@using (Html.BeginForm("NewMessage", "Message", FormMethod.Get))
{   
    <div id="box_header">
        <div class="row">
            <div class="cell">
                <div class="label">
                    @Html.LabelFor(m => m.FromDate, @Lang.dateRange) :
                </div>
                <div class="editor">
                    @Html.DatePickerFor(m => m.FromDate, minDate: minDate, maxDate: maxDate)
                </div>
            </div>
            <div class="cell">
                <div class="label">
                    @Html.LabelFor(m => m.ToDate, "~")
                </div>
                <div class="editor">
                    @Html.DatePickerFor(m => m.ToDate, minDate: minDate, maxDate: maxDate)
                </div>
            </div>
            <div class="cell">
                <div class="editor">
                    <input type="submit" class="btn" id="dSubmit" value="@Lang.search"/>
                </div>
            </div>
        </div>
    </div>

    <table class="tblRpt message">
        <thead>
            <tr>
                <th colspan="3" class="tbList">
                    <ul>
                        <li @normal><a href="#" query="@Constants.Normal" class="pagequery">
                            @Lang.normalmessage</a> </li>
                        <li @special><a href="#" query="@Constants.Special" class="pagequery">
                            @Lang.specialmessage</a> </li>
                        <li @pri><a href="#" query="@Constants.Private" class="pagequery">
                            @Lang.personalmessage</a> </li>
                    </ul>
                    @Html.HiddenFor(m => m.PageQuery)
                </th>
            </tr>
            <tr>
                <th class="width-40">
                    @Lang.lblNo.
                </th>
                <th class="width-180">
                    @Lang.times
                </th>
                <th>
                    @Lang.news
                </th>
            </tr>
        </thead>
        <tbody>
            @{
    int count = 0;
    if (listMessage != null && listMessage.Any())
    {
        string rowClass = string.Empty;

        foreach (MessageModel itemMessage in listMessage)
        {
            count++;
            rowClass = count % 2 == 0 ? string.Empty : "class='alt'";
                <tr @Html.Raw(rowClass)>
                    <td class="c">
                        @count
                    </td>
                    <td class="c">
                        @itemMessage.PostTime.ToString("yyyy-MM-dd hh:mm:ss")
                    </td>
                    <td class="message_content">
                        @itemMessage.GetContent(lang)
                    </td>
                </tr>
        }
    }    
            }
        </tbody>
    </table>
    @Html.Hidden("messagePrivate", Apollo.Age.Resources.Lang.privatemessage)    
    @Html.Hidden("isShowMessageLevel", isShowMessageLevel ? "true" : "false")       
}