@using Apollo.Age.Web.Mvc
@model Apollo.Age.Web.ViewModels.UnderMaintenanceViewModel
@{
	Layout = null;
	string title = Apollo.Age.Resources.Lang.UnderMaintenance;
    string UMtime = Model.StartTime.ToUpper() + "~" + Model.EndTime.ToUpper() + "(GMT +08:00)";
    }
<!DOCTYPE HTML>
<html>
<head>
	<title>@title</title>
    @Styles.Render("~/css/error")
</head>
<body>
    <div class="container">
        <div class="header">
            <div class="icon-maintenance"></div>
            <div class="title">
                <div class="zh-CN">我们的网站正在维护</div>
                <div class="en-US">OUR WEBSITE IS UNDER MAINTENANCE</div>
                <div class="th-TH">กำลังปรับปรุงระบบ</div>
            </div>
        </div>
        <div class="content">
            <div class="content-container">
                <div class="col">
                    <div class="title">SYSTEM MAINTENANCE</div>
                    <p>We apologize for the inconvenience which this may acuse. If you have any query, please contact us at:</p>
                    <p><strong>Service Discruption Period</strong> - @Model.UMDate.ToUpper()</p>
                    <p><strong>@UMtime</strong></p>
                </div>
                <div class="col">
                    <div class="title">SYSTEM MAINTENANCE</div>
                    <p>We apologize for the inconvenience which this may acuse. If you have any query, please contact us at:</p>
                    <p><strong>Service Discruption Period</strong> - @Model.UMDate.ToUpper()</p>
                    <p><strong>@UMtime</strong></p>
                </div>
                <div class="col">
                    <div class="title">กำลังปรับปรุงระบบ</div>
                    <p>ขออภัยในความไม่สะดวก หากท่านมีข้อสงสัย โปรดติดต่อได้ที่:</p>
                    <p><strong>ช่วงเวลางดให้บริการ</strong> - @Model.UMDate.ToUpper()</p>
                    <p><strong>@UMtime</strong></p>
                </div
            </div>
        </div>
    </div>
</body>
</html>