@using Apollo.Age.Web.Mvc
@model Apollo.Age.Web.ViewModels.UnderMaintenanceViewModel
@{
	Layout = null;
	string title = Apollo.Age.Resources.Lang.UnderMaintenance;
    string UMtime = Model.start_time.ToUpper() + "~" + Model.end_time.ToUpper() + "(GMT +08:00)";
    }
<!DOCTYPE HTML>
<html>
<head>
	<title>@title</title>
    <script src="~/_globalresources/js/head.js"></script>
    <link href="~/views/error/resources/Index.less" rel="stylesheet"/>
</head>
<body>
    <div class="container">
        <div class="header">
            <div class="icon-maintenance"></div>
            <div class="title">
                <div class="zh-CN">我们的网站正在进行系统维护</div>
                <div class="en-US">OUR WEBSITE IS UNDER MAINTENANCE</div>
                <div class="th-TH">กำลังปรับปรุงระบบ</div>
            </div>
        </div>
        <div class="content">
            <div class="content-container">
                <div class="col">
                    <div class="title">系统维护</div>
                    <p>非常抱歉，造成您的不便。如果您有任何疑问，请与我们联系：</p>
                    <p><strong>服务中断期间</strong> - @Model.UMDate.ToUpper()</p>
                    <p><strong>@UMtime</strong></p>
                </div>
                <div class="col">
                    <div class="title">SYSTEM MAINTENANCE</div>
                    <p>We apologize for the inconvenience which this may cause. If you have any query, please contact us at:</p>
                    <p><strong>Service Discruption Period</strong> - @Model.UMDate.ToUpper()</p>
                    <p><strong>@UMtime</strong></p>
                </div>
                <div class="col">
                    <div class="title thailand">กำลังปรับปรุงระบบ</div>
                    <p class="thailand">ขออภัยในความไม่สะดวก หากท่านมีข้อสงสัย โปรดติดต่อได้ที่:</p>
                    <p class="thailand"><strong>ช่วงเวลางดให้บริการ</strong> - @Model.UMDate.ToUpper()</p>
                    <p class="thailand"><strong>@UMtime</strong></p>
                </div>
            </div>
        </div>
    </div>
</body>
</html>