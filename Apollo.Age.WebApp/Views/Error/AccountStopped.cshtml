@{
    Layout = null;
    string title = Apollo.Age.Resources.Lang.lblAccountWasStopped;
    var isInternal = (bool)ViewBag.IsInternal;
}

<!DOCTYPE HTML>
<html>
<head>
    <title>@title</title>
</head>
<body>       
    @if (isInternal)
    { 
        <script type="text/javascript">
            alert('@title');
            parent.location.href='@Url.Action("SignOut", "Internal")';
        </script>
    }    
    <span>@title</span>
</body>
</html>

