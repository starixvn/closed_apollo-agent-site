@{
    ViewBag.Title = "RedirectToUM";
    Layout = null;
    var url = Url.Action("UnderMaintenance");
    var ssoUrl = Request.Url.Host + url;
}
<script src="~/_GlobalResources/Js/jquery.js" type="text/javascript"></script>
<script language="javascript" type="text/javascript">
    if (parent.IsSSO == true) {
        parent.location.href = '@url';
    }
    else {
        location.href = '@url';
    }
    
</script>
