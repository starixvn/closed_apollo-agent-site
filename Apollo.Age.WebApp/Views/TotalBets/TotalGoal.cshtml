@model IEnumerable<Apollo.Age.TotalBets.Models.TotalGoalModel>
@{
    Layout = "~/Views/TotalBets/Shared/_Layout.cshtml";
    ViewBag.Title = Lang.totalgoal;
    var hasDownlineDetailsPermission = ViewBag.HasDownlineDetailsPermission != null ? (bool)ViewBag.HasDownlineDetailsPermission : false;
}
<table class="tblRpt persist-area">
    <thead class="persist-header">
        <tr class="RptHeader">
            <td style="width: 9%;">
                @Lang.time
                <br />
                (@Lang.GMT+8)
            </td>
            <td style="width: 25%;">
                @Lang.homeaway
            </td>
            <td>
                @Lang.total01
            </td>
            <td>
                @Lang.total23
            </td>
            <td>
                @Lang.total46
            </td>
            <td>
                @Lang.total7over
            </td>
        </tr>
    </thead>
    <tbody>
        @{
            if (Model.Any())
            {
                int count = 0;
                var classRow = string.Empty;
                foreach (var item in Model)
                {
                    count++;
                    if (count % 2 != 0)
                    {
                        classRow = "alt";
                    }
                    else
                    {
                        classRow = string.Empty;
                    }
            <tr class="item @item.Closed @classRow">
                @Html.FormatShowTime(item.ShowTime)
                <td style="width: 150px;" class="home-away-team">
                    @if (hasDownlineDetailsPermission)
                    { 
                        <a  class="view-bet-list" match-id="@item.MatchId" bet-type="6" betlist-type="BettypeMatch"  
                            href="javascript:void(0);"  league-name="@item.AwayTeam" bet-type-name="@Lang.totalgoal"  title="@Lang.ViewBetList">
                            @item.HomeTeam
                        </a>
                    }
                    else
                    { 
                        @item.HomeTeam
                    }
                    <br />
                    @item.AwayTeam
                </td>
                <td class="r fcnum" style="width: 80px;">
                    @RazorHelper.FormatPositiveNumber(item.Total01, 2)
                </td>
                <td class="r fcnum" style="width: 80px;">
                    @RazorHelper.FormatPositiveNumber(item.Total23, 2)
                </td>
                <td class="r fcnum" style="width: 80px;">
                    @RazorHelper.FormatPositiveNumber(item.Total46, 2)
                </td>
                <td class="r fcnum" style="width: 80px;">
                    @RazorHelper.FormatPositiveNumber(item.Total7Over, 2)
                </td>
            </tr>
                }
            }
            else
            {
                //@RazorHelper.ShowNoInfo(colspan: 7)
            }
        }
    </tbody>
</table>
@section scripts
{
    <script type="text/javascript">
        var DEFAULT_OBJECT = function () {
            return {
                initData: function () {
                    TOTALBETS.initViewBetList();
                }
            };
        } ();
        $(function () {
            DEFAULT_OBJECT.initData();
        });
    </script>
}
