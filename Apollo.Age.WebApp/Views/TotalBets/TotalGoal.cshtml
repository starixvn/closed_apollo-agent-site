@model IEnumerable<Apollo.Age.TotalBets.Models.TotalGoalModel>
@{
    Layout = "~/Views/TotalBets/Shared/_Layout.cshtml";
    ViewBag.Title = Apollo.Age.Resources.Lang.totalgoal;
}

<table class="tblRpt persist-area">
    <thead class="persist-header">
        <tr class="RptHeader">
            <td style="width: 9%;">
                @*@Apollo.Age.Resources.Lang.TimeGMT8*@
                @Apollo.Age.Resources.Lang.time
                <br />
                (@Apollo.Age.Resources.Lang.gmt8)
            </td>
            <td style="width: 25%;">
                @Apollo.Age.Resources.Lang.homeaway
            </td>
@*            <td style="width: 150px;">
                @Apollo.Age.Resources.Lang.away
            </td>*@
            <td >
                @Apollo.Age.Resources.Lang.total01
            </td>
            <td >
                @Apollo.Age.Resources.Lang.total23
            </td>
            <td >
                @Apollo.Age.Resources.Lang.total46
            </td>
            <td >
                @Apollo.Age.Resources.Lang.total7over
            </td>
        </tr>
    </thead>
    <tbody>
        @{
            if (Model.Any())
            {
                int count = 0;
                var classRow = string.Empty;
                foreach (var item in Model)
                {
                    count++;
                    if (count % 2 != 0)
                    {
                        classRow = "alt";
                    }
                    else
                    {
                        classRow = string.Empty;
                    }
                <tr class="item @item.Closed @classRow">
                
               @Html.FormatShowTime(item.ShowTime)
                    <td style="width: 150px;" class="home-away-team">
                        <a  class="view-bet-list" match-id="@item.MatchId" bet-type="6" betlist-type="BettypeMatch"  
                            href="javascript:void(0);"  league-name="@item.AwayTeam" bet-type-name="@Apollo.Age.Resources.Lang.totalgoal"  title="@Apollo.Age.Resources.Lang.ViewBetList">
                            @item.HomeTeam
                            
                        </a>
                        <br />
                            @item.AwayTeam
                    </td>
                    <td class="r fcnum" style="width: 80px;">
                        @RazorHelper.FormatPositiveNumber(item.Total01, 2)
                    </td>
                    <td class="r fcnum" style="width: 80px;">
                        @RazorHelper.FormatPositiveNumber(item.Total23, 2)
                    </td>
                    <td class="r fcnum" style="width: 80px;">
                        @RazorHelper.FormatPositiveNumber(item.Total46, 2)
                    </td>
                    <td class="r fcnum" style="width: 80px;">
                        @RazorHelper.FormatPositiveNumber(item.Total7Over, 2)
                    </td>
                </tr>
                }
            }
            else
            { 
            //@RazorHelper.ShowNoInfo(colspan: 7)
            }
        }
    </tbody>
</table>

@section scripts
{
    <script type="text/javascript">
        var DEFAULT_OBJECT = function () {
            return {
                initData: function () {
                    TOTALBETS.initViewBetList();
                }
            };
        }();
        $(function () {
            DEFAULT_OBJECT.initData();
        });
    </script>       
}
