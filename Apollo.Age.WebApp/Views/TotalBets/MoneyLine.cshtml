@using Apollo.Age.TotalBets.Models
@{
    Layout = "~/Views/TotalBets/Shared/_Layout.cshtml";
    ViewBag.Title = Apollo.Age.Resources.Lang.moneyline;
    var hasDownlineDetailsPermission = ViewBag.HasDownlineDetailsPermission != null ? (bool)ViewBag.HasDownlineDetailsPermission : false;
}
@model IEnumerable<MoneyLineModel>
@helper ShowLeague(int currentLeagueId, MoneyLineModel item)
    {
        if (currentLeagueId != item.LeagueId)
        { 
    <!--LeagueContents-->
    <tr class="league">
        <td colspan="12">
            @item.LeagueName
        </td>
    </tr>
        }            
}
@helper ShowTotal(int betCount, decimal odds)
    {
        if (betCount != 0)
        {
    @Formater.FormatNumber2(odds, "en-US")                
        }   
}
@helper ShowForecas(int betCount, decimal winlost)
    {
        if (betCount != 0)
        {
    @RazorHelper.FormatPositiveNumber(winlost, 2)
        }
}
<table class="tblRpt persist-area" style="width: 100%">
    <thead class="persist-header">
        <tr class="RptHeader">
            <td rowspan="2" style="width: 9%;">
                @*@Lang.TimeGMT8*@
                @Lang.time
                <br />
                (@Lang.GMT+8)
            </td>
            @*  <td rowspan="2" style="width: 7%;">
                @Lang.lblScore
            </td>*@
            <td rowspan="2" style="width: 25%;">
                @Lang.league
            </td>
            <td rowspan="2" style="width: 15%;">
                @Lang.homeaway
            </td>
            <td colspan="4">
                @Lang.fulltime
            </td>
            <td colspan="4">
                @Lang.lbl1sthalf
            </td>
        </tr>
        <tr class="RptHeader02">
            <td>
                @Lang.totalhome
            </td>
            <td>
                @Lang.totalaway
            </td>
            <td>
                @Lang.forecasthome
            </td>
            <td>
                @Lang.forecastaway
            </td>
            <td>
                @Lang.totalhome
            </td>
            <td>
                @Lang.totalaway
            </td>
            <td>
                @Lang.forecasthome
            </td>
            <td>
                @Lang.forecastaway
            </td>
        </tr>
    </thead>
    <tbody>
        <!--LeagueContents-->
        @{
        
            if (Model != null && Model.Any())
            {
                int rowIndex = 0;
                int currentLeagueId = 0;
                var classRow = string.Empty;

                foreach (var item in Model)
                {
                    rowIndex++;

                    //@ShowLeague(currentLeagueId, item)  
            
            <!--MatchContents-->
            <tr class='r'>
                @Html.FormatShowTime(item.ShowTime)
                <td class="c">
                    @item.LeagueName
                </td>
                <td class="l no-border-bottom  valign-top home-away-team">
                    @item.HomeTeam
                    <br />
                    @item.AwayTeam
                </td>
                <td>
                    @if (hasDownlineDetailsPermission)
                    { 
                        <a class="fcnum  view-bet-list" match-id="@item.MatchId" bet-type="20" betlist-type="BettypeMatch" 
                        href="javascript:void(0);" league-name="@item.LeagueName" bet-type-name="Money Line" title="@Lang.ViewBetList">@ShowTotal(item.BetCountHome, item.HomeOdds)
                        </a>
                    }
                    else
                    {
                        @ShowTotal(item.BetCountHome, item.HomeOdds)
                    }
                </td>
                <td>
                    @if (hasDownlineDetailsPermission)
                    { 
                        <a class="fcnum  view-bet-list" match-id="@item.MatchId" bet-type="20" betlist-type="BettypeMatch" 
                        href="javascript:void(0);" league-name="@item.LeagueName" bet-type-name="Money Line" title="@Lang.ViewBetList">@ShowTotal(item.BetCountAway, item.AwayOdds)
                        </a>
                    }
                    else
                    {
                        @ShowTotal(item.BetCountAway, item.AwayOdds)
                    }
                </td>
                <td>
                    @if (hasDownlineDetailsPermission)
                    { 
                        <a class="fcnum view-bet-list" match-id="@item.MatchId" bet-type="20" betlist-type="BettypeMatch" 
                        href="javascript:void(0);" league-name="@item.LeagueName" bet-type-name="Money Line" title="@Lang.ViewBetList">@ShowForecas(item.BetCountHome, item.HomeWinLost)
                        </a>
                    }
                    else
                    { 
                        @ShowForecas(item.BetCountHome, item.HomeWinLost)
                    }
                </td>
                <td>
                    @if (hasDownlineDetailsPermission)
                    { 
                        <a class="fcnum view-bet-list" match-id="@item.MatchId" bet-type="20" betlist-type="BettypeMatch" 
                        href="javascript:void(0);" league-name="@item.LeagueName" bet-type-name="Money Line" title="@Lang.ViewBetList">@ShowForecas(item.BetCountAway, item.AwayWinLost)
                        </a>
                    }
                    else
                    {
                        @ShowForecas(item.BetCountAway, item.AwayWinLost)
                    }
                </td>
                <td>
                    @if (hasDownlineDetailsPermission)
                    { 
                        <a class="fcnum view-bet-list" match-id="@item.MatchId" bet-type="21" betlist-type="BettypeMatch" 
                        href="javascript:void(0);" league-name="@item.LeagueName" bet-type-name="1st Money Line" title="@Lang.ViewBetList">@ShowTotal(item.BetCountHomeHalfTime, item.HomeOddsHalfTime)
                        </a>
                    }
                    else
                    { 
                        @ShowTotal(item.BetCountHomeHalfTime, item.HomeOddsHalfTime)
                    }
                </td>
                <td>
                    @if (hasDownlineDetailsPermission)
                    { 
                        <a class="fcnum view-bet-list" match-id="@item.MatchId" bet-type="21" betlist-type="BettypeMatch" 
                        href="javascript:void(0);" league-name="@item.LeagueName" bet-type-name="1st Money Line" title="@Lang.ViewBetList">@ShowTotal(item.BetCountAwayHalfTime, item.AwayOddsHalfTime)
                        </a>
                    }
                    else
                    {
                        @ShowTotal(item.BetCountAwayHalfTime, item.AwayOddsHalfTime)
                    }
                </td>
                <td>
                    @if (hasDownlineDetailsPermission)
                    { 
                        <a class="fcnum view-bet-list" match-id="@item.MatchId" bet-type="21" betlist-type="BettypeMatch" 
                        href="javascript:void(0);" league-name="@item.LeagueName" bet-type-name="1st Money Line" title="@Lang.ViewBetList">@ShowForecas(item.BetCountHomeHalfTime, item.HomeHalfTimeWinLost)
                        </a>
                    }
                    else
                    { 
                        @ShowForecas(item.BetCountHomeHalfTime, item.HomeHalfTimeWinLost)
                    }
                </td>
                <td>
                    @if (hasDownlineDetailsPermission)
                    { 
                        <a class="fcnum view-bet-list" match-id="@item.MatchId" bet-type="21" betlist-type="BettypeMatch" 
                        href="javascript:void(0);" league-name="@item.LeagueName" bet-type-name="1st Money Line" title="@Lang.ViewBetList">@ShowForecas(item.BetCountAwayHalfTime, item.AwayHalfTimeWinLost)
                        </a>
                    }
                    else
                    { 
                        @ShowForecas(item.BetCountAwayHalfTime, item.AwayHalfTimeWinLost)
                    }
                </td>
            </tr>
  
                    currentLeagueId = item.LeagueId;
                }
            }
            else
            {
                //@RazorHelper.ShowNoInfo(colspan: 11)
            }            
        }
    </tbody>
</table>
@section scripts
{
    <script type="text/javascript">
        var DEFAULT_OBJECT = function () {
            return {
                initData: function () {
                    TOTALBETS.initViewBetList();

                }
            };
        } ();
        $(function () {
            DEFAULT_OBJECT.initData();
        });
    </script>
}
