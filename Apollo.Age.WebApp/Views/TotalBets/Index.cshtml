@{
	Layout = null;
	var menu = new List<string[]>
	{
		new string[] {"~/totalBets/handicap", Apollo.Age.Resources.Lang.lblHOUL},
		new string[] {"~/totalBets/moneyline", Apollo.Age.Resources.Lang.moneyline},
		new string[] {"~/totalBets/oddeven", Apollo.Age.Resources.Lang.OE1x2DND},
		new string[] {"~/_betList/BetList.aspx?type=CorrectScore", "CScore"},
		new string[] {"~/totalBets/totalgoal", Apollo.Age.Resources.Lang.totalgoal},
		new string[] {"~/_betList/BetList.aspx?type=MixParlay", "MPL"},
		new string[] {"~/_betList/BetList.aspx?type=CombMixParlayBetList", "SPL"},
		new string[] {"~/totalBets/outright", Apollo.Age.Resources.Lang.lblOutRight},
		new string[] {"~/totalBets/htft", Apollo.Age.Resources.Lang.htft},
		new string[] {"~/totalBets/firstgoal", Apollo.Age.Resources.Lang.fglg},
		new string[] {"~/_betList/BetList.aspx?bettype=13&amp;type=Bettype", "CSheet"},
		new string[] {"~/_betList/BetList.aspx?bettype=24&amp;type=Bettype", "DC"},
		new string[] {"~/totalBets/homenobet", Apollo.Age.Resources.Lang.lblHomeDrawAwayNoBet},
		new string[] {"~/_betList/BetList.aspx?bettype=26&amp;type=Bettype", "B/O/NTTS"},
		new string[] {"~/_betList/BetList.aspx?bettype=27&amp;type=Bettype", "WN"},
		new string[] {"~/_betList/BetList.aspx?bettype=28&amp;type=Bettype", "3WHDP"}
	};
	int menuItemCount = menu.Count;
}
<!DOCTYPE html>
<html lang="en-us">
<head>
	<title>Forecast</title>
	<link href="~/views/totalbets/resources/totalbets.less" rel="Stylesheet" type="text/css" />
</head>
<body>
	<div id="function-bar">
		<ul class="menu">
		@for (int i = 0; i < 10; i++)
		{
			var item = menu[i];
			<li><a href="@Url.Content(item[0])" target="submain">@item[1]</a></li>
		}
			<li id="more-link"><a href="javascript:;">@Apollo.Age.Resources.Lang.more...</a>
				<ul class="sub-menu" style="display: none">
				@for (int i = 10; i < menuItemCount; i++)
				{
					var item = menu[i];
					<li><a href="@Url.Content(item[0])" target="submain">@item[1]</a></li>
				}			
				</ul>
			</li>
		</ul>
		<img alt="" src="~/_GlobalResources/Images/top_04.gif">
	</div>

	<div class="mainpage">
		<iframe id="submain" name="submain" width="100%" height="99%" frameborder="0"></iframe>
	</div>

	@Scripts.Render("~/scripts/forecast-indexjs")
</body>
</html>