@using Apollo.Age.TotalBets.Models

@{
    Layout = "~/Views/TotalBets/Shared/_Layout.cshtml";
    ViewBag.Title = string.Format("{0} + {1} + {2}/{3}", Apollo.Age.Resources.Lang.lblOddEven, Apollo.Age.Resources.Lang.lbl1x2, Apollo.Age.Resources.Lang.lblDraw, Apollo.Age.Resources.Lang.lblNoDraw);
}
@model IEnumerable<OddEvenModel>
@helper ShowLeague(int currentLeagueId, OddEvenModel item)
    {
        if (currentLeagueId != item.LeagueId)
        { 
    <!--LeagueContents-->
    <tr class="league">
        <td colspan="10" class="league">
            @item.LeagueName
        </td>
    </tr>
        }            
}
@helper ShowTotal(int betCount, decimal odds)
    {
    if (betCount != 0)
    {
    @Formater.FormatNumber2(odds, "en-US")                
    }   
}
@helper ShowForecas(int betCount, decimal winlost)
    {
    if (betCount != 0)
    {
    @RazorHelper.FormatPositiveNumber(winlost, 2)
    }
}
@helper Show1x2Button(OddEvenModel item, bool isFullTime)
    {
    if (isFullTime)
    {
        <td style="width: 70px" >
            <!--OneXTwoValue-->
            <a class="fcnum  view-bet-list" match-id="@item.MatchId" bet-type="5" betlist-type="BettypeMatch" 
                href="javascript:void(0);" league-name="@item.LeagueName" bet-type-name="@Apollo.Age.Resources.Lang.lbl1x2" title="@Apollo.Age.Resources.Lang.ViewBetList">
                @RazorHelper.FormatNumber(item.OneXTwoTotal, 2, showZero: item.BetCount1X2 != 0)
            </a>
            <!--/OneXTwoValue-->
        </td>
           
        <td class="fcbtn" align="center" style="width: 16px">
            @if (item.OneXTwoTotal != 0)
            { 
                <!--OneXTwoButton-->
                <a match-id="@item.MatchId" league-name="@item.LeagueName" bet-type="5" href="javascript:void(0);" class="btnInfo view-forecast" title="@Apollo.Age.Resources.Lang.ViewForeCast"></a>
                <!--/OneXTwoButton-->
            }
        </td>
        
    }
    else
    {
        <td style="width: 70px" >
            <!--OneXTwoFirstHalfValue-->
            <a class="fcnum  view-bet-list" match-id="@item.MatchId" bet-type="15" betlist-type="BettypeMatch" 
                href="javascript:void(0);" league-name="@item.LeagueName" bet-type-name="@Apollo.Age.Resources.Lang.lbl1x2_1st" title="@Apollo.Age.Resources.Lang.ViewBetList">
                @RazorHelper.FormatNumber(item.OneXTwoFirstHalf, 2, showZero: item.BetCount1X2HalfTime != 0)
            </a>
            <!--/OneXTwoFirstHalfValue-->
        </td>
        
        <td class="fcbtn" align="center" style="width: 16px" >
            @if (item.OneXTwoFirstHalf != 0)
            {
                <!--OneXTwoFirstHalfButton-->
                <a match-id="@item.MatchId" league-name="@item.LeagueName" bet-type="15" href="javascript:void(0);" class="btnInfo view-forecast" title="@Apollo.Age.Resources.Lang.ViewForeCast"></a>
            }
            <!--/OneXTwoFirstHalfButton-->
        </td>
       
    }
}
@helper ShowTime(OddEvenModel item)
{
    <td class="c bl_time" >
        @if (item.LiveIndicator)
        {
            @Html.Raw(item.LiveHomeScore + " - " + item.LiveAwayScore)
            <br />
            <!--LiveNotice-->
            <i style="color: red">@Apollo.Age.Resources.Lang.lblLive</i>
            <!--/LiveNotice-->
        }
        else
        {
            @Html.Raw(item.ShowTime)
        }
    </td>
}
@RazorHelper.RefreshCountDown("OddEven", 15, 15, "ReloadPage();")
<table class="tblRpt persist-area">
    <thead class="persist-header">
        <tr class="RptHeader">
            <td rowspan="2" style="width: 60px;">
                @Apollo.Age.Resources.Lang.time
            </td>
            <td rowspan="2" style="width: 110px;">
                
            </td>
            <td rowspan="2" style="width: 150px;">
                @Apollo.Age.Resources.Lang.league
            </td>
            <td rowspan="2">
                @Apollo.Age.Resources.Lang.homeaway
            </td>
            <td colspan="4">
                @Apollo.Age.Resources.Lang.fulltime
            </td>
            <td colspan="3">
                @Apollo.Age.Resources.Lang.lbl1sthalf
            </td>
        </tr>
        <tr class="RptHeader02">
            <td style="width: 100px;">
                @Apollo.Age.Resources.Lang.lblOddEven
            </td>
            <td colspan="2" style="width: 100px;">
                @Apollo.Age.Resources.Lang.lbl1x2
            </td>
            <td style="width: 100px;">
                @Apollo.Age.Resources.Lang.lblDraw/@Apollo.Age.Resources.Lang.lblNoDraw
            </td>
            <td style="width: 100px;">
                @Apollo.Age.Resources.Lang.lblOddEven
            </td>
            <td colspan="2" style="width: 100px;">
                @Apollo.Age.Resources.Lang.lbl1x2
            </td>
        </tr>
    </thead>
    <tbody>
        <!--LeagueContents-->
        @{
        
            if (Model != null && Model.Any())
            {
                int rowIndex = 0;
                int currentLeagueId = 0;
                var classRow = string.Empty;

                foreach (var item in Model)
                {
                    rowIndex++;
                    
                    if (item.LiveIndicator)
                    {
                        classRow = "live";
                    }
                    else
                    {                       
                        classRow = string.Empty;                        
                    }
                    
            //@ShowLeague(currentLeagueId, item)  
            
            <!--MatchContents-->
            <tr class='r @classRow'>
                 <td class="c">
                        @if(item.KickOffTime != null){
                            @Html.Raw(Formater.FormatDateTime22(item.KickOffTime.Value))
                        }
                    </td>
                    @ShowTime(item)
                    <td class="c">
                         @item.LeagueName 
                    </td>
                <td class="l" >
                    @item.HomeTeam 
                    <br />
                    @item.AwayTeam
                </td>
                <td>
                    <!--OddEvenValue-->
                    <a class="fcnum  view-bet-list" match-id="@item.MatchId" bet-type="2" betlist-type="BettypeMatch" 
                        href="javascript:void(0);" league-name="@item.LeagueName" bet-type-name="@Apollo.Age.Resources.Lang.lblOddEven" title="@Apollo.Age.Resources.Lang.ViewBetList"> 
                        @RazorHelper.FormatNegativeNumber(item.OddEvenTotal, 2, showZero: item.BetCountOddEven != 0)
                    </a>
                    <!--/OddEvenValue-->
                </td>
                @Show1x2Button(item, true)
                <td style="width: 86px" >
                    <!--DNDValue-->
                    <a class="fcnum  view-bet-list" match-id="@item.MatchId" bet-type="123" betlist-type="BettypeMatch" 
                        href="javascript:void(0);" league-name="@item.LeagueName" bet-type-name="@Apollo.Age.Resources.Lang.lblHomeDrawAwayNoBet" title="@Apollo.Age.Resources.Lang.ViewBetList">
                        @RazorHelper.FormatNumber(item.DrawNoDrawTotal, 2, showZero: item.BetCountDrawNoDraw != 0)
                    </a>
                    <!--/DNDValue-->
                </td>
                <td >
                    <!--OddEvenFirstHalfValue-->
                    <a class="fcnum  view-bet-list" match-id="@item.MatchId" bet-type="12" betlist-type="BettypeMatch" 
                        href="javascript:void(0);" league-name="@item.LeagueName" bet-type-name="@Apollo.Age.Resources.Lang.lblOddEven_1st" title="@Apollo.Age.Resources.Lang.ViewBetList">
                        @RazorHelper.FormatNegativeNumber(item.OddEvenFirstHalf, 2, showZero: item.BetCountHalfTimeOddEven != 0)
                    </a>
                    <!--/OddEvenFirstHalfValue-->
                </td>
                @Show1x2Button(item, false)
            </tr>

                    currentLeagueId = item.LeagueId;
                }
            }
            else
            { 
            @RazorHelper.ShowNoInfo(colspan: 11)
            }            
        }
    </tbody>
</table>
@section scripts
{
    <script type="text/javascript">
        var DEFAULT_OBJECT = function () {
            return {
                initData: function () {
                    TOTALBETS.initViewForecast1x2();
                    TOTALBETS.initViewBetList(); 
                }
            };
        } ();
        $(function () {
            DEFAULT_OBJECT.initData();
        });
    </script>       
}