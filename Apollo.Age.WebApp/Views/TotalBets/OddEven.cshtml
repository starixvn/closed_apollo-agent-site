@using Apollo.Age.TotalBets.Models
@{
    Layout = "~/Views/TotalBets/Shared/_Layout.cshtml";
    ViewBag.Title = string.Format("{0} + {1} + {2}/{3}", Apollo.Age.Resources.Lang.lblOddEven, Apollo.Age.Resources.Lang.lbl1x2, Apollo.Age.Resources.Lang.lblDraw, Apollo.Age.Resources.Lang.lblNoDraw);
    var hasDownlineDetailsPermission = ViewBag.HasDownlineDetailsPermission != null ? (bool)ViewBag.HasDownlineDetailsPermission : false;
}
@model IEnumerable<OddEvenModel>
@helper ShowTotal(int betCount, decimal odds)
    {
        if (betCount != 0)
        {
    @Formater.FormatNumber2(odds, "en-US")
        }
}
@helper ShowForecas(int betCount, decimal winlost)
    {
        if (betCount != 0)
        {
    @RazorHelper.FormatPositiveNumber(winlost, 2)
        }
}
@helper Show1x2Button(OddEvenModel item, bool isFullTime, bool hasDownlineDetailsPermission = true)
    {
        if (isFullTime)
        {
    <td style="width: 70px">
        <!--OneXTwoValue-->
        @if (hasDownlineDetailsPermission)
        { 
            <a class="fcnum  view-bet-list" match-id="@item.MatchId" bet-type="5" betlist-type="BettypeMatch" 
                href="javascript:void(0);" league-name="@item.LeagueName" bet-type-name="@Lang.lbl1x2" title="@Lang.ViewBetList">
                @RazorHelper.FormatNumber(item.OneXTwoTotal, 2, showZero: item.BetCount1X2 != 0)
            </a>
        }
        else
        { 
            @RazorHelper.FormatNumber(item.OneXTwoTotal, 2, showZero: item.BetCount1X2 != 0)
        }
        <!--/OneXTwoValue-->
    </td>
           
    <td class="fcbtn" align="center" style="width: 16px">        
        @if (item.OneXTwoTotal != 0)
        {
             <!--OneXTwoButton-->
                <input match-id="@item.MatchId" type="button" league-name="@item.LeagueName" bet-type="5" class="fc-button view-forecast" title="@Lang.ViewForeCast" value="+" />
                <!--/OneXTwoButton-->  
        }
    </td>
        
        }
        else
        {
    <td style="width: 70px">
        <!--OneXTwoFirstHalfValue-->
        @if (hasDownlineDetailsPermission)
        { 
            <a class="fcnum  view-bet-list" match-id="@item.MatchId" bet-type="15" betlist-type="BettypeMatch" 
                href="javascript:void(0);" league-name="@item.LeagueName" bet-type-name="@Lang.lbl1x2_1st" title="@Lang.ViewBetList">
                @RazorHelper.FormatNumber(item.OneXTwoFirstHalf, 2, showZero: item.BetCount1X2HalfTime != 0)
            </a>
        }
        else
        { 
            @RazorHelper.FormatNumber(item.OneXTwoFirstHalf, 2, showZero: item.BetCount1X2HalfTime != 0)
        }
        <!--/OneXTwoFirstHalfValue-->
    </td>
        
    <td class="fcbtn" align="center" style="width: 16px">
        @if (item.OneXTwoFirstHalf != 0)
        {
            <!--OneXTwoFirstHalfButton-->
            <input  match-id="@item.MatchId" type="button" league-name="@item.LeagueName" bet-type="15" class="fc-button view-forecast" title="@Lang.ViewForeCast" value="+" />
            <!--/OneXTwoFirstHalfButton-->
        }
    </td>
        }
}
@helper ShowTime(OddEvenModel item)
    {
    <td class="c bl_time">
        @if (item.LiveIndicator)
        {
            @Html.Raw(item.LiveHomeScore + " - " + item.LiveAwayScore)
        }
@* else
        {
            @Html.Raw(item.ShowTime)
        }*@
    </td>
}
<table class="tblRpt persist-area">
    <thead class="persist-header">
        <tr class="RptHeader">
            <td rowspan="2" style="width: 9%;">
                @Lang.time
                <br />
                (@Lang.GMT+8)
            </td>
            <td rowspan="2" style="width: 7%;">
                @Lang.lblScore
            </td>
            <td rowspan="2" style="width: 25%;">
                @Lang.league
            </td>
            <td rowspan="2" style="width: 15%;">
                @Lang.homeaway
            </td>
            <td colspan="4">
                @Lang.fulltime
            </td>
            <td colspan="3">
                @Lang.lbl1sthalf
            </td>
        </tr>
        <tr class="RptHeader02">
            <td style="width: 100px;">
                @Lang.lblOddEven
            </td>
            <td colspan="2" style="width: 100px;">
                @Lang.lbl1x2
            </td>
            <td style="width: 100px;">
                @Lang.lblDraw/@Lang.lblNoDraw
            </td>
            <td style="width: 100px;">
                @Lang.lblOddEven
            </td>
            <td colspan="2" style="width: 100px;">
                @Lang.lbl1x2
            </td>
        </tr>
    </thead>
    <tbody>
        <!--LeagueContents-->
        @{
        
            if (Model != null && Model.Any())
            {
                int rowIndex = 0;
                var classRow = string.Empty;

                foreach (var item in Model)
                {
                    rowIndex++;

                    if (item.LiveIndicator)
                    {
                        classRow = "live";
                    }
                    else
                    {
                        classRow = string.Empty;
                    }
            <!--MatchContents-->
            <tr class='r @classRow'>
                @Html.FormatShowTime(item.ShowTime)
                @ShowTime(item)
                <td class="c">
                    @item.LeagueName
                </td>
                <td class="l valign-top home-away-team">
                    @item.HomeTeam
                    <br />
                    @item.AwayTeam
                </td>
                <td>
                    <!--OddEvenValue-->
                    @if (hasDownlineDetailsPermission)
                    { 
                        <a class="fcnum  view-bet-list" match-id="@item.MatchId" bet-type="2" betlist-type="BettypeMatch" 
                        href="javascript:void(0);" league-name="@item.LeagueName" bet-type-name="@Lang.lblOddEven" title="@Lang.ViewBetList">
                            @RazorHelper.FormatNegativeNumber(item.OddEvenTotal, 2, showZero: item.BetCountOddEven != 0)
                        </a>
                    }
                    else
                    { 
                        @RazorHelper.FormatNegativeNumber(item.OddEvenTotal, 2, showZero: item.BetCountOddEven != 0)
                    }
                    <!--/OddEvenValue-->
                </td>
                @Show1x2Button(item, true, hasDownlineDetailsPermission)
                <td style="width: 86px">
                    <!--DNDValue-->
                    <a class="fcnum  view-bet-list" match-id="@item.MatchId" bet-type="123" betlist-type="BettypeMatch" 
                        href="javascript:void(0);" league-name="@item.LeagueName" bet-type-name="@Lang.lblHomeDrawAwayNoBet" title="@Lang.ViewBetList">
                        @RazorHelper.FormatNumber(item.DrawNoDrawTotal, 2, showZero: item.BetCountDrawNoDraw != 0)
                    </a>
                    <!--/DNDValue-->
                </td>
                <td>
                    <!--OddEvenFirstHalfValue-->
                    @if (hasDownlineDetailsPermission)
                    { 
                        <a class="fcnum  view-bet-list" match-id="@item.MatchId" bet-type="12" betlist-type="BettypeMatch" 
                        href="javascript:void(0);" league-name="@item.LeagueName" bet-type-name="@Lang.lblOddEven_1st" title="@Lang.ViewBetList">
                            @RazorHelper.FormatNegativeNumber(item.OddEvenFirstHalf, 2, showZero: item.BetCountHalfTimeOddEven != 0)
                        </a>
                    }
                    else
                    { 
                        @RazorHelper.FormatNegativeNumber(item.OddEvenFirstHalf, 2, showZero: item.BetCountHalfTimeOddEven != 0)
                    }
                    <!--/OddEvenFirstHalfValue-->
                </td>
                @Show1x2Button(item, false, hasDownlineDetailsPermission)
            </tr>
                }
            }
            else
            {
                //@RazorHelper.ShowNoInfo(colspan: 11)
            }
        }
    </tbody>
</table>
@section scripts
{
    <script type="text/javascript">
        var DEFAULT_OBJECT = function () {
            return {
                initData: function () {
                    TOTALBETS.initViewForecast1x2();
                    TOTALBETS.initViewBetList();
                }
            };
        } ();
        $(function () {
            DEFAULT_OBJECT.initData();
        });
    </script>
}
