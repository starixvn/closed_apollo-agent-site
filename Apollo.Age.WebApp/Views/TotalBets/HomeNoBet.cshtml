@using Apollo.Age.TotalBets.Models
@{
    Layout = "~/Views/TotalBets/Shared/_Layout.cshtml";
    ViewBag.Title = Apollo.Age.Resources.Lang.lblHomeDrawAwayNoBet;
}

@model IEnumerable<HomeNoBetModel>

@helper ShowLeague(int currentLeagueId, HomeNoBetModel item)
{
    if (currentLeagueId != item.LeagueId)
    { 
        <!--LeagueContents-->
        <tr class="league">
            <td colspan="6">
                @item.LeagueName
            </td>
        </tr>
    }            
}

@helper ShowMatch(int index, HomeNoBetModel item)
{
    var classRow = string.Empty;
    if (item.LiveIndicator)
    {
        classRow = "class=live";
    }
    else
    {       
        classRow = string.Empty;        
    }
    
    <tr @classRow>
        @Html.FormatShowTime(item.ShowTime)
        @ShowTime(item)
        <td class="c">
            @item.LeagueName
        </td>
        <td  class="no-border-bottom  valign-top home-away-team">
            @item.HomeTeam
            <br />
            @item.AwayTeam
        </td>
        
        <td class="r" >
            @if(item.BetCountHNB != 0)
            {
                <a class="fcnum view-bet-list" match-id="@item.MatchId" bet-type="121" betlist-type="BettypeMatch" 
                    href="javascript:void(0);" league-name="@item.LeagueName" bet-type-name="@Apollo.Age.Resources.Lang.lblHomeNoBet" title="@Apollo.Age.Resources.Lang.ViewBetList">
                    @RazorHelper.FormatNumber(item.HomeOddsHNB - item.AwayOddsHNB, 2)    
                </a>
            }
            
        </td>
        <td class="r" >
            @if(item.BetCountDNB != 0)
            {
                <a class="fcnum view-bet-list" match-id="@item.MatchId" bet-type="25" betlist-type="BettypeMatch" 
                    href="javascript:void(0);" league-name="@item.LeagueName" bet-type-name="@Apollo.Age.Resources.Lang.lblDrawNoBet" title="@Apollo.Age.Resources.Lang.ViewBetList">
                    @RazorHelper.FormatNumber(item.HomeOddsDNB - item.AwayOddsDNB, 2)
                </a>
            }
        </td>
        <td class="r" >
            @if(item.BetCountANB != 0)
            {
                <a class="fcnum view-bet-list" match-id="@item.MatchId" bet-type="122" betlist-type="BettypeMatch" 
                    href="javascript:void(0);" league-name="@item.LeagueName" bet-type-name="@Apollo.Age.Resources.Lang.lblAwayNoBet" title="@Apollo.Age.Resources.Lang.ViewBetList">
                    @RazorHelper.FormatNumber(item.HomeOddsANB - item.AwayOddsANB, 2)
                </a>
            }
        </td>
    </tr>   
   
}

@helper ShowTime(HomeNoBetModel item)
    {
    <td class="c bl_time" >
        @if (item.LiveIndicator)
        {
            @Html.Raw(item.LiveHomeScore + " - " + item.LiveAwayScore)
        }
        @*else
        {
            @Html.Raw(item.ShowTime)
        }*@
    </td>
}

<table class="tblRpt persist-area">
    <thead class="persist-header">
        <tr>
            <td rowspan="2" style="width: 9%;">
                @*@Apollo.Age.Resources.Lang.TimeGMT8*@
                @Apollo.Age.Resources.Lang.time
                <br />
                (@Apollo.Age.Resources.Lang.GMT+8)
            </td>
            <td rowspan="2" style="width: 7%;">
                @Apollo.Age.Resources.Lang.lblScore
            </td>
            <td rowspan="2" style="width: 25%;"">
                 @Apollo.Age.Resources.Lang.league
            </td>
            <td rowspan="2" style="width: 15%;">
                @Apollo.Age.Resources.Lang.homeaway
            </td>
            <td colspan="3">
                @Apollo.Age.Resources.Lang.fulltime
            </td>
        </tr>
        <tr class="RptHeader02">
            <td style="width: 100px;">
                @Apollo.Age.Resources.Lang.lblHomeNoBet
            </td>
            <td style="width: 100px;">
                @Apollo.Age.Resources.Lang.lblDrawNoBet
            </td>
            <td style="width: 100px;">
                @Apollo.Age.Resources.Lang.lblAwayNoBet
            </td>
        </tr>
    </thead>
    <tbody>
        @if (Model != null && Model.Any())
        {
            int rowIndex = 0;
            int currentLeagueId = 0;

            foreach (var item in Model)
            {
                rowIndex++;

                //@ShowLeague(currentLeagueId, item)
                @ShowMatch(rowIndex, item)

                currentLeagueId = item.LeagueId;
            }
        }
        else
        {
            //@RazorHelper.ShowNoInfo(colspan: 6)
        }
    </tbody>
</table>

@section scripts
{
    <script type="text/javascript">
        var DEFAULT_OBJECT = function () {
            return {
                initData: function () {
                    TOTALBETS.initViewBetList();                    
                }
            };
        } ();
        $(function () {
            DEFAULT_OBJECT.initData();
        });
    </script>    
}
