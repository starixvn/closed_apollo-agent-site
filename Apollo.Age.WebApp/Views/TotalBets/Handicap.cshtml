@using Apollo.Age.Web.Mvc;
@using Apollo.Age.TotalBets.Models
@{
    Layout = "~/Views/TotalBets/Shared/_Layout.cshtml";
    ViewBag.Title = Lang.lblHOUL;

    var hasDownlineDetailsPermission = ViewBag.HasDownlineDetailsPermission != null ? (bool)ViewBag.HasDownlineDetailsPermission : false;
}
@model IEnumerable<HandicapModel>
@helper ShowBlock(int betType, int matchId, decimal homeOdds, decimal awayOdds, string leagueName, string betTypeName, bool hasDownlineDetailsPermission = true)
    {
        var totalOdds = homeOdds - awayOdds;

        if (Math.Round(totalOdds, 2) != 0)
        { 
    <td class="r" style="width: 90px">
        <!--HandicapTotalValue-->
        @if (hasDownlineDetailsPermission)
        { 
            <a class="fcnum view-bet-list" match-id="@matchId" bet-type="@betType" 
            betlist-type="BettypeMatch" href="javascript:void(0);" league-name="@leagueName" bet-type-name="@betTypeName"  title="@Lang.ViewBetList">@RazorHelper.FormatNegativeNumber(totalOdds, 2)</a>
        }
        else
        {
            @RazorHelper.FormatNegativeNumber(totalOdds, 2)
        }
        <!--/HandicapTotalValue-->
    </td>
    <td class="fcbtn c">
        <!--HandicapTotalButton-->
        <input type="button" match-id="@matchId" bet-type="@betType" 
            class="fc-button view-forecast" league-name="@leagueName" title="@Lang.ViewForeCast" value="+" />
        <!--/HandicapTotalButton-->
    </td>
        }
        else
        { 
    <td class="r" style="width: 90px">
    </td>
    <td class="fcbtn">
    </td>
        }
}
@helper ShowTime(HandicapModel item)
    {
    <td class="c bl_time">
        @if (item.LiveIndicator)
        {
            @Html.Raw(item.LiveHomeScore + " - " + item.LiveAwayScore)
        }
@* else
        {
            @Html.Raw(item.ShowTime)
        }*@
    </td>
}
@helper ShowMatch(int index, HandicapModel item, bool hasDownlineDetailsPermission = true)
    {
        var classRow = string.Empty;
        if (item.LiveIndicator)
        {
            classRow = "class=live";
        }
        else
        {
            classRow = string.Empty;
        }
    
    <tr @classRow>
        @Html.FormatShowTime(item.ShowTime)
        @ShowTime(item)
        <td class="c">
            @item.LeagueName
        </td>
        <td class="valign-top  home-away-team">
            @item.HomeTeam
            <br />
            @item.AwayTeam
        </td>
        @ShowBlock(1, item.MatchId, item.HomeOddsHandicap, item.AwayOddsHandicap, item.LeagueName, Apollo.Age.Resources.Lang.lblHandicapFC, hasDownlineDetailsPermission)
        @ShowBlock(3, item.MatchId, item.HomeOddsOverUnder, item.AwayOddsOverUnder, item.LeagueName, Apollo.Age.Resources.Lang.lblOU, hasDownlineDetailsPermission)
        @ShowBlock(7, item.MatchId, item.HomeOddsHalfTimeHandicap, item.AwayOddsHalfTimeHandicap, item.LeagueName, Apollo.Age.Resources.Lang.lbl1stHdp, hasDownlineDetailsPermission)
        @ShowBlock(8, item.MatchId, item.HomeOddHalfTimeOverUnder, item.AwayOddHalfTimeOverUnder, item.LeagueName, Apollo.Age.Resources.Lang.lbl1stOU, hasDownlineDetailsPermission)
    </tr>
}
<table class="tblRpt persist-area">
    <thead class="persist-header">
        <tr>
            <td rowspan="2" style="width: 9%;">
                @Lang.time
                <br />
                (@Lang.GMT+8)
            </td>
            <td rowspan="2" style="width: 7%;">
                @Lang.lblScore
            </td>
            <td rowspan="2" style="width: 25%;">
                @Lang.league
            </td>
            <td rowspan="2" style="width: 15%;">
                @Lang.homeaway
            </td>
            <td colspan="4">
                @Lang.fulltime
            </td>
            <td colspan="4">
                @Lang.lbl1sthalf
            </td>
        </tr>
        <tr>
            <td colspan="2">
                @Lang.lblHandicapFC
            </td>
            <td colspan="2">
                @Lang.lblOverUnder
            </td>
            <td colspan="2">
                @Lang.lblHandicapFC
            </td>
            <td colspan="2">
                @Lang.lblOverUnder
            </td>
        </tr>
    </thead>
    <tbody>
        @if (Model != null && Model.Any())
        {
            int rowIndex = 0;

            foreach (var item in Model)
            {
                rowIndex++;

            @ShowMatch(rowIndex, item, hasDownlineDetailsPermission)
            }
        }
        else
        {
            //@RazorHelper.ShowNoInfo(colspan: 11)
        }
    </tbody>
</table>
@section scripts
{
    <script type="text/javascript">
        var DEFAULT_OBJECT = function () {
            return {
                initData: function () {
                    TOTALBETS.initViewForeCastHandicap();
                    TOTALBETS.initViewBetList();
                }
            };
        } ();
        $(function () {
            DEFAULT_OBJECT.initData();
        });
    </script>
}
