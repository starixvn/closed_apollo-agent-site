@using Apollo.Age.Web.Mvc;
@using Apollo.Age.TotalBets.Models

@{
    Layout = "~/Views/TotalBets/Shared/_Layout.cshtml";
    ViewBag.Title = Apollo.Age.Resources.Lang.lblHOUL;
}

@model IEnumerable<HandicapModel>

@helper ShowBlock(int betType, int matchId, decimal homeOdds, decimal awayOdds, string leagueName, string betTypeName)
{
    var totalOdds = homeOdds - awayOdds;
        
    if (Math.Round(totalOdds, 2) != 0)
    { 
        <td class="r" style="width: 90px" >
            <!--HandicapTotalValue-->
            <a class="fcnum view-bet-list" match-id="@matchId" bet-type="@betType" 
            betlist-type="BettypeMatch" href="javascript:void(0);" league-name="@leagueName" bet-type-name="@betTypeName"  title="@Apollo.Age.Resources.Lang.ViewBetList">@RazorHelper.FormatNegativeNumber(totalOdds, 2)</a>
            <!--/HandicapTotalValue-->
        </td>
        <td class="fcbtn c" >
            <!--HandicapTotalButton-->
            <input type="button" match-id="@matchId" bet-type="@betType" 
            class="fc-button view-forecast" league-name="@leagueName" title="@Apollo.Age.Resources.Lang.ViewForeCast" value="+" />
            <!--/HandicapTotalButton-->
        </td>
    }
    else
    { 
        <td class="r" style="width: 90px" ></td>
        <td class="fcbtn"  ></td>
    }
}

@helper ShowTime(HandicapModel item)
{
    <td class="c bl_time">
        @if (item.LiveIndicator)
        {
            @Html.Raw(item.LiveHomeScore + " - " + item.LiveAwayScore)
        }
       @* else
        {
            @Html.Raw(item.ShowTime)
        }*@
    </td>
}

@helper ShowMatch(int index, HandicapModel item)
{
    var classRow = string.Empty;
    if (item.LiveIndicator)
    {
        classRow = "class=live";
    }
    else
    {        
        classRow = string.Empty;        
    }
    
    <tr @classRow>
        @Html.FormatShowTime(item.ShowTime)
        @ShowTime(item)
        <td class="c" >
            @item.LeagueName
        </td>
        <td class="valign-top  home-away-team">
            @item.HomeTeam
            <br />
            @item.AwayTeam
        </td>
        @ShowBlock(1, item.MatchId, item.HomeOddsHandicap, item.AwayOddsHandicap, item.LeagueName, Apollo.Age.Resources.Lang.lblHandicapFC)
        @ShowBlock(3, item.MatchId, item.HomeOddsOverUnder, item.AwayOddsOverUnder, item.LeagueName, Apollo.Age.Resources.Lang.lblOU)
        @ShowBlock(7, item.MatchId, item.HomeOddsHalfTimeHandicap, item.AwayOddsHalfTimeHandicap, item.LeagueName, Apollo.Age.Resources.Lang.lbl1stHdp)
        @ShowBlock(8, item.MatchId, item.HomeOddHalfTimeOverUnder, item.AwayOddHalfTimeOverUnder, item.LeagueName, Apollo.Age.Resources.Lang.lbl1stOU)
    </tr>          
}

@helper ShowLeague(int currentLeagueId, HandicapModel item)
    {
        if (currentLeagueId != item.LeagueId)
        { 
    <!--LeagueContents-->
    <tr class="league">
        <td colspan="11">
            @item.LeagueName
        </td>
    </tr>
        }            
}



<table class="tblRpt persist-area">
    <thead class="persist-header">
        <tr>
            <td rowspan="2" style="width: 9%;">
                @*@Apollo.Age.Resources.Lang.TimeGMT8*@
                @Apollo.Age.Resources.Lang.time
                <br />
                (@Apollo.Age.Resources.Lang.gmt8)
            </td>
            <td rowspan="2" style="width: 7%;">
                @Apollo.Age.Resources.Lang.lblScore
            </td>
            <td rowspan="2" style="width: 25%;">
                @Apollo.Age.Resources.Lang.league
            </td>
            <td rowspan="2"  style="width: 15%;">
                @Apollo.Age.Resources.Lang.homeaway
            </td>
            <td colspan="4">
                @Apollo.Age.Resources.Lang.fulltime
            </td>
            <td colspan="4">
                @Apollo.Age.Resources.Lang.lbl1sthalf
            </td>
        </tr>
        <tr>
            <td colspan="2">
                @Apollo.Age.Resources.Lang.lblHandicapFC
            </td>
            <td colspan="2">
                @Apollo.Age.Resources.Lang.lblOverUnder
            </td>
            <td colspan="2">
                @Apollo.Age.Resources.Lang.lblHandicapFC
            </td>
            <td colspan="2">
                @Apollo.Age.Resources.Lang.lblOverUnder
            </td>
        </tr>
    </thead>
    <tbody>
        @if (Model != null && Model.Any())
        {
            int rowIndex = 0;
            int currentLeagueId = 0;

            foreach (var item in Model)
            {
                rowIndex++;

                //@ShowLeague(currentLeagueId, item)
                @ShowMatch(rowIndex, item)

                currentLeagueId = item.LeagueId;
            }
        }
        else
        {
            //@RazorHelper.ShowNoInfo(colspan: 11)
        }
    </tbody>
</table>

@section scripts
{
    <script type="text/javascript">
        var DEFAULT_OBJECT = function () {
            return {
                initData: function () {
                    TOTALBETS.initViewForeCastHandicap();
                    TOTALBETS.initViewBetList();                    
                }
            };
        } ();
        $(function () {
            DEFAULT_OBJECT.initData();
        });
    </script>    
}
