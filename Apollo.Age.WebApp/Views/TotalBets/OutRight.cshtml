@using Apollo.Age.TotalBets.Models
@{
    Layout = "~/Views/TotalBets/Shared/_Layout.cshtml";
    ViewBag.Title = Apollo.Age.Resources.Lang.lblOutRight;
    var hasDownlineDetailsPermission = ViewBag.HasDownlineDetailsPermission != null ? (bool)ViewBag.HasDownlineDetailsPermission : false;
}
@model IEnumerable<OutRightModel>
@helper ShowLeague(int currentLeagueId, OutRightModel item)
    {
        if (currentLeagueId != item.LeagueId)
        { 
    <!--LeagueContents-->
    <tr class="league">
        <td colspan="3" class="league">
            @item.LeagueName
        </td>
    </tr>
        }            
}
<table class="tblRpt  persist-area">
    <thead class="persist-header">
        <tr class="RptHeader">
            @* <td style="width: 5%;">
                @Apollo.Age.Resources.Lang.time
                <br />
                (@Apollo.Age.Resources.Lang.GMT)
            </td>*@
            <td style="width: 45%;">
                @Apollo.Age.Resources.Lang.lblTeam
            </td>
            <td style="width: 25%">
                @Apollo.Age.Resources.Lang.lblBalance
            </td>
            <td style="width: 25%">
                @Apollo.Age.Resources.Lang.lblForecast
            </td>
        </tr>
    </thead>
    <tbody>
        <!--LeagueContents-->
        @{
        
            if (Model != null && Model.Any())
            {
                int rowIndex = 0;
                int currentLeagueId = 0;

                foreach (var item in Model)
                {
                    rowIndex++;

            @ShowLeague(currentLeagueId, item)  
            <!--MatchContents-->
            <tr class="r">
                @*<td class="c" rowspan="2">
                        @if(item.KickOffTime != null){
                            @Html.Raw(Formater.FormatDateTime22(item.KickOffTime.Value))
                        }
                    </td>*@
                <td class="l  valign-top  home-away">
                    @if (hasDownlineDetailsPermission)
                    { 
                        <a class="view-bet-list" match-id="@item.MatchId" bet-type="10" betlist-type="BettypeMatch" 
                        href="javascript:void(0);"   league-name="@item.LeagueName" bet-type-name="@Apollo.Age.Resources.Lang.lblOutRight"  title="@Apollo.Age.Resources.Lang.ViewBetList">@item.TeamName
                        </a>
                    }
                    else
                    {
                        @item.TeamName
                    }
                </td>
                <td class="fcnum">
                    @RazorHelper.FormatNumber(item.Balance, 2)
                </td>
                <td class="fcnum">
                    @RazorHelper.FormatPositiveNumber(item.TotalWinLost, 2)
                </td>
            </tr>
                    currentLeagueId = item.LeagueId;
                }
            }
            else
            {
                //@RazorHelper.ShowNoInfo(colspan: 4)
            }     
        }
    </tbody>
</table>
@section scripts
{
    <script type="text/javascript">
        var DEFAULT_OBJECT = function () {
            return {
                initData: function () {
                    TOTALBETS.initViewBetList();
                }
            };
        } ();
        $(function () {
            DEFAULT_OBJECT.initData();
        });
    </script>
}
