@using Apollo.Age.TotalBets.Models
@{
    Layout = "~/Views/TotalBets/Shared/_Layout.cshtml";
    ViewBag.Title = Apollo.Age.Resources.Lang.htft;
    var hasDownlineDetailsPermission = ViewBag.HasDownlineDetailsPermission != null ? (bool)ViewBag.HasDownlineDetailsPermission : false;
}
@model IEnumerable<HTFTModel>
<table class="tblRpt persist-area">
    <thead class="persist-header">
        <tr class="RptHeader">
            <td style="width: 9%;">
                @*@Lang.TimeGMT8*@
                @Lang.time
                <br />
                (@Lang.GMT+8)
            </td>
            <td style="width: 20%">
                @Lang.homeaway
            </td>
            @*<td style="width: 200px;">
                @Lang.away
            </td>*@
            <td>
                @Lang.hh
            </td>
            <td>
                @Lang.hd
            </td>
            <td>
                @Lang.ha
            </td>
            <td>
                @Lang.dh
            </td>
            <td>
                @Lang.dd
            </td>
            <td>
                @Lang.da
            </td>
            <td>
                @Lang.ah
            </td>
            <td>
                @Lang.ad
            </td>
            <td>
                @Lang.aa
            </td>
        </tr>
    </thead>
    @{
        
        if (Model != null && Model.Any())
        {
            int rowIndex = 0;
            var classRow = string.Empty;

            foreach (var item in Model)
            {
                rowIndex++;
                if (rowIndex % 2 != 0)
                {
                    classRow = "r alt";
                }
                else
                {
                    classRow = "r";
                }
        <tr class="@classRow">
            @Html.FormatShowTime(item.ShowTime)
            <td class="l no-border-bottom  valign-top home-away-team">
                @if (hasDownlineDetailsPermission)
                { 
                    <a class="view-bet-list" match-id="@item.MatchId" bet-type="16" betlist-type="BettypeMatch" 
                            href="javascript:void(0);"   league-name="@item.AwayTeam" bet-type-name="@Lang.htft"  title="@Lang.ViewBetList">@item.HomeTeam
                    </a>
                }
                else
                {
                    @item.HomeTeam
                }
                <br />
                @item.AwayTeam
            </td>
            <td class="fcnum">
                @RazorHelper.FormatPositiveNumber(item.TotalHH, 2)
            </td>
            <td class="fcnum">
                @RazorHelper.FormatPositiveNumber(item.TotalHD, 2)
            </td>
            <td class="fcnum">
                @RazorHelper.FormatPositiveNumber(item.TotalHA, 2)
            </td>
            <td class="fcnum">
                @RazorHelper.FormatPositiveNumber(item.TotalDH, 2)
            </td>
            <td class="fcnum">
                @RazorHelper.FormatPositiveNumber(item.TotalDD, 2)
            </td>
            <td class="fcnum">
                @RazorHelper.FormatPositiveNumber(item.TotalDA, 2)
            </td>
            <td class="fcnum">
                @RazorHelper.FormatPositiveNumber(item.TotalAH, 2)
            </td>
            <td class="fcnum">
                @RazorHelper.FormatPositiveNumber(item.TotalAD, 2)
            </td>
            <td class="fcnum">
                @RazorHelper.FormatPositiveNumber(item.TotalAA, 2)
            </td>
        </tr>
            }
        }
        else
        {
            //@RazorHelper.ShowNoInfo(colspan: 12)
        }
    }
</table>
@section scripts
{
    <script type="text/javascript">
        var DEFAULT_OBJECT = function () {
            return {
                initData: function () {
                    TOTALBETS.initViewBetList();

                }
            };
        } ();
        $(function () {
            DEFAULT_OBJECT.initData();
        });
    </script>
}
