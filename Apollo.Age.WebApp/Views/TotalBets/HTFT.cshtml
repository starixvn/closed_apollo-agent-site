@using Apollo.Age.TotalBets.Models
@{
    Layout = "~/Views/TotalBets/Shared/_Layout.cshtml";
    ViewBag.Title = Apollo.Age.Resources.Lang.htft;
}
@model IEnumerable<HTFTModel>
@RazorHelper.RefreshCountDown("HTFT", 90, 60, "ReloadPage();")
<table class="tblRpt persist-area no-border-bottom">
    <thead class="persist-header">
        <tr class="RptHeader">
           @* <td style="width: 20px;">
            @Apollo.Age.Resources.Lang.no
            </td>*@
            <td style="width: 200px;">
                @Apollo.Age.Resources.Lang.home
            </td>
            <td style="width: 200px;">
                @Apollo.Age.Resources.Lang.away
            </td>
            <td style="width: 50px;">
                @Apollo.Age.Resources.Lang.hh
            </td>
            <td style="width: 50px;">
                @Apollo.Age.Resources.Lang.hd
            </td>
            <td style="width: 50px;">
                @Apollo.Age.Resources.Lang.ha
            </td>
            <td style="width: 50px;">
                @Apollo.Age.Resources.Lang.dh
            </td>
            <td style="width: 50px;">
                @Apollo.Age.Resources.Lang.dd
            </td>
            <td style="width: 50px;">
                @Apollo.Age.Resources.Lang.da
            </td>
            <td style="width: 50px;">
                @Apollo.Age.Resources.Lang.ah
            </td>
            <td style="width: 50px;">
                @Apollo.Age.Resources.Lang.ad
            </td>
            <td style="width: 50px;">
                @Apollo.Age.Resources.Lang.aa
            </td>
        </tr>
    </thead>
    @{
        
        if (Model != null && Model.Any())
        {
            int rowIndex = 0;
            var classRow = string.Empty;
            
            foreach (var item in Model)
            {
                rowIndex++;
                if (rowIndex % 2 != 0)
                {
                    classRow = "r alt";
                }
                else
                {
                    classRow = "r";
                }
                <tr class="@classRow">
                  @*  <td class="c">
                        @rowIndex
                    </td>*@
                    <td class="l">
                        <a class="view-bet-list" match-id="@item.MatchId" bet-type="16" betlist-type="BettypeMatch" 
                            href="javascript:void(0);"   league-name="@item.AwayTeam" bet-type-name="@Apollo.Age.Resources.Lang.htft"  title="@Apollo.Age.Resources.Lang.ViewBetList">@item.HomeTeam
                        </a>
                    </td>
                    <td class="l">
                        @item.AwayTeam
                    </td>
                    <td class="fcnum">
                        @RazorHelper.FormatPositiveNumber(item.TotalHH, 2)
                    </td>
                    <td class="fcnum">
                        @RazorHelper.FormatPositiveNumber(item.TotalHD, 2)
                    </td>
                    <td class="fcnum">
                        @RazorHelper.FormatPositiveNumber(item.TotalHA, 2)
                    </td>
                    <td class="fcnum">
                        @RazorHelper.FormatPositiveNumber(item.TotalDH, 2)
                    </td>
                    <td class="fcnum">
                        @RazorHelper.FormatPositiveNumber(item.TotalDD, 2)
                    </td>
                    <td class="fcnum">
                        @RazorHelper.FormatPositiveNumber(item.TotalDA, 2)
                    </td>
                    <td class="fcnum">
                        @RazorHelper.FormatPositiveNumber(item.TotalAH, 2)
                    </td>
                    <td class="fcnum">
                        @RazorHelper.FormatPositiveNumber(item.TotalAD, 2)
                    </td>
                    <td class="fcnum">
                        @RazorHelper.FormatPositiveNumber(item.TotalAA, 2)
                    </td>
                </tr>
            }
        }
        else
        {
        @RazorHelper.ShowNoInfo(colspan: 12)
        }
    }
</table>
@section scripts
{
    <script type="text/javascript">
        var DEFAULT_OBJECT = function () {
            return {
                initData: function () {
                    TOTALBETS.initViewBetList();
                    
                }
            };
        } ();
        $(function () {
            DEFAULT_OBJECT.initData();
        });
    </script>       
}
