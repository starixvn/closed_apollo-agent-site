@using Apollo.Age.TotalBets.Models
@{
    Layout = "~/Views/TotalBets/Shared/_Layout.cshtml";
    ViewBag.Title = Lang.fglg;

    var hasDownlineDetailsPermission = ViewBag.HasDownlineDetailsPermission != null ? (bool)ViewBag.HasDownlineDetailsPermission : false;
}
@model IEnumerable<FirstGoalModel>
@helper ShowMatch(int index, FirstGoalModel item, bool hasDownlineDetailsPermission = true)
    {
    <tr>
        @Html.FormatShowTime(item.ShowTime)
        <td class="c">
            @item.LeagueName
        </td>
        <td class="no-border-bottom  valign-top home-away-team">
            @if (hasDownlineDetailsPermission)
            { 
                <a class="view-bet-list" match-id="@item.MatchId" bet-type="14" betlist-type="BettypeMatch" 
                href="javascript:void(0);"  league-name="@item.LeagueName" bet-type-name="@Lang.fglg" title="@Lang.ViewBetList">
                    @item.HomeTeam
                </a>
            }
            else
            { 
                @item.HomeTeam
            }
            <br />
            @if (hasDownlineDetailsPermission)
            { 
                <a class="view-bet-list" match-id="@item.MatchId" bet-type="14" betlist-type="BettypeMatch" 
                href="javascript:void(0);"  league-name="@item.LeagueName" bet-type-name="@Lang.fglg" title="@Lang.ViewBetList">
                    @item.AwayTeam
                </a>
            }
            else
            {
                @item.AwayTeam
            }
        </td>
        <td class="fcnum r">
            @RazorHelper.FormatPositiveNumber(item.WinLostHomeFG, numDecimals: 2)
            <br />
            @RazorHelper.FormatPositiveNumber(item.WinLostAwayFG, numDecimals: 2)
        </td>
        <td class="fcnum r">
            @RazorHelper.FormatPositiveNumber(item.WinLostHomeLG, numDecimals: 2)
            <br />
            @RazorHelper.FormatPositiveNumber(item.WinLostAwayLG, numDecimals: 2)
        </td>
        <td class="fcnum r">
            @RazorHelper.FormatPositiveNumber(item.WinLostNoGoal, numDecimals: 2)
        </td>
    </tr>
}
<table class="tblRpt persist-area">
    <thead class="persist-header">
        <tr>
            <td style="width: 5%;">
                @Lang.time
            </td>
            <td style="width: 25%;">
                @Lang.league
            </td>
            <td style="width: 15%;">
                @Lang.homeaway
            </td>
            <td>
                @Lang.firstgoal
            </td>
            <td>
                @Lang.lastgoal
            </td>
            <td>
                @Lang.nogoal
            </td>
        </tr>
    </thead>
    <tbody>
        @if (Model != null && Model.Any())
        {
            int rowIndex = 0;
            foreach (var item in Model)
            {
                rowIndex++;
				@ShowMatch(rowIndex, item, hasDownlineDetailsPermission)
            }
        }
        else
        {
            //@RazorHelper.ShowNoInfo(colspan: 6)
        }
    </tbody>
</table>
@section scripts
{
    <script type="text/javascript">
        var DEFAULT_OBJECT = function () {
            return {
                initData: function () {
                    TOTALBETS.initViewBetList();
                }
            };
        } ();
        $(function () {
            DEFAULT_OBJECT.initData();
        });
    </script>
}
