@using Apollo.Age.TotalBets.Models
@{
    Layout = "~/Views/TotalBets/Shared/_Layout.cshtml";
    ViewBag.Title = Apollo.Age.Resources.Lang.fglg;

    var hasDownlineDetailsPermission = ViewBag.HasDownlineDetailsPermission != null ? (bool)ViewBag.HasDownlineDetailsPermission : false;
}
@model IEnumerable<FirstGoalModel>
@helper ShowLeague(int currentLeagueId, FirstGoalModel item)
    {
        if (currentLeagueId != item.LeagueId)
        { 
    <!--LeagueContents-->
    <tr class="league">
        <td colspan="6">
            @item.LeagueName
        </td>
    </tr>
        }            
}
@helper ShowMatch(int index, FirstGoalModel item, bool hasDownlineDetailsPermission = true)
    {    
    <tr>
        @Html.FormatShowTime(item.ShowTime)
        <td class="c">
            @item.LeagueName
        </td>
        <td class="no-border-bottom  valign-top home-away-team">
            @if (hasDownlineDetailsPermission)
            { 
                <a class="view-bet-list" match-id="@item.MatchId" bet-type="14" betlist-type="BettypeMatch" 
                href="javascript:void(0);"  league-name="@item.LeagueName" bet-type-name="@Apollo.Age.Resources.Lang.fglg" title="@Apollo.Age.Resources.Lang.ViewBetList">
                    @item.HomeTeam
                </a>
            }
            else
            { 
                @item.HomeTeam
            }
            <br />
            @if (hasDownlineDetailsPermission)
            { 
                <a class="view-bet-list" match-id="@item.MatchId" bet-type="14" betlist-type="BettypeMatch" 
                href="javascript:void(0);"  league-name="@item.LeagueName" bet-type-name="@Apollo.Age.Resources.Lang.fglg" title="@Apollo.Age.Resources.Lang.ViewBetList">
                    @item.AwayTeam
                </a>
            }
            else
            {
                @item.AwayTeam
            }
        </td>
        <td class="fcnum r">
            @RazorHelper.FormatPositiveNumber(item.WinLostHomeFG, numDecimals: 2)
            <br />
            @RazorHelper.FormatPositiveNumber(item.WinLostAwayFG, numDecimals: 2)
        </td>
        <td class="fcnum r">
            @RazorHelper.FormatPositiveNumber(item.WinLostHomeLG, numDecimals: 2)
            <br />
            @RazorHelper.FormatPositiveNumber(item.WinLostAwayLG, numDecimals: 2)
        </td>
        <td class="fcnum r">
            @RazorHelper.FormatPositiveNumber(item.WinLostNoGoal, numDecimals: 2)
        </td>
    </tr>         
}
<table class="tblRpt persist-area">
    <thead class="persist-header">
        <tr>
            <td style="width: 5%;">
                @Apollo.Age.Resources.Lang.time
            </td>
            <td style="width: 25%;">
                @Apollo.Age.Resources.Lang.league
            </td>
            <td style="width: 15%;">
                @Apollo.Age.Resources.Lang.homeaway
            </td>
            <td>
                @Apollo.Age.Resources.Lang.firstgoal
            </td>
            <td>
                @Apollo.Age.Resources.Lang.lastgoal
            </td>
            <td>
                @Apollo.Age.Resources.Lang.nogoal
            </td>
        </tr>
    </thead>
    <tbody>
        @if (Model != null && Model.Any())
        {
            int rowIndex = 0;
            int currentLeagueId = 0;
            string rowClass = string.Empty;
            foreach (var item in Model)
            {
                rowIndex++;

                //@ShowLeague(currentLeagueId, item)
            @ShowMatch(rowIndex, item)

                currentLeagueId = item.LeagueId;
            }
        }
        else
        {
            //@RazorHelper.ShowNoInfo(colspan: 6)
        }
    </tbody>
</table>
@section scripts
{
    <script type="text/javascript">
        var DEFAULT_OBJECT = function () {
            return {
                initData: function () {
                    TOTALBETS.initViewBetList();
                }
            };
        } ();
        $(function () {
            DEFAULT_OBJECT.initData();
        });
    </script>
}
