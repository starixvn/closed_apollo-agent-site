@using Apollo.Age.Resources
@model Apollo.Age.Web.ViewModels.SignInViewModel
@{
	string title = Lang.SignIn;
	ViewBag.Title = title;
}
@section css {
	<link href="~/views/internal/resources/style.css" rel="stylesheet" type="text/css" />
}
<div class="login-box">
	@using (Html.BeginForm())
	{
		<h1>@title</h1>
		<p class="username">
			@Html.LabelFor(m => m.Username)
			@Html.TextBoxFor(m => m.Username, new { @class = "input-text", autocomplete = "off" })
		</p>
		<p>
			@Html.LabelFor(m => m.Password)
			@Html.PasswordFor(m => m.Password, new { @class = "input-text", autocomplete = "off" })
		</p>
		<p>
			@Html.LabelFor(m => m.Captcha)
            <span id="captcha">
                <img src="@Url.Action("CaptchaImage")" id="img-captcha" alt="Captcha" />
			</span>
			@Html.TextBoxFor(m => m.Captcha, new { @class = "input-captcha", autocomplete = "off" })
			<label></label>
			<em>@Lang.CaptchaInstruction</em>
		</p>
		<p>
			@Html.LabelFor(m => m.Language)
			@Html.DropDownListFor(m => m.Language, Model.Languages)
		</p>
		if (!ViewData.ModelState.IsValid)
		{
		@Html.ValidationSummary()
		}
		<p>
			<input type="submit" value="@title" />
		</p>
	}
</div>
@section scripts {
	<script type="text/javascript">
		function preventBack() {
			window.history.forward();
		}

		setTimeout("preventBack()", 0);

		window.onunload = function () { null };

		window.onload = function () {
			var txtUsername = document.getElementById('Username');
			var txtPassword = document.getElementById('Password');
			var captcha = document.getElementById('Captcha');

			if (txtUsername.value.length == 0) {
				txtUsername.focus();
			} else {
				txtPassword.focus();
			}

			captcha.value = '';
			$('#captcha').click(function () {
				var $this = $(this);
				$('#img-captcha').attr('src', '@Url.Action("CaptchaImage")' + "?" +  Date.now());
			});
			// delete cookies
			document.cookie = 'searching-id' + '="-1";-1; path=/';
			document.cookie = 'searching-name' + '="";-1; path=/';
			document.cookie = 'searching-ismember' + '="false";-1; path=/';
		};
	</script>
	<script src="~/_GlobalResources/Js/jquery.js" type="text/javascript"></script>
	<script src="~/_GlobalResources/Js/Core.js" type="text/javascript"></script>
}