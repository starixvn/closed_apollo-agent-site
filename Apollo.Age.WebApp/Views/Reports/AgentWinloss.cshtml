@section scripts
{
    <script type="text/javascript">
     var LANGUAGES = function () {
         return {
             MessageValidateDateRange: "@LangMsg.MessageValidateDateRange"
         };
     } ();
    </script>
    @Scripts.Render("~/scripts/winlossjs")
   
}
