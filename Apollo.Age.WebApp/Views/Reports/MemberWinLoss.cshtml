@using Apollo.Age.Reports.ViewModels
@{
    ViewBag.Title = Apollo.Age.Resources.Lang.lblMemberWinLoss;
	Layout = "~/Views/Reports/Shared/_Layout.cshtml";
    int i = 1;
    string rowClass = string.Empty;
}
@model MemberWinLossViewModel
<div id="function-bar">
    @*<div class="item">
        <span>@Apollo.Age.Resources.Lang.date : @Formater.ShortDateFormat(Model.FromDate)~@Formater.ShortDateFormat(Model.ToDate)
            -- @Apollo.Age.Resources.Lang.sport : @Model.SportName -- @Apollo.Age.Resources.Lang.WagerType
            : @Model.BettypeName -- </span><a id="btnBack" href="javascript:;">@Apollo.Age.Resources.Lang.back</a>
    </div>*@
    <div class="item">
        <label for="ddlSport">@Apollo.Age.Resources.Lang.lblReport:</label>
        @RazorHelper.RenderSportDropDownList(Model.SportList, currentSportId: Model.Sporttypes)
    </div>
    @RazorHelper.RenderReportLinks(Apollo.Age.Resources.Lang.lblWinLoss)
    <img alt="" src="~/_GlobalResources/Images/top_04.png">
</div>
<div id="box_header" class="report">
    <table class="winloss">
        <tr>
            <td class="firstcolumn">
                @Apollo.Age.Resources.Lang.dateRange:
            </td>
            <td class= "secondcolumn">
                <div class="row">
                    <div class="cell">
                        <div class="editor">
                            @Html.DatePicker("FromDate", DateTime.Now, minDate: DateTime.Now.AddYears(-20), maxDate: DateTime.Now.AddYears(20))
                        </div>
                    </div>
                    <div class="cell">
                        <div class="label">
                            <label for="dateFrom">
                                ~
                            </label>
                        </div>
                        <div class="editor">
                            @Html.DatePicker("ToDate", DateTime.Now, minDate: DateTime.Now.AddYears(-20), maxDate: DateTime.Now.AddYears(20))
                        </div>
                    </div>
                    <div class="cell">
                        <input class="btn dateRange" data-range="1" type="button" value="@Apollo.Age.Resources.Lang.today" />
                        <input  class="btn dateRange" data-range="2" type="button" value="@Apollo.Age.Resources.Lang.yesterday" />
                        <input  class="btn dateRange" data-range="3" type="button" value="@Apollo.Age.Resources.Lang.tomorrow" />
                        <input  class="btn dateRange" data-range="4" type="button" value="@Apollo.Age.Resources.Lang.thisWeek" />
                        <input class="btn dateRange" data-range="5" type="button" value="@Apollo.Age.Resources.Lang.lastWeek" />
                    </div>
                </div>
            </td>
        </tr>
        <tr>
            <td class="firstcolumn">
                @Apollo.Age.Resources.Lang.WagerType:
            </td>
            <td class= "secondcolumn">
                @RazorHelper.RenderBettypeDropDownList(Model.BettypeList, Model.Bettypes)
            </td>
        </tr>
	</table>
	<div>
        <div class="row bg-action">
            <div class="item">
                @Apollo.Age.Resources.Lang.ArchivedDate: @(Model.BalanceUpDay != null ? Formater.ShortDateFormat(Model.BalanceUpDay) : "")
            </div>
            <div class="item btn-action">
                <input id="btnSubmit" class="btn" type="button" value="@Apollo.Age.Resources.Lang.search" />
                <input id="btnCancel" class="btn" type="button" value="@Apollo.Age.Resources.Lang.Cancel" />
            </div>
        </div>
    </div>
</div>
@if (Model.DownlinePath != null && Model.DownlinePath.Any())
{
    @RazorHelper.Navigation(Model.DownlinePath, true)
}
@if (Model.MemberWinLossList != null && Model.MemberWinLossList.Any())
{
    var list = Model.MemberWinLossList;
    decimal totalTurnover = 0;
    decimal totalActual = 0;
    decimal totalMWinLoss = 0;
    decimal totalMComm = 0;
    decimal totalMTotal = 0;
    decimal totalAWinLoss = 0;
    decimal totalAComm = 0;
    decimal totalATotal = 0;
    decimal totalUpline = 0;
    decimal totalOutstanding = 0;
    decimal totalOutstandingShare = 0;
    <div class="export-excel" id="btnExcelMemberWinLoss"></div>
    <table class="tblRpt report">
        <thead>
            <tr>
                <th rowspan="2">
                </th>
                <th rowspan="2">
                    @Apollo.Age.Resources.Lang.lblSoccerPT
                </th>
                <th rowspan="2">
                    @Apollo.Age.Resources.Lang.BetAmount
                </th>
                <th rowspan="2">
                    @Apollo.Age.Resources.Lang.CommBase
                </th>
                <th rowspan="2">
                    @Apollo.Age.Resources.Lang.outstanding
                </th>
                <th rowspan="2">
                    @Apollo.Age.Resources.Lang.ShareAmount
                </th>
                <th colspan="3">
                    @Apollo.Age.Resources.Lang.member
                </th>
                <th colspan="3">
                    @Model.AgentName
                </th>
                <th rowspan="2">
                    @Apollo.Age.Resources.Lang.UplineTotal
                </th>
            </tr>
            <tr>
                <th>
                    @Apollo.Age.Resources.Lang.lblWinLoss
                </th>
                <th>
                    @Apollo.Age.Resources.Lang.lblComm
                </th>
                <th>
                    @Apollo.Age.Resources.Lang.total
                </th>
                <th>
                    @Apollo.Age.Resources.Lang.lblWinLoss
                </th>
                <th>
                    @Apollo.Age.Resources.Lang.lblComm
                </th>
                <th>
                    @Apollo.Age.Resources.Lang.total
                </th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in list)
            {
                totalTurnover += item.Turnover;
                totalActual += item.ActualTO;
                totalMWinLoss += item.WinLoss;
                totalMComm += item.MemComm;
                totalMTotal += item.MemTotal;
                totalAWinLoss += item.AWinLoss;
                totalAComm += item.AComm;
                totalATotal += item.ATotal;
                totalUpline += item.UplineTotal;
                totalOutstanding += item.Outstanding;
                totalOutstandingShare += item.OutstandingShare;
                rowClass = i++ % 2 == 0 ? string.Empty : "class='alt'";

                <tr @Html.Raw(rowClass)>
                    <td>
                        <a class="view-betlist" data-memberid="@item.MemberId" data-membername="item.MemberName" href="javascript:;">
                            @item.MemberName
                        </a>
                    </td>
                    <td class="r">
                        @Formater.FormatNumber20(item.SoccerShare / 100.00, Formater.CULT_NAME_ENG)
                    </td>
                    <td class="r">
                        @Formater.FormatNumber20(item.Turnover, Formater.CULT_NAME_ENG)
                    </td>
                    <td class="r">
                        @Formater.FormatNumber20(item.ActualTO, Formater.CULT_NAME_ENG)
                    </td>
                    <td class="r">
                        @Formater.FormatNumber20(item.Outstanding, Formater.CULT_NAME_ENG)
                    </td>
                    <td class="r">
                        @Formater.FormatNumber20(item.OutstandingShare, Formater.CULT_NAME_ENG)
                    </td>
                    <td class="r">
                        @Formater.FormatNumber20(item.WinLoss, Formater.CULT_NAME_ENG)
                    </td>
                    <td class="r">
                        @Formater.FormatNumber20(item.MemComm, Formater.CULT_NAME_ENG)
                    </td>
                    <td class="r bold">
                        @Formater.FormatNumber20(item.MemTotal, Formater.CULT_NAME_ENG)
                    </td>
                    <td class="r">
                        @Formater.FormatNumber20(item.AWinLoss, Formater.CULT_NAME_ENG)
                    </td>
                    <td class="r">
                        @Formater.FormatNumber20(item.AComm, Formater.CULT_NAME_ENG)
                    </td>
                    <td class="r bold">
                        @Formater.FormatNumber20(item.ATotal, Formater.CULT_NAME_ENG)
                    </td>
                    <td class="r bold">
                        @Formater.FormatNumber20(item.UplineTotal, Formater.CULT_NAME_ENG)
                    </td>
                </tr>
            }
        </tbody>
        <tfoot>
            <tr class="total">
                <td>
                    @Apollo.Age.Resources.Lang.total
                </td>
                <td>
                </td>
                <td class="r">
                    @Formater.FormatNumber20(totalTurnover, Formater.CULT_NAME_ENG)
                </td>
                <td class="r">
                    @Formater.FormatNumber20(totalActual, Formater.CULT_NAME_ENG)
                </td>
                <td class="r">
                    @Formater.FormatNumber20(totalOutstanding, Formater.CULT_NAME_ENG)
                </td>
                <td class="r">
                    @Formater.FormatNumber20(totalOutstandingShare, Formater.CULT_NAME_ENG)
                </td>
                <td class="r">
                    @Formater.FormatNumber20(totalMWinLoss, Formater.CULT_NAME_ENG)
                </td>
                <td class="r">
                    @Formater.FormatNumber20(totalMComm, Formater.CULT_NAME_ENG)
                </td>
                <td class="r">
                    @Formater.FormatNumber20(totalMTotal, Formater.CULT_NAME_ENG)
                </td>
                <td class="r">
                    @Formater.FormatNumber20(totalAWinLoss, Formater.CULT_NAME_ENG)
                </td>
                <td class="r">
                    @Formater.FormatNumber20(totalAComm, Formater.CULT_NAME_ENG)
                </td>
                <td class="r">
                    @Formater.FormatNumber20(totalATotal, Formater.CULT_NAME_ENG)
                </td>
                <td class="r">
                    @Formater.FormatNumber20(totalUpline, Formater.CULT_NAME_ENG)
                </td>
            </tr>
        </tfoot>
    </table>
}
else
{
    <table class="tblRpt report none-result">
        <thead>
            <th>
                @Apollo.Age.Resources.Lang.NodataSearch
            </th>
        </thead>
        <tbody>
            <td class="text-center row-exit">
                <a href="javascript:;" id="lnkExit">@Apollo.Age.Resources.Lang.lblExit</a>
            </td>
        </tbody>
    </table>
}
@Html.Hidden("agentId", Model.AgentId)
@Html.Hidden("agentName", Model.AgentName)
@Html.Hidden("hdSportType", Model.Sporttypes)
@Html.Hidden("hdBettype", Model.Bettypes)
@Html.Hidden("hdToDate", Formater.ShortDateFormat(Model.ToDate))
@Html.Hidden("hdFromDate", Formater.ShortDateFormat(Model.FromDate))
@Html.Hidden("SportName", Model.SportName)
@Html.Hidden("BettypeName", Model.BettypeName)

@section scripts
{
	@Scripts.Render("~/scripts/winlossjs")
    <script type="text/javascript">
        var LANGUAGES = function () {
            return {
                MessageValidateDate: "@Apollo.Age.Resources.LangMsg.ValidateFromToDate"
            };
        } ();
    </script>
}
