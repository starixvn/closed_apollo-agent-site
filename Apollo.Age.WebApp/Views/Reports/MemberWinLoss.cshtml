@using Apollo.Age.Reports.ViewModels
@using Apollo.Age.Resources
@{
    ViewBag.Title = Lang.lblMemberWinLoss;
	Layout = "~/Views/Reports/Shared/_Layout.cshtml";
    int i = 1;
    string rowClass = string.Empty;
}
@model MemberWinLossViewModel
<div id="function-bar">
    <div class="item">
        <label for="ddlSport">@Lang.lblReport:</label>
        @RazorHelper.RenderSportDropDownList(Model.SportList, currentSportId: Model.Sporttypes)
    </div>
    @RazorHelper.RenderReportLinks(Lang.lblWinLoss)
    <img alt="" src="~/_GlobalResources/Images/top_04.png"/>
</div>
<div id="box_header" class="report">
    <table class="winloss">
        <tr>
            <td class="firstcolumn">
                @Lang.dateRange:
            </td>
            <td class= "secondcolumn">
                <div class="row">
                    <div class="cell">
                        <div class="editor">
                            @Html.DatePicker("FromDate", DateTime.Now, minDate: DateTime.Now.AddYears(-20), maxDate: DateTime.Now.AddYears(20))
                        </div>
                    </div>
                    <div class="cell">
                        <div class="label">
                            <label for="FromDate">
                                ~
                            </label>
                        </div>
                        <div class="editor">
                            @Html.DatePicker("ToDate", DateTime.Now, minDate: DateTime.Now.AddYears(-20), maxDate: DateTime.Now.AddYears(20))
                        </div>
                    </div>
                    <div class="cell">
                        <input class="btn dateRange" data-range="1" type="button" value="@Lang.today" />
                        <input  class="btn dateRange" data-range="2" type="button" value="@Lang.yesterday" />
                        <input  class="btn dateRange" data-range="3" type="button" value="@Lang.tomorrow" />
                        <input  class="btn dateRange" data-range="4" type="button" value="@Lang.thisWeek" />
                        <input class="btn dateRange" data-range="5" type="button" value="@Lang.lastWeek" />
                    </div>
                </div>
            </td>
        </tr>
        <tr>
            <td class="firstcolumn">
                @Lang.WagerType:
            </td>
            <td class= "secondcolumn">
                @RazorHelper.RenderBettypeDropDownList(Model.BettypeList, Model.Bettypes)
            </td>
        </tr>
	</table>
	<div>
        <div class="row bg-action">
            <div class="item">
                @Lang.ArchivedDate: @(Model.BalanceUpDay != null ? Formater.ShortDateFormat(Model.BalanceUpDay) : "")
            </div>
            <div class="item btn-action">
                <input id="btnSubmit" class="btn" type="button" value="@Lang.search" />
                <input id="btnCancel" class="btn" type="button" value="@Lang.Cancel" />
            </div>
        </div>
    </div>
</div>
@if (Model.DownlinePath != null && Model.DownlinePath.Any())
{
    @RazorHelper.Navigation(Model.DownlinePath, true)
}
@if (Model.MemberWinLossList != null && Model.MemberWinLossList.Any())
{
    var list = Model.MemberWinLossList;
    decimal totalBetAmount = 0;
    decimal totalBetCount = 0;
    decimal totalCommBase = 0;
    decimal totalMemWinLoss = 0;
    decimal totalMemComm = 0;
    decimal totalMemTotal = 0;
    decimal totalAWinLoss = 0;
    decimal totalAComm = 0;
    decimal totalATotal = 0;
    decimal totalUpLineEffectiveStake = 0;
    decimal totalUpLineWinLoss = 0;
    decimal totalOutstandingAmount = 0;
    decimal totalOutstandingShareAmount = 0;
    
    <div class="export-excel" id="btnExcelMemberWinLoss"></div>
    <table class="tblRpt report tblWinLoss">
        <thead>
            <tr>
                <th class="namecolor" rowspan="2">
                </th>
                <th class="sharecolor" rowspan="2">
                    @Lang.lblSoccerPT
                </th>
                <th class="membercolor" colspan="5">
                    @Lang.member
                </th>
                <th class="agentcolor" colspan="3">
                    @Model.AgentName
                </th>
                <th class="uplinecolor" colspan="2">
                    @Lang.lblUpline
                </th>
                <th class="oustandingcolor" rowspan="2">
                    @Lang.lblOutstandingAmount
                </th>
                <th class="oustandingcolor" rowspan="2">
                    @Lang.lblOutstandingShareAmount
                </th>
            </tr>
            <tr>
                <th class="membercolor">
                    @Lang.BetAmount/@Lang.lblBetCount
                </th>
                <th class="membercolor">
                    @Lang.CommBase
                </th>
                <th class="membercolor">
                    @Lang.lblWinLossReport
                </th>
                <th class="membercolor">
                    @Lang.lblComm
                </th>
                <th class="membercolor">
                    @Lang.total
                </th>
                <th class="agentcolor">
                    @Lang.lblWinLossReport
                </th>
                <th class="agentcolor">
                    @Lang.lblComm
                </th>
                <th class="agentcolor">
                    @Lang.total
                </th>
                <th class="uplinecolor">
                    @Lang.lblEffectiveStake
                </th>
                <th class="uplinecolor">
                    @Lang.lblWinLossReport
                </th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in list)
            {
                totalBetAmount += item.BetAmount;
                totalBetCount += item.BetCount;
                totalCommBase += item.CommBase;
                totalMemWinLoss += item.MemWinLoss;
                totalMemComm += item.MemComm;
                totalMemTotal += item.MemTotal;
                totalAWinLoss += item.AWinLoss;
                totalAComm += item.AComm;
                totalATotal += item.ATotal;
                totalUpLineEffectiveStake += item.UpLineEffectiveStake;
                totalUpLineWinLoss += item.UpLineWinLoss;
                totalOutstandingAmount += item.OutstandingAmount;
                totalOutstandingShareAmount += item.OutstandingShareAmount;
                
                rowClass = i++ % 2 == 0 ? string.Empty : "class='alt'";

                <tr @Html.Raw(rowClass)>
                    <td>
                        <a class="view-betlist" data-memberid="@item.MemberId" data-membername="item.MemberName" href="javascript:;">
                            @item.MemberName
                        </a>
                    </td>
                    <td class="r">
                        @Formater.FormatNumber20(item.SoccerShare / 100.00, Formater.CULT_NAME_ENG)
                    </td>
                    <td class="r">
                            @item.BetAmount/@item.BetCount
                        </td>
                        <td class="r">
                            @Formater.FormatNumber20(item.CommBase, Formater.CULT_NAME_ENG)
                        </td>
                        <td class="r">
                            @Formater.FormatNumber20(item.MemWinLoss, Formater.CULT_NAME_ENG)
                        </td>
                        <td class="r">
                            @Formater.FormatNumber20(item.MemComm, Formater.CULT_NAME_ENG)
                        </td>
                        <td class="r">
                            @Formater.FormatNumber20(item.MemTotal, Formater.CULT_NAME_ENG)
                        </td>
                        <td class="r">
                            @Formater.FormatNumber20(item.AWinLoss, Formater.CULT_NAME_ENG)
                        </td>
                        <td class="r">
                            @Formater.FormatNumber20(item.AComm, Formater.CULT_NAME_ENG)
                        </td>
                        <td class="r">
                            @Formater.FormatNumber20(item.ATotal, Formater.CULT_NAME_ENG)
                        </td>
                        <td class="r">
                            @Formater.FormatNumber20(item.UpLineEffectiveStake, Formater.CULT_NAME_ENG)
                        </td>
                        <td class="r">
                            @Formater.FormatNumber20(item.UpLineWinLoss, Formater.CULT_NAME_ENG)
                        </td>
                        <td class="r">
                            @Formater.FormatNumber20(item.OutstandingAmount, Formater.CULT_NAME_ENG)
                        </td>
                        <td class="r">
                            @Formater.FormatNumber20(item.OutstandingShareAmount, Formater.CULT_NAME_ENG)
                        </td>
                </tr>
            }
        </tbody>
        <tfoot>
            <tr class="total">
                <td>
                    @Lang.total
                </td>
                <td> 
                </td>
                <td class="r">
                    @totalBetAmount/@totalBetCount
                </td>
                <td class="r">
                    @Formater.FormatNumber20(totalCommBase, Formater.CULT_NAME_ENG)
                </td>
                <td class="r">
                    @Formater.FormatNumber20(totalMemWinLoss, Formater.CULT_NAME_ENG)
                </td>
                <td class="r">
                    @Formater.FormatNumber20(totalMemComm, Formater.CULT_NAME_ENG)
                </td>
                <td class="r">
                    @Formater.FormatNumber20(totalMemTotal, Formater.CULT_NAME_ENG)
                </td>
                <td class="r">
                    @Formater.FormatNumber20(totalAWinLoss, Formater.CULT_NAME_ENG)
                </td>
                <td class="r">
                    @Formater.FormatNumber20(totalAComm, Formater.CULT_NAME_ENG)
                </td>
                <td class="r">
                    @Formater.FormatNumber20(totalATotal, Formater.CULT_NAME_ENG)
                </td>
                <td class="r">
                    @Formater.FormatNumber20(totalUpLineEffectiveStake, Formater.CULT_NAME_ENG)
                </td>
                <td class="r">
                    @Formater.FormatNumber20(totalUpLineWinLoss, Formater.CULT_NAME_ENG)
                </td>
                <td class="r">
                    @Formater.FormatNumber20(totalOutstandingAmount, Formater.CULT_NAME_ENG)
                </td>
                <td class="r">
                    @Formater.FormatNumber20(totalOutstandingShareAmount, Formater.CULT_NAME_ENG)
                </td>
            </tr>
        </tfoot>
    </table>
}
else
{
    <table class="tblRpt report none-result">
        <thead>
            <th>
                @Lang.NodataSearch
            </th>
        </thead>
        <tbody>
            <td class="text-center row-exit">
                <a href="javascript:;" id="lnkExit">@Lang.lblExit</a>
            </td>
        </tbody>
    </table>
}
@Html.Hidden("agentId", Model.AgentId)
@Html.Hidden("agentName", Model.AgentName)
@Html.Hidden("hdSportType", Model.Sporttypes)
@Html.Hidden("hdBettype", Model.Bettypes)
@Html.Hidden("hdToDate", Formater.ShortDateFormat(Model.ToDate))
@Html.Hidden("hdFromDate", Formater.ShortDateFormat(Model.FromDate))
@Html.Hidden("SportName", Model.SportName)
@Html.Hidden("BettypeName", Model.BettypeName)

@section scripts
{
	@Scripts.Render("~/scripts/winlossjs")
    <script type="text/javascript">
        var LANGUAGES = function () {
            return {
                MessageValidateDate: "@LangMsg.ValidateFromToDate"
            };
        } ();
    </script>
}
