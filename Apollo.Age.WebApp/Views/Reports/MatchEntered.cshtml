{
	key = "AgentWinLossPageInfo",
	trigger = string.Empty,
	title = Apollo.Age.Resources.Lang.AgentWinLossInstructions,
	tipTitle = Apollo.Age.Resources.Lang.ClickToViewInstructions
})*@
@section scripts
{
	@Scripts.Render("~/scripts/winlossjs")
	<script type="text/javascript">
		var LANGUAGES = function () {
			return {
				MessageValidateDate: "@Apollo.Age.Resources.LangMsg.ValidateFromToDate",
				MessageValidateDateRange: "@Apollo.Age.Resources.LangMsg.MessageValidateDateRange"
			};
		} ();
	</script>
}
@helper RenderMatchEnteredSportRow(List<MatchEnteredModel> matchEnteredList)
	{
		var matchEnteredSports = Apollo.Age.Reports.Core.Constants.MatchEnteredSports;
		var matchEntered = new MatchEnteredModel();

		foreach (KeyValuePair<int, string> pair in matchEnteredSports)
		{
			if (matchEnteredList != null && matchEnteredList.Any())
			{
				matchEntered = matchEnteredList.Where(t => t.SportTypeId == pair.Key).SingleOrDefault();

				if (matchEntered != null)
				{
	<tr>
		<td class="firstcolumn">@Html.Resource(pair.Value):
		</td>
		<td class="winloss_yesterday">@matchEntered.YesterdayEntered
		</td>
		<td class="winloss_yesterday">@matchEntered.YesterdayNonEntered
		</td>
		<td>@matchEntered.TodayEntered
		</td>
		<td>@matchEntered.TodayNonEntered
		</td>
	</tr>
				}
				else
				{
	<tr>
		<td class="firstcolumn">
			@Html.Resource(pair.Value):
		</td>
		<td>
		</td>
		<td>
		</td>
		<td>
		</td>
		<td>
		</td>
	</tr>
				}
			}
			else
			{
	<tr>
		<td class="firstcolumn">
			@Html.Resource(pair.Value):
		</td>
		<td>
		</td>
		<td>
		</td>
		<td>
		</td>
		<td>
		</td>
	</tr>
			}
		}
}
<div class="period-schedule">
	<table class="tblRpt">
		<thead>
			<tr>
				<th colspan="2">@string.Format(Lang.periodlisttitle, currentDate.Year)
				</th>
			</tr>
		</thead>
		<tbody>
			@foreach (var item in Model.PeriodList)
			{
                fromDate = new DateTime(item.FromDate.Year, item.FromDate.Month, item.FromDate.Day);
                toDate = new DateTime(item.ToDate.Year, item.ToDate.Month, item.ToDate.Day);
				counter++;
                if (fromDate <= currentDate && toDate >= currentDate)
				{                  
				<tr class="CurrentPeriod">
					<td class="firstcolumn">@string.Format(Lang.periodnumber, counter)
					</td>
					<td>
						@fromDate.ToString("yyyy-MM-dd") @Lang.to @toDate.ToString("yyyy-MM-dd")
					</td>
				</tr>
				}
				else
				{ 
				<tr>
					<td class="firstcolumn">@string.Format(Lang.periodnumber, counter)
					</td>
					<td>
						@fromDate.ToString("yyyy-MM-dd") @Lang.to @toDate.ToString("yyyy-MM-dd")
					</td>
				</tr>
				}
			}
		</tbody>
	</table>
</div>
