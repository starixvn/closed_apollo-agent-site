@using Apollo.Age.Reports.ViewModels
@using Apollo.Age.Entities
@{
    ViewBag.Title = Apollo.Age.Resources.Lang.agentwinloss;
    Layout = "~/Views/Reports/Shared/_Layout.cshtml";
}
@model MatchEnteredViewModel
<div style="padding:5px;">
    @*@Html.LabelFor(, @Apollo.Age.Resources.Lang.sport)*@

    <label for="ddlSport">Report:</label>

    @RazorHelper.RenderSportDropDownList(Model.SportList, currentSportId: "0")

    <a href="#" style="padding:5px;" class="sub-menu">@Apollo.Age.Resources.Lang.lblReport</a>
    <a href="#" style="padding:5px;" class="sub-menu">@Apollo.Age.Resources.Lang.TicketsCancelled</a>
</div>
<div id="box_header" class="report">
    <table>
        <tr>
            <td class="winloss_firstcolumn">
                @Apollo.Age.Resources.Lang.dateRange:
            </td>
            <td colspan="4">
                <div class="row">
                    <div class="cell">
                        @*<div class="label">
                            <label for="dateFrom">
                                @Apollo.Age.Resources.Lang.dateRange
                            </label>
                        </div>*@
                        <div class="editor">
                            @Html.DatePicker("FromDate", DateTime.Now)
                        </div>
                    </div>
                    <div class="cell">
                        <div class="label">
                            <label for="dateFrom">
                                ~
                            </label>
                        </div>
                        <div class="editor">
                            @Html.DatePicker("ToDate", DateTime.Now)
                        </div>
                    </div>
                    <div class="cell">
                        <input class="btn dateRange" range="1" type="button" value="@Apollo.Age.Resources.Lang.today" />
                    </div>
                    <div class="cell">
                        <input  class="btn dateRange" range="2" type="button" value="@Apollo.Age.Resources.Lang.yesterday" />
                    </div>
                    <div class="cell">
                        <input  class="btn dateRange" range="3" type="button" value="@Apollo.Age.Resources.Lang.tomorrow" />
                    </div>
                    <div class="cell">
                        <input  class="btn dateRange" range="4" type="button" value="@Apollo.Age.Resources.Lang.thisWeek" />
                    </div>
                    <div class="cell">
                        <input class="btn dateRange" range="5" type="button" value="@Apollo.Age.Resources.Lang.lastWeek" />
                    </div>
                </div>
                @*<div class="row bg-action">
                    <input id="btnSubmit" class="btn" type="button" value="@Apollo.Age.Resources.Lang.search" />
                </div>*@
            </td>
        </tr>
        <tr>
            <td class="winloss_firstcolumn">
                @Apollo.Age.Resources.Lang.WagerType:
            </td>
            <td colspan="4">
                @RazorHelper.RenderBettypeDropDownList(Model.BettypeList, currentBettypeId: "0")
            </td>
        </tr>
        <tr>
            <td class="winloss_firstcolumn">
                @Apollo.Age.Resources.Lang.date:
            </td>
            <td colspan="2" class="winloss_date">
                @Formater.ShortDateFormat(DateTime.Now.AddDays(-1)) 
                @if (Model.CheckIsCompleted(isToday: false))
                {
                    <span class="winloss_complete">
                        @Apollo.Age.Resources.Lang.Complete
                    </span>
                }
                else
                {
                    <span class="winloss_incomplete">
                        @Apollo.Age.Resources.Lang.InComplete
                    </span>
                }
            </td>
            <td colspan="2"  class="winloss_date">
                @Formater.ShortDateFormat(DateTime.Now)
                @if (Model.CheckIsCompleted(isToday: true))
                {
                    <span class="winloss_complete">
                        @Apollo.Age.Resources.Lang.Complete
                    </span>
                }
                else
                {
                    <span class="winloss_incomplete">
                        @Apollo.Age.Resources.Lang.InComplete
                    </span>
                }
            </td>
        </tr>
        <tr>
            <td class="winloss_firstcolumn">
                @Apollo.Age.Resources.Lang.result:
            </td>
            <td class="winloss_yesterday">
                @Apollo.Age.Resources.Lang.entered
            </td>
            <td class="winloss_yesterday">
                @Apollo.Age.Resources.Lang.nonentered
            </td>
            <td>
                @Apollo.Age.Resources.Lang.entered
            </td>
            <td>
                @Apollo.Age.Resources.Lang.nonentered
            </td>
        </tr>
        @if (Model.matchEnteredModelList != null && Model.matchEnteredModelList.Any() && Model.matchEnteredModelList.Count == 7)
        {
            <tr>
                <td class="winloss_firstcolumn">
                    @Apollo.Age.Resources.Lang.soccer:
                </td>
                @if (Model.matchEnteredModelList[0] != null)
                {
                    <td class="winloss_yesterday">@Model.matchEnteredModelList[0].YesterdayEntered</td>
                    <td class="winloss_yesterday">@Model.matchEnteredModelList[0].YesterdayNonEntered</td>
                    <td>@Model.matchEnteredModelList[0].TodayEntered</td>
                    <td>@Model.matchEnteredModelList[0].TodayNonEntered</td>
                }
                else
                {
                    <td></td>
                    <td></td>
                    <td></td>
                    <td></td>
                }
                
            </tr>
            <tr>
                <td class="winloss_firstcolumn">
                    @Apollo.Age.Resources.Lang.BK:
                </td>
                @if (Model.matchEnteredModelList[1] != null)
                {
                    <td class="winloss_yesterday">@Model.matchEnteredModelList[1].YesterdayEntered</td>
                    <td class="winloss_yesterday">@Model.matchEnteredModelList[1].YesterdayNonEntered</td>
                    <td>@Model.matchEnteredModelList[1].TodayEntered</td>
                    <td>@Model.matchEnteredModelList[1].TodayNonEntered</td>
                }
                else
                {
                    <td></td>
                    <td></td>
                    <td></td>
                    <td></td>
                }
            </tr>
            <tr>
                <td class="winloss_firstcolumn">
                    @Apollo.Age.Resources.Lang.Tennis:
                </td>
                @if (Model.matchEnteredModelList[2] != null)
                {
                    <td class="winloss_yesterday">@Model.matchEnteredModelList[2].YesterdayEntered</td>
                    <td class="winloss_yesterday">@Model.matchEnteredModelList[2].YesterdayNonEntered</td>
                    <td>@Model.matchEnteredModelList[2].TodayEntered</td>
                    <td>@Model.matchEnteredModelList[2].TodayNonEntered</td>
                }
                else
                {
                    <td></td>
                    <td></td>
                    <td></td>
                    <td></td>
                }
            </tr>
            <tr>
                <td class="winloss_firstcolumn">
                    @Apollo.Age.Resources.Lang.Volleyball:
                </td>
                @if (Model.matchEnteredModelList[3] != null)
                {
                    <td class="winloss_yesterday">@Model.matchEnteredModelList[3].YesterdayEntered</td>
                    <td class="winloss_yesterday">@Model.matchEnteredModelList[3].YesterdayNonEntered</td>
                    <td>@Model.matchEnteredModelList[3].TodayEntered</td>
                    <td>@Model.matchEnteredModelList[3].TodayNonEntered</td>
                }
                else
                {
                    <td></td>
                    <td></td>
                    <td></td>
                    <td></td>
                }
            </tr>
            <tr>
                <td class="winloss_firstcolumn">
                    @Apollo.Age.Resources.Lang.Baseball:
                </td>
                @if (Model.matchEnteredModelList[4] != null)
                {
                    <td class="winloss_yesterday">@Model.matchEnteredModelList[4].YesterdayEntered</td>
                    <td class="winloss_yesterday">@Model.matchEnteredModelList[4].YesterdayNonEntered</td>
                    <td>@Model.matchEnteredModelList[4].TodayEntered</td>
                    <td>@Model.matchEnteredModelList[4].TodayNonEntered</td>
                }
                else
                {
                    <td></td>
                    <td></td>
                    <td></td>
                    <td></td>
                }
            </tr>
            <tr>
                <td class="winloss_firstcolumn">
                    @Apollo.Age.Resources.Lang.lblOutRight:
                </td>
                @if (Model.matchEnteredModelList[5] != null)
                {
                    <td class="winloss_yesterday">@Model.matchEnteredModelList[5].YesterdayEntered</td>
                    <td class="winloss_yesterday">@Model.matchEnteredModelList[5].YesterdayNonEntered</td>
                    <td>@Model.matchEnteredModelList[5].TodayEntered</td>
                    <td>@Model.matchEnteredModelList[5].TodayNonEntered</td>
                }
                else
                {
                    <td></td>
                    <td></td>
                    <td></td>
                    <td></td>
                }
            </tr>
            <tr>
                <td class="winloss_firstcolumn">
                    @Apollo.Age.Resources.Lang.InterEvent:
                </td>
                @if (Model.matchEnteredModelList[6] != null)
                {
                    <td class="winloss_yesterday">@Model.matchEnteredModelList[6].YesterdayEntered</td>
                    <td class="winloss_yesterday">@Model.matchEnteredModelList[6].YesterdayNonEntered</td>
                    <td>@Model.matchEnteredModelList[6].TodayEntered</td>
                    <td>@Model.matchEnteredModelList[6].TodayNonEntered</td>
                }
                else
                {
                    <td></td>
                    <td></td>
                    <td></td>
                    <td></td>
                }
            </tr>
        }
        else
        {
            <tr>
                <td class="winloss_firstcolumn">
                    @Apollo.Age.Resources.Lang.soccer:
                </td>
                <td></td>
                <td></td>
                <td></td>
                <td></td>
            </tr>
            <tr>
                <td class="winloss_firstcolumn">
                    @Apollo.Age.Resources.Lang.BK:
                </td>
                <td></td>
                <td></td>
                <td></td>
                <td></td>
            </tr>
            <tr>
                <td class="winloss_firstcolumn">
                    @Apollo.Age.Resources.Lang.Tennis:
                </td>
                <td></td>
                <td></td>
                <td></td>
                <td></td>
            </tr>
            <tr>
                <td class="winloss_firstcolumn">
                    @Apollo.Age.Resources.Lang.Volleyball:
                </td>
                <td></td>
                <td></td>
                <td></td>
                <td></td>
            </tr>
            <tr>
                <td class="winloss_firstcolumn">
                    @Apollo.Age.Resources.Lang.Baseball:
                </td>
                <td></td>
                <td></td>
                <td></td>
                <td></td>
            </tr>
            <tr>
                <td class="winloss_firstcolumn">
                    @Apollo.Age.Resources.Lang.lblOutRight:
                </td>
                <td></td>
                <td></td>
                <td></td>
                <td></td>
            </tr>
            <tr>
                <td class="winloss_firstcolumn">
                    @Apollo.Age.Resources.Lang.InterEvent:
                </td>
                <td></td>
                <td></td>
                <td></td>
                <td></td>
            </tr>
        }
    </table>

    <div>
        <div class="row bg-action">
            <span>@Apollo.Age.Resources.Lang.WagerState: </span>
            <select>
                <option value="true">@Apollo.Age.Resources.Lang.lblResult</option>
                <option value="false">@Apollo.Age.Resources.Lang.NonResult</option>
            </select>
            
            <input id="btnSubmit" class="btn" type="button" value="@Apollo.Age.Resources.Lang.search" />
            <input class="btn" type="button" value="@Apollo.Age.Resources.Lang.Cancel" />
            <span>
                @Apollo.Age.Resources.Lang.ArchivedDate: @(Model.BalanceUpDay != null ? Formater.ShortDateFormat(Model.BalanceUpDay) : "")
            </span>
        </div>
    </div>
</div>

@Html.Hidden("balanceUpDay", DateTime.Now.ToString("yyyy-MM-dd"))
@Html.Hidden("today", DateTime.Now.ToString("yyyy-MM-dd"))
@Html.Hidden("yesterday", DateTime.Now.AddDays(-1).ToString("yyyy-MM-dd"))
@Html.Hidden("tomorrow", DateTime.Now.AddDays(1).ToString("yyyy-MM-dd"))
@Html.Hidden("thisWeekFrom", DateTime.Now.StartOfWeek(DayOfWeek.Monday).ToString("yyyy-MM-dd"))
@Html.Hidden("thisWeekTo", DateTime.Now.EndOfWeek(DayOfWeek.Sunday).ToString("yyyy-MM-dd"))
@Html.Hidden("lastWeekFrom", DateTime.Now.AddDays(-7).StartOfWeek(DayOfWeek.Monday).ToString("yyyy-MM-dd"))
@Html.Hidden("lastWeekTo", DateTime.Now.AddDays(-7).EndOfWeek(DayOfWeek.Sunday).ToString("yyyy-MM-dd"))
@Html.Action("Index", "Instruction", new
{
    key = "AgentWinLossPageInfo",
    trigger = string.Empty,
    title = Apollo.Age.Resources.Lang.AgentWinLossInstructions,
    tipTitle = Apollo.Age.Resources.Lang.ClickToViewInstructions
})
@section scripts
{
    <script src="~/views/reports/resources/winloss.js" type="text/javascript"></script>
    <script type="text/javascript">
        var LANGUAGES = function () {
            return {
                MessageValidateDate: "@Apollo.Age.Resources.LangMsg.ValidateFromToDate",
                MessageValidateWithArchivedDate: "@Apollo.Age.Resources.LangMsg.MessageValidateWithArchivedDate"
            };
        } ();
    </script>
}
