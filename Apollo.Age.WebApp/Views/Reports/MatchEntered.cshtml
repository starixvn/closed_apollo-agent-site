@using Apollo.Age.Reports.ViewModels
@{
    ViewBag.Title = Apollo.Age.Resources.Lang.agentwinloss;
    Layout = "~/Views/Reports/Shared/_Layout.cshtml";
}
@model List<MatchEnteredViewModel>
<div id="box_header">
    <div class="row">
        @{
            var maxDate = DateTime.Now;
            var minDate = maxDate.AddMonths(-3);
        }
        <div class="cell">
            <div class="label">
                <label for="dateFrom">
                    @Apollo.Age.Resources.Lang.dateRange
                </label>
            </div>
            <div class="editor">
                @Html.DatePicker("FromDate", maxDate, minDate, maxDate)
            </div>
        </div>
        <div class="cell">
            <div class="label">
                <label for="dateFrom">
                    ~
                </label>
            </div>
            <div class="editor">
                @Html.DatePicker("ToDate", maxDate, minDate, maxDate)
            </div>
        </div>
        <div class="cell">
            <input class="btn dateRange" range="1" type="button" value="@Apollo.Age.Resources.Lang.today" />
        </div>
        <div class="cell">
            <input  class="btn dateRange" range="2" type="button" value="@Apollo.Age.Resources.Lang.yesterday" />
        </div>
        <div class="cell">
            <input  class="btn dateRange" range="3" type="button" value="@Apollo.Age.Resources.Lang.tomorrow" />
        </div>
        <div class="cell">
            <input  class="btn dateRange" range="4" type="button" value="@Apollo.Age.Resources.Lang.thisWeek" />
        </div>
        <div class="cell">
            <input class="btn dateRange" range="5" type="button" value="@Apollo.Age.Resources.Lang.lastWeek" />
        </div>
    </div>
    <div class="row">
        <div class="cell">
            <div class="editor">
                <input id="btnSubmit" class="btn" type="button" value="@Apollo.Age.Resources.Lang.search" />
            </div>
        </div>
    </div>
</div>
<table class="tblRpt report" style="width: auto; min-width: 700px;">
    <thead>
        <tr>
            <td rowspan="2">
                @Apollo.Age.Resources.Lang.Sports
            </td>
            <td colspan="2">
                @Formater.FormatShortDateNoZeroLeading(DateTime.Now.AddDays(-1))
            </td>
            <td colspan="2">
                @Formater.FormatShortDateNoZeroLeading(DateTime.Now)
            </td>
        </tr>
        <tr>
            <td style="width: 120px;">
                @Apollo.Age.Resources.Lang.entered
            </td>
            <td style="width: 120px;">
                @Apollo.Age.Resources.Lang.nonentered
            </td>
            <td style="width: 120px;">
                @Apollo.Age.Resources.Lang.entered
            </td>
            <td style="width: 120px;">
                @Apollo.Age.Resources.Lang.nonentered
            </td>
        </tr>
    </thead>
    <tbody>
        @if (Model != null && Model.Any())
        {
            int i = 1;
            string rowClass = string.Empty;

            foreach (var item in Model)
            {
                rowClass = i++ % 2 == 0 ? string.Empty : "class='alt'";
            <tr @Html.Raw(rowClass)>
                <td>
                    @item.SportTypeName
                </td>
                <td class="fcnum r">
                    @item.YesterdayEntered
                </td>
                <td class="fcnum r">
                    @item.YesterdayNonEntered
                </td>
                <td class="fcnum r">
                    @item.TodayEntered
                </td>
                <td class="fcnum r">
                    @item.TodayNonEntered
                </td>
            </tr>
            }
        }
        else
        {
            @RazorHelper.ShowNoInfo(5)
        }
    </tbody>
</table>
@Html.Hidden("today", DateTime.Now.ToString("yyyy-MM-dd"))
@Html.Hidden("yesterday", DateTime.Now.AddDays(-1).ToString("yyyy-MM-dd"))
@Html.Hidden("tomorrow", DateTime.Now.AddDays(1).ToString("yyyy-MM-dd"))
@Html.Hidden("thisWeekFrom", DateTime.Now.StartOfWeek(DayOfWeek.Monday).ToString("yyyy-MM-dd"))
@Html.Hidden("thisWeekTo", DateTime.Now.EndOfWeek(DayOfWeek.Sunday).ToString("yyyy-MM-dd"))
@Html.Hidden("lastWeekFrom", DateTime.Now.AddDays(-7).StartOfWeek(DayOfWeek.Monday).ToString("yyyy-MM-dd"))
@Html.Hidden("lastWeekTo", DateTime.Now.AddDays(-7).EndOfWeek(DayOfWeek.Sunday).ToString("yyyy-MM-dd"))
@Html.Action("Index", "Instruction", new
{
    key = "AgentWinLossPageInfo",
    trigger = string.Empty,
    title = Apollo.Age.Resources.Lang.AgentWinLossInstructions,
    tipTitle = Apollo.Age.Resources.Lang.ClickToViewInstructions
})
@section scripts
{
    <script src="~/views/reports/resources/winloss.js" type="text/javascript"></script>
    <script type="text/javascript">
        var LANGUAGES = function () {
            return {
                MessageValidateDate: "@Apollo.Age.Resources.LangMsg.ValidateFromToDate"
            };
        } ();
    </script>
}
