@using Apollo.Age.Reports.ViewModels
@using Apollo.Age.Entities
@{
    ViewBag.Title = Apollo.Age.Resources.Lang.agentwinloss;
    Layout = "~/Views/Reports/Shared/_Layout.cshtml";
}
@model List<MatchEnteredViewModel>
<div style="padding:5px;">
    @*@Html.LabelFor(, @Apollo.Age.Resources.Lang.sport)*@

    <label for="ddlSport">Report:</label>

    @RazorHelper.RenderSportDropDownList((List<SingbetSport>)ViewBag.SportList, currentSportId: "0")

    <a href="#" style="padding:5px;" class="sub-menu">Report</a>
    <a href="#" style="padding:5px;" class="sub-menu">Ticket cancelled</a>
</div>
<div id="box_header" class="report">
    <table>
        <tr>
            <td class="winloss_firstcolumn">
                @Apollo.Age.Resources.Lang.dateRange:
            </td>
            <td colspan="4">
                <div class="row">
                    @{
                        var maxDate = DateTime.Now;
                        var minDate = maxDate.AddMonths(-3);
                    }
                    <div class="cell">
                        @*<div class="label">
                            <label for="dateFrom">
                                @Apollo.Age.Resources.Lang.dateRange
                            </label>
                        </div>*@
                        <div class="editor">
                            @Html.DatePicker("FromDate", maxDate, minDate, maxDate)
                        </div>
                    </div>
                    <div class="cell">
                        <div class="label">
                            <label for="dateFrom">
                                ~
                            </label>
                        </div>
                        <div class="editor">
                            @Html.DatePicker("ToDate", maxDate, minDate, maxDate)
                        </div>
                    </div>
                    <div class="cell">
                        <input class="btn dateRange" range="1" type="button" value="@Apollo.Age.Resources.Lang.today" />
                    </div>
                    <div class="cell">
                        <input  class="btn dateRange" range="2" type="button" value="@Apollo.Age.Resources.Lang.yesterday" />
                    </div>
                    <div class="cell">
                        <input  class="btn dateRange" range="3" type="button" value="@Apollo.Age.Resources.Lang.tomorrow" />
                    </div>
                    <div class="cell">
                        <input  class="btn dateRange" range="4" type="button" value="@Apollo.Age.Resources.Lang.thisWeek" />
                    </div>
                    <div class="cell">
                        <input class="btn dateRange" range="5" type="button" value="@Apollo.Age.Resources.Lang.lastWeek" />
                    </div>
                </div>
                @*<div class="row bg-action">
                    <input id="btnSubmit" class="btn" type="button" value="@Apollo.Age.Resources.Lang.search" />
                </div>*@
            </td>
        </tr>
        <tr>
            <td class="winloss_firstcolumn">
                @Apollo.Age.Resources.Lang.WagerType:
            </td>
            <td colspan="4">
                @RazorHelper.RenderBettypeDropDownList((List<SingbetBettype>)ViewBag.BettypeList, currentBettypeId: "0")
            </td>
        </tr>
        <tr>
            <td class="winloss_firstcolumn">
                @Apollo.Age.Resources.Lang.date:
            </td>
            <td colspan="2" class="winloss_date">
                @Formater.ShortDateFormat(DateTime.Now.AddDays(-1))
            </td>
            <td colspan="2"  class="winloss_date">
                @Formater.ShortDateFormat(DateTime.Now)
            </td>
        </tr>
        <tr>
            <td class="winloss_firstcolumn">
                @Apollo.Age.Resources.Lang.result:
            </td>
            <td class="winloss_yesterday">
                @Apollo.Age.Resources.Lang.entered
            </td>
            <td class="winloss_yesterday">
                @Apollo.Age.Resources.Lang.nonentered
            </td>
            <td>
                @Apollo.Age.Resources.Lang.entered
            </td>
            <td>
                @Apollo.Age.Resources.Lang.nonentered
            </td>
        </tr>
        @if (Model != null && Model.Any() && Model.Count == 7)
        {
            <tr>
                <td class="winloss_firstcolumn">
                    @Apollo.Age.Resources.Lang.soccer:
                </td>
                @if (Model[0] != null)
                {
                    <td class="winloss_yesterday">@Model[0].YesterdayEntered</td>
                    <td class="winloss_yesterday">@Model[0].YesterdayNonEntered</td>
                    <td>@Model[0].TodayEntered</td>
                    <td>@Model[0].TodayNonEntered</td>
                }
                else
                {
                    <td></td>
                    <td></td>
                    <td></td>
                    <td></td>
                }
                
            </tr>
            <tr>
                <td class="winloss_firstcolumn">
                    @Apollo.Age.Resources.Lang.BK:
                </td>
                @if (Model[1] != null)
                {
                    <td class="winloss_yesterday">@Model[1].YesterdayEntered</td>
                    <td class="winloss_yesterday">@Model[1].YesterdayNonEntered</td>
                    <td>@Model[1].TodayEntered</td>
                    <td>@Model[1].TodayNonEntered</td>
                }
                else
                {
                    <td></td>
                    <td></td>
                    <td></td>
                    <td></td>
                }
            </tr>
            <tr>
                <td class="winloss_firstcolumn">
                    @Apollo.Age.Resources.Lang.Tennis:
                </td>
                @if (Model[2] != null)
                {
                    <td class="winloss_yesterday">@Model[2].YesterdayEntered</td>
                    <td class="winloss_yesterday">@Model[2].YesterdayNonEntered</td>
                    <td>@Model[2].TodayEntered</td>
                    <td>@Model[2].TodayNonEntered</td>
                }
                else
                {
                    <td></td>
                    <td></td>
                    <td></td>
                    <td></td>
                }
            </tr>
            <tr>
                <td class="winloss_firstcolumn">
                    @Apollo.Age.Resources.Lang.Volleyball:
                </td>
                @if (Model[3] != null)
                {
                    <td class="winloss_yesterday">@Model[3].YesterdayEntered</td>
                    <td class="winloss_yesterday">@Model[3].YesterdayNonEntered</td>
                    <td>@Model[3].TodayEntered</td>
                    <td>@Model[3].TodayNonEntered</td>
                }
                else
                {
                    <td></td>
                    <td></td>
                    <td></td>
                    <td></td>
                }
            </tr>
            <tr>
                <td class="winloss_firstcolumn">
                    @Apollo.Age.Resources.Lang.Baseball:
                </td>
                @if (Model[4] != null)
                {
                    <td class="winloss_yesterday">@Model[4].YesterdayEntered</td>
                    <td class="winloss_yesterday">@Model[4].YesterdayNonEntered</td>
                    <td>@Model[4].TodayEntered</td>
                    <td>@Model[4].TodayNonEntered</td>
                }
                else
                {
                    <td></td>
                    <td></td>
                    <td></td>
                    <td></td>
                }
            </tr>
            <tr>
                <td class="winloss_firstcolumn">
                    @Apollo.Age.Resources.Lang.lblOutRight:
                </td>
                @if (Model[5] != null)
                {
                    <td class="winloss_yesterday">@Model[5].YesterdayEntered</td>
                    <td class="winloss_yesterday">@Model[5].YesterdayNonEntered</td>
                    <td>@Model[5].TodayEntered</td>
                    <td>@Model[5].TodayNonEntered</td>
                }
                else
                {
                    <td></td>
                    <td></td>
                    <td></td>
                    <td></td>
                }
            </tr>
            <tr>
                <td class="winloss_firstcolumn">
                    @Apollo.Age.Resources.Lang.InterEvent:
                </td>
                @if (Model[6] != null)
                {
                    <td class="winloss_yesterday">@Model[6].YesterdayEntered</td>
                    <td class="winloss_yesterday">@Model[6].YesterdayNonEntered</td>
                    <td>@Model[6].TodayEntered</td>
                    <td>@Model[6].TodayNonEntered</td>
                }
                else
                {
                    <td></td>
                    <td></td>
                    <td></td>
                    <td></td>
                }
            </tr>
        }
        else
        {
            <tr>
                <td class="winloss_firstcolumn">
                    @Apollo.Age.Resources.Lang.soccer:
                </td>
                <td></td>
                <td></td>
                <td></td>
                <td></td>
            </tr>
            <tr>
                <td class="winloss_firstcolumn">
                    @Apollo.Age.Resources.Lang.BK:
                </td>
                <td></td>
                <td></td>
                <td></td>
                <td></td>
            </tr>
            <tr>
                <td class="winloss_firstcolumn">
                    @Apollo.Age.Resources.Lang.Tennis:
                </td>
                <td></td>
                <td></td>
                <td></td>
                <td></td>
            </tr>
            <tr>
                <td class="winloss_firstcolumn">
                    @Apollo.Age.Resources.Lang.Volleyball:
                </td>
                <td></td>
                <td></td>
                <td></td>
                <td></td>
            </tr>
            <tr>
                <td class="winloss_firstcolumn">
                    @Apollo.Age.Resources.Lang.Baseball:
                </td>
                <td></td>
                <td></td>
                <td></td>
                <td></td>
            </tr>
            <tr>
                <td class="winloss_firstcolumn">
                    @Apollo.Age.Resources.Lang.lblOutRight:
                </td>
                <td></td>
                <td></td>
                <td></td>
                <td></td>
            </tr>
            <tr>
                <td class="winloss_firstcolumn">
                    @Apollo.Age.Resources.Lang.InterEvent:
                </td>
                <td></td>
                <td></td>
                <td></td>
                <td></td>
            </tr>
        }
    </table>

    <div>
        <div class="row bg-action">
            <span>@Apollo.Age.Resources.Lang.WagerState: </span>
            <select>
                <option value="true">@Apollo.Age.Resources.Lang.lblResult</option>
                <option value="false">@Apollo.Age.Resources.Lang.NonResult</option>
            </select>
            
            <input id="btnSubmit" class="btn" type="button" value="@Apollo.Age.Resources.Lang.search" />
            <input class="btn" type="button" value="@Apollo.Age.Resources.Lang.Cancel" />
            <span>
                @Apollo.Age.Resources.Lang.ArchivedDate: 2013-06-25
            </span>
        </div>
    </div>
</div>
