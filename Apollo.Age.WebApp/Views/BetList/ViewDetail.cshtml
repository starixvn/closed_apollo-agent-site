@using Fanex.BetList.Core.TicketHelper;
@using Fanex.BetList.Core.Factories;
@model Apollo.Age.BetList.ViewModels.BetListViewModel
@{
    Layout = "~/Views/BetList/Shared/_Layout.cshtml";
    ViewBag.Title = Apollo.Age.Resources.BetList.viewCommDetails;
}
@{
    var tickets = Model.ListAgentComm;
    var index = 0;
}
<div id="spData">
    <table class="tblRpt">
        <thead>
            <tr>
                <th>
                    @Apollo.Age.Resources.Lang.agent
                </th>
                <th style="width: 100px;">
                    @Apollo.Age.Resources.BetList.agentPT
                </th>
                <th style="width: 100px;">
                    @Apollo.Age.Resources.BetList.agentComm
                </th>
            </tr>
        </thead>
        @if (tickets != null && tickets.Any())
        {
            <tbody>
                @foreach (var ticket in tickets)
                {
                    index++;
                    <tr @(index % 2 == 0 ? string.Empty : "class=alt")>
                        <td class='l'>
                            @ticket.UserName
                        </td>
                        <td class='r'>@Html.Raw(ticket.AgentShare)
                        </td>
                        <td class='r'>@Html.Raw(ticket.AgentComm)
                        </td>
                    </tr>
                }
            </tbody>
        }
        else
        {
            <tfoot>
                <tr class='total no-result'>
                    <td class='c' colspan='4'>@Apollo.Age.Resources.Lang.noInfo
                    </td>
                </tr>
            </tfoot>
        }
    </table>
</div>