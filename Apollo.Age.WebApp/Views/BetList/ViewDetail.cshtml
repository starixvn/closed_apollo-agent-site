@using Apollo.BetList.Core.TicketHelper;
@using Apollo.BetList.Core.Factories;
@model Apollo.Age.BetList.ViewModels.BetListViewModel
@{
    Layout = "~/Views/BetList/Shared/_Layout.cshtml";
    ViewBag.Title = Apollo.Age.Resources.BetList.viewCommDetails;
}
@{
    var tickets = Model.TicketList;
    var index = 0;
}
<div id="spData">
    <table class="tblRpt betlist" style="width: 97%">
        <thead>
            <tr>
                <th>
                    @Lang.agent
                </th>
                <th style="width: 100px;">
                    @BetList.Share
                </th>
                <th style="width: 100px;">
                    @BetList.Comm
                </th>
            </tr>
        </thead>
        @if (tickets != null && tickets.Any())
        {
            <tbody>
                @foreach (var ticket in tickets)
                {
                    index++;
                    <tr @(index % 2 == 0 ? string.Empty : "class=alt")>
                        <td class='l'>
                            @ticket.UserName
                        </td>
                        <td class='r'>@Html.Raw(ticket.AgentShare)
                        </td>
                        <td class='r'>@Html.Raw(ticket.AgentComm)
                        </td>
                    </tr>
                }
            </tbody>
        }
        else
        {
            <tfoot>
                <tr class='total no-result'>
                    <td class='c' colspan='4'>@Lang.noInfo
                    </td>
                </tr>
            </tfoot>
        }
    </table>
</div>