@using Apollo.BetList.Core;
@using Apollo.BetList.Core.Factories;
@using Apollo.BetList.Core.Utils;
@model Apollo.Age.BetList.ViewModels.BetListViewModel
@{
    Layout = "~/Views/BetList/Shared/_Layout.cshtml";
    ViewBag.Title = Lang.lblBetLists;
}
<div id="page_main">
    <div id="content_main">
        <div id="header_main">@Model.Title</div>
        @if (Model.ListMainShareHolders.Any())
        {
            @RazorHelper.RenderMainShareHolderDropDownList(Model.CurrentMainShareHolderId, Model.ListMainShareHolders)
        }
        <div>
        </div>
        <div id="spData">
        <div class="export-betlist-excel" id="btnExcelForeCast">
        @Lang.exporttoexcel
        </div>
            <table class="tblRpt">
                <thead class="persist-header">
                    <tr>
                        <th style="width: 50px;">
                            @BetList.time
                        </th>
                        <th style="width: 120px;">
                            @BetList.rebate
                        </th>
                        <th style="width: 110px;">
                            @BetList.ticket
                        </th>
                        <th>
                            @BetList.content
                        </th>
                        <th style="width: 60px;">
                            @BetList.amount
                        </th>
                        <th style="width: 60px;">
                            @BetList.result
                        </th>
                        <th style="width: 60px;">
                @BetList.status
            </th>
                        <th style="width: 80px;">
                            @BetList.agentPT
                        </th>
                        <th style="width: 80px;">
                            @BetList.agentComm
                        </th>
                        <th style="width: 50px;">
                            @BetList.feature
                        </th>
                    </tr>
                </thead>
                @if (Model.TicketList != null && Model.TicketList.Any())
                {
                    var i = 0;
                    decimal totalAmount = 0;
                    <tbody>
                        @foreach (var item in Model.TicketList)
                        {
                            i++;
                            totalAmount += item.Stake;
                            <tr>
                                <td class='c'>
                                    @Html.Raw(item.TransTime)
                                </td>
                                <td class='c'>@Html.Raw(item.Discount)
                                </td>
                                <td class='c'>@Html.Raw(item.GameType)
                                </td>
                                <td class='r'>
                                    @Html.Raw(item.Choice)
                                </td>
                                <td class='r'>
                                    @Formater.FormatNumber20(item.Stake, Formater.CULT_NAME_ENG)
                                </td>
                                <td class='r'>
                                    0.00
                                </td>
                                <td class='c'>
                                    @Html.Raw(item.Status)
                                </td>
                                <td class='r'>
                                    @Html.Raw(item.AgentShare)
                                </td>
                                <td class='r'>
                                    @Html.Raw(item.AgentComm)
                                </td>
                                <td class='r'>
                                    <a class="view-detail" href="#" tid="@item.TransId">@BetList.details</a>
                                </td>
                            </tr>
                        }
                        <tr>
                            <td colspan="3">
                            </td>
                            <td class="r total">@i
                            </td>
                            <td class="r total">
                                @Formater.FormatNumber20(totalAmount, Formater.CULT_NAME_ENG)
                            </td>
                            <td class="r result">
                                0.00
                            </td>
                            <td class='r total'>
                            </td>
                            <td class='r result'>
                                0.00
                            </td>
                            <td class="r result">
                                0.00
                            </td>
                            <td class='r total'>
                            </td>
                        </tr>
                    </tbody>

                }
            </table>
        </div>
    </div>
</div>
@Html.Hidden("matchId", Request["matchId"])
@Html.Hidden("betType", Request["betType"])
@Html.Hidden("type", Request["type"])
@Html.Hidden("leagueName", Request["leagueName"])
@Html.Hidden("mainShareHolderId", Model.CurrentMainShareHolderId)
@Html.Hidden("isForecast", Request["isForecast"])