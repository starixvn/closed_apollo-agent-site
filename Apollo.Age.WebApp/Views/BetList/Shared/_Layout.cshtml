<!DOCTYPE html>
<html lang="en-us">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <title>@ViewBag.Title</title>    
    @Styles.Render("~/css/betlist")
    @RenderSection("css", required: false)
</head>
<body>
    @RenderBody()
    @Html.Hidden("ApoRoot", Url.Content("~/"))
    @Html.Partial("_ApoRes")
    <script type="text/javascript">
        var LANGUAGES = function () {
            return {
                MessageValidateDate: "@Apollo.Age.Resources.LangMsg.ValidateFromToDate",
                MessageValidateWithArchivedDate: "@Apollo.Age.Resources.LangMsg.MessageValidateWithArchivedDate",
                MessageValidateDateRange: "@Apollo.Age.Resources.LangMsg.MessageValidateDateRange"
            };
        } ();
    </script>
    @Scripts.Render("~/scripts/betlist")
    @RenderSection("scripts", required: false)
</body>
</html>