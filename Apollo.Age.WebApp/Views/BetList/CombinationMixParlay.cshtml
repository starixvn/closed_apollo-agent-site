@using Apollo.Age.Services;
@using Apollo.BetList.Core.Utils;
@{
    ViewBag.Title = "CombinationMixParlay";
    Layout =null;
    decimal total = 0;
}
@model Apollo.Age.BetList.Criterias.SystemParlayData

<!DOCTYPE html>
<html lang="en-us">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <title>@ViewBag.Title</title>    
    @Styles.Render("~/css/betlist")    
</head>
<body>
   
<div id="page_main">
    <table class="tblRpt border-tbl">
        <thead>
            <tr>
                <th style="width: 100px;">
                    @Lang.time
                </th>
                <th style="width: auto;">
                    @Lang.homeaway
                </th>
                <th style="width: 60px;">
                    @Lang.odds
                </th>
                <th style="width: 60px;">
                    @Lang.Amount
                </th>
                <th style="width: 80px;">
                    @Lang.lblResult
                </th>
                <th style="width: 80px;">
                    @Lang.status
                </th>
            </tr>
        </thead>
        <tbody>
            @if (Model.TicketList != null && Model.TicketList.Any())
            {
                var groupByWinlostDate = Model.TicketList.GroupBy(x => x.WinLostDate);


                foreach (var winLostDate in groupByWinlostDate)
                {
                    decimal sumWinlost = 0;
                    var listOfTickets = Model.TicketList.Where(x => x.WinLostDate == winLostDate.Key);
                    bool isFirst = true;
                    foreach (var ticket in listOfTickets)
                    {

                        sumWinlost += ticket.WinLost + ticket.PlayerComm;
                        total += sumWinlost;
                <tr>
                    @if (isFirst)
                    {                           
                        <td rowspan="@listOfTickets.Count()" class="c">@ticket.WinLostDate.ToString("yyyy-MM-dd")
                        </td>   
                        isFirst = false;
                    }
                    <td class="l">
                        @if (ticket.Status.Equals(Apollo.BetList.Core.Entities.BetStatus.Lose, StringComparison.OrdinalIgnoreCase))
                        {
                            <span>@BetList.losingtickets</span>
                        }
                        else
                        {
                            var serials = Model.SerialList.Where(x => x.Serial == ticket.Serial);
                            foreach (var serial in serials)
                            {
                            <span>@CacheRef.GetTeamName(serial.HomeId)</span>
                            <span>-vs-</span>
                            <span>@CacheRef.GetTeamName(serial.AwayId)</span>
                            <br />
                            }
                        }
                    </td>
                    <td class="r bl_underdog">
                        @if (ticket.Status.Equals(Apollo.BetList.Core.Entities.BetStatus.Lose, StringComparison.OrdinalIgnoreCase))
                        {
                            <span>-</span>
                        }
                        else
                        {
                            if (ticket.MOdds > 0)
                            { 
                            <span>@ticket.MOdds.ToString("##0.###")</span>
                            }
                            else
                            { 
                            <span>@ConvertByBetType.Odds(ticket.MOdds)</span>
                            }
                        }
                    </td>
                    <td class="r bl_underdog">
                        @ConvertByBetType.Stake(ticket.Stake)
                    </td>
                    <td class="r">
                        <div>
                            <span class="bl_underdog">@Html.Raw(ConvertByBetType.Winloss(ticket.WinLost))</span></div>
                        <div>
                            <span class="bl_underdog">@Html.Raw(ConvertByBetType.Comm(ticket.PlayerComm))</span></div>
                    </td>
                    <td class="bl_status c">
                        @switch (ticket.Status.ToLower())
                        {
                            case Apollo.BetList.Core.Entities.BetStatus.Running:
                                { 
                            <span>@Lang.running</span>
                                    break;
                                }
                            case Apollo.BetList.Core.Entities.BetStatus.Reject:
                                { 
                            <span>@BetList.reject</span>
                                    break;
                                }
                            case Apollo.BetList.Core.Entities.BetStatus.Won:
                                { 
                            <span>@BetList.won</span>
                                    break;
                                }
                            case Apollo.BetList.Core.Entities.BetStatus.Lose:
                                { 
                            <span>@BetList.lose</span>
                                    break;
                                }
                            case Apollo.BetList.Core.Entities.BetStatus.Draw:
                                { 
                            <span>@BetList.draw</span>
                                    break;
                                }
                            case Apollo.BetList.Core.Entities.BetStatus.Waiting:
                                { 
                            <span>@BetList.waiting</span>
                                    break;
                                }
                            case Apollo.BetList.Core.Entities.BetStatus.Void:
                                { 
                            <span>@BetList.voided</span>
                                    break;
                                }
                            case Apollo.BetList.Core.Entities.BetStatus.Refund:
                                { 
                            <span>@BetList.refund</span>
                                    break;
                                }
                            default:
                                { 
                            <span>@string.Empty</span>
                                    break;
                                }
                        }
                    </td>
                </tr>                                                                        
                
                    }
                
                <tr class="subtotal">
                    <td colspan="4" class="r">@Lang.subTotal
                    </td>
                    <td class="r">
                        @Html.Raw(ConvertByBetType.Winloss(sumWinlost))
                    </td>
                    <td>
                    </td>
                </tr>    
               
                }
            }
            <tr class="outstanding">
                <td colspan="4" class="r">
                    @Lang.outstanding
                </td>
                <td class="r">
                    @Html.Raw(ConvertByBetType.WinLossNoColor(Model.Outstanding))
                </td>
                <td>
                </td>
            </tr>
        </tbody>
        <tfoot>
            <!--Summary-->
            <tr class="total">
                <td colspan="4" class="r">
                    @Lang.total
                </td>
                <td class="r" style="color: White">
                    @Html.Raw(ConvertByBetType.WinLossNoColor(total))
                </td>
                <td>
                </td>
            </tr>
            <!--/Summary-->
        </tfoot>
    </table>
</div>
    @Html.Hidden("ApoRoot", Url.Content("~/"))
    @Html.Partial("_ApoRes")
    <script type="text/javascript">
        var LANGUAGES = function () {
            return {
                MessageValidateDate: "@Apollo.Age.Resources.LangMsg.ValidateFromToDate",
                MessageValidateWithArchivedDate: "@Apollo.Age.Resources.LangMsg.MessageValidateWithArchivedDate",
                MessageValidateDateRange: "@Apollo.Age.Resources.LangMsg.MessageValidateDateRange"
            };
        } ();
    </script>        
</body>
</html>

