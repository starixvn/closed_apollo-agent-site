@{
    ViewBag.Title = "MixParlay";
    Layout = null;
}
@using Apollo.BetList.Core.Builder;
@using Apollo.Age.BetList.Criterias;
@using Apollo.BetList.Core.TicketHelper;
@model Apollo.Age.BetList.ViewModels.MixParlayViewModel
@if (Model.TicketList != null && Model.TicketList.Any())
{
    
    var ticketTextList = new List<TicketText>();
    var ticketHelper = new TicketHelper();
    var line = "<div class='line'></div>";
    var i = 0;
    foreach (var item in Model.TicketList)
    {
        var builder = new BetListHTMLBuilder();
        var choice = string.Empty;
        if (i == Model.TicketList.Count - 1)
        {
            line = "<div></div>";
        }

        if (item.StatusId == (int)Apollo.Age.Enumerations.BetStatus.Void)
        {
            builder.AddChoice(item, ticketHelper, null, "<div class='strike_through'>", "</div>" + line, false);
        }
        else
        {
            builder.AddChoice(item, ticketHelper, null, string.Empty, line, false);
        }

    @Html.Raw(builder.GetBetList().Replace("<div class=\"league\">", string.Format("<div class=\"league\"> <span class=\"red-color\"> {0} </span> ", ticketHelper.GetSportNameById(item.SportTypeId))));

                                   i++;
    }

}