@using Apollo.Age
@using Apollo.Age.CreditBalance.ViewModels
@model CreditBalanceViewModel
@{
    Layout = "~/Views/CreditBalance/Shared/_Layout.cshtml";
    ViewBag.Title = Lang.Draw;
}
<div id="function-bar">
    <div class="item detail-information">
        <span>
            @string.Format("{0} - {1}", @Lang.Draw, @Model.Username)
        </span><a href="@Model.BackLink">--@Lang.back</a>
    </div>
    <div class="end">
    </div>
</div>
<div class="clear-both">
</div>
@Html.Hidden("back-link", @Model.BackLink)
@using (Html.BeginForm(null, null, FormMethod.Post, new { id = "credit-form" }))
{
    @Html.HiddenFor(m => m.CustomerId)

    <table class="credit-balance">
        <tbody>
            <tr>
                <td class="lbl-amount">
                    @Html.Label("lbl-amount", @Lang.DrawAmount)
                </td>
                <td>
                    @Html.TextBox("amount", string.Empty, new { data_min = Model.MinAmount, data_max = Model.MaxAmount })
                    @Html.Label(string.Empty, "(" + @Model.MinAmount + " - " + @Model.MaxAmount.ToString("#,###.##") + ")")
                </td>
            </tr>
            <tr class="btn-action">
                <td colspan="2">
                    <input id="draw-agent-submit" type="button" value="@Lang.SubmitCredit" />
                </td>
            </tr>
        </tbody>
    </table>
    <div id="msg">
    </div>
}