@using Apollo.Age.Reports.Models
@using Apollo.Age.Reports.Core
@using Apollo.Age
@model IEnumerable<MatchResultModel>

<table class="tblRpt">
    <thead>
        @if ((bool)@ViewBag.IsParlay)
        {
            <tr>
                <th class="summary-header" colspan="5">
                    <span class="sport-header">@Model.ToList()[0].SportName</span> &nbsp;- 
                    <span>@Model.ToList()[0].LeagueName</span>
                </th>
            </tr> 
        }
        <tr class="RptHeader">
            <th class="width-80">
                @Apollo.Age.Resources.Lang.kickofftime
            </th>
            <th>
                @Apollo.Age.Resources.Lang.match
            </th>
            <th style="width: 100px;">
                @Apollo.Age.Resources.Lang.firsthalfscore
            </th>
            <th class="nowrap" style="width: 100px;">
                @Apollo.Age.Resources.Lang.finalscore
            </th>
            <th class="nowrap" style="width: 100px;">
                @Apollo.Age.Resources.Lang.status
            </th>
        </tr>
    </thead>
    <tbody>
        @if (Model != null && Model.Any())
        {
            int currentLeagueId = 0;

            foreach (var item in Model)
            {
            @ShowLeague(currentLeagueId, item)
            @ShowMatch(item)

                currentLeagueId = item.LeagueId;
            }
        }
        else
        {
            @RazorHelper.ShowNoInfo(colspan: 5);
        }
    </tbody>
</table>
@helper ShowLeague(int currentLeagueId, MatchResultModel item)
    {
        if (!(bool)ViewBag.IsParlay)
        {
            if (currentLeagueId != item.LeagueId)
            {
                <tr class="league">
                    <td colspan="6">
                        @item.LeagueName
                    </td>
                </tr>
            }
        }
}
@helper ShowMatch(MatchResultModel item)
    {
    <tr class="c">
        <td rowspan="2" class="width-80">
            @RazorHelper.RenderDatetimeFormated2line(item.KickoffTime)
        </td>
        <td class="l">
            @if (item.FinalHomeScore > item.FinalAwayScore)
            {
                <b>
                    @item.HomeTeam
                </b>
            }
            else
            {
                @item.HomeTeam
            }
            @FirstAndLastGoal(item, isRowHome: true)
        </td>
        @BindScore(item, isRowHome: true)
        <td rowspan="2" class="border-right">
            @Html.Raw(item.EventStatusTranslation)
        </td>
    </tr>
    <tr class="c">
        <td class="l">
            @if (item.FinalHomeScore < item.FinalAwayScore)
            {
                <b>
                    @item.AwayTeam
                </b>
            }
            else
            {
                @item.AwayTeam
            }
            @FirstAndLastGoal(item, isRowHome: false)
        </td>
        @BindScore(item, isRowHome: false)
    </tr>
}
@helper FirstAndLastGoal(MatchResultModel item, bool isRowHome)
    {
        // Base on [BetStatus] to get First/Last Goal
        // Example [BetStatus] = "FL:1-2", "Refund FT;FL:0-2"

        var betStatus = string.Empty;
        if (item.EventStatus.Equals(Apollo.Age.Reports.Core.Constants.RefundFT))
        {
            if (!string.IsNullOrWhiteSpace(item.BetStatus) && item.BetStatus.Contains(";"))
            {
                string[] refundArray = item.BetStatus.Split(';');
                if (refundArray.Length == 2 && refundArray[1].ToString() != string.Empty)
                {
                    betStatus = refundArray[1].ToString();
                }
            }
        }
        else if (!item.EventStatus.Equals(Apollo.Age.Reports.Core.Constants.Refund)
            && !item.EventStatus.Equals(Apollo.Age.Reports.Core.Constants.RefundHT))
        {
            if (!string.IsNullOrWhiteSpace(item.BetStatus) && item.BetStatus.Contains(":"))
            {
                betStatus = item.BetStatus;
            }
        }

        if (!string.IsNullOrWhiteSpace(betStatus) && betStatus.Contains(":"))
        {
            var valueArr = betStatus.Split(':');
            if (string.Compare(valueArr[0], "FL", true) == 0)
            {
                var firstGoal = valueArr[1].Split('-')[0];
                var lastGoal = valueArr[1].Split('-')[1];

                if (isRowHome)
                {
                    if (firstGoal == "1")
                    {
                        <div class="first_goal">&nbsp;</div>
                    }
                    if (lastGoal == "1")
                    {
                        <div class="last_goal">&nbsp;</div>
                    }
                }
                else
                {
                    if (firstGoal == "2")
                    {
                        <div class="first_goal">&nbsp;</div>
                    }
                    if (lastGoal == "2")
                    {
                        <div class="last_goal">&nbsp;</div>
                    }
                }
            }
        }
}
@helper BindScore(MatchResultModel item, bool isRowHome)
    {
        if (item.EventStatus.Equals(Apollo.Age.Reports.Core.Constants.Refund ))
        {
    <td>
        @Apollo.Age.Resources.Lang.lblNA
    </td>
    <td>
        @Apollo.Age.Resources.Lang.lblNA
    </td>
        }
        else if (item.EventStatus.Equals(Apollo.Age.Reports.Core.Constants.RefundFT))
        {
            if (isRowHome)
            {
                <td>
                    @if (item.HalfTimeHomeScore == null)
                    {
                        <span>-</span>
                    }
                    else
                    {
                        @item.HalfTimeHomeScore
                    }
                </td>
                <td>
                    @Apollo.Age.Resources.Lang.lblNA
                </td>
            }
            else
            {
                <td>
                    @if (item.HalfTimeAwayScore == null)
                    {
                        <span>-</span>
                    }
                    else
                    {
                        @item.HalfTimeAwayScore
                    }
                </td>
                <td>
                    @Apollo.Age.Resources.Lang.lblNA
                </td>
            }
        }
        else if (item.EventStatus.Equals(Apollo.Age.Reports.Core.Constants.RefundHT ))
        {
            if (isRowHome)
            {
                <td>
                    @Apollo.Age.Resources.Lang.lblNA
                </td>
                <td>
                    @if (item.FinalHomeScore == null)
                    {
                        <span>-</span>
                    }
                    else
                    {
                        @item.FinalHomeScore
                    }
                </td>
            }
            else
            {
                <td>
                    @Apollo.Age.Resources.Lang.lblNA
                </td>
                <td>
                    @if (item.FinalAwayScore == null)
                    {
                        <span>-</span>
                    }
                    else
                    {
                        @item.FinalAwayScore
                    }
                </td>
            }
        }
        else
        {
            if (isRowHome)
            {
                <td>
                    @if (item.HalfTimeHomeScore == null)
                    {
                        <span>-</span>
                    }
                    else
                    {
                        @item.HalfTimeHomeScore
                    }
                </td>
                <td>
                    @if (item.FinalHomeScore == null)
                    {
                        <span>-</span>
                    }
                    else
                    {
                        @item.FinalHomeScore
                    }
                </td>
            }
            else
            {
                <td>
                    @if (item.HalfTimeAwayScore == null)
                    {
                        <span>-</span>
                    }
                    else
                    {
                        @item.HalfTimeAwayScore
                    }
                </td>
                <td>
                    @if (item.FinalAwayScore == null)
                    {
                        <span>-</span>
                    }
                    else
                    {
                        @item.FinalAwayScore
                    }
                </td>
            }
        }
}