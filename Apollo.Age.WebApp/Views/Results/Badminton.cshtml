@using Apollo.Age.Reports.Models
@using Apollo.Age.Reports.Core
@using Apollo.Age.Resources
@model IEnumerable<MatchResultModel>

<table class="tblRpt volleyball">
    <thead>
        @if ((bool)@ViewBag.IsParlay)
        {
            <tr>
                <th class="summary-header" colspan="11">
                    <span class="sport-header">@Model.ToList()[0].SportName</span> &nbsp;- 
                    <span>@Model.ToList()[0].LeagueName</span>
                </th>
            </tr> 
        }
        <tr class="RptHeader">
            <td columnname="kickofftime" style="width: 50px;">
                @Lang.time
            </td>
             <td style="width: 300px;">
                @Lang.league
            </td>
            <td>
                @Lang.match
            </td>
            <td style="width: 20px;">
                @Lang.S1
            </td>
            <td style="width: 20px;">
                @Lang.S2
            </td>
            <td style="width: 20px;">
                @Lang.S3
            </td>
            <td style="width: 20px;">
                @Lang.S4
            </td>
            <td style="width: 20px;">
                @Lang.S5
            </td>
            <td style="width: 100px;">
                @Lang.totalpoint
            </td>
            <td class="nowrap" style="width: 100px;">
                @Lang.totalset
            </td>
            <td class="nowrap" style="width: 100px;">
                @Lang.more
            </td>
        </tr>
    </thead>
    <tbody>
        @if (Model != null && Model.Any())
        {
            var currentLeagueId = 0;

            var betStatus = string.Empty;
            var eventStatus = string.Empty;

            List<string> homeSets = null;
            List<string> awaySets = null;

            var totalPointAway = string.Empty;
            var totalPointHome = string.Empty;
            
            foreach (var item in Model)
            {
                 betStatus = string.Empty;
                 eventStatus = string.Empty;

                 homeSets = new List<string> { "-", "-", "-", "-", "-" };
                 awaySets = new List<string> { "-", "-", "-", "-", "-" };

                 totalPointAway = string.Empty;
                 totalPointHome = string.Empty;

                betStatus = item.BetStatus;
                
                if (!string.IsNullOrWhiteSpace(betStatus) && betStatus.IndexOf(',') >= 0)
                {

                    string[] listOfBetStatus = betStatus.Split(',');
                    var i = 0;
                    string[] itemsBetStatus = null;
                    var totalGameHome = 0;
                    var totalGameAway = 0;
                    foreach (var x in listOfBetStatus)
                    {
                        itemsBetStatus = x.Split('-');
                        homeSets[i] = itemsBetStatus[0];
                        awaySets[i] = itemsBetStatus[1];

                        totalGameHome += Convert.ToInt32(homeSets[i]);
                        totalGameAway += Convert.ToInt32(awaySets[i]);
                        i++;

                    }
                    totalPointHome = totalGameHome > 0 ? totalGameHome.ToString() : string.Empty;
                    totalPointAway = totalGameAway > 0 ? totalGameAway.ToString() : string.Empty;

                }

                if (!(bool)@ViewBag.IsParlay)
                {
                    if (currentLeagueId != item.LeagueId)
                    {
                        currentLeagueId = item.LeagueId;
                        <tr class="league">
                            <td colspan="10">
                                @item.LeagueName
                            </td>
                        </tr>
                    }
                }

            <tr class="c">
                <td class="width-80">
                    @Html.Raw(Formater.FormatDateTime22(item.KickoffTime))
                </td>
                 <td class="width-80">
                    @item.LeagueName
                </td>
                <td class="l width-215">
                    @if (item.FinalHomeScore > item.FinalAwayScore)
                    {
                        <b>@Html.Raw(item.HomeTeam)</b>
                    }
                    else
                    {
                        @Html.Raw(item.HomeTeam)
                    }
                    <br />
                     @if (item.FinalHomeScore < item.FinalAwayScore)
                    {
                        <b>@Html.Raw(item.AwayTeam)</b>
                    }
                    else
                    {
                        @Html.Raw(item.AwayTeam)
                    }
                </td>
                <td>
                    @homeSets[0]
                    <br />
                     @awaySets[0]
                </td>
                <td>
                    @homeSets[1]
                    <br />
                     @awaySets[1]
                </td>
                <td>
                    @homeSets[2]
                    <br />
                     @awaySets[2]
                </td>
                <td>
                    @homeSets[3]
                    <br />
                     @awaySets[3]
                </td>
                <td>
                    @homeSets[4]
                    <br />
                     @awaySets[4]
                </td>
                <td>
                    @if(string.IsNullOrWhiteSpace(totalPointHome))
                    {
                        <span>-</span>
                    }
                    else
                    {
                        @totalPointHome
                    }
                    <br />
                     @if (string.IsNullOrWhiteSpace(totalPointAway))
                    {
                        <span>-</span>
                    }
                    else
                    {
                        @totalPointAway
                    }
                </td>
                <td>
                    @if(item.FinalHomeScore == null)
                    {
                        <span>-</span>
                    }
                    else
                    {
                        @item.FinalHomeScore
                    }
                    <br />
                     @if (item.FinalAwayScore == null)
                    {
                        <span>-</span>
                    }
                    else
                    {
                        @item.FinalAwayScore
                    }
                </td>
                <td rowspan="2" class="border-right">
                    @item.EventStatusTranslation
                </td>
            </tr>           

            }
        }
        else
        {
            @RazorHelper.ShowNoInfo(colspan: 11);
        }
    </tbody>
</table>