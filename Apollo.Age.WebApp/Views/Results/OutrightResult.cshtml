@using Apollo.Age.Reports.Models
@using Apollo.Age.Reports.Core
@model IEnumerable<OutrightResultModel>

<table class="tblRpt res-outright">
    <thead>
        <tr class="RptHeader">
            <td style="width: 90px" columnname="kickofftime">
                @Apollo.Age.Resources.Lang.time
            </td>
            <td>
                @Apollo.Age.Resources.Lang.lblTeam
            </td>
            <td class="nowrap" style="width: 60px;">
                @Apollo.Age.Resources.Lang.result
            </td>
        </tr>
    </thead>
    <tbody>
        @if (Model != null && Model.Any())
        {
            var currentLeagueId = 0;

            foreach (var item in Model)
            {

                if (currentLeagueId != item.LeagueId)
                {
                    currentLeagueId = item.LeagueId;
            <tr class="league">
                <td colspan="3">
                    @item.LeagueName
                </td>
            </tr>
                }

            <tr class="c">
                <td>
                    @RazorHelper.RenderDatetimeFormated2line(item.EventDate)
                </td>
                <td class="l">
                    @item.TeamName
                </td>
                <td>
                    @item.Status
                </td>
            </tr>

            }
        }
        else
        {
            @RazorHelper.ShowNoInfo(colspan: 3);
        }
    </tbody>
</table>