<!DOCTYPE html>
<html lang="en-us">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <title>@ViewBag.Title - Results</title>
    @RenderSection("css", required: false)
</head>
<body>
    
    <div id="page_main">
        <div id="header_main">
            @ViewBag.Title
        </div>
        <div id="content_main">
            @RenderBody()
        </div>
    </div>
    @Html.Hidden("ApoRoot", Url.Content("~/"))
    @Html.Partial("_ApoRes")
    @Scripts.Render("~/scripts/resultjs")
    @RenderSection("scripts", required: false)
</body>
</html>