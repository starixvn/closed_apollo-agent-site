@using Apollo.Age.Reports.Models
@using Apollo.Age.Reports.Core
@using Apollo.Age.Reports.ViewModels
@{
	Layout = null;
}
@model IEnumerable<MatchResultModel>

<table class="tblRpt others">
	<thead>
		<tr>
			<th style="width: 100px">
				@Lang.time
			</th>
			<th style="width: 300px">
				@Lang.league
			</th>
			<th style="width: 200px">
				@Lang.HomeGuest
			</th>
			<th style="width: 100px">
				@Lang.lblhalf
			</th>
			<th style="width: 100px">
				@Lang.lblfinal
			</th>
			<th style="width: 100px">
				@Lang.status
			</th>
		</tr>
	</thead>
	<tbody>
		@if (Model != null && Model.Any())
		{
			foreach (var item in Model)
			{
			<tr class="c">
				<td class="width-80">
					@Html.Raw(Formater.FormatDateTime22(item.KickoffTime))
				</td>
				<td class="l">
					@item.LeagueName
				</td>
				<td class="l">
					@Html.Raw(item.HomeTeam)
					<br />
					@Html.Raw(item.AwayTeam)
				</td>
				<td>
					@if (item.HalfTimeHomeScore == null)
					{
						<span>-</span> 
					}
					else
					{
						@item.HalfTimeHomeScore
					}
					<br />
					@if (item.HalfTimeAwayScore == null)
					{
						<span>-</span> 
					}
					else
					{
						@item.HalfTimeAwayScore
					}
				</td>
				<td>
					@if (item.FinalHomeScore == null)
					{
						<span>-</span> 
					}
					else
					{
						@item.FinalHomeScore
					}
					<br />
					@if (item.FinalAwayScore == null)
					{
						<span>-</span> 
					}
					else
					{
						@item.FinalAwayScore
					}
				</td>
				<td class="border-right">
					@item.EventStatusTranslation
				</td>
			</tr>
			}
		}
	</tbody>
</table>