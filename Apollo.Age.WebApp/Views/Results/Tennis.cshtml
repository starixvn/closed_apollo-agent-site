@using Apollo.Age.Reports.Models
@using Apollo.Age.Reports.Core
@model IEnumerable<MatchResultModel>
<table class="tblRpt">
    <thead>
        @if ((bool)@ViewBag.IsParlay)
        {
            <tr>
                <th class="summary-header" colspan="10">
                    <span class="sport-header">@Model.ToList()[0].SportName</span> &nbsp;- 
                    <span>@Model.ToList()[0].LeagueName</span>
                </th>
            </tr> 
        }
        <tr>
            <td style="width: 90px">
                @Apollo.Age.Resources.Lang.kickofftime
            </td>
            <td>
                @Apollo.Age.Resources.Lang.match
            </td>
            <td style="width: 18px">
                @Apollo.Age.Resources.Lang.S1
            </td>
            <td style="width: 18px">
                @Apollo.Age.Resources.Lang.S2
            </td>
            <td style="width: 18px">
                @Apollo.Age.Resources.Lang.S3
            </td>
            <td style="width: 18px">
                @Apollo.Age.Resources.Lang.S4
            </td>
            <td style="width: 18px">
                @Apollo.Age.Resources.Lang.S5
            </td>
            <th style="width: 100px">
                @Apollo.Age.Resources.Lang.totalgame
            </th>
            <th style="width: 100px">
                @Apollo.Age.Resources.Lang.totalset
            </th>
            <th style="width: 100px">
                @Apollo.Age.Resources.Lang.status
            </th>
        </tr>
    </thead>
    <tbody>
        @if (Model != null && Model.Any())
        {
            var currentLeagueId = 0;
            foreach (var item in Model)
            {
                if (!(bool)@ViewBag.IsParlay)
                {
                    if (currentLeagueId != item.LeagueId)
                    {
                        currentLeagueId = item.LeagueId;
                        <tr class="league">
                            <td colspan="10">
                                @item.LeagueName
                            </td>
                        </tr>
                    }
                }

            <tr class="c">
                <td rowspan="2" class="fixed-width">
                    @item.KickoffTime
                </td>
                <td class="l">
                    @if (item.FinalHomeScore > item.FinalAwayScore)
                    { <b>@item.HomeTeam</b> }
                    else
                    { @item.HomeTeam }
                </td>
                @{
                    int totalGameHome = 0;
                    int totalAwayHome = 0;
                    var betStatusList = new List<string>();
                    bool betStatusIsAvailable = item.BetStatus != null && item.BetStatus.IndexOf(',') >= 0;

                    if (betStatusIsAvailable)
                    {
                        betStatusList = item.BetStatus.Split(',').ToList();
                    }

                    foreach (var status in betStatusList)
                    {
                        int homeScore = Convert.ToInt32(status.Split('-')[0]);
                        totalGameHome += homeScore;
                    <td>@homeScore
                    </td>
                    }
                    for (int i = betStatusList.Count; i < 5; i++)
                    {
                    <td>
                        -
                    </td>
                    }
                }
                <td>
                    @if (betStatusIsAvailable)
                    {
                        @totalGameHome
                    }
                </td>
                <td>
                    @item.FinalHomeScore
                </td>
                <td rowspan="2">
                    @item.EventStatusTranslation
                </td>
            </tr>
            <tr class="c">
                <td class="l">
                    @if (item.FinalAwayScore < item.FinalHomeScore)
                    { <b>@item.AwayTeam</b> }
                    else
                    { @item.AwayTeam }
                </td>
                @foreach (var status in betStatusList)
                {
                    int awayScore = Convert.ToInt32(status.Split('-')[1]);
                    totalAwayHome += awayScore;
                    <td>@awayScore
                    </td>
                }
                @for (int i = betStatusList.Count; i < 5; i++)
                {
                    <td>
                        -
                    </td>
                }
                <td>
                    @if (betStatusIsAvailable)
                    {
                        @totalAwayHome
                    }
                </td>
                <td>
                    @item.FinalAwayScore
                </td>
            </tr>

            }
        }
        else
        {
            @RazorHelper.ShowNoInfo(colspan: 10);
        }
    </tbody>
</table>