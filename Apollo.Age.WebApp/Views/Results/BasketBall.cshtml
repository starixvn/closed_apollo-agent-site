@using Apollo.Age.Reports.Models
@using Apollo.Age.Reports.Core
@model IEnumerable<MatchResultModel>

<table class="tblRpt res-basketball">
    <thead>
        @if ((bool)@ViewBag.IsParlay)
        {
            <tr>
                <th class="summary-header" colspan="10">
                    <span class="sport-header">@Model.ToList()[0].SportName</span> &nbsp;- 
                    <span>@Model.ToList()[0].LeagueName</span>
                </th>
            </tr> 
        }
        <tr class="RptHeader">
            <td class="width-80" columnname="kickofftime">
                @Apollo.Age.Resources.Lang.kickofftime
            </td>
            <td>
                @Apollo.Age.Resources.Lang.match
            </td>
            <td style="width: 40px;">
                @Apollo.Age.Resources.Lang.Q1
            </td>
            <td style="width: 40px;">
                @Apollo.Age.Resources.Lang.Q2
            </td>
            <td style="width: 40px;">
                @Apollo.Age.Resources.Lang.Q3
            </td>
            <td style="width: 40px;">
                @Apollo.Age.Resources.Lang.Q4
            </td>
            <td style="width: 40px;">
                @Apollo.Age.Resources.Lang.OT
            </td>
            <td style="width: 100px;">
                @Apollo.Age.Resources.Lang.firsthalfscore
            </td>
            <td class="nowrap" style="width: 100px;">
                @Apollo.Age.Resources.Lang.finalscore
            </td>
            <td class="nowrap" style="width: 60px;">
                @Apollo.Age.Resources.Lang.status
            </td>
        </tr>
    </thead>
    <tbody>
        @if (Model != null && Model.Any())
        {
            var currentLeagueId = 0;
            var eventStatus = string.Empty;
            var betStatus = string.Empty;

            var finalHomeScore = string.Empty;
            var finalAwayScore = string.Empty;
            var firstHalfHomeScore = string.Empty;
            var firstHalfAwayScore = string.Empty;

            List<string> homeSet = null;
            List<string> awaySet = null;

            var OTAway = string.Empty;
            var OTHome = string.Empty;

            foreach (var item in Model)
            {
                eventStatus = string.Empty;
                betStatus = string.Empty;

                finalHomeScore = string.Empty;
                finalAwayScore = string.Empty;
                firstHalfHomeScore = string.Empty;
                firstHalfAwayScore = string.Empty;

                homeSet = new List<string>() { "-", "-", "-", "-", "-" };
                awaySet = new List<string>() { "-", "-", "-", "-", "-" };

                OTAway = string.Empty;
                OTHome = string.Empty;

                eventStatus = item.EventStatus;

                if (eventStatus.Equals(Apollo.Age.Reports.Core.Constants.Refund))
                {
                    finalHomeScore = finalAwayScore = firstHalfHomeScore = firstHalfAwayScore = @Apollo.Age.Resources.Lang.lblNA;
                }
                else if (eventStatus.Equals(Apollo.Age.Reports.Core.Constants.RefundFT))
                {
                    if (!string.IsNullOrWhiteSpace(item.BetStatus) && item.BetStatus.IndexOf(';') >= 0)
                    {
                        betStatus = item.BetStatus.Split(';')[1];
                    }
                    
                    finalHomeScore = finalAwayScore = @Apollo.Age.Resources.Lang.lblNA;
                    firstHalfHomeScore = item.HalfTimeHomeScore == null ? "-" : item.HalfTimeHomeScore.ToString();
                    firstHalfAwayScore = item.HalfTimeAwayScore == null ? "-" : item.HalfTimeAwayScore.ToString();
                }
                else if (eventStatus.Equals(Apollo.Age.Reports.Core.Constants.RefundHT))
                {
                    if (!string.IsNullOrWhiteSpace(item.BetStatus) && item.BetStatus.IndexOf(';') >= 0)
                    {
                        betStatus = item.BetStatus.Split(';')[1];
                    }
                    
                    finalHomeScore = item.FinalHomeScore == null ? "-" : item.FinalHomeScore.ToString();
                    finalAwayScore = item.FinalAwayScore == null ? "-" : item.FinalAwayScore.ToString();
                    firstHalfHomeScore = firstHalfAwayScore = @Apollo.Age.Resources.Lang.lblNA;
                }
                else
                {
                    firstHalfHomeScore = item.HalfTimeHomeScore == null ? "-" : item.HalfTimeHomeScore.ToString();
                    firstHalfAwayScore = item.HalfTimeAwayScore == null ? "-" : item.HalfTimeAwayScore.ToString();
                    finalHomeScore = item.FinalHomeScore == null ? "-" : item.FinalHomeScore.ToString();
                    finalAwayScore = item.FinalAwayScore == null ? "-" : item.FinalAwayScore.ToString();

                    betStatus = item.BetStatus;
                }

                if (!eventStatus.Equals(Apollo.Age.Reports.Core.Constants.Refund))
                {
                    //23-12,26-11,17-13,15-15
                    if (!string.IsNullOrWhiteSpace(betStatus) && betStatus.IndexOf(',') >= 0)
                    {
                        string[] listOfBetStatus = betStatus.Split(',');
                        string[] sets = null;
                        int i = 0;
                        foreach (var itemBetStatus in listOfBetStatus)
                        {
                            sets = itemBetStatus.Split('-');
                            homeSet[i] = sets[0];
                            awaySet[i] = sets[1];
                            i++;
                        }

                        if (listOfBetStatus.Count() > 4)
                        {
                            OTHome = listOfBetStatus[4].Split('-')[0];
                            OTAway = listOfBetStatus[4].Split('-')[1];
                        }
                    }
                }

                if (!(bool)@ViewBag.IsParlay)
                {
                    if (currentLeagueId != item.LeagueId)
                    {
                        currentLeagueId = item.LeagueId;
                        <tr class="league">
                            <td colspan="10">
                                @item.LeagueName
                            </td>
                        </tr>
                    }
                }

            <tr class="c">
                <td rowspan="2" class="width-80">
                    @Html.Raw(Formater.FormatDateTime22(item.KickoffTime))
                </td>
                <td class="l">
                    @if (item.FinalHomeScore > item.FinalAwayScore)
                    {
                        <b>@Html.Raw(item.HomeTeam)</b>
                    }
                    else
                    {
                        @Html.Raw(item.HomeTeam)
                    }
                </td>
                @if (eventStatus.Equals(Apollo.Age.Reports.Core.Constants.Refund))
                {
                    <td>-</td>
                    <td>-</td>
                }
                else
                {
                    <td>
                        @homeSet[0]
                    </td>
                    <td>
                        @homeSet[1]
                    </td>
                }
                
                @if (eventStatus.Equals(Apollo.Age.Reports.Core.Constants.Refund) 
                    || eventStatus.Equals(Apollo.Age.Reports.Core.Constants.RefundFT))
                {
                    <td>-</td>
                    <td>-</td>
                }
                else
                {
                    <td>
                        @homeSet[2]
                    </td>
                    <td>
                        @homeSet[3]
                    </td>
                }

                <td>
                    @if (string.IsNullOrWhiteSpace(OTHome))
                    {
                        <span>-</span>
                    }
                    else
                    {
                        @OTHome
                    }
                </td>
                <td>
                    @firstHalfHomeScore
                </td>
                <td>
                    @finalHomeScore
                </td>
                <td rowspan="2" class="border-right">
                    @item.EventStatusTranslation
                </td>
            </tr>
            <tr class="c">
                <td class="l">
                    @if (item.FinalHomeScore < item.FinalAwayScore)
                    {
                        <b>@Html.Raw(item.AwayTeam)</b>
                    }
                    else
                    {
                        @Html.Raw(item.AwayTeam)
                    }
                </td>
                @if (eventStatus.Equals(Apollo.Age.Reports.Core.Constants.Refund))
                {
                    <td>-</td>
                    <td>-</td>
                }
                else
                {
                    <td>
                        @awaySet[0]
                    </td>
                    <td>
                        @awaySet[1]
                    </td>
                }
                
                @if (eventStatus.Equals(Apollo.Age.Reports.Core.Constants.Refund) 
                    || eventStatus.Equals(Apollo.Age.Reports.Core.Constants.RefundFT))
                {
                    <td>-</td>
                    <td>-</td>
                }
                else
                {
                    <td>
                        @awaySet[2]
                    </td>
                    <td>
                        @awaySet[3]
                    </td>
                }

                <td>
                    @if (string.IsNullOrWhiteSpace(OTAway))
                    {
                        <span>-</span>
                    }
                    else
                    {
                        @OTAway
                    }
                </td>
                <td>
                    @firstHalfAwayScore
                </td>
                <td>
                    @finalAwayScore
                </td>
            </tr>
            }
        }
        else
        {
            @RazorHelper.ShowNoInfo(colspan: 10);
        }
    </tbody>
</table>