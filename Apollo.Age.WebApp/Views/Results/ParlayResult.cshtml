@using Apollo.Age.Reports.ViewModels;
@using Apollo.Age.Reports.Models;

@model IEnumerable<MatchResultModel>

@section css {
    <link href="~/views/reports/resources/reports.less" rel="stylesheet" type="text/css" />
    <link href="~/views/results/resources/results.less" rel="stylesheet" type="text/css" />
}

<div id="resultContainer">
    @if (Model != null && Model.Any())
    {
        List<int> arrLeagueId = new List<int>();
        foreach (var match in Model)
        {
            if (!arrLeagueId.Contains(match.LeagueId))
            {
                arrLeagueId.Add(match.LeagueId);
            }
        }

        var listMatch = new List<MatchResultModel>();
        var sportName = string.Empty;
        
        foreach (var LeagueId in arrLeagueId)
        {
            listMatch = Model.Where(t => t.LeagueId == LeagueId).ToList();
            sportName = listMatch[0].ViewName;
            
            Html.RenderPartial(string.Format("~/Views/Results/{0}.cshtml", sportName), listMatch);
        }
    }
</div>