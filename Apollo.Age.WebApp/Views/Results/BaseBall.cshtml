@using Apollo.Age.Reports.Models
@using Apollo.Age.Reports.Core
@using Apollo.Age.Resources
@{
	Layout = null;
}
@model IEnumerable<MatchResultModel>

<table class="tblRpt baseball">
	<thead>
		<tr>
			<td columnname="kickofftime" style="width: 50px">
				@Lang.time
			</td>
			<td style="width: 300px">
				@Lang.league
			</td>
			<td style="width: 200px">
				@Lang.HomeGuest
			</td>
			<td style="width: 50px">
				@Lang.lbl1
			</td>
			<td style="width: 50px">
				@Lang.lbl2
			</td>
			<td style="width: 50px">
				@Lang.lbl3
			</td>
			<td style="width: 50px">
				@Lang.lbl4
			</td>
			<td style="width: 50px">
				@Lang.lbl5
			</td>
			<td style="width: 50px">
				@Lang.lbl6
			</td>
			<td style="width: 50px">
				@Lang.lbl7
			</td>
			<td style="width: 50px">
				@Lang.lbl8
			</td>
			<td style="width: 50px">
				@Lang.lbl9
			</td>
			<td style="width: 50px">
				@Lang.lblEI
			</td>
			<td class="nowrap" style="width: 70px">
				@Lang.lblhalf
			</td>
			<td class="nowrap" style="width: 70px">
				@Lang.lblfinal
			</td>
			<td class="nowrap" style="width: 100px">
				@Lang.status
			</td>
		</tr>
	</thead>
	<tbody>
		@if (Model != null && Model.Any())
		{
			foreach (var item in Model)
			{
				var betStatus = string.Empty;

				string ieHome = "-";
				string ieAway = "-";

				List<string> homeSet = new List<string>() { "-", "-", "-", "-", "-", "-", "-", "-", "-", "-1" };
				List<string> awaySet = new List<string>() { "-", "-", "-", "-", "-", "-", "-", "-", "-", "-1" }; 

				betStatus = item.BetStatus;

				if (!string.IsNullOrWhiteSpace(betStatus) && betStatus.IndexOf(',') >= 0)
				{
					string[] listOfBetStatus = betStatus.Split(',');
					if (listOfBetStatus.Count() > 1)
					{
						string[] splitBetStatus = null;
						int i = 0;
						foreach (string betstatus in listOfBetStatus)
						{
							splitBetStatus = betstatus.Split('-');
							if (splitBetStatus != null)
							{
								homeSet[i] = splitBetStatus[0];
								awaySet[i] = splitBetStatus[1];
								i++;
							}
						}
						if (homeSet.Count() >= 10 && awaySet.Count() >= 10)
						{
							ieHome = Convert.ToInt32(homeSet[9]) >= 0 ? homeSet[9] : ieHome;
							ieAway = Convert.ToInt32(awaySet[9]) >= 0 ? awaySet[9] : ieAway;
						}
					}
				}

			<tr class="c">
				<td>
					@Html.Raw(Formater.FormatDateTime22(item.KickoffTime))
				</td>
				 <td class="l">
					@item.LeagueName
				</td>
				<td class="l">
					@Html.Raw(item.HomeTeam)
					<br />
					 @Html.Raw(item.AwayTeam)
				</td>
				<td>
					@homeSet[0]
					<br />
					 @awaySet[0]
				</td>
				<td>
					@homeSet[1]
					<br />
					 @awaySet[1]
				</td>
				<td>
					@homeSet[2]
					<br />
					 @awaySet[2]
				</td>
				<td>
					@homeSet[3]
					<br />
					 @awaySet[3]
				</td>
				<td>
					@homeSet[4]
					<br />
					 @awaySet[4]
				</td>
				<td>
					@homeSet[5]
					<br />
					 @awaySet[5]
				</td>
				<td>
					@homeSet[6]
					<br />
					 @awaySet[6]
				</td>
				<td>
					@homeSet[7]
					<br />
					 @awaySet[7]
				</td>
				<td>
					@homeSet[8]
					<br />
					 @awaySet[8]
				</td>
				<td>
					@ieHome
					<br />
					 @ieAway
				</td>
				<td>
					@if (item.HalfTimeHomeScore == null)
					{
						<span>-</span>
					}
					else
					{
						@item.HalfTimeHomeScore
					}
					<br />
					 @if (item.HalfTimeAwayScore == null)
					{
						<span>-</span>
					}
					else
					{
						@item.HalfTimeAwayScore
					}
				</td>
				<td>
					@if (item.FinalHomeScore == null)
					{
						<span>-</span>
					}
					else
					{
						@item.FinalHomeScore
					}
					<br />
					 @if (item.FinalAwayScore == null)
					{
						<span>-</span>
					}
					else
					{
						@item.FinalAwayScore
					}
				</td>
				<td class="border-right">
					@item.EventStatusTranslation
				</td>
			</tr>
			}
		}
	</tbody>
</table>