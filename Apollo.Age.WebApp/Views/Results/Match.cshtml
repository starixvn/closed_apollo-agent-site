@using Apollo.Age.Reports.Models;
@using Apollo.Age.Reports.ViewModels;
@{
	Layout = "~/Views/Reports/Shared/_Layout.cshtml";
	ViewBag.Title = Apollo.Age.Resources.Lang.lblMatchResult;
}
@model MatchResultViewModel
@section css {
	<link href="~/views/results/resources/results.less" rel="stylesheet" type="text/css" />
}

<div id="function-bar">
	@{ string[] sportTypes = { "Soccer", "BK/NFL/RUGBY", "Tennis", "VB/BDM/TT", "Baseball", "Other", "Outright", "S Outright" };
	<ul class="menu">
		<li><a href="#">Yesterday</a></li>
		<li>Game:</li>
		@foreach (string sport in sportTypes)
		{
		<li><a href="#">[@(sport)]</a></li>
		}
	</ul>
	}
	<ul class="pager">
		<li>PAGE:</li>
		<li class="current"><a href="#">01</a></li>
		@for (int i = 2; i < 6; i++)
		{
			<li><a href="#">@(i < 10 ? string.Format("0{0}", i) : i.ToString())</a></li>
		}
	</ul>
	<img src="~/_GlobalResources/Images/top_04.gif" alt="" />
</div>

@using (Html.BeginForm())
{
	<div id="box_header" class="report">
		<div class="row">
			<div class="cell">
				<div class="label">
					<label for="EventDate">@Apollo.Age.Resources.Lang.date</label>
				</div>
				<div class="editor">
					@Html.DatePicker("EventDate", Model.EventDate, minDate: Model.BalanceUpDay, maxDate: DateTime.Now.Date)					
				</div>
			</div>
			<div class="cell">
				<div class="editor">
					<input id="btnSubmit" value="@Apollo.Age.Resources.Lang.search" type="submit" class="btn" />
					<input id="btnToday" value="@Apollo.Age.Resources.Lang.today" type="submit" 
						class="btn" title="@Formater.FormatShortDateNoZeroLeading(DateTime.Now)"/>
					<input id="btnYesterday" value="@Apollo.Age.Resources.Lang.yesterday" type="submit" 
						class="btn" title="@Formater.FormatShortDateNoZeroLeading(DateTime.Now.AddDays(-1))"/>

					<input type="hidden" name="todayValue" id="todayValue"
						value="@Formater.FormatShortDateNoZeroLeading(DateTime.Now)">
					<input type="hidden" name="yesterdayValue" id="yesterdayValue"
						value="@Formater.FormatShortDateNoZeroLeading(DateTime.Now.AddDays(-1))">
				</div>
			</div>
		</div>
		@if (Model.SportList != null && Model.SportList.Any())
		{
			<div class="row">
				<div class="cell">
					<div class="label">
						<label for="ddlSport">@Apollo.Age.Resources.Lang.sport</label>
					</div>
					<div class="editor">
						@Html.DropDownList("ddlSport", Model.SportSelectListItem)
					</div>
				</div>
				<div class="cell">
					<div class="label">
						<label for="ddlLeague">@Apollo.Age.Resources.Lang.league</label>
					</div>
					<div class="editor">
						@Html.DropDownList("ddlLeague",
						new List<SelectListItem> { new SelectListItem { Text = string.Empty, Value = "0" } },
						new { style = "width: 500px" })
					</div>
				</div>
			</div>
		}
	</div>

	if (Model.SportList != null && Model.SportList.Any())
	{
		<div id="resultContainer"></div>
	}	
}
@section scripts
{
	<script src="~/views/results/resources/match.js" type="text/javascript"></script>
}