@using Apollo.Age.Reports.Models;
@using Apollo.Age.Reports.ViewModels;
@{
	Layout = "~/Views/Reports/Shared/_Layout.cshtml";
	ViewBag.Title = Apollo.Age.Resources.Lang.lblMatchResult;
}
@model MatchResultViewModel
@section css {
	<link href="~/views/results/resources/results.less" rel="stylesheet" type="text/css" />
}

<div id="function-bar">
	@{ string[] sportTypes = { "Soccer", "BK/NFL/RUGBY", "Tennis", "VB/BDM/TT", "Baseball", "Other", "Outright", "S Outright" };
	<ul class="menu">
		<li><a href="#">Yesterday</a></li>
		<li>Game:</li>
		@foreach (string sport in sportTypes)
		{
		<li><a href="#">[@(sport)]</a></li>
		}
	</ul>
	}
	<ul class="pager">
		<li>PAGE:</li>
		<li class="current"><a href="#">01</a></li>
		@for (int i = 2; i < 6; i++)
		{
			<li><a href="#">@(i < 10 ? string.Format("0{0}", i) : i.ToString())</a></li>
		}
	</ul>
	<img src="~/_GlobalResources/Images/top_04.gif" alt="" />
    
	<input type="hidden" name="todayValue" id="todayValue" value="@Formater.FormatShortDateNoZeroLeading(DateTime.Now)">
	<input type="hidden" name="yesterdayValue" id="yesterdayValue" value="@Formater.FormatShortDateNoZeroLeading(DateTime.Now.AddDays(-1))">
</div>

@using (Html.BeginForm())
{	
	<div id="resultContainer"></div>
}
@section scripts
{
	<script src="~/views/results/resources/match.js" type="text/javascript"></script>
}