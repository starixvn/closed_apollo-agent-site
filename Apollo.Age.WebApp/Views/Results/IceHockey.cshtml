@using Apollo.Age.Reports.Models
@using Apollo.Age.Reports.Core
@model IEnumerable<MatchResultModel>

<table class="tblRptother">
    <thead>
        @if ((bool)@ViewBag.IsParlay)
        {
            <tr>
                <th class="summary-header" colspan="8">
                    <span class="sport-header">@Model.ToList()[0].SportName</span> &nbsp;- 
                    <span>@Model.ToList()[0].LeagueName</span>
                </th>
            </tr> 
        }
        <tr class="RptHeader">
            <td class="width-80" columnname="kickofftime">
                @Apollo.Age.Resources.Lang.kickofftime
            </td>
            <td>
                @Apollo.Age.Resources.Lang.match
            </td>
            <td style="width: 50px;">
                @Apollo.Age.Resources.Lang.P1
            </td>
            <td style="width: 50px;">
                @Apollo.Age.Resources.Lang.P2
            </td>
            <td style="width: 50px;">
                @Apollo.Age.Resources.Lang.P3
            </td>
            <td style="width: 50px;">
                @Apollo.Age.Resources.Lang.OT
            </td>
            <td class="nowrap" style="width: 100px;">
                @Apollo.Age.Resources.Lang.finalscore
            </td>
            <td class="nowrap" style="width: 100px;">
                @Apollo.Age.Resources.Lang.status
            </td>
        </tr>
    </thead>
    <tbody>
        @if (Model != null && Model.Any())
        {
            var currentLeagueId = 0;
            var eventStatus = string.Empty;
            var betStatus = string.Empty;

            List<string> PHome = null;
            List<string> PAway = null;

            var OTAway = string.Empty;
            var OTHome = string.Empty;

            foreach (var item in Model)
            {
                eventStatus = string.Empty;
                betStatus = string.Empty;

                PHome = new List<string>() { "-", "-", "-", "-" };
                PAway = new List<string>() { "-", "-", "-", "-" };

                OTAway = string.Empty;
                OTHome = string.Empty;

                betStatus = item.BetStatus;
                
                if (!string.IsNullOrWhiteSpace(betStatus) && betStatus.IndexOf(',') >= 0)
                {

                    string[] listOfBetStatus = betStatus.Split(',');
                    string[] itemsBetStatus = null;
                    var i = 0;
                    foreach (var x in listOfBetStatus)
                    {
                        itemsBetStatus = x.Split('-');

                        PHome[i] = itemsBetStatus[0];
                        PAway[i] = itemsBetStatus[1];
                        i++;

                    }
                    if (listOfBetStatus.Count() > 3)
                    {

                        OTHome = listOfBetStatus[3].Split('-')[0];
                        OTAway = listOfBetStatus[3].Split('-')[1];

                    }
                }
                if (!(bool)@ViewBag.IsParlay)
                {
                    if (currentLeagueId != item.LeagueId)
                    {
                        currentLeagueId = item.LeagueId;
                        <tr class="league">
                            <td colspan="10">
                                @item.LeagueName
                            </td>
                        </tr>
                    }
                }

            <tr class="c">
                <td rowspan="2" class="width-80">
                    @Html.Raw(Formater.FormatDateTime22(item.KickoffTime))
                </td>
                <td class="l">
                    @if (item.FinalHomeScore > item.FinalAwayScore)
                    {
                        <b>@Html.Raw(item.HomeTeam)</b>
                    }
                    else
                    {
                        @Html.Raw(item.HomeTeam)
                    }
                    
                </td>
                <td>
                    @PHome[0]
                </td>
                <td>
                    @PHome[1]
                </td>
                <td>
                    @PHome[2]
                </td>
                <td>
                    @if (string.IsNullOrWhiteSpace(OTHome))
                    {
                        <span>-</span>
                    }
                    else
                    {
                        @OTHome
                    }
                </td>
                <td>
                    @if (item.FinalHomeScore == null)
                    {
                        <span>-</span>
                    }
                    else
                    {
                        @item.FinalHomeScore
                    }
                    
                </td>
                <td rowspan="2" class="border-right">
                    @item.EventStatusTranslation
                </td>
            </tr>
            <tr class="c">
                <td class="l">
                    @if (item.FinalHomeScore < item.FinalAwayScore)
                    {
                        <b>@Html.Raw(item.AwayTeam)</b>
                    }
                    else
                    {
                        @Html.Raw(item.AwayTeam)
                    }
                </td>
                <td>
                    @PAway[0]
                </td>
                <td>
                    @PAway[1]
                </td>
                <td>
                    @PAway[2]
                </td>
                <td>
                    @if (string.IsNullOrWhiteSpace(OTAway))
                    {
                        <span>-</span>
                    }
                    else
                    {
                        @OTAway
                    }
                </td>
                <td>
                    @if (item.FinalAwayScore == null)
                    {
                        <span>-</span>
                    }
                    else
                    {
                        @item.FinalAwayScore
                    }
                </td>
            </tr>

            }
        }
        else
        {
            @RazorHelper.ShowNoInfo(colspan: 8);
        }
    </tbody>
</table>