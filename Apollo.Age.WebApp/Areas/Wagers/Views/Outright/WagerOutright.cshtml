@using Apollo.Age.Resources
@using Apollo.Age.Entities
@using Apollo.Age.Wagers.ViewModels.Outright
@using Apollo.Age.Web.Mvc
@model List<OutrightViewModel>
<table class="tblRpt soccer">
    <thead>
        <tr>
            <th>
                @Lang.time
            </th>
            <th>
                @Lang.league
            </th>
            <th>
                @Lang.lblTeam
            </th>
            <th>
                @Lang.lblelimination
            </th>
            <th>
                @Lang.lblWager
            </th>
        </tr>
    </thead>    
    <tbody>
        @if (Model != null && Model.Any())
        {
            var subModel = new List<OutrightViewModel>();
            foreach (var item in Model)
            {
            <tr>
                <td>
                    @item.EventDate
                </td>
                <td>
                    @item.LeagueName
                </td>
                <td colspan="3">
                    <table class="tblRpt soccer">
                        @{
                            subModel = Model.Where(x => x.LeagueId == item.LeagueId).ToList();
                            var status = string.Empty;
                            foreach (OutrightViewModel subItem in subModel)
                            {
                                if (subItem.Status.ToLower() == "refund")
                                {
                                    status = Lang.refund;
                                }
                                else if (subItem.Status.ToLower() == "close")
                                {
                                    status = "+";
                                }
                                        <tr>
                                            <td>@subItem.TeamName
                                            </td>
                                            <td>@status
                                            </td>
                                            <td>@((int)subItem.BetCount)/@((int)subItem.Stake)
                                            </td>
                                        </tr>
                            }
                        }
                    </table>
                </td>
            </tr>
            }
        }
    </tbody>
</table>
@Html.Hidden("TotalItems", (int)ViewBag.TotalItems)