@using Apollo.Age.Resources
@using Apollo.Age.Entities
@using Apollo.Age.Wagers.ViewModels.Soccer
@using Apollo.Age.Web.Mvc
@using Apollo.Age.Enumerations
@model List<CorrectScoreViewModel>
<table class="tblRpt soccer half-full @((bool)ViewBag.IsEM ? "emw" : string.Empty)">
    @WagerHelper.RederHeaderColumn(Lang.lblWagersGolds)
    <tbody>
        @Model.List(
            @<tr class="c">
                @WagerHelper.RenderBaseColumns(item)
                <td class="r red-num" data-bettype="@((int)BetTypes.HT_FT)">
                    @WagerHelper.RenderColumnData("0", item.BetCount, item.Stake, item.LiveIndicator, item.LeagueId)
                </td>
            </tr>
        )
    </tbody>
</table>
@Html.Hidden("TotalItems", (int)ViewBag.TotalItems)
@Html.Hidden("TimeZone", RazorHelper.GetAtlanticStandardTimeZone(DateTime.Now))