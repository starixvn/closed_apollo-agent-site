@using Apollo.Age.Resources
@using Apollo.Age.Entities
@using Apollo.Age.Wagers.ViewModels.Soccer
@model IEnumerable<CorrectScoreViewModel>
<table class="tblRpt soccer">
                    <thead>
                        <tr class="RptHeader">
                            <th style="width: 100px;">
                                @Lang.time
                            </th>
                            <th style="width: 300px;">
                                @Lang.league
                            </th>                          
                            <th style="width: 100px;" class="nowrap">
                                @Lang.lblHomeAway
                            </th>
                            <th style="width: 100px;" class="nowrap">
                               @Lang.correctscore
                            </th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model)
                        {
                            <tr class="c">
                                <td>
                                   @item.ShowTime
                                </td>
                                <td>
                                    @item.LeagueName
                                </td>
                                <td class="l">
                                    <div>@item.HomeName </div>
                                    <div> @item.AwayName</div>                                     
                                </td>
                                <td class="r">
                                     @item.BetCount 
                                    /                              
                                    @item.Stake
                                </td>                            
                            </tr>
                        }
                    </tbody>
                </table>