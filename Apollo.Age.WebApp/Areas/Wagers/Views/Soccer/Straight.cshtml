@using Apollo.Age.Resources
@using Apollo.Age.Entities
@using Apollo.Age.Wagers.ViewModels.Soccer
@using Apollo.Age.Web.Mvc
@using Apollo.Age.Enumerations
@model List<StraightViewModel>
<table class="tblRpt soccer straight @((bool)ViewBag.IsEM ? "emw" : string.Empty)">
    @WagerHelper.RederHeaderColumn(Lang.lblHandicapFC
                    , Lang.lblOverUnder
                    , Lang.lbl1x2)
    <tbody>
        @Model.List(
            @<tr class="c">
                @WagerHelper.RenderBaseColumns(item, Lang.lblDraw)
                <td class="r red-num" data-bettype="@((int)BetTypes.Handicap)">
                    @WagerHelper.RenderColumnData(item.HomeBetteamHDP, item.HomeCountHDP, item.HomeStakeHDP, item.HomeStakeBeforeHDP, item.LiveIndicator, item.LeagueId, item.MatchId)
                    <br />
                    @WagerHelper.RenderColumnData(item.AwayBetteamHDP, item.AwayCountHDP, item.AwayStakeHDP, item.AwayStakeBeforeHDP, item.LiveIndicator, item.LeagueId, item.MatchId)
                </td>
                <td class="r red-num" data-bettype="@((int)BetTypes.Over_Under)">
                    @WagerHelper.RenderColumnData(item.HomeBetteamOU, item.HomeCountOU, item.HomeStakeOU, item.HomeStakeBeforeOU, item.LiveIndicator, item.LeagueId, item.MatchId)
                    <br />
                    @WagerHelper.RenderColumnData(item.AwayBetteamOU, item.AwayCountOU, item.AwayStakeOU, item.AwayStakeBeforeOU, item.LiveIndicator, item.LeagueId, item.MatchId)
                    <br />
                    &nbsp
                </td>
                <td class="r red-num" data-bettype="@((int)BetTypes.FT_1X2)">
                    @WagerHelper.RenderColumnData(item.Betteam1, item.Count1, item.Stake1, item.StakeBefore1, item.LiveIndicator, item.LeagueId, item.MatchId)
                    <br />
                    @WagerHelper.RenderColumnData(item.Betteam2, item.Count2, item.Stake2, item.StakeBefore2, item.LiveIndicator, item.LeagueId, item.MatchId)
                    <br />
                    @WagerHelper.RenderColumnData(item.BetteamX, item.CountX, item.StakeX, item.StakeBeforeX, item.LiveIndicator, item.LeagueId, item.MatchId)
                </td>
            </tr>
                                                  )
    </tbody>
</table>
@Html.Hidden("TotalItems", (int)ViewBag.TotalItems)
@Html.Hidden("TimeZone", RazorHelper.GetAtlanticStandardTimeZone(DateTime.Now))