@using Apollo.Age.Resources
@using Apollo.Age.Entities
@using Apollo.Age.Wagers.ViewModels.Soccer
@using Apollo.Age.Web.Mvc
@using Apollo.Age.Wagers.ViewModels
@model List<RunningBallViewModel>
<table class="tblRpt soccer @((bool)ViewBag.IsEM ? "emw" : string.Empty)">
    @WagerHelper.RederHeaderColumn(
    Lang.lblHandicapWager, 
    Lang.lbl1stHpdWager, 
    Lang.lblOverUnderWager, 
    Lang.lbl1stOUWager,
    Lang.lblOddEvenWagers,
    Lang.lbl1stOddEven,
    Lang.lbl1x2Wager,
    Lang.lbl1st1x2wager,
    Lang.lblmoneylineWager   
    )
    <tbody>
        @Model.List(
            @<tr class="c">
                @WagerHelper.RenderBaseColumns(item, Lang.lblDraw)
                <td class="border-right r red-num">
                    @WagerHelper.RenderColumnData(item.HomeBetteamHDP, item.HomeCountHDP, item.HomeStakeHDP, item.LiveIndicator, item.LeagueId)
                    <br />
                    @WagerHelper.RenderColumnData(item.AwayBetteamHDP, item.AwayCountHDP, item.AwayStakeHDP, item.LiveIndicator, item.LeagueId)
                </td>
                 <td class="border-right r red-num">
                    @WagerHelper.RenderColumnData(item.HomeBetteamHTHDP, item.HomeCountHTHDP, item.HomeStakeHTHDP, item.LiveIndicator, item.LeagueId)
                    <br />
                    @WagerHelper.RenderColumnData(item.AwayBetteamHTHDP, item.AwayCountHTHDP, item.AwayStakeHTHDP, item.LiveIndicator, item.LeagueId)
                </td>
                <td class="border-right r red-num">
                    @WagerHelper.RenderColumnData(item.HomeBetteamOU, item.HomeCountOU, item.HomeStakeOU, item.LiveIndicator, item.LeagueId)
                    <br />
                    @WagerHelper.RenderColumnData(item.AwayBetteamOU, item.AwayCountOU, item.AwayStakeOU, item.LiveIndicator, item.LeagueId)
                </td>
                 <td class="border-right r red-num">
                    @WagerHelper.RenderColumnData(item.HomeBetteamHTOU, item.HomeCountHTOU, item.HomeStakeHTOU, item.LiveIndicator, item.LeagueId)
                    <br />
                    @WagerHelper.RenderColumnData(item.AwayBetteamHTOU, item.AwayCountHTOU, item.AwayStakeHTOU, item.LiveIndicator, item.LeagueId)
                </td>             
                <td class="border-right r red-num">
                    @WagerHelper.RenderColumnData(item.HomeBetteamOE, item.HomeCountOE, item.HomeStakeOE, item.LiveIndicator)
                    <br />
                    @WagerHelper.RenderColumnData(item.AwayBetteamOE, item.AwayCountOE, item.AwayStakeOE, item.LiveIndicator)
                </td>
                 <td class="border-right r red-num">
                    @WagerHelper.RenderColumnData(item.HomeBetteamHTOE, item.HomeCountHTOE, item.HomeStakeHTOE, item.LiveIndicator)
                    <br />
                    @WagerHelper.RenderColumnData(item.AwayBetteamHTOE, item.AwayCountHTOE, item.AwayStakeHTOE, item.LiveIndicator)
                </td>
                <td class="border-right r red-num">
                    @WagerHelper.RenderColumnData(item.BetteamHT1, item.Count1, item.Stake1, item.LiveIndicator)
                    <br />
                    @WagerHelper.RenderColumnData(item.BetteamHTX, item.CountX, item.StakeX, item.LiveIndicator)
                    <br />
                    @WagerHelper.RenderColumnData(item.BetteamHT2, item.Count2, item.Stake2, item.LiveIndicator)
                </td>
                 <td class="border-right r red-num">
                    @WagerHelper.RenderColumnData(item.BetteamHT1, item.CountHT1, item.StakeHT1, item.LiveIndicator)
                    <br />
                    @WagerHelper.RenderColumnData(item.BetteamHTX, item.CountHTX, item.StakeHTX, item.LiveIndicator)
                    <br />
                    @WagerHelper.RenderColumnData(item.BetteamHT2, item.CountHT2, item.StakeHT2, item.LiveIndicator)
                </td> 
                 <td class="border-right r red-num">
                    @WagerHelper.RenderColumnData(item.HomeBetteamMoney, item.HomeCountMoney, item.HomeStakeMoney, item.LiveIndicator)
                    <br />
                    @WagerHelper.RenderColumnData(item.AwayBetteamMoney, item.AwayCountMoney, item.AwayStakeMoney, item.LiveIndicator)
                </td>
                     
            </tr>
            )
    </tbody>
</table>
@Html.Hidden("TotalItems", (int)ViewBag.TotalItems)
@Html.Hidden("TimeZone", RazorHelper.GetAtlanticStandardTimeZone(DateTime.Now))
