@using Apollo.Age.Resources
@using Apollo.Age.Entities
@using Apollo.Age.Wagers.ViewModels.Soccer
@using Apollo.Age.Web.Mvc
@using Apollo.Age.Enumerations
@model List<TotalViewModel>
@{
    var hasDownlineDetailsPermission = ViewBag.HasDownlineDetailsPermission != null ? (bool)ViewBag.HasDownlineDetailsPermission : false;
}
<table class="tblRpt soccer total @((bool)ViewBag.IsEM ? "emw" : string.Empty)">
    <thead>
        <tr class="RptHeader">
            <th rowspan="2" class="width-90">@Lang.TimeGMT8
            </th>
            <th rowspan="2">@Lang.lblWagerLeague
            </th>
            <th rowspan="2">@Lang.HomeGuest
            </th>
            <th colspan="2">@Lang.lbl1sthalf
            </th>
            <th colspan="2">@Lang.fulltime
            </th>
            <th colspan="3">@Lang.lbl1sthalf
            </th>
            <th colspan="4">@Lang.fulltime
            </th>
        </tr>
        <tr class="RptHeader">
            <th>@Lang.lblOdd
            </th>
            <th>@Lang.lblEven
            </th>
            <th>@Lang.lblOdd
            </th>
            <th>@Lang.lblEven
            </th>
            <th>@Lang.lbl0_1
            </th>
            <th>@Lang.lbl2_3
            </th>
            <th>@Lang.lbl4over
            </th>
            <th>@Lang.lbl0_1
            </th>
            <th>@Lang.lbl2_3
            </th>
            <th>@Lang.lbl4_6
            </th>
            <th>@Lang.lbl7up
            </th>
        </tr>
    </thead>
    @*@WagerHelper.RederHeaderColumn(Lang.lblfirsthalfOdd, Lang.lblfirsthalfOven, Lang.lblOdd, Lang.lblEven, Lang.lbl0_1, Lang.lbl2_3, Lang.lbl4_6, Lang.lbl7up)*@
    @Model.List(
        @<tr class="c">
            @WagerHelper.RenderBaseColumns(item)
            <td class="r red-num vertical-middle nowrap" data-bettype="@((int)BetTypes._1st_Odd_Even)">
                @WagerHelper.RenderColumnData(item.HomeBetteamHTOE, item.HomeCountHTOE, item.HomeStakeHTOE, item.HomeStakeBeforeHTOE, item.LiveIndicator, item.LeagueId, item.MatchId, hasDownlineDetailsPermission)
            </td>
            <td class="r red-num vertical-middle nowrap" data-bettype="@((int)BetTypes._1st_Odd_Even)">
                @WagerHelper.RenderColumnData(item.AwayBetteamHTOE, item.AwayCountHTOE, item.AwayStakeHTOE, item.AwayStakeBeforeHTOE, item.LiveIndicator, item.LeagueId, item.MatchId, hasDownlineDetailsPermission)
            </td>
            <td class="r red-num vertical-middle nowrap" data-bettype="@((int)BetTypes.Odd_Even)">
                @WagerHelper.RenderColumnData(item.HomeBetteamOE, item.HomeCountOE, item.HomeStakeOE, item.HomeStakeBeforeOE, item.LiveIndicator, item.LeagueId, item.MatchId, hasDownlineDetailsPermission)
            </td>
            <td class="r red-num vertical-middle nowrap" data-bettype="@((int)BetTypes.Odd_Even)">
                @WagerHelper.RenderColumnData(item.AwayBetteamOE, item.AwayCountOE, item.AwayStakeOE, item.AwayStakeBeforeOE, item.LiveIndicator, item.LeagueId, item.MatchId, hasDownlineDetailsPermission)
            </td>
            <td class="r red-num vertical-middle nowrap" data-bettype="@((int)BetTypes.First_Total_Goal)">
                @WagerHelper.RenderColumnData(item.HTTotal01Betteam, item.HTTotal01Count, item.HTTotal01Stake, item.HTTotal01StakeBefore, item.LiveIndicator, item.LeagueId, item.MatchId, hasDownlineDetailsPermission)
            </td>
            <td class="r red-num vertical-middle nowrap" data-bettype="@((int)BetTypes.First_Total_Goal)">
                @WagerHelper.RenderColumnData(item.HTTotal23Betteam, item.HTTotal23Count, item.HTTotal23Stake, item.HTTotal23StakeBefore, item.LiveIndicator, item.LeagueId, item.MatchId, hasDownlineDetailsPermission)
            </td>
            <td class="r red-num vertical-middle nowrap" data-bettype="@((int)BetTypes.First_Total_Goal)">
                @WagerHelper.RenderColumnData(item.HTTotal4OverBetteam, item.HTTotal4OverCount, item.HTTotal4OverStake, item.HTTotal4OverStakeBefore, item.LiveIndicator, item.LeagueId, item.MatchId, hasDownlineDetailsPermission)
            </td>
            <td class="r red-num vertical-middle nowrap" data-bettype="@((int)BetTypes.Total_Goal)">
                @WagerHelper.RenderColumnData(item.Total01Betteam, item.Total01Count, item.Total01Stake, item.Total01StakeBefore, item.LiveIndicator, item.LeagueId, item.MatchId, hasDownlineDetailsPermission)
            </td>
            <td class="r red-num vertical-middle nowrap" data-bettype="@((int)BetTypes.Total_Goal)">
                @WagerHelper.RenderColumnData(item.Total23Betteam, item.Total23Count, item.Total23Stake, item.Total23StakeBefore, item.LiveIndicator, item.LeagueId, item.MatchId, hasDownlineDetailsPermission)
            </td>
            <td class="r red-num vertical-middle nowrap" data-bettype="@((int)BetTypes.Total_Goal)">
                @WagerHelper.RenderColumnData(item.Total46Betteam, item.Total46Count, item.Total46Stake, item.Total46StakeBefore, item.LiveIndicator, item.LeagueId, item.MatchId, hasDownlineDetailsPermission)
            </td>
            <td class="r red-num vertical-middle nowrap" data-bettype="@((int)BetTypes.Total_Goal)">
                @WagerHelper.RenderColumnData(item.Total7OverBetteam, item.Total7OverCount, item.Total7OverStake, item.Total7OverStakeBefore, item.LiveIndicator, item.LeagueId, item.MatchId, hasDownlineDetailsPermission)
            </td>
        </tr>
    )
</table>
@Html.Hidden("TotalItems", (int)ViewBag.TotalItems)
@Html.Hidden("TimeZone", RazorHelper.GetAtlanticStandardTimeZone(DateTime.Now))
