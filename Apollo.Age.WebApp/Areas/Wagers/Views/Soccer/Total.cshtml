@using Apollo.Age.Resources
@using Apollo.Age.Entities
@using Apollo.Age.Wagers.ViewModels.Soccer
@using Apollo.Age.Web.Mvc
@model List<TotalViewModel>
<table class="tblRpt soccer total">
    @WagerHelper.RederHeaderColumn(Lang.lblfirsthalfOdd, Lang.lblfirsthalfOven, Lang.odds, Lang.events, Lang.lbl0_1, Lang.lbl2_3, Lang.lbl4_6, Lang.lbl7up)
    @Model.List(
        @<tr class="c">
            @WagerHelper.RenderBaseColumns(item)
            <td class="border-right r red-num">
                @item.HomeCountHTOE/@Math.Round(@item.HomeStakeHTOE)
            </td>
            <td class="border-right r red-num">
                @item.AwayCountHTOE/@Math.Round(@item.AwayStakeHTOE)
            </td>
            <td class="border-right r red-num">
                @item.HomeCountOE/@Math.Round(@item.HomeStakeOE)
            </td>
            <td class="border-right r red-num">
                @item.AwayCountOE/@Math.Round(@item.AwayStakeOE)
            </td>
            <td class="border-right r red-num">
                @item.Total01Count/@Math.Round(@item.Total01Stake)
            </td>
            <td class="border-right r red-num">
                @item.Total23Count/@Math.Round(@item.Total23Stake)
            </td>
            <td class="border-right r red-num">
                @item.Total46Count/@Math.Round(@item.Total46Stake)
            </td>
            <td class="border-right r red-num">
                @item.Total7OverCount/@Math.Round(@item.Total7OverStake)
            </td>
        </tr>
    )
</table>
@Html.Hidden("TotalItems", (int)ViewBag.TotalItems)
