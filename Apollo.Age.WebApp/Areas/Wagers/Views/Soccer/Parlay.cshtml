@using Apollo.Age.Resources
@using Apollo.Age.Entities
@using Apollo.Age.Wagers.ViewModels.Soccer
@using Apollo.Age.Web.Mvc
@using Apollo.Age.Enumerations
@model List<ParlayViewModel>
<table class="tblRpt soccer parlay @((bool)ViewBag.IsEM ? "emw" : string.Empty)">
    @WagerHelper.RederHeaderColumn(Lang.lblMixParlay
                    , Lang.lblSystemParlay)
    <tbody>
        @Model.List(
            @<tr class="c">
                @WagerHelper.RenderBaseColumns(item)
                <td class="r red-num vertical-middle" data-bettype="@((int)BetTypes.MixParlay)">
                    @WagerHelper.RenderColumnData("0", item.Count9, item.Stake9, item.StakeBefore9, item.LiveIndicator, item.LeagueId, item.MatchId)
                </td>
                <td class="r red-num vertical-middle" data-bettype="@((int)BetTypes.Combine_Mix_Parlay)">
                    @WagerHelper.RenderColumnData("0", item.Count29, item.Stake29, item.StakeBefore29, item.LiveIndicator, item.LeagueId, item.MatchId)
                </td>
            </tr>
        )
    </tbody>
</table>
@Html.Hidden("TotalItems", (int)ViewBag.TotalItems)
@Html.Hidden("TimeZone", RazorHelper.GetAtlanticStandardTimeZone(DateTime.Now))