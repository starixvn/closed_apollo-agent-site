@using Apollo.Age.Resources
@using Apollo.Age.Entities
@using Apollo.Age.Wagers.ViewModels.Soccer
@using Apollo.Age.Web.Mvc
@model List<FirstHalfViewModel>
<table class="tblRpt soccer">
    @WagerHelper.RederHeaderColumn(Lang.lblHandicapWager
                    , Lang.lblOverUnderWager
                    , Lang.lblOddEvenWagers)
    <tbody>
        @Model.List(
                            @<tr class="c">
                                @WagerHelper.RenderBaseColumns(item, Lang.lblDraw)
                                <td class="r">
                                    @((int)item.HomeCountHTHDP)/@((int)item.HomeStakeHTHDP)
                                    <br />
                                    @((int)item.AwayCountHTHDP)/@((int)item.AwayCountHTHDP)
                                </td>
                                <td class="r">
                                    @((int)item.HomeCountHTOU)/@((int)item.HomeStakeHTOU)
                                    <br />
                                    @((int)item.AwayCountHTOU)/@((int)item.AwayStakeHTOU)
                                </td>
                                <td class="r">
                                    @((int)item.CountHT1)/@((int)item.StakeHT1)
                                    <br />
                                    @((int)item.CountHT2)/@((int)item.StakeHT2)
                                    <br />
                                    @((int)item.CountHTX)/@((int)item.StakeHTX)
                                </td>
                            </tr>
                       )
    </tbody>
</table>