@using Apollo.Age.Resources
@using Apollo.Age.Entities
@using Apollo.Age.Wagers.ViewModels.Soccer
@using Apollo.Age.Web.Mvc
@model List<FirstHalfViewModel>
<table class="tblRpt soccer first-half">
    @WagerHelper.RederHeaderColumn(Lang.lblHandicapWager
                    , Lang.lblOverUnderWager
                    , Lang.lblOddEvenWagers)
    <tbody>
        @Model.List(
            @<tr class="c">
                @WagerHelper.RenderBaseColumns(item, Lang.lblDraw)
                <td class="border-right r red-num">
                    @item.HomeCountHTHDP/@Math.Round(item.HomeStakeHTHDP)
                    <br />
                    @item.AwayCountHTHDP/@Math.Round(item.AwayStakeHTHDP)
                </td>
                <td class="border-right r red-num">
                    @item.HomeCountHTOU/@Math.Round(item.HomeStakeHTOU)
                    <br />
                    @item.AwayCountHTOU/@Math.Round(item.AwayStakeHTOU)
                </td>
                <td class="border-right r red-num">
                    @item.CountHT1/@Math.Round(item.StakeHT1)
                    <br />
                    @item.CountHT2/@Math.Round(item.StakeHT2)
                    <br />
                    @item.CountHTX/@Math.Round(item.StakeHTX)
                </td>
            </tr>
        )
    </tbody>
</table>
@Html.Hidden("TotalItems", (int)ViewBag.TotalItems)
