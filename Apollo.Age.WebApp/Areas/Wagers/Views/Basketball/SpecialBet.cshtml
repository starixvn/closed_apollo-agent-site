@using Apollo.Age.Resources
@using Apollo.Age.Wagers.ViewModels.Basketball
@using Apollo.Age.Web.Mvc
@model List<SpecialViewModel>
<table class="tblRpt basketball">
    @WagerHelper.RederHeaderColumn(Lang.moneyline)
    @*/RenderHeader*@
    <tbody>
        @Model.List(
            @<tr class="c">
                @WagerHelper.RenderBaseColumns(item)
                <td class="border-right r red-num">
                    @((int)item.HomeCountMoney)/@((int)item.HomeStakeMoney)
                    <br />
                    @((int)item.AwayCountMoney)/@((int)item.AwayStakeMoney)
                </td>
            </tr>
            )
    </tbody>
</table>
