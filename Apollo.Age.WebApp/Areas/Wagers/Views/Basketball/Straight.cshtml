@using Apollo.Age.Resources
@using Apollo.Age.Wagers.ViewModels.Basketball
@using Apollo.Age.Web.Mvc
@model List<WagersStraightViewModel>
<table class="tblRpt basketball">
    <thead>
        <tr class="RptHeader">
            <th style="width: 40px;">
                @Lang.time
            </th>
            <th>
                @Lang.league
            </th>
            <th class="nowrap">
                @Lang.lblhomeandguest
            </th>
            <th class="nowrap">
                @Lang.lblHandicapWager
            </th>
            <th class="nowrap">
                @Lang.lblOverUnderWager
            </th>
            <th class="nowrap">
                @Lang.lblOddEvenWagers
            </th>
        </tr>
    </thead>
    <tbody>
        @if (!ReferenceEquals(Model, null)
        && Model.Any())
        {
            foreach (var item in Model)
            {
            <tr class="c">
                <td class="width-40 show-time">
                    @Html.FormatShowTime(item.Showtime, true)
                    <br />
                    @if (item.LiveIndicator)
                    {
                        <span class="red-num">@Lang.RunningBall</span>
                    }
                </td>
                <td class="l">
                    @item.LeagueName
                </td>
                <td class="l">
                    <div>@item.HomeName</div>
                    <div>@item.AwayName</div>
                </td>
                <td class="border-right">
                    <div class="r red-num">
                        @((int)item.HomeCountHDP)/@((int)item.HomeStakeHDP)
                    </div>
                    <div class="r red-num">
                        @((int)item.AwayCountHDP)/@((int)item.AwayStakeHDP)
                    </div>
                </td>
                <td class="border-right">
                    <div class="r red-num">
                        @((int)item.HomeCountOU)/@((int)item.HomeStakeOU)
                    </div>
                    <div class="r red-num">
                        @((int)item.AwayCountOU)/@((int)item.AwayStakeOU)
                    </div>
                </td>
                <td class="border-right">
                    <div class="r red-num">
                        @((int)item.HomeCountOE)/@((int)item.HomeStakeOE)
                    </div>
                    <div class="r red-num">
                        @((int)item.AwayCountOE)/@((int)item.AwayStakeOE)
                    </div>
                </td>
            </tr>
            }
        }
    </tbody>
</table>
