@using Apollo.Age.Resources
@using Apollo.Age.Wagers.ViewModels.Basketball
@using Apollo.Age.Web.Mvc
@model List<StraightViewModel>
<table class="tblRpt @ViewBag.SportName straight @((bool)ViewBag.IsEM ? "emw" : string.Empty)">
    @WagerHelper.RederHeaderColumn(Lang.lblHandicapWager
        , Lang.lblOverUnderWager
        , Lang.lbl1x2Wager)
    @*/RenderHeader*@
    <tbody>
        @Model.List(
            @<tr class="c">
                @WagerHelper.RenderBaseColumns(item)
                <td class="border-right r red-num">
                    @WagerHelper.RenderColumnData(item.HomeBetteamHDP, item.HomeCountHDP, item.HomeStakeHDP, item.LiveIndicator)
                    <br />
                    @WagerHelper.RenderColumnData(item.AwayBetteamHDP, item.AwayCountHDP, item.AwayStakeHDP, item.LiveIndicator)
                </td>
                <td class="border-right r red-num">
                    @WagerHelper.RenderColumnData(item.HomeBetteamOU, item.HomeCountOU, item.HomeStakeOU, item.LiveIndicator)
                    <br />
                    @WagerHelper.RenderColumnData(item.AwayBetteamOU, item.AwayCountOU, item.AwayStakeOU, item.LiveIndicator)
                </td>
                <td class="border-right r red-num">
                    @WagerHelper.RenderColumnData(item.HomeBetteamOE, item.HomeCountOE, item.HomeStakeOE, item.LiveIndicator)
                    <br />
                    @WagerHelper.RenderColumnData(item.AwayBetteamOE, item.AwayCountOE, item.AwayStakeOE, item.LiveIndicator)
                </td>
            </tr>
        )
    </tbody>
</table>
@Html.Hidden("TotalItems", (int)ViewBag.TotalItems)
