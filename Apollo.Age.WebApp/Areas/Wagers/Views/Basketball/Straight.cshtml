@using Apollo.Age.Resources
@using Apollo.Age.Wagers.ViewModels.Basketball
@using Apollo.Age.Web.Mvc
@model List<StraightViewModel>
<table class="tblRpt @ViewBag.SportName straight">
    @WagerHelper.RederHeaderColumn(Lang.lblHandicapWager
        , Lang.lblOverUnderWager
        , Lang.lbl1x2Wager)
    @*/RenderHeader*@
    <tbody>
        @Model.List(
            @<tr class="c">
                @WagerHelper.RenderBaseColumns(item)
                <td class="border-right r red-num">
                    @item.HomeCountHDP/@Math.Round(item.HomeStakeHDP)
                    <br />
                    @item.AwayCountHDP/@Math.Round(item.AwayStakeHDP)
                </td>
                <td class="border-right r red-num">
                    @item.HomeCountOU/@Math.Round(item.HomeStakeOU)
                    <br />
                    @item.AwayCountOU/@Math.Round(item.AwayStakeOU)
                </td>
                <td class="border-right r red-num">
                    @item.HomeCountOE/@Math.Round(item.HomeStakeOE)
                    <br />
                    @item.AwayCountOE/@Math.Round(item.AwayStakeOE)
                </td>
            </tr>
            )
    </tbody>
</table>
@Html.Hidden("TotalItems", (int)ViewBag.TotalItems)
