@using Apollo.Age.Resources
@using Apollo.Age.Wagers.ViewModels.Basketball
@using Apollo.Age.Web.Mvc
@model List<WagersFirstHaftViewModel>
<table class="tblRpt basketball">
    <thead>
        <tr class="RptHeader">
            <th style="width: 40px;">
                @Lang.time
            </th>
            <th>
                @Lang.league
            </th>
            <th class="nowrap">
                @Lang.lblhomeandguest
            </th>
            <th class="nowrap">
                @Lang.lblHandicapWager
            </th>
            <th class="nowrap">
                @Lang.lblOverUnderWager
            </th>
            <th class="nowrap">
                @Lang.lblOddEvenWagers
            </th>
        </tr>
    </thead>
    <tbody>
        @if (!ReferenceEquals(Model, null)
        && Model.Any())
        {
            foreach (var item in Model)
            {
            <tr class="c">
                <td class="width-40 show-time">
                    @Html.FormatShowTime(item.Showtime, true)
                    @if (item.LiveIndicator)
                    {
                        <span class="red-num">@Lang.RunningBall</span>
                    }
                </td>
                <td class="l">
                    @item.LeagueName
                </td>
                <td class="l">
                    <div>@item.HomeName</div>
                    <div>@item.AwayName</div>
                </td>
                <td class="border-right">
                    <div class="r red-num">
                        @((int)item.HomeCountHTHDP)/@((int)item.HomeStakeHTHDP)
                    </div>
                    <div class="r red-num">
                        @((int)item.AwayCountHTHDP)/@((int)item.AwayStakeHTHDP)
                    </div>
                </td>
                <td class="border-right">
                    <div class="r red-num">
                        @((int)item.HomeCountHTOU)/@((int)item.HomeStakeHTOU)
                    </div>
                    <div class="r red-num">
                        @((int)item.AwayCountHTOU)/@((int)item.AwayStakeHTOU)
                    </div>
                </td>
                <td class="border-right">
                    <div class="r red-num">
                        @((int)item.HomeCountHTOE)/@((int)item.HomeStakeHTOE)
                    </div>
                    <div class="r red-num">
                        @((int)item.AwayCountHTOE)/@((int)item.AwayStakeHTOE)
                    </div>
                </td>
            </tr>
            }
        }
    </tbody>
</table>
