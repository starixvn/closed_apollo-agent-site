@using Apollo.Age.Resources
@using Apollo.Age.Entities
@{
    Layout = null;    
}
<!DOCTYPE html>
<html lang="en-us">
<head>
    <title>@Lang.lblWager</title>
    <link href="~/Areas/Wagers/Styles/Wagers.less" rel="Stylesheet" type="text/css" />
    <link href="~/_GlobalResources/Css/RefreshCountDown.less" rel="Stylesheet" type="text/css" />
</head>
<body>
    <div id="function-bar">
        <div class="item">
            @Lang.lblOP.
            <select class="za_select" name="ltype" id="ltype">
                <option value="a">@Lang.soccer A</option>
                <option value="b">@Lang.soccer B</option>
                <option value="c">@Lang.soccer C</option>
                <option value="d">@Lang.soccer D</option>
            </select>
        </div>
        <div class="before-filter">
            --</div>@RazorHelper.RefreshCountDown("TOTALBETSINDEX", new int[1] { 180 }, "TOTALBETS_INDEX.reloadChild();")
        @RazorHelper.ToEasternTime(DateTime.Now)
        <div class="before-filter">
            --</div>
        <ul class="menu">
           @RazorHelper.RenderWagersBettypeMenu(Apollo.Age.Wagers.Core.WagersSporttypes.SC)
        </ul>
        <img alt="" src="~/_GlobalResources/Images/top_04.gif">
    </div>
    <div class="mainpage">
        <div id="content_main">
            <div id="header_main">@ViewBag.Title</div>
            <div class="box-header" id="main-shareholder-box">
                <div class="row">
                    <div class="cell">
                        <div class="label">
                            <label for="ddlLeague">
                                @Lang.view&nbsp;:</label>
                        </div>
                        <div class="editor">
                            @Html.DropDownList("ViewOption", new List<SelectListItem>
                       {
                           new SelectListItem{ Value="0", Text=Lang.all},
                           new SelectListItem{Value="1",Text=Lang.DirectMembers}
                       })
                        </div>
                    </div>
                    <div class="cell">
                        <div class="label">
                            <label for="ddlLeague">
                                @Lang.league&nbsp;:</label>
                        </div>
                        <div class="editor">
                            @Html.DropDownList("League", (List<SelectListItem>)ViewBag.Leagues)
                        </div>
                    </div>
                </div>
            </div>
            <div id="wagerContainer">
                <table class="tblRpt soccer">
                    <thead>
                        <tr class="RptHeader">
                            <th style="width: 100px;">
                                @Lang.time
                            </th>
                            <th style="width: 300px;">
                                @Lang.league
                            </th>
                            <th style="width: 300px;">
                               Match Code
                            </th>
                            <th style="width: 100px;" class="nowrap">
                                @Lang.homeaway
                            </th>
                            <th style="width: 100px;" class="nowrap">
                                Handicap/Wagers
                            </th>
                            <th style="width: 100px;" class="nowrap">
                                Over/Under/Wagers
                            </th>
                             <th style="width: 100px;" class="nowrap">
                                1x2/Wagers
                            </th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr class="c">
                            <td class="width-80">
                               
                            </td>
                            <td>
                                
                            </td>
                            <td class="l">
                               
                            </td>
                            <td>
                              
                            </td>
                            <td class="border-right">
                              
                            </td>
                            <td class="border-right">
                              
                            </td>
                              </td>
                            <td class="border-right">
                               
                            </td>
                        </tr>
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</body>
</html>
@Scripts.Render("~/areas/Wagers/Soccer")
