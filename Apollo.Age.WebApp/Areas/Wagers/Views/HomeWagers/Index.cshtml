@using Apollo.Age.Resources
@using Apollo.Age.Entities
@{
    Layout = null;
    var sportType = (string)ViewBag.SportType;
    var title = (string)ViewBag.Title;
}
<!DOCTYPE html>
<html lang="en-us">
<head>
    <title>@Lang.lblWager</title>
    <link href="~/Areas/Wagers/Styles/Wagers.less" rel="Stylesheet" type="text/css" />
    <link href="~/_GlobalResources/Css/RefreshCountDown.less" rel="Stylesheet" type="text/css" />
</head>
<body>
    <div id="function-bar">
        <div class="item">
            @Lang.lblOP.
            <select class="za_select" name="ltype" id="ltype">
                <option value="a">@title A</option>
                <option value="b">@title B</option>
                <option value="c">@title C</option>
                <option value="d">@title D</option>
            </select>
        </div>
        <div class="before-filter">
            --</div>@RazorHelper.RefreshCountDown("TOTALBETSINDEX", 15, 15, "TOTALBETS_INDEX.reloadChild();")
        @RazorHelper.ToEasternTime(DateTime.Now)
        <div class="before-filter">
            --</div>
        <ul class="menu">
            @RazorHelper.RenderWagersBettypeMenu(sportType)
        </ul>
        <img alt="" src="~/_GlobalResources/Images/top_04.gif">
    </div>
    <div class="mainpage">
        <div id="content_main">
            @RazorHelper.RenderWagersFilter(title, (List<League>)ViewBag.Leagues)
            <div id="wagerContainer">
            </div>
        </div>
    </div>
</body>
</html>
@Scripts.Render("~/areas/Wagers/BkNFLRugby")
