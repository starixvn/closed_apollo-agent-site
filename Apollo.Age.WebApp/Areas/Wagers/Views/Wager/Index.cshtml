@using Apollo.Age.Resources
@using Apollo.Age.Wagers.Core
@using Apollo.Age.Entities
@{
    Layout = null;
    var groupBetName = (string)ViewBag.GroupBetName;
    var sportName = (string)ViewBag.SportName;
    var title = (string)ViewBag.Title;
    var titleAll = (string)ViewBag.TitleAll;
    var lableGroupBet = (string)ViewBag.LableGroupBetName;
    var EmCalendar = ViewBag.EmCalendar != null ? (List<SelectListItem>)ViewBag.EmCalendar : null;
    var isEM = false;
}
<!DOCTYPE html>
<html lang="en-us">
<head>
    <title>@Lang.lblWager</title>
    <link href="~/Areas/Wagers/Styles/Wagers.less" rel="Stylesheet" type="text/css" />
    <link href="~/_GlobalResources/Css/RefreshCountDown.less" rel="Stylesheet" type="text/css" />
    <link href="~/_GlobalResources/Js/Pager/jquery.sbpager.less" rel="stylesheet" type="text/css" />
</head>
<body>
    <div id="function-bar">
        <div class="item">
            @Lang.lblOP.
            <select class="za_select" name="ltype" id="groupComm">
                <option value="All">@titleAll</option>
                <option value="A">@title A</option>
                <option value="B">@title B </option>
                <option value="C">@title C </option>
                <option value="D">@title D </option>
            </select>
        </div>
        <div class="before-filter">
            --</div>@RazorHelper.RefreshCountDown("TOTALBETSINDEX", new int[] { 180 }, "TotalBetsIndex.reloadChild();")
        @RazorHelper.ToServerTime(DateTime.Now)
        <div class="before-filter">
            --</div>
        @if (EmCalendar != null)
        {
            isEM = true;         
            <div class="item">
                @(Lang.date):
                @Html.DropDownList("EmDate", EmCalendar)
            </div>
        }
        <div class="before-filter">
            --</div>
        @WagerHelper.RenderMenu(sportName, groupBetName, isEM)
        <img alt="" src="~/_GlobalResources/Images/top_04.gif" />
    </div>
    @Html.Hidden("GroupBetName", groupBetName)
    @Html.Hidden("SportName", sportName)
    @Html.Hidden("FromDate", new DateTime(2013, 8, 1))@*Sample data - 10 days*@
    @Html.Hidden("SportTypeIds", (string)ViewBag.SportTypes)
    <div class="mainpage">
        @WagerHelper.RenderFilter(lableGroupBet, (List<League>)ViewBag.Leagues, (List<Agent>)ViewBag.MainShareHolder)
        @Lang.Pages:
        <div id="pager" class="sbpager">
        </div>
        <div id="container">
        </div>
    </div>
    @Html.Hidden("ApoRoot", Url.Content("~/"))
    @Html.Hidden("PageIndex", 0)
</body>
</html>
@Scripts.Render("~/areas/Wagers")
