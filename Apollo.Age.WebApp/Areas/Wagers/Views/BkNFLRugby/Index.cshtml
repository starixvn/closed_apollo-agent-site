@using Apollo.Age.Resources
@using Apollo.Age.Entities
@{
    Layout = null;
    var menu = new List<string[]>
	{
		new string[] {"~/wagers/BkNFLRugby?bettype=1", Lang.lblStraight},		
		new string[] {"~/wagers/BkNFLRugby?bettype=2", Lang.lblRB},		
		new string[] {"~/wagers/BkNFLRugby?bettype=3", Lang.total},
		new string[] {"~/wagers/BkNFLRugby?bettype=4", Lang.lblHalfFull},
		new string[] {"~/wagers/BkNFLRugby?bettype=5",Lang.lblParlay}		
	};
    int menuItemCount = menu.Count;
}
<!DOCTYPE html>
<html lang="en-us">
<head>
    <title>@Lang.lblWager</title>
    <link href="~/Areas/Wagers/Styles/Wagers.less" rel="Stylesheet" type="text/css" />
    <link href="~/_GlobalResources/Css/RefreshCountDown.less" rel="Stylesheet" type="text/css" />
</head>
<body>
    <div id="function-bar">
        <div class="item">
            @Lang.lblOP.
            <select class="za_select" name="ltype" id="ltype">
                <option value="1">Baskeball A</option>
                <option value="2">Baskeball B</option>
                <option value="3">Baskeball C</option>
                <option value="4">Baskeball D</option>
            </select>
        </div>
        <div class="before-filter">
            --</div>@RazorHelper.RefreshCountDown("TOTALBETSINDEX", 15, 15, "TOTALBETS_INDEX.reloadChild();")
        @RazorHelper.ToEasternTime(DateTime.Now)
        <div class="before-filter">
            --</div>
        <ul class="menu">
            @for (int i = 0; i < menu.Count; i++)
            {
                var item = menu[i];
                <li class="@(i == 0 ? "active" : string.Empty)"><a href="@Url.Content(item[0])" target="submain">@item[1]</a></li>
            }
        </ul>
        <img alt="" src="~/_GlobalResources/Images/top_04.gif">
    </div>
    <div class="mainpage">
        <div id="content_main">
            <div id="header_main">@ViewBag.Title</div>
            <div class="box-header" id="main-shareholder-box">
                <div class="row">
                    <div class="cell">
                        <div class="label">
                            <label for="ddlLeague">
                                @Lang.view&nbsp;:</label>
                        </div>
                        <div class="editor">
                            @Html.DropDownList("ViewOption", new List<SelectListItem>
                       {
                           new SelectListItem{ Value="0", Text=Lang.all},
                           new SelectListItem{Value="1",Text=Lang.DirectMembers}
                       })
                        </div>
                    </div>
                    <div class="cell">
                        <div class="label">
                            <label for="ddlLeague">
                                @Lang.league&nbsp;:</label>
                        </div>
                        <div class="editor">
                            @Html.DropDownList("League", (List<SelectListItem>)ViewBag.Leagues)
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</body>
</html>
