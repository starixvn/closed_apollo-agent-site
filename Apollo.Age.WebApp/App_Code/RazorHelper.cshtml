@helper RenderSportDropDownList(List<Apollo.Age.Entities.SingbetSport> sportList, string currentSportId, string id = "ddlSport", string className = "")
    {
    <select id="@id" name="@id"  class="@className">
        @if (sportList != null)
        {
            foreach (var sport in sportList)
            {
            <option value="@sport.Id" selected="@(sport.Id == @currentSportId)">@sport.Name</option>
            }
        }
    </select>
}
@helper RenderBettypeDropDownList(List<Apollo.Age.Entities.SingbetBettype> bettypeList, string currentBettypeId, string id = "ddlBettype", string className = "")
    {
    <select id="@id" name="@id" class="@className">
        @if (bettypeList != null)
        {
            foreach (var bettype in bettypeList)
            {
            <option value="@bettype.Id" selected="@(bettype.Id == @currentBettypeId)">@bettype.Name</option>
            }
        }
    </select>
}
@helper RenderResultBySport()
    {
        List<SingbetSport> singbetSports = Apollo.Age.Services.Impl.SingbetSportService.GetSport(true);

        foreach (SingbetSport sport in singbetSports)
        {
            if (sport.Id != Apollo.Age.Core.SportGroup.All)
            {
                if (sport.Id == Apollo.Age.Core.SportGroup.Others)
                {
    <li><a href="#" id="@sport.Id" name="menuothersport">[@(sport.Name)]</a></li>
                }
                else if (sport.Id == Apollo.Age.Core.SportGroup.Outright)
                {
    <li><a href="#" id="@sport.Id" name="menuoutright">[@(sport.Name)]</a></li>
                }
                else
                {
    <li><a href="#" id="@sport.Id" name="menusport">[@(sport.Name)]</a></li>
                }
            }

        }
}
@helper ToServerTime(DateTime datetime)
    {
        if (datetime != null)
        {
            datetime = DateTime.Now;
        }
        try
        {
            TimeZoneInfo easternZone = TimeZoneInfo.FindSystemTimeZoneById("Atlantic Standard Time");
            var easternTime = TimeZoneInfo.ConvertTimeFromUtc(datetime.ToUniversalTime(), easternZone);

    <div class="est-zone">@(string.Format("--GMT-4: {0}", Formater.LongDateFormat(easternTime)))</div>

        }
        catch (Exception ex)
        {
            Logger.Log.Error(ex.Message, ex);
        }
}
@helper RenderWagersFilter(string title, List<League> leagues)
    {
    <div id="header_main">@title</div>
    <div class="box-header" id="main-shareholder-box">
        <div class="row">
            <div class="cell">
                <div class="label">
                    <label for="ddlLeague">
                        @Lang.view&nbsp;:</label>
                </div>
                <div class="editor">
                    <select id="ViewOption" class="za_select">
                        <option value="false">@Lang.all</option>
                        <option value="true">@Lang.DirectMembers</option>
                    </select>
                </div>
            </div>
            <div class="cell">
                <div class="label">
                    <label for="ddlLeague">
                        @Lang.league&nbsp;:</label>
                </div>
                <div class="editor">
                    <select id="League" class="za_select">
                        <option value="0">@Lang.all</option>
                        @if (!ReferenceEquals(leagues, null)
                            && leagues.Any())
                        {
                            foreach (var item in leagues)
                            {
                            <option value="@item.Id">@CacheRef.GetLeagueName(item.Id)</option>
                            }
                        }
                    </select>
                </div>
            </div>
        </div>
    </div>
}
@helper RenderWagersBaseColumn(WagerViewModel item, bool isRaw = false)
    {
        var showTime = item.ShowTime;
        string format = string.IsNullOrEmpty(showTime) ? string.Empty : showTime.Replace("</font>", "<#font>").Replace('/', '-').Replace("<#font>", "</font>").TrimEnd('M');
    <td class="width-40 show-time">
        @item.ShowTime
        @if (item.LiveIndicator)
        {
            <span class="red-num">@Lang.RunningBall</span>
        }
    </td>
    <td class="l">
        @item.LeagueName
    </td>
    <td class="l">
        @item.HomeName
        <br />
        @item.AwayName
        @if (isRaw)
        {
            <div class="r text-green">@Lang.lblDraw</div>
        }
    </td>
}

@helper RenderReportLinks(string currentLink)
{
	var classWinloss = string.Empty;
	var classOutstanding = string.Empty;
	var classTransaction = string.Empty;
	var classTicketsCancelled = string.Empty;

	if (currentLink.ToUpper().Equals(Lang.lblWinLoss.ToUpper()))
	{
		classWinloss = "class=active";
	}
	else if (currentLink.ToUpper().Equals(Lang.outstanding.ToUpper()))
	{
		classOutstanding = "class=active";
	}
	else if (currentLink.ToUpper().Equals(Lang.transaction.ToUpper()))
	{
		classTransaction = "class=active";
	}
	else
	{
		classTicketsCancelled = "class=active";
	}

	<ul class="menu report-winloss">
        <li @classWinloss><a href="~/Reports/MatchEntered">@Lang.lblWinLoss</a></li>
        <li @classOutstanding><a href="~/reports/outstanding">@Lang.outstanding</a></li>
        <li @classTransaction><a href="~/_betList/BetListTransaction.aspx?type=transaction">@Lang.transaction</a></li>
        <li @classTicketsCancelled><a href="~/betList/ticketcancel?fromDate=2013-6-20&toDate=2013-7-1">@Lang.TicketsCancelled</a></li>
    </ul>
}