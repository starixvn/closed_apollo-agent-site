    {
    <text>@string.Format("{0:#,##0.00}", value)</text>
}
@helper Navigation(List<Apollo.Age.Entities.Agent> Model)
    {
    <div class="boxNavigation">
        <ul>
            @foreach (Apollo.Age.Entities.Agent item in Model)
            {
                var last = Model.LastOrDefault();
                if (last != null && !last.Equals(item))
                {
                <li><a href="javascript:void(0);" class="navigation" data-agentlevel="@item.Level" data-agentid="@item.Id">@item.Username</a>
                </li>
                }
                else
                {
                <li class="currentUser"><span>@item.Username</span> </li>
                }
            }
        </ul>
    </div>
}
@helper Navigation(List<Apollo.Age.Entities.Agent> Model, bool linkLastItem)
    {
        if (linkLastItem)
        {
    <div class="boxNavigation">
        <ul>
            @foreach (Apollo.Age.Entities.Agent item in Model)
            {
                var last = Model.LastOrDefault();
                if (last != null && !last.Equals(item))
                {
                <li><a href="javascript:void(0);" class="navigation" data-agentlevel="@item.Level" data-agentid="@item.Id">@item.Username</a>
                </li>
                }
                else
                {
                <li class="currentUser"><a href="javascript:void(0);" class="navigation" data-agentlevel="@item.Level" data-agentid="@item.Id">@item.Username</a>
                </li>
                }
            }
        </ul>
    </div>
        }
        else
        {
            RazorHelper.Navigation(Model);
        }
}
@helper RenderMainShareHolderDropDownList(int currentMainShareHolderId, IEnumerable<Apollo.Age.Entities.Agent> mainShareHolders, bool hasDownlineDetailsPermission = true)
    {
    <div id="main-shareholder-box" class="box-header">
        <div class="row">
            <div class="cell">
                @{
                    if (mainShareHolders != null && mainShareHolders.Any())
                    {
                    <div class="label">
                        <label for="ddlLeague">@Apollo.Age.Resources.Lang.lblMainShareHolder&nbsp:</label>
                    </div>
                    <div class="editor">
                        <select id='ddlMainShareHolder' name='ddlMainShareHolder'>
                            @{
                        var selectedString = string.Empty;
                        foreach (var mainShareHolder in mainShareHolders)
                        {
                            if (mainShareHolder.Id == currentMainShareHolderId)
                            {
                                selectedString = "selected='selected'";
                            }
                            else
                            {
                                selectedString = string.Empty;
                            }

                            var username = !hasDownlineDetailsPermission ? mainShareHolder.Username.EncryptUsername() : mainShareHolder.Username;
                            
                                <option value="@mainShareHolder.Id" @(selectedString) >@username</option>
                        }
                            }
                        </select>
                    </div>
                    }
                }
            </div>
        </div>
    </div>
}
