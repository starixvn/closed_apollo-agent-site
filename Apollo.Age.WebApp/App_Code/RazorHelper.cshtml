@helper FormatNegativeNumber(decimal value, byte numDecimals = 0, bool showZero = false)
    {
        if (value != 0 || showZero)
        {
            if (Math.Round(value, numDecimals) < 0 || (numDecimals == 0 && value < 0))
            {
    <span class="red-num">@Formater.DecFormat(value, numDecimals)</span>
            }
            else
            {
    @Formater.DecFormat(value, numDecimals)
            }
        }
}
@helper FormatPositiveNumber(decimal value, byte numDecimals = 0, bool showZero = false)
    {
        if (value != 0 || showZero)
        {
            if (Math.Round(value, numDecimals) > 0 || (numDecimals == 0 && value > 0))
            {
    <span class="red-num">@Formater.DecFormat(value, numDecimals)</span>
            }
            else
            {
    @Formater.DecFormat(value, numDecimals)
            }
        }
}
@helper FormatPositiveNumber(decimal? value, byte numDecimals = 0, bool showZero = false)
    {
        if (value != null && (value.Value != 0 || showZero))
        {
            if (Math.Round(value.Value, numDecimals) > 0 || (numDecimals == 0 && value > 0))
            {
    <span class="red-num">@Formater.DecFormat(value.Value, numDecimals)</span>
            }
            else
            {
    @Formater.DecFormat(value, numDecimals)
            }
        }
}
@helper FormatNumber(decimal value, byte numDecimals = 0, bool showZero = false)
    {
        if (value != 0 || showZero)
        {
    @Formater.DecFormat(value, numDecimals)
        }
}
@helper FormatComm(decimal value)
    {
    <text>@string.Format("{0:#,##0.00}", value)</text>
}
@helper Navigation(List<Apollo.Age.Entities.Agent> Model)
    {
    <div class="boxNavigation">
        <ul id="divnavigation">
            @foreach (Apollo.Age.Entities.Agent item in Model)
            {
                var last = Model.LastOrDefault();
                if (last != null && !last.Equals(item))
                {
                <li><a href="javascript:void(0);" name="navigation" class="navigation" agentlevel="@item.Level" agentid="@item.Id">@item.Username</a>
                </li>
                }
                else
                {
                <li class="currentUser"><span>@item.Username</span> </li>
                }
            }
        </ul>
    </div>
}
@helper Navigation(List<Apollo.Age.Entities.Agent> Model, bool linkLastItem)
    {
        if (linkLastItem)
        {
    <div class="boxNavigation">
        <ul id="divnavigation">
            @foreach (Apollo.Age.Entities.Agent item in Model)
            {
                var last = Model.LastOrDefault();
                if (last != null && !last.Equals(item))
                {
                <li><a href="javascript:void(0);" name="navigation" class="navigation" agentlevel="@item.Level" agentid="@item.Id">@item.Username</a>
                </li>
                }
                else
                {
                <li class="currentUser"><a href="javascript:void(0);" name="navigation" class="navigation" agentlevel="@item.Level" agentid="@item.Id">@item.Username</a>
                </li>
                }
            }
        </ul>
    </div>
        }
        else
        {
            RazorHelper.Navigation(Model);
        }
}
@helper RenderMainShareHolderDropDownList(int currentMainShareHolderId, IEnumerable<Apollo.Age.Entities.Agent> mainShareHolders)
    {
    <div id="main-shareholder-box" class="box-header">
        <div class="row">
            <div class="cell">
                @{
                    if (mainShareHolders != null && mainShareHolders.Any())
                    {
                    <div class="label">
                        <label for="ddlLeague">@Apollo.Age.Resources.Lang.lblMainShareHolder</label>
                    </div>
                    <div class="editor">
                        <select id='ddlMainShareHolder' name='ddlMainShareHolder' style="width: 280px">
                            @{
                        var selectedString = string.Empty;
                        foreach (var mainShareHolder in mainShareHolders)
                        {
                            if (mainShareHolder.Id == currentMainShareHolderId)
                            {
                                selectedString = "selected='selected'";
                            }
                            else
                            {
                                selectedString = string.Empty;
                            }
                                <option value="@mainShareHolder.Id" @(selectedString) >@mainShareHolder.Username</option>
                        }
                            }
                        </select>
                    </div>
                    }
                }
            </div>
        </div>
    </div>
}
