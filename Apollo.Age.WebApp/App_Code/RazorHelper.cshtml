@helper RefreshCountDown(string refreshCountDownId,
    int[] timerArray,
    string onRefresh = "location.reload()")
    {
    <div id="refreshCountDownId" refresh-id=@(refreshCountDownId) class="btnCountDown">
        @Apollo.Age.Resources.Lang.Flesh:
        <select>
            <option value="0">@Apollo.Age.Resources.Lang.Inactive</option>
            @for (int i = 0; i < timerArray.Length; i++)
            {
                <option value="@timerArray[i]">@timerArray[i] @Apollo.Age.Resources.Lang.sec</option>
            }
        </select>
        <input type="hidden" id="apo-on-refresh" value="@onRefresh" />
    </div>
}
