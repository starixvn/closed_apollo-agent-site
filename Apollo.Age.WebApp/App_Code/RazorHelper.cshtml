@helper RefreshCountDown(string refreshCountDownId,
    List<int> timerArray = null,
    string onRefresh = "location.reload()",
        bool isShowRefreshNow = false
    )
    {

    <div id="refreshCountDownId" refresh-id="@(refreshCountDownId)" class="btnCountDown refresh">
        <span>@Apollo.Age.Resources.Lang.Flesh:</span>
        <div id="ddlCountDown" class="btnCountDown clearfix">
            <div id="countdownrefresh" class="btnRefresh" title="@Apollo.Age.Resources.Lang.Flesh">
            </div>
            <div class="btnDown" id="btndown">
            </div>
        </div>
        <ul id="countdownmenu" class="panelDown">
            <li data-intervaltime="0" class="menuitem">@Apollo.Age.Resources.Lang.Inactive</li>
            @for (var i = 15; i <= 75; i += 15)
            {
                <li data-intervaltime="@i.ToString()" class="menuitem">
                    @(i.ToString())
                    @Apollo.Age.Resources.Lang.sec
                </li>
            }
            <li data-intervaltime="180" class="menuitem">180 @Apollo.Age.Resources.Lang.sec</li>
        </ul>
        @if (isShowRefreshNow)
        {
            <span class="refresh" id="btnrefresh"></span>
        }
