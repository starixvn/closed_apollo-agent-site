@helper RenderMenu(string controller, string groupBetName, bool isEarlyMarket)
    {
        var resMgr = new ResourceManager(typeof(Apollo.Age.Resources.Lang));
        var xDocument = WagerMenusConfiguration.MenuConfig;
        var xWagers = xDocument.Descendants("Wagers");
    <ul id="menu-child" class="menu">
        @foreach (var itemWager in xWagers)
        {
            var xSport = itemWager.Descendants("Sport");

            foreach (var itemSport in xSport)
            {
                string currentController = itemSport.Attribute("Controller").Value;

                if (string.Compare(currentController, controller, true) == 0)
                {
                    var xBettype = itemSport.Descendants("BetType");
                    foreach (var itemBettype in xBettype)
                    {
                        string tempAction = itemBettype.Attribute("Action").Value;
                        string resourceKey = itemBettype.Attribute("ResourceKey").Value;

                        // Remove Running Ball submenu in Early Market
                        if (isEarlyMarket && tempAction.ToLower() == "runningball")
                        {
                            continue;
                        }
                        if (string.Compare(groupBetName, tempAction, true) == 0)
                        {
            <li class="active"><a href="#">@resMgr.GetString(resourceKey)</a> </li>                           
                        }
                        else
                        {
            <li><a href="~/wagers/wager?sportName=@controller&amp;groupBetName=@tempAction&amp;resourceKey=@resourceKey&amp;isEM=@(isEarlyMarket ? "true" : "false")" target="main">@resMgr.GetString(resourceKey)</a>
            </li>                           
                        }
                    }

                    break;
                }

            }
        }
    </ul>
}
@helper RenderFilter(string title, List<League> leagues, List<Agent> mainShareHolders, int isShowViewOption)
    {
    <div id="header_main">@title</div>
    <div class="box-header" id="main-shareholder-box">
        <div class="row">
            <div class="cell" style="@(isShowViewOption == 0 || isShowViewOption == 2 ? string.Empty : "display:none")">
                <div class="label">
                    <label>
                        @if (isShowViewOption == 0)
                        {
                            @Lang.lblMainShareHolder
                        }
                        else
                        {
                            @Lang.view
                        }
                        :
                    </label>
                </div>
                <div class="editor">
                    <select id="ViewOption" class="za_select">
                        @if (isShowViewOption == 0)
                        {
                            foreach (var mainShareHolder in mainShareHolders)
                            {
                            <option value="@mainShareHolder.Id">@mainShareHolder.Username</option>
                            }
                        }
                        else
                        {
                            <option value="0">@Lang.lblallmembers</option>
                            <option value="-1">@Lang.DirectMembers</option>
                        }
                    </select>
                </div>
            </div>
            <div class="cell league-el">
                <div class="label">
                    <label>
                        @Lang.lblWagerLeague&nbsp;:</label>
                </div>
                <div class="editor">
                    <select id="League" class="za_select league">
                        <option value="0">@Lang.all</option>
                        @if (!ReferenceEquals(leagues, null)
                            && leagues.Any())
                        {
                            foreach (var item in leagues)
                            {
                            <option value="@item.Id">@item.Name</option>
                            }
                        }
                    </select>
                </div>
            </div>
        </div>
    </div>
}
@helper RenderBaseColumns(WagerViewModel item, string draw = "")
    {
        var showTime = item.ShowTime;
        showTime = string.IsNullOrEmpty(showTime) ? string.Empty : showTime.Replace("</font>", "<#font>").Replace('/', '-').Replace("<#font>", "</font><br/>").TrimEnd('M');
        var format = new HtmlString(showTime.Length > 12 ? showTime : showTime.Replace(" ", "<br/>"));
    <td class="width-40 show-time">
        @format
        @*@if (item.LiveIndicator)
        {
            <span class="red-num">@Lang.RunningBall</span>
        }*@
    </td>
    <td class="l" style="min-width: 300px">
        @item.LeagueName
    </td>
    <td class="l nowrap">
        @item.HomeName
        <br />
        @item.AwayName
        <br />
        <span class="pull-right text-green">
            @draw
        </span>
    </td>
}
@helper RederHeaderColumn(params string[] columnNames)
    {
    <thead>
        <tr class="RptHeader">
            <th style="width: 90px;">
                @Lang.TimeGMT8
            </th>
            <th>
                @Lang.league
            </th>
            <th class="nowrap">
                @Lang.lblhomeandguest
            </th>
            @foreach (string columnName in columnNames)
            {     
                <th class="nowrap">
                    @columnName
                </th>            
            }
        </tr>
    </thead>
}
@helper RenderBody(WagerViewModel item, Func<dynamic, HelperResult> template)
    {
    <tbody>
    </tbody>
}
@helper RenderBetTypeData(List<SpecialViewModel> list, int currentBettype)
    {         
        var groupBet = list.Where(m => m.Bettype == currentBettype).OrderBy(m => m.Type).ToList();

        if (!ReferenceEquals(groupBet, null) && groupBet.Any())
        {
            var firstModel = groupBet.FirstOrDefault();    
    @RenderColumnData(firstModel.BetTeam, (int)groupBet.Sum(m => m.Count), groupBet.Sum(m => m.Stake), firstModel.LiveIndicator, firstModel.LeagueId, firstModel.MatchId)    
        }
        else
        {
    <span>0/0</span>                   
        } 
}
@helper RenderColumn(SpecialViewModel item)
    {
        if (item != null)
        {    
    @RenderColumnData(item.BetTeam, (int)item.Count, item.Stake, item.LiveIndicator, item.LeagueId, item.MatchId)
        }
        else
        { 
    <br />
        }
@*
    Type : 
        + 0 : All
        + 1 : Home
        + 2 : Away
        + 3 : Draw
*@
}
@helper RenderColumnData(string betTeams, int betCount, decimal stake, bool isLive, int leagueId, int matchId)
    {    
        if (betCount != 0
            && stake != 0)
        { 
    <a href="#" class="red wager-link" data-betTeams="@betTeams" data-live="@isLive" data-league="@leagueId" data-match="@matchId">@betCount/@Math.Round(stake)</a>   
        }
        else
        {
    <span>@betCount/@Math.Round(stake)</span>
        }        
}