@using Apollo.Age.Resources
@using Apollo.Age.Core
@using Apollo.Age.Services
@using Apollo.Age.Wagers.Configuration
@using System.Xml.Linq
@using Apollo.Age.Web
@using System.Resources
@using Apollo.Age.Wagers.ViewModels
@using Apollo.Age.Web.Mvc
@helper RenderMenu(string controller, string groupBetName)
    {
        var resMgr = new ResourceManager(typeof(Apollo.Age.Resources.Lang));
        var xDocument = WagerMenusConfiguration.MenuConfig;
        var xWagers = xDocument.Descendants("Wagers");
    <ul class="menu">
        @foreach (var itemWager in xWagers)
        {
            var xSport = itemWager.Descendants("Sport");

            foreach (var itemSport in xSport)
            {
                string currentController = itemSport.Attribute("Controller").Value;

                if (string.Compare(currentController, controller, true) == 0)
                {
                    var xBettype = itemSport.Descendants("BetType");
                    foreach (var itemBettype in xBettype)
                    {
                        string tempAction = itemBettype.Attribute("Action").Value;
                        string resourceKey = itemBettype.Attribute("ResourceKey").Value;
						
            <li class="@(string.Compare(groupBetName, tempAction, true) == 0 ? "active" : string.Empty)">
                <a href="~/wagers/wager?sportName=@controller&groupBetName=@tempAction&resourceKey=@resourceKey" target="main">@resMgr.GetString(resourceKey)</a>
            </li>                           
                    }

                    break;
                }

            }
        }
    </ul>
}
@helper RenderFilter(string title, List<League> leagues)
    {
    <div id="header_main">@title</div>
    <div class="box-header" id="main-shareholder-box">
        <div class="row">
            <div class="cell">
                <div class="label">
                    <label for="ddlLeague">
                        @Lang.view&nbsp;:</label>
                </div>
                <div class="editor">
                    <select id="ViewOption" class="za_select">
                        <option value="false">@Lang.all</option>
                        <option value="true">@Lang.DirectMembers</option>
                    </select>
                </div>
            </div>
            <div class="cell">
                <div class="label">
                    <label for="ddlLeague">
                        @Lang.league&nbsp;:</label>
                </div>
                <div class="editor">
                    <select id="League" class="za_select">
                        <option value="0">@Lang.all</option>
                        @if (!ReferenceEquals(leagues, null)
                            && leagues.Any())
                        {
                            foreach (var item in leagues)
                            {
                            <option value="@item.Id">@CacheRef.GetLeagueName(item.Id)</option>
                            }
                        }
                    </select>
                </div>
            </div>
        </div>
    </div>
}
@helper RenderBaseColumns(WagerViewModel item, string draw = "")
    {
        var showTime = item.ShowTime;
        var format = new HtmlString(string.IsNullOrEmpty(showTime) ? string.Empty : showTime.Replace("</font>", "<#font>").Replace('/', '-').Replace("<#font>", "</font>").TrimEnd('M'));
    <td class="width-40 show-time">
        @format
        @if (item.LiveIndicator)
        {
            <span class="red-num">@Lang.RunningBall</span>
        }
    </td>
    <td class="l">
        @item.LeagueName
    </td>
    <td class="l">
        @item.HomeName
        <br />
        @item.AwayName
        <br />
        <span class="r text-green">
            @draw
        </span>
    </td>
}
@helper RederHeaderColumn(params string[] columnNames)
    {
    <thead>
        <tr class="RptHeader">
            <th style="width: 40px;">
                @Lang.time
            </th>
            <th>
                @Lang.league
            </th>
            <th class="nowrap">
                @Lang.lblhomeandguest
            </th>
            @foreach (string columnName in columnNames)
            {     
                <th class="nowrap">
                    @columnName
                </th>            
            }
        </tr>
    </thead>
}
@helper RenderBody(WagerViewModel item, Func<dynamic, HelperResult> template)
    {
     <tbody>    
    </tbody>
}