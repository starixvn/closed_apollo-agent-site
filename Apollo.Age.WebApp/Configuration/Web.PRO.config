<configuration>
  <configSections>
    <section name="dotless" type="dotless.Core.configuration.DotlessConfigurationSectionHandler, dotless.Core" />
    <section name="Fanex.Data.DbSettingProvider" type="Fanex.Data.Configuration.DbSettingProviderConfigurationSection, Fanex.Data" />
    <section name="Fanex.Logging" type="Fanex.Logging.Configuration.LoggingSettings, Fanex.Logging" />
    <section name="Apollo.Age.OAuthSettings" type="Apollo.Age.Integration.Configurations.OAuthSettings, Apollo.Age.Integration" />
    <section name="Apollo.Age.ApoURLs" type="Apollo.Age.Web.ApoURLs, Apollo.Age.Web" />
    <sectionGroup name="bundleTransformer">
      <section name="core" type="BundleTransformer.Core.Configuration.CoreSettings, BundleTransformer.Core" />
      <section name="less" type="BundleTransformer.Less.Configuration.LessSettings, BundleTransformer.Less" />
    </sectionGroup>
  </configSections>
  <Fanex.Data.DbSettingProvider default="XmlDbSettingProvider">
    <providers>
      <add name="XmlDbSettingProvider" type="Fanex.Data.Configuration.XmlDbSettingProvider, Fanex.Data" resourcePath="~/App_Data/pro/SpNames.xml" enableWatching="1" ignoreExceptionIsNotParameters="1" />
    </providers>
  </Fanex.Data.DbSettingProvider>
  <Fanex.Logging msmqPath="FormatName:DIRECT=TCP:10.103.181.1\private$\entlib" defaultCategory="Agent" />
  <Apollo.Age.OAuthSettings AppId="sHPBLIbUTtlePZn8" AppSecret="F9Ua2UVXkpx7oK4LqnmNoOkrbPe4e82e" AuthorizeUrl="https://oauth01.sunapi.net/" TokenUrl="https://oauth01.sunapi.net/oauth/token" DefaultUrl="~/" RedirectUri="https://www.sunsport66.net/oauth/getcode" TgpScriptSrc="https://oauth01.sunapi.net/Scripts/tgp.js" />
  <Apollo.Age.ApoURLs AccessDenied="~/AccessDenied" AccountStopped="~/AccountStopped" Error="~/Error" InternalSignIn="~/Internal/SignIn" Unauthorized="~/Unauthorized" UnderMaintenance="~/UnderMaintenance" RedirectToUM="~/RedirectToUM" />
  <connectionStrings configSource="Web.ConnectionString.config" />
  <appSettings file="Web.AppSettings.config">
    <add key="webpages:Version" value="2.0.0.0" />
    <add key="webpages:Enabled" value="false" />
    <add key="PreserveLoginUrl" value="true" />
    <add key="ClientValidationEnabled" value="true" />
    <add key="UnobtrusiveJavaScriptEnabled" value="true" />
  </appSettings>
  <system.web>
    <machineKey decryption="Auto" decryptionKey="D75AE97D107DE7F3652E67CF1F60717EE08DA87960F394D8,IsolateApps" validation="SHA1" validationKey="EDE6E4D1E3C3B36298DBC2447640A6767D242C7BE140025F7D43BC23045EEC39050D3E3C4A70E02C659E3CA6880CDD37695235F0D687E49356145EA3E6062953,IsolateApps" />
    <httpRuntime executionTimeout="600" maxRequestLength="2000000000" maxUrlLength="200" maxQueryStringLength="2097151" requestValidationMode="2.0" requestPathInvalidCharacters="" />
    <compilation targetFramework="4.0" debug="false" />
    <authentication mode="Forms">
      <forms loginUrl="~/Unauthorized" path="/" defaultUrl="~/" cookieless="UseCookies" name=".AGENTFORMSAUTH" protection="All" />
    </authentication>
    <authorization>
      <deny users="?" />
      <allow users="*" />
    </authorization>
    <customErrors mode="RemoteOnly" defaultRedirect="~/Error" />
    <sessionState mode="StateServer" stateConnectionString="tcpip=10.40.41.112:42424" timeout="720" cookieless="false" />
    <globalization fileEncoding="utf-8" requestEncoding="utf-8" responseEncoding="utf-8" uiCulture="auto" culture="auto" />
    <pages validateRequest="false" controlRenderingCompatibilityVersion="4.0" clientIDMode="AutoID">
      <namespaces>
        <add namespace="System.Web.Helpers" />
        <add namespace="System.Web.Mvc" />
        <add namespace="System.Web.Mvc.Ajax" />
        <add namespace="System.Web.Mvc.Html" />
        <add namespace="System.Web.Routing" />
        <add namespace="System.Web.WebPages" />
        <add namespace="Apollo.Age" />
        <add namespace="Apollo.Age.Resources" />
      </namespaces>
    </pages>
    <httpHandlers>
      <add path="*.less" verb="GET" type="dotless.Core.LessCssHttpHandler, dotless.Core" />
    </httpHandlers>
  </system.web>
  <location path="assets">
