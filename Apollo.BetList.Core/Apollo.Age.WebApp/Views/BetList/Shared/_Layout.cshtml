<!DOCTYPE html>
<html lang="en-us">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <title>@ViewBag.Title</title>
    <script src="~/_globalresources/js/head.min.js" type="text/javascript"></script>
    <link href="~/_globalresources/css/jquery-ui-1.10.2/apollo/jquery-ui.min.css" rel="stylesheet"
        type="text/css" />
    <link href="~/views/betlist/resources/betList.less" rel="stylesheet" type="text/css" />
    @RenderSection("css", required: false)
</head>
<body>
    @RenderBody()
    @Html.Hidden("ApoRoot", Url.Content("~/"))
    @Html.Partial("_ApoRes")
    @Scripts.Render("~/scripts/betlist")
    @RenderSection("scripts", required: false)
</body>
</html>