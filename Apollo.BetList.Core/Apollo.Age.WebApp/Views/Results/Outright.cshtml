@using Apollo.Age.Reports.Models
@using Apollo.Age.Reports.Core
@model IEnumerable<OutrightResultModel>

<table class="tblRpt outright">
    <thead>
        <tr class="RptHeader">
            <td style="width: 100px" columnname="kickofftime">
                @Apollo.Age.Resources.Lang.time
            </td>
            <td style="width: 300px">
                @Apollo.Age.Resources.Lang.league
            </td>
           
            <td class="nowrap" style="width: 200px;">
                @Apollo.Age.Resources.Lang.lblTeam 
            </td>
            <td class="nowrap" style="width: 100px;">
                @Apollo.Age.Resources.Lang.lblWinLoss 
            </td>
        </tr>
    </thead>
    <tbody>
        @if (Model != null && Model.Any())
        {           

            foreach (var item in Model)
            {

            <tr class="c">
                <td>
                    @RazorHelper.RenderDatetimeFormated2line(item.EventDate)
                </td>
                <td class="l">
                 @item.LeagueName
                </td>
              
                <td class="l">
                    @item.TeamName
                </td>
                <td>
                    @item.Status
                </td>
            </tr>

            }
        }
        else
        {
            @RazorHelper.ShowNoInfo(colspan: 5);
        }
    </tbody>
</table>