@using Apollo.Age.Reports.Models;
@using Apollo.Age.Reports.ViewModels;
@using Apollo.Age.Entities;
@using Apollo.Age.Resources;
@{
    Layout = "~/Views/Reports/Shared/_Layout.cshtml";
    ViewBag.Title = Apollo.Age.Resources.Lang.lblMatchResult;
}
@model MatchResultViewModel
@section css {
    <link href="~/views/results/resources/results.less" rel="stylesheet" type="text/css" />
    <link href="~/_GlobalResources/Js/Pager/jquery.sbpager.less" rel="stylesheet" type="text/css" />
}
<div id="function-bar">
    <ul class="menu">
        <li><a href="#" id="filterbydate" value="@Formater.FormatShortDateNoZeroLeading(DateTime.Now)" action="0">@Lang.yesterday</a></li>
        <li>@Lang.Game:</li>
        @RazorHelper.RenderResultBySport()
    </ul>
    <ul class="pager" style="display: none">
        <li>@Lang.Page:</li>
        <li>
            <div id="pager" class="sbpager">
            </div>
        </li>
    </ul>
    <img src="~/_GlobalResources/Images/top_04.gif" alt="" />
    <input type="hidden" name="todayValue" id="todayValue" value="@Formater.FormatShortDateNoZeroLeading(DateTime.Now)"/>
    <input type="hidden" name="yesterdayValue" id="yesterdayValue" value="@Formater.FormatShortDateNoZeroLeading(DateTime.Now.AddDays(-1))"/>
    <input type="hidden" name="lbltoday" id="lbltoday" value="@Lang.today"/>
    <input type="hidden" name="lblyesterday" id="lblyesterday" value="@Lang.yesterday"/>
</div>
@using (Html.BeginForm())
{
    <div id="filterResult" class="box-header">
        <div class="row">
            <div class="cell" id="filterResultGame">
                <div class="label">
                    <label for="ddlSport">@Lang.Game:</label>
                </div>
                <div class="editor">
                    @Html.DropDownList("ddlSport", new List<SelectListItem> { new SelectListItem { Text = string.Empty, Value = "0" } },
                new { @class="selSport" })
                </div>
            </div>
            <div class="cell" id="filterResultLeague">
                <div class="label">
                    <label for="ddlLeague">@Lang.league:</label>
                </div>
                <div class="editor">
                    @Html.DropDownList("ddlLeague",
                new List<SelectListItem> { new SelectListItem { Text = string.Empty, Value = "0" } },
                new { @class = "selLeague" })
                </div>
            </div>
        </div>
    </div>
    <div id="resultContainer" class="clear">
    </div>
}
@section scripts
{
    <script src="~/_GlobalResources/Js/Pager/jquery.sbpager.js" type="text/javascript"></script>
    <script src="~/views/results/resources/Result.js" type="text/javascript"></script>
}
