@using Apollo.Age.Reports.ViewModels
@using Apollo.Age.Entities

@{
    ViewBag.Title = Apollo.Age.Resources.Lang.agentwinloss;
    Layout = "~/Views/Reports/Shared/_LayoutWinloss.cshtml";
}
@model MatchEnteredViewModel
<div id="function-bar">
    <div class="item">
        <label for="ddlSport">@Apollo.Age.Resources.Lang.lblReport:</label>
        @RazorHelper.RenderSportDropDownList(Model.SportList, currentSportId: "0")
    </div>
    @RazorHelper.RenderReportLinks(Apollo.Age.Resources.Lang.lblWinLoss)
    <img alt="" src="~/_GlobalResources/Images/top_04.gif">
</div>
<div id="box_header" class="report">
    <table class="winloss">
        <tr>
            <td class="winloss_firstcolumn">
                @Apollo.Age.Resources.Lang.dateRange:
            </td>
            <td colspan="4">
                <div class="row">
                    <div class="cell">
                        <div class="editor">
                            @Html.DatePicker("FromDate", DateTime.Now, minDate: DateTime.Now.AddYears(-20), maxDate: DateTime.Now.AddYears(20))
                        </div>
                    </div>
                    <div class="cell">
                        <div class="label">
                            <label for="dateFrom">
                                ~
                            </label>
                        </div>
                        <div class="editor">
                            @Html.DatePicker("ToDate", DateTime.Now, minDate: DateTime.Now.AddYears(-20), maxDate: DateTime.Now.AddYears(20))
                        </div>
                    </div>
                    <div class="cell">
                        <input class="btn dateRange" range="1" type="button" value="@Apollo.Age.Resources.Lang.today" />
                        <input  class="btn dateRange" range="2" type="button" value="@Apollo.Age.Resources.Lang.yesterday" />
                        <input  class="btn dateRange" range="3" type="button" value="@Apollo.Age.Resources.Lang.tomorrow" />
                        <input  class="btn dateRange" range="4" type="button" value="@Apollo.Age.Resources.Lang.thisWeek" />
                        <input class="btn dateRange" range="5" type="button" value="@Apollo.Age.Resources.Lang.lastWeek" />
                    </div>
                </div>
            </td>
        </tr>
        <tr>
            <td class="winloss_firstcolumn">
                @Apollo.Age.Resources.Lang.WagerType:
            </td>
            <td colspan="4">
                @RazorHelper.RenderBettypeDropDownList(Model.BettypeList, currentBettypeId: "0")
            </td>
        </tr>
        <tr>
            <td class="winloss_firstcolumn">
                @Apollo.Age.Resources.Lang.date:
            </td>
            <td colspan="2" class="winloss_date">
                @Formater.ShortDateFormat(DateTime.Now.AddDays(-1))
                @if (Model.CheckIsCompleted(isToday: false))
                {
                    <span class="winloss_complete">
                        @Apollo.Age.Resources.Lang.Complete
                    </span>
                }
                else
                {
                    <span class="winloss_incomplete">
                        @Apollo.Age.Resources.Lang.InComplete
                    </span>
                }
            </td>
            <td colspan="2" class="winloss_date">
                @Formater.ShortDateFormat(DateTime.Now)
                @if (Model.CheckIsCompleted(isToday: true))
                {
                    <span class="winloss_complete">
                        @Apollo.Age.Resources.Lang.Complete
                    </span>
                }
                else
                {
                    <span class="winloss_incomplete">
                        @Apollo.Age.Resources.Lang.InComplete
                    </span>
                }
            </td>
        </tr>
        <tr>
            <td class="winloss_firstcolumn">
                @Apollo.Age.Resources.Lang.result:
            </td>
            <td class="winloss_yesterday">
                @Apollo.Age.Resources.Lang.entered
            </td>
            <td class="winloss_yesterday">
                @Apollo.Age.Resources.Lang.nonentered
            </td>
            <td>
                @Apollo.Age.Resources.Lang.entered
            </td>
            <td>
                @Apollo.Age.Resources.Lang.nonentered
            </td>
        </tr>
        @if (Model.matchEnteredModelList != null && Model.matchEnteredModelList.Any() && Model.matchEnteredModelList.Count == 7)
        {
            <tr>
                <td class="winloss_firstcolumn">
                    @Apollo.Age.Resources.Lang.soccer:
                </td>
                @if (Model.matchEnteredModelList[0] != null)
                {
                    <td class="winloss_yesterday">@Model.matchEnteredModelList[0].YesterdayEntered
                    </td>
                    <td class="winloss_yesterday">@Model.matchEnteredModelList[0].YesterdayNonEntered
                    </td>
                    <td>@Model.matchEnteredModelList[0].TodayEntered
                    </td>
                    <td>@Model.matchEnteredModelList[0].TodayNonEntered
                    </td>
                }
                else
                {
                    <td>
                    </td>
                    <td>
                    </td>
                    <td>
                    </td>
                    <td>
                    </td>
                }
            </tr>
            <tr>
                <td class="winloss_firstcolumn">
                    @Apollo.Age.Resources.Lang.BK:
                </td>
                @if (Model.matchEnteredModelList[1] != null)
                {
                    <td class="winloss_yesterday">@Model.matchEnteredModelList[1].YesterdayEntered
                    </td>
                    <td class="winloss_yesterday">@Model.matchEnteredModelList[1].YesterdayNonEntered
                    </td>
                    <td>@Model.matchEnteredModelList[1].TodayEntered
                    </td>
                    <td>@Model.matchEnteredModelList[1].TodayNonEntered
                    </td>
                }
                else
                {
                    <td>
                    </td>
                    <td>
                    </td>
                    <td>
                    </td>
                    <td>
                    </td>
                }
            </tr>
            <tr>
                <td class="winloss_firstcolumn">
                    @Apollo.Age.Resources.Lang.Tennis:
                </td>
                @if (Model.matchEnteredModelList[2] != null)
                {
                    <td class="winloss_yesterday">@Model.matchEnteredModelList[2].YesterdayEntered
                    </td>
                    <td class="winloss_yesterday">@Model.matchEnteredModelList[2].YesterdayNonEntered
                    </td>
                    <td>@Model.matchEnteredModelList[2].TodayEntered
                    </td>
                    <td>@Model.matchEnteredModelList[2].TodayNonEntered
                    </td>
                }
                else
                {
                    <td>
                    </td>
                    <td>
                    </td>
                    <td>
                    </td>
                    <td>
                    </td>
                }
            </tr>
            <tr>
                <td class="winloss_firstcolumn">
                    @Apollo.Age.Resources.Lang.Volleyball:
                </td>
                @if (Model.matchEnteredModelList[3] != null)
                {
                    <td class="winloss_yesterday">@Model.matchEnteredModelList[3].YesterdayEntered
                    </td>
                    <td class="winloss_yesterday">@Model.matchEnteredModelList[3].YesterdayNonEntered
                    </td>
                    <td>@Model.matchEnteredModelList[3].TodayEntered
                    </td>
                    <td>@Model.matchEnteredModelList[3].TodayNonEntered
                    </td>
                }
                else
                {
                    <td>
                    </td>
                    <td>
                    </td>
                    <td>
                    </td>
                    <td>
                    </td>
                }
            </tr>
            <tr>
                <td class="winloss_firstcolumn">
                    @Apollo.Age.Resources.Lang.Baseball:
                </td>
                @if (Model.matchEnteredModelList[4] != null)
                {
                    <td class="winloss_yesterday">@Model.matchEnteredModelList[4].YesterdayEntered
                    </td>
                    <td class="winloss_yesterday">@Model.matchEnteredModelList[4].YesterdayNonEntered
                    </td>
                    <td>@Model.matchEnteredModelList[4].TodayEntered
                    </td>
                    <td>@Model.matchEnteredModelList[4].TodayNonEntered
                    </td>
                }
                else
                {
                    <td>
                    </td>
                    <td>
                    </td>
                    <td>
                    </td>
                    <td>
                    </td>
                }
            </tr>
            <tr>
                <td class="winloss_firstcolumn">
                    @Apollo.Age.Resources.Lang.lblOutRight:
                </td>
                @if (Model.matchEnteredModelList[5] != null)
                {
                    <td class="winloss_yesterday">@Model.matchEnteredModelList[5].YesterdayEntered
                    </td>
                    <td class="winloss_yesterday">@Model.matchEnteredModelList[5].YesterdayNonEntered
                    </td>
                    <td>@Model.matchEnteredModelList[5].TodayEntered
                    </td>
                    <td>@Model.matchEnteredModelList[5].TodayNonEntered
                    </td>
                }
                else
                {
                    <td>
                    </td>
                    <td>
                    </td>
                    <td>
                    </td>
                    <td>
                    </td>
                }
            </tr>
            <tr>
                <td class="winloss_firstcolumn">
                    @Apollo.Age.Resources.Lang.InterEvent:
                </td>
                @if (Model.matchEnteredModelList[6] != null)
                {
                    <td class="winloss_yesterday">@Model.matchEnteredModelList[6].YesterdayEntered
                    </td>
                    <td class="winloss_yesterday">@Model.matchEnteredModelList[6].YesterdayNonEntered
                    </td>
                    <td>@Model.matchEnteredModelList[6].TodayEntered
                    </td>
                    <td>@Model.matchEnteredModelList[6].TodayNonEntered
                    </td>
                }
                else
                {
                    <td>
                    </td>
                    <td>
                    </td>
                    <td>
                    </td>
                    <td>
                    </td>
                }
            </tr>
        }
        else
        {
            <tr>
                <td class="winloss_firstcolumn">
                    @Apollo.Age.Resources.Lang.soccer:
                </td>
                <td>
                </td>
                <td>
                </td>
                <td>
                </td>
                <td>
                </td>
            </tr>
            <tr>
                <td class="winloss_firstcolumn">
                    @Apollo.Age.Resources.Lang.BK:
                </td>
                <td>
                </td>
                <td>
                </td>
                <td>
                </td>
                <td>
                </td>
            </tr>
            <tr>
                <td class="winloss_firstcolumn">
                    @Apollo.Age.Resources.Lang.Tennis:
                </td>
                <td>
                </td>
                <td>
                </td>
                <td>
                </td>
                <td>
                </td>
            </tr>
            <tr>
                <td class="winloss_firstcolumn">
                    @Apollo.Age.Resources.Lang.Volleyball:
                </td>
                <td>
                </td>
                <td>
                </td>
                <td>
                </td>
                <td>
                </td>
            </tr>
            <tr>
                <td class="winloss_firstcolumn">
                    @Apollo.Age.Resources.Lang.Baseball:
                </td>
                <td>
                </td>
                <td>
                </td>
                <td>
                </td>
                <td>
                </td>
            </tr>
            <tr>
                <td class="winloss_firstcolumn">
                    @Apollo.Age.Resources.Lang.lblOutRight:
                </td>
                <td>
                </td>
                <td>
                </td>
                <td>
                </td>
                <td>
                </td>
            </tr>
            <tr>
                <td class="winloss_firstcolumn">
                    @Apollo.Age.Resources.Lang.InterEvent:
                </td>
                <td>
                </td>
                <td>
                </td>
                <td>
                </td>
                <td>
                </td>
            </tr>
        }
    </table>
    <div>
        <div class="row bg-action">
            @*<div class="item">
                <span>@Apollo.Age.Resources.Lang.WagerState: </span>
                <select>
                    <option value="true">@Apollo.Age.Resources.Lang.lblResult</option>
                    <option value="false">@Apollo.Age.Resources.Lang.NonResult</option>
                </select>
            </div>*@
            <div class="item">
                @Apollo.Age.Resources.Lang.ArchivedDate: @(Model.BalanceUpDay != null ? Formater.ShortDateFormat(Model.BalanceUpDay) : "")
            </div>
            <div class="item btn-action">
                <input id="btnSubmit" class="btn" type="button" value="@Apollo.Age.Resources.Lang.search" />
                <input id="btnCancel" class="btn" type="button" value="@Apollo.Age.Resources.Lang.Cancel" />
            </div>
        </div>
    </div>
</div>
@Html.Hidden("balanceUpDay", Model.BalanceUpDay != null ? Formater.ShortDateFormat(Model.BalanceUpDay) : Formater.ShortDateFormat(DateTime.Now))
@Html.Hidden("today", Formater.ShortDateFormat(DateTime.Now))
@Html.Hidden("yesterday", Formater.ShortDateFormat(DateTime.Now.AddDays(-1)))
@Html.Hidden("tomorrow", Formater.ShortDateFormat(DateTime.Now.AddDays(1)))
@Html.Hidden("thisWeekFrom", Formater.ShortDateFormat(DateTime.Now.StartOfWeek()))
@Html.Hidden("thisWeekTo", Formater.ShortDateFormat(DateTime.Now.EndOfWeek()))
@Html.Hidden("lastWeekFrom", Formater.ShortDateFormat(DateTime.Now.AddDays(-7).StartOfWeek()))
@Html.Hidden("lastWeekTo", Formater.ShortDateFormat(DateTime.Now.AddDays(-7).EndOfWeek()))
@Html.Action("Index", "Instruction", new
{
    key = "AgentWinLossPageInfo",
    trigger = string.Empty,
    title = Apollo.Age.Resources.Lang.AgentWinLossInstructions,
    tipTitle = Apollo.Age.Resources.Lang.ClickToViewInstructions
})
@section scripts
{
    <script type="text/javascript">
        var LANGUAGES = function () {
            return {
                MessageValidateDate: "@Apollo.Age.Resources.LangMsg.ValidateFromToDate",
                MessageValidateWithArchivedDate: "@Apollo.Age.Resources.LangMsg.MessageValidateWithArchivedDate"
            };
        } ();
    </script>
}
