<!DOCTYPE html>
<html lang="en-us">
<head>
	<meta charset="utf-8" />
	<meta name="viewport" content="width=device-width" />
	<title>@ViewBag.Title - Reports</title>
	<link href="~/_globalresources/css/jquery-ui-1.10.2/apollo/jquery-ui.min.css" rel="stylesheet" type="text/css" />
    @RenderSection("css", required: false)
	<link href="~/views/reports/resources/reports.less" rel="stylesheet" type="text/css" />	
</head>
<body>
	
	<div id="page_main">
		<div id="header_main">
			@ViewBag.Title
		</div>
		<div id="content_main">
			@RenderBody()
		</div>
	</div>
	@Html.Hidden("ApoRoot", Url.Content("~/"))
	@Html.Partial("_ApoRes")
	@Scripts.Render("~/scripts/winlossjs")
	@RenderSection("scripts", required: false)
</body>
</html>