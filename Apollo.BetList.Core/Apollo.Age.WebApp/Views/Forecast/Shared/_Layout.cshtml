@{
	var currentMainShareHolderId = ViewBag.CurrentMainShareHolderId ?? 0;
	var currentAgentId = ViewBag.CurrentAgentId;
	var mainShareHolders = (IEnumerable<Apollo.Age.Entities.Agent>)ViewBag.MainShareHolders;
}
<!DOCTYPE html>
<html lang="en-us">
<head>
	<meta charset="utf-8" />
	<meta name="viewport" content="width=device-width" />
	<title>@ViewBag.Title - Forecast</title>
	<link href="~/_globalresources/css/jquery-ui-1.10.2/apollo/jquery-ui.min.css" rel="stylesheet" type="text/css" />
	<link href="~/_globalresources/css/refreshcountdown.less" rel="stylesheet" type="text/css" />
	<link href="~/_globalresources/js/errormsg/errormsg.less" rel="stylesheet" type="text/css" />

	@RenderSection("css", required: false)
</head>
<body>
	
	<div id="page_main">
		<div id="header_main">
			<span id="leagueName">@ViewBag.Title</span>
		</div>
		<div id="content_main">
			@RenderSection("refreshcountdown", required: false)
			@if (currentAgentId == 0)
			{
				@RazorHelper.RenderMainShareHolderDropDownList(currentMainShareHolderId, mainShareHolders)
			}
			@RenderBody()
		</div>
	</div>
	@Html.Hidden("ApoRoot", Url.Content("~/"))
	@Html.Partial("_ApoRes")
	@Scripts.Render("~/scripts/forecastjs")
	
	<script type="text/javascript">
		var DEFAULT_LAYOUT = function(){
			return {
				currentMainShareHolderId: @(currentMainShareHolderId),
				currentActionLink: '@Url.Action(null)',
				betListString: '@Apollo.Age.Resources.Lang.lblBetLists.ToUpper()',
				forecastString: '@Apollo.Age.Resources.Lang.lblForecast.ToUpper()'
			};
		}();
	</script>
	@RenderSection("scripts", required: false)
</body>
</html>