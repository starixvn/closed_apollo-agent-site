@{
    Layout = "~/Views/Account/Shared/_LayoutTreeView.cshtml";
}
<ul id="treeview_list" class="tree-tab" agent-id="@ViewBag.AgentId">
</ul>

@section foot {
    <script src="~/_globalresources/js/core.js" type="text/javascript"></script>
    <script src="~/views/account/resources/downlineinfo.js" type="text/javascript"></script>
    <script type="text/javascript">
        $(document).ready(function () {
            var treeList = $("#treeview_list"),
                agentId = treeList.attr("agent-id"),
                appRoot = "@Url.Content("~/")";

            treeList.treeview({
                url: appRoot + "Account/GetDataByNode",
                link: "<a class='view-agentinfo' href='javascript:;'" + "agent-id='{0}' agent-name={1} target='menu'> {2} </a>",
                agentId: agentId,
                showRoot: false
            });

            DOWNLINE.initAgentdownline();
        });
    </script>
}