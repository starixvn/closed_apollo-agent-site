@using Apollo.Age.Account.ViewModels
@using Apollo.Age.Resources

@{
	ViewBag.Title = Lang.ViewCommission;
	Layout = "~/Views/Account/Shared/_ViewSettingLayout.cshtml";
	int index = 0;
}
@model ViewCommissionViewModel

@using (Html.BeginForm())
{
	<div id="box_header">
		<div class="row">
			<div class="cell">
				<div class="editor">
					@Html.DropDownListFor(m => m.IsMember, new List<SelectListItem>
					{
						new SelectListItem { Value = "false", Text = Lang.agent },
						new SelectListItem { Value = "true", Text = Lang.member }
					})
					@Html.TextBoxFor(m => m.Username, new { style = "width: 200px" })
					<input type="submit" id="btnSubmit" class="btn" value="@Lang.submit" />
				</div>
			</div>
		</div>
	</div>
}

<div class="view-detail-container">
	<div class="div-border">
		<table id="tableCommission" class="tb-cust-setting no-border-bottom">
			<thead>
				<tr>
					<th style="width:16%">
					</th>
					<th style="width:14%">@Lang.lblA
					</th>
					<th style="width:14%">@Lang.lblB
					</th>
					<th style="width:14%">@Lang.lblC
					</th>
					<th style="width:14%">@Lang.lblD
					</th>
					<th style="width:14%">@Lang.lbl1x2
                    </th>
					<th style="width:14%">@Lang.other
					</th>
				</tr>
			</thead>
			<tbody>
				@if (Model.CommissionList != null && Model.CommissionList.Any())
				{
					int lastIndex = Model.CommissionList.Count();

					foreach (var comm in Model.CommissionList)
					{
						string rowClass = index++ % 2 == 0 ? "class='alt'" : string.Empty;

					<tr @Html.Raw(rowClass)>
						<td class="first-cell l">@comm.Username</td>
						@if (index == lastIndex && Model.IsMember)
						{
							<td>
								@if (Model.Group.ToLower() == "a")
								{
									@Formater.DecFormat(comm.DiscountA * 100, 2)
								}
							</td>
							<td>
								@if (Model.Group.ToLower() == "b")
								{
									@Formater.DecFormat(comm.DiscountB * 100, 2)
								}
							</td>
							<td>
								@if (Model.Group.ToLower() == "c")
								{
									@Formater.DecFormat(comm.DiscountC * 100, 2)
								}
							</td>
							<td>
								@if (Model.Group.ToLower() == "d")
								{
									@Formater.DecFormat(comm.DiscountD * 100, 2)
								}
							</td>
						}
						else
						{
							<td>@Formater.DecFormat(comm.DiscountA * 100, 2)
							</td>
							<td>@Formater.DecFormat(comm.DiscountB * 100, 2)
							</td>
							<td>@Formater.DecFormat(comm.DiscountC * 100, 2)
							</td>
							<td>@Formater.DecFormat(comm.DiscountD * 100, 2)
							</td>
						}
						<td>@Formater.DecFormat(comm.Discount1x2 * 100, 2)
						</td>
						<td>@Formater.DecFormat(comm.DiscountOthers * 100, 2)
						</td>
					</tr>
					}
				}
				else
				{
					@RazorHelper.ShowNoInfo(7)
				}
			</tbody>
		</table>
	</div>
</div>

@section scripts
{
	@Scripts.Render("~/scripts/viewcommsettingjs")
}