<!DOCTYPE html>
<html lang="en-us">
<head>
    <title>@ViewBag.Title</title>
    <link href="~/_globalresources/css/jquery-ui-1.10.2/apollo/jquery-ui.min.css" rel="stylesheet"
        type="text/css" />
    <link href="~/views/account/resources/customerlist.less" rel="stylesheet" type="text/css" />
    @RenderSection("css", required: false)
</head>
<body>
    <div id="page_main">
        <div id="header_main">
            <div class="header-title">
                @ViewBag.HeaderTitle
                <span id="currUsername">@ViewBag.CurrentUsername</span>
            </div>
            <div class="edit-setting icon-pencil" username='@ViewBag.CurrentUsername' agentid='@ViewBag.CurrentAgentId' agentlevel='@ViewBag.CurrentAgentLevel' id="quickLinkEditSetting">
            </div>
        </div>
        <div id="content_main">
            @RenderBody()
            <ul id="menuedit" class="edit-menu">
                <li><a href="#" id="commission">@Apollo.Age.Resources.Lang.Commission (%)</a></li>
                <li><a href="#" id="betsetting">@Apollo.Age.Resources.Lang.lblBetSetting</a></li>
                <li><a href="#" id="sharesetting">@Apollo.Age.Resources.Lang.lblShareSetting</a></li>
            </ul>
        </div>
    </div>
    @Html.Hidden("ApoRoot", Url.Content("~/"))
    @Html.Partial("_ApoRes")
    <script type="text/javascript">
        var BASELANGUAGES = function () {
            return {
                EnterUsername: "@Apollo.Age.Resources.Lang.enterusername"
            };
        } ();
    </script>
    @Scripts.Render("~/scripts/accountlistjs")
    @RenderSection("scripts", required: false)
</body>
</html>
