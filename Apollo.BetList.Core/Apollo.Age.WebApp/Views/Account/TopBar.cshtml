@model ICurrentSession
@using Apollo.Age.Resources
@using Apollo.Age.Wagers.Core
@{
    Layout = null;
}
<!DOCTYPE html>
<html>
<head>
    <title>Header</title>
    <script src="~/_GlobalResources/Js/head.js" type="text/javascript"></script>
    <link href="~/_globalresources/css/agent.less" rel="stylesheet" type="text/css" />
    <link href="~/views/account/resources/header.less" rel="stylesheet" type="text/css" />
</head>
<body>
    @if (Model != null)
    {
        <div id="news_main">
            <div class="login-bg clearfix">
                @{ string sso = Model.IsInternalSignIn ? string.Empty : "sso"; }
                <div class="left @sso">
                </div>
                <div class="right">
                    @if (Model.IsInternalSignIn)
                    {
                        <div class="login-info clearfix">
                            <div class="username">@Lang.lblLogin--@Model.Username<span> (@Model.AdminName)</span></div>
                            <ul class="link">
                                <li><a href="javascript:;" id="contact-us">@Lang.lblContactUs</a></li>
                                <li>|<a id="signout" class="logout" href="#">@Lang.SignOut</a></li>
                            </ul>
                        </div>
                    }
                    <div class="toolbar @sso">
                        <ul>
                            <li><span class="menu-list border-link">[@Lang.lblWager]</span>
                                <ul class="sub-menu">
                                    <li><a href="~/wagers/wager?sportname=@WagersSportName.Soccer" target="main">@Lang.lblSC</a></li>
                                    <li><a href="~/wagers/wager?sportname=@WagersSportName.Basketball" target="main">@Lang.lblBkNflRugby</a></li>
                                    <li><a href="~/wagers/wager?sportname=@WagersSportName.Tennis" target="main">@Lang.lblTN</a></li>
                                    <li><a href="~/wagers/wager?sportname=@WagersSportName.Volleyball" target="main">@Lang.lblVbBdmTt</a></li>
                                    <li><a href="~/wagers/wager?sportname=@WagersSportName.Baseball" target="main">@Lang.lblBs</a></li>
                                    <li><a href="~/wagers/wager?sportname=@WagersSportName.Others" target="main">@Lang.other</a></li>
                                </ul>
                            </li>
                            <li><span class="menu-list border-link">[@Lang.lblEmWager]</span>
                                <ul class="sub-menu">
                                    <li><a  href="~/wagers/wager?sportname=@(WagersSportName.Soccer)&isEM=true" target="main">@Lang.lblScEm</a></li>
                                    <li><a href="~/wagers/wager?sportname=@(WagersSportName.Basketball)&isEM=true" target="main">@Lang.lblBkNflRugbyEm</a></li>
                                    <li><a href="~/wagers/wager?sportname=@(WagersSportName.Tennis)&isEM=true" target="main">@Lang.lblTnEm</a></li>
                                    <li><a href="~/wagers/wager?sportname=@(WagersSportName.Volleyball)&isEM=true" target="main">@Lang.lblVbBdmTtEm</a></li>
                                    <li><a href="~/wagers/wager?sportname=@(WagersSportName.Baseball)&isEM=true" target="main">@Lang.lblBsEm</a></li>
                                    <li><a href="~/wagers/wager?sportname=@(WagersSportName.Others)&isEM=true" target="main">@Lang.lblOtherEm</a></li>
                                </ul>
                            </li>
                            <li><span class="menu-list border-link"><a href="~/totalBets" target="main">[@Lang.lblForecast]</a></span></li>
                            <li>
                            <span class="menu-list border-link">[@Lang.lblOutRight]</span>
                                <ul class="sub-menu">
                                    <li><a href="~/wagers/wager?sportname=@WagersSportName.Soccer&isOR=true" target="main">@Lang.lblSC</a></li>
                                    <li><a href="~/wagers/wager?sportname=@WagersSportName.Basketball&isOR=true" target="main">@Lang.lblBkNflRugby</a></li>
                                    <li><a href="~/wagers/wager?sportname=@WagersSportName.Tennis&isOR=true" target="main">@Lang.lblTN</a></li>
                                    <li><a href="~/wagers/wager?sportname=@WagersSportName.Volleyball&isOR=true" target="main">@Lang.lblVbBdmTt</a></li>
                                    <li><a href="~/wagers/wager?sportname=@WagersSportName.Baseball&isOR=true" target="main">@Lang.lblBs</a></li>
                                    <li><a href="~/wagers/wager?sportname=@WagersSportName.Others&isOR=true" target="main">@Lang.InterEvent</a></li>
                                </ul>
                            </li>                            
                            <li id="account-link"><span class="menu-list border-link">[@Lang.lblAccounts]</span>
                                <ul class="sub-menu">
                                    @*@if (!Model.IsSuper)
                                    { 
                                        <li><a href="~/CustomerSetting/MySetting" target="main">@Lang.Agency</a></li>
                                    }*@
                                    <li><a href="~/Account/AgentList" target="main">@Lang.Agents</a></li>
                                    @if (Model.AgentLevel > AgentLevel.Shareholder)
                                    {
                                        <li><a href="~/Account/MemberList" target="main">@Lang.Members</a></li>
                                    }
                                    <li><a href="~/CustomerSetting/AgentShare" target="main">@Lang.Share</a></li>
                                    <li><a href="~/CustomerSetting/ViewCommission" target="main">@Lang.lblComm</a></li>
                                </ul>
                            </li>
                            <li><a href="~/Reports/matchentered" target="main" class="txtRed">[@Lang.lblReport]</a></li>
                            <li id="result-link"><a href="~/results/match" target="main" class="txtRed">[@Lang.lblResult]</a></li>
                            <li><a href="~/hiddentool/index" target="main" class="txtRed">[@Lang.lblHiddenUrlTool]</a></li>
                            <li id="message-link"><a href="~/message/newmessage" target="main" class="txtRed">[@Lang.announcement]</a></li>
                        </ul>
                    </div>
                </div>
            </div>
            @Html.Hidden("IsAllowMultipleSignIn", @Apollo.Age.Configurations.AppSettings.AllowMultipleSignIn.ToString().ToLower())
            @*<div id="text_news_out">
				<div id="text_news" onclick="Change2Menu('Message/NewMessage?PageQuery=normal', this)">
					<div id="scroller" class="news-scroller">
						<a id="topnews" href="javascript:;"></a>
					</div>
				</div>
				<span id="button_top" class="icon-envelope" onclick="Change2Menu('Message/NewMessage?PageQuery=private', this)">
					<a id="privateMsgLnk">&nbsp;&nbsp;(0)</a> </span><a class="home-page" href="~/Message/Portal"
						target="main"><span class="icon-home icon-white"></span></a>
			</div>*@
        </div>
        <input type="hidden" id="ApoRoot" value="@Url.Content("~/")" />
        <input type="hidden" id="ctime" value="@DateTime.Now.AddHours(12).ToString("H-m-s-tt")" />
        <input type="hidden" id="cdate" value="@DateTime.Now.AddHours(12).ToString("MMM dd,yyyy 'GMT'+8")" />
        <script src="~/_globalresources/js/jquery.js" type="text/javascript"></script>		
        <script src="~/_globalresources/js/core.js" type="text/javascript"></script>	 
        <script src="~/views/account/resources/header.js" type="text/javascript"></script>
        <script type="text/javascript">
			 var DEFAULTS = {
				 IsInternalLogin: @Model.IsInternalSignIn.ToString().ToLower(),
				 IsAllowMultipleSignIn: @Apollo.Age.Configurations.AppSettings.AllowMultipleSignIn.ToString().ToLower(),
				 IsMaster: @Model.IsSuper.ToString().ToLower()	 
			 };
			 var LANGUAGES = {
				AlerSignonMessage : "@Apollo.Age.Resources.Lang.stringSessionLogged"
			 };
        </script>
    }
</body>
</html>
