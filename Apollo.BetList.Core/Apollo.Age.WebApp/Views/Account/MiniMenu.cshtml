@using System.Resources
@using Apollo.Age.Enumerations
@{
	Layout = null;
	var menu = ViewBag.RootNode;
}
<ul class="tab-menu-icon">
	<li class="main-menu"><i class="icon-align-justify" title="@Apollo.Age.Resources.Lang.mainmenu"></i>
		<ul class="parent">
			@foreach (SiteMapNode item in menu.ChildNodes)
			{
				string activeClass = Convert.ToBoolean(item["active"]) ? "active" : string.Empty;

				if (item.HasChildNodes)
				{
					<li><a>@Html.Resource(item.Title)</a>
						<ul>
						@foreach (SiteMapNode subItem in item.ChildNodes)
						{
							var isAgentOnly = Convert.ToBoolean(subItem["isAgentOnly"]);

							if (Model.AgentLevel < AgentLevel.MainAgent && isAgentOnly)
							{
								continue;
							}

							int bettypeId = 0;
							string title = string.Empty;

							if (subItem.Title.Contains("bettype")
								&& Int32.TryParse(subItem.Title.Substring(7), out bettypeId)) // get from RemotingRef
							{
								title = Apollo.Age.Services.CacheRef.GetBettype(bettypeId);
							}
							else
							{
								title = Html.Resource(subItem.Title);
							}
							<li>
								<a href="@subItem.Url" target="main">@title</a>
							</li>
						}
						</ul>
					</li>
				}
				else
				{
					<li><a class="">@Html.Resource(item.Title)</a></li>
				}
			}
		</ul>
	</li>
	<li class="account"><i class="icon-user" title="@Apollo.Age.Resources.Lang.userinfo"></i></li>
	<li class="search"><i class="icon-search" title="@Apollo.Age.Resources.Lang.search"></i></li>
</ul>