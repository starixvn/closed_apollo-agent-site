@using Apollo.Age.Integration.Configurations;
@model Apollo.Age.Integration.Models.AuthModel
@{
	Layout = null;
	string log = ViewBag.Log != null ? ViewBag.Log as string : string.Empty;
}
<!DOCTYPE html>
<html>
<head>
	<title></title>
</head>
<body>
	<script type="text/javascript">
		window.onload = function () {
			@if (Model != null && Model.IsValid)
			{
				// SSO succeeded
				@:var url = '@Url.Content(OAuthSettings.Settings.DefaultUrl)';
			}
			else
			{
				@:var url = '@Url.Content("~/OAuth/Error?error_code=" + Model.ErrorCode)';
			}

			parent.location.href = url;
		};
	</script>
</body>
</html>