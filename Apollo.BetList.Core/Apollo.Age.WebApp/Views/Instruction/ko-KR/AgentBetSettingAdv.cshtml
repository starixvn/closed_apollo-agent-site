@{
	Layout = "~/Views/Instruction/Shared/_Layout.cshtml";
}
<div class="instruction-content">
	<p>
		Min Bet, Max Bet and Max Per Match for each product (Sport type) are defined here.<br />
		<img src="~/Views/Account/Resources/CustSettingEngine/Images/copyUnChecked.png" alt="" />
		this icon is used to copy the values set for Bet Setting of Soccer and apply them
		to other sports
	</p>
	<ul>
		<li>Min Bet: the minimum stake allowed on a bet. ">= X" means Input must be greater than X</li>
		<li>Max Bet: the maximum stake allowed on a bet. "<= X" means Input must be less than X</li>
		<li>Max Per Match: the maximum stake allowed on a match. "<= X" means Input must be less than X</li>
	</ul>
	<p>
		<span class="note">Note:</span> decimal numbers are not allowed. For instance, 100.25 is an invalid input.
	</p>
</div>