@{
	Layout = "~/Views/Instruction/Shared/_Layout.cshtml";
}

<div class="instruction-content">
	<p>
		<img src="~/Views/Account/Resources/CustSettingEngine/Images/copyUnChecked.png" alt="" />
		this icon is used to copy the values set for Share Setting of Soccer - Dead Ball/Handicap and apply them to other sports/bet types
	</p>
	<ul>
		<li>Max Given Share (%): the maximum share amount which can be given to a main shareholder.</li>
		<li>Min Given Sare (%): the minimum share amount which a main shareholder and its down-line agents must cover.</li>
        <li>[x - y]: input range. If K is the entered amount, then K must be: x <= K <= y.</li>
	</ul>
	<p>
		<span class="note">Note:</span> only allow two numbers after the decimal point. For instance, 80.25 is a valid input, but 80.555 is not.
	</p>
</div>