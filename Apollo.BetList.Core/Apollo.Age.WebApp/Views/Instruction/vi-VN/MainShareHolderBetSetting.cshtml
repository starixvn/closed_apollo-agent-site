@{
	Layout = "~/Views/Instruction/Shared/_Layout.cshtml";
}
<div class="instruction-content">
	<p>
		Min Bet, Max Bet and Max Per Match for each product (Sport type) are defined here. In Simple mode, settings applied to Soccer will be applied to other products as well.
	</p>
	<ul>
		<li>Min Bet: the minimum stake allowed on a bet.</li>
		<li>Max Bet: the maximum stake allowed on a bet.</li>
		<li>Max Per Match: the maximum stake allowed on a match.</li>
	</ul>
	<p>
		<span class="note">Note:</span> decimal numbers are not allowed. For instance, 100.25 is an invalid input.
	</p>
</div>