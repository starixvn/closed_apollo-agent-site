@{
	Layout = "~/Views/Instruction/Shared/_Layout.cshtml";
}
<div class="instruction-content">
	<p>
		Single Game, Single Bet and Min Single Bet for each product (Sport type) are defined here. In Simple mode, settings applied to Soccer will be applied to other products as well.
	</p>
	<ul>
        <li>Single Game: the maximum stake allowed on a match.</li>
        <li>Single Bet: the maximum stake allowed on a bet.</li>
		<li>Min Single Bet: the minimum stake allowed on a bet.</li>
	</ul>
	<p>
		<span class="note">Note1:</span> decimal numbers are not allowed. For instance, 100.25 is an invalid input.
	</p>
</div>