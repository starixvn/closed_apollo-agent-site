@using Apollo.Age.Enumerations
@using Apollo.Age.Account.Models
@using Apollo.Age.Resources
@using Fanex.CustSetting.Core
@{    
    var template = _Configuration.PositionTakingGridConfig;
    var agentLevel = (int)ViewBag.AgentLevel;
    var isAgent = (bool)ViewBag.IsAgent;
    var list = (Dictionary<string, PositionTakingModel>)Model;   
}
@if (!ReferenceEquals(list, null) && list.Any())
{
    var itemMixSport = new PositionTakingModel();
    var xmlSportType = template.Descendants("SportType");
    var count = 0;
    
    <table class="tblRpt">
        @foreach (var itemSportType in xmlSportType)
        {
            var sportId = itemSportType.Attribute("id").Value;
            var isLive = itemSportType.Attribute("isLive").Value;
            var resoureKey = itemSportType.Attribute("resourcekey").Value;
            <tr class="sub-title">
                <td colspan="6">
                    @if (sportId == ((int)SportTypes.Soccer).ToString())
                    {
                        var strLive = isLive == "true" ? Lang.lblLive : Lang.lblDeadball;            
                  
                        @GetResource(resoureKey, " " + strLive)                    
                    }
                    else
                    {
                        @GetResource(resoureKey)                
                    }
                </td>
            </tr>   
                    var xmlBetGroup = itemSportType.Descendants("BetTypeGroup");

                    foreach (var itemBetGroup in xmlBetGroup)
                    {
                        var xmlBetType = itemBetGroup.Descendants("BetType");
            <tr>
                <td class="colW1">
                </td>
                @foreach (var itemBet in xmlBetType)
                {
                    var noborder = count == 4 ? "no-border-right" : string.Empty;
                    var betId = itemBet.Attribute("id").Value;
                    var betResourceKey = itemBet.Attribute("resourcekey").Value;                   
                    <td class="colW1 @noborder">
                        @GetResource(betResourceKey)
                    </td>                            
                    count++;
                }
                @GenerateEmptyColumn(count, "colW1")
                @{
                count = 0;
                }
            </tr>
                if (isAgent)
                {
            <tr>
                <td class="colW">
                    @Lang.lblMaxGivenShare
                </td>
                @foreach (var itemBet in xmlBetType)
                {
                    var noborder = count == 4 ? "no-border-right" : string.Empty;
                    var betId = itemBet.Attribute("id").Value;
                    string key = string.Format("{0}_{1}_{2}", sportId, betId, isLive);
                    var model = list.ContainsKey(key) ? list[key] : null;
                    
                    <td class="colW2 @noborder">
                        @if (!ReferenceEquals(model, null))
                        { 
                            @ToString(model.OldMaxGiven, model.MaxGiven)
                        }
                    </td>                            
                        count++;
                }
                @GenerateEmptyColumn(count)
                @{
                count = 0;
                }
            </tr>
                }

                if (agentLevel != 1)
                { 

            <tr>
                <td class="colW">
                    @if (isAgent)
                    { 
                        @Lang.lblMaxTakenShare
                    }
                    else
                    {
                        <span>%</span>
                    }
                </td>
                @foreach (var itemBet in xmlBetType)
                {
                    var noborder = count == 4 ? "no-border-right" : string.Empty;
                    var betId = itemBet.Attribute("id").Value;
                    string key = string.Format("{0}_{1}_{2}", sportId, betId, isLive);
                    var model = list.ContainsKey(key) ? list[key] : null;           
                    <td class="colW2 @noborder">
                        @if (!ReferenceEquals(model, null))
                        {
                            @ToString(model.OldMaxUpper, model.MaxUpper)
                        }
                    </td>                            
                        count++;
                }
                @GenerateEmptyColumn(count)
                @{
                count = 0;
                }
            </tr>
                }
                if (isAgent)
                { 

            <tr>
                <td class="colW">
                    @Lang.lblMinGivenShare
                </td>
                @foreach (var itemBet in xmlBetType)
                {
                    var noborder = count == 4 ? "no-border-right" : string.Empty;
                    var betId = itemBet.Attribute("id").Value;
                    string key = string.Format("{0}_{1}_{2}", sportId, betId, isLive);
                    var model = list.ContainsKey(key) ? list[key] : null;           
                    <td class="colW2 @noborder">
                        @if (!ReferenceEquals(model, null))
                        {
                            @ToString(model.OldMinGiven, model.MinGiven)
                        }
                    </td>                            
                        count++;
                }
                @GenerateEmptyColumn(count)
                @{
                count = 0;
                }
            </tr>
                }
                    }
        }
    </table>
}
@helper ToString(decimal oldValue, decimal newValue)
    {
        string strOld = Math.Round(oldValue / 100).ToString();
        string strNew = Math.Round(newValue / 100).ToString();

        if (oldValue != newValue)
        { <span class="valuechanged" title="@Lang.OldValue : @strOld">@strNew</span> 
                     
    <span>| </span><span class="valueold">@strOld</span>
           
        }
        else
        { <span class="valueold">@strOld</span>
        }            
}
@helper GetResource(string key, string isLive = "")
    {
        string str = Html.Resource(key);    
    @str @isLive    
}
@helper GenerateEmptyColumn(int count, string className = "colW2")
    {
        if (count <= 4)
        {
            for (int i = count; i < 4; i++)
            {
    <td class="@className">
    </td>
            }
    <td class="@className no-border-right">
    </td>
        }
}