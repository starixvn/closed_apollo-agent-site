@using Apollo.Age.Enumerations
@using Apollo.Age.Account.Models
@using Apollo.Age.Resources
@model List<DiscountModel>
@if (!ReferenceEquals(Model, null) && Model.Any())
{
    var group = new DiscountModel();
    var group1x2 = new DiscountModel();
    var groupOthers = new DiscountModel();

    foreach (var item in Model)
    {
        switch (item.BetType)
        {
            case (int)BetTypes.Handicap:
                group = item;
                break;
            case (int)BetTypes.Correct_Score:
                groupOthers = item;
                break;
            case (int)BetTypes.FT_1X2:
                group1x2 = item;
                break;
        }
    }
    
    <table class="tblRpt">
        <tr class="no-border-top">
            <td class="colW">
                @Lang.lblGroupa (%)
            </td>
            <td class="colW2">
                @ToString(group.OldGroupA, group.GroupA)
            </td>
            <td class="colW3 left-text">
                @Lang.lblGroupc (%)
            </td>
            <td class="colW2">
                @ToString(group.OldGroupC, group.GroupC)
            </td>
            <td class="colW2 left-text">
                @Lang.lbl1x2Comm (%)
            </td>
            <td class="colW2 no-border-right">
                @ToString(group1x2.OldGroupA, group1x2.GroupA)
            </td>
        </tr>
        <tr class="have-border-bottom">
            <td class="colW3 left-text">
                @Lang.lblGroupb (%)
            </td>
            <td class="colW2">
                @ToString(group.OldGroupB, group.GroupB)
            </td>
            <td class="colW3 left-text">
                @Lang.lblGroupd (%)
            </td>
            <td class="colW2">
                @ToString(group.OldGroupD, group.GroupD)
            </td>
            <td class="colW2 left-text">
                @Lang.lblOtherComm (%)
            </td>
            <td class="colW2 no-border-right">
                @ToString(groupOthers.OldGroupA, groupOthers.GroupA)
            </td>
        </tr>
    </table>
}
@helper ToString(decimal oldValue, decimal newValue)
    {
        string strOld = Math.Round(oldValue * 100, 2).ToString();
        string strNew = Math.Round(newValue * 100, 2).ToString();

        if (oldValue != newValue)
        { 
    <span class="valuechanged" title="@Lang.OldValue : @strOld">@strNew</span>           
    <span>| </span><span class="valueold">@strOld</span>           
        }
        else
        { <span class="valueold">@strOld</span>
        }
}