@using Apollo.Age.TotalBets.Models
@{
    Layout = "~/Views/TotalBets/Shared/_Layout.cshtml";
    ViewBag.Title = Apollo.Age.Resources.Lang.numbergame;
}

@model IEnumerable<NumberGameModel>

@helper ShowLeague(int currentLeagueId, NumberGameModel item)
{
    if (currentLeagueId != item.LeagueId)
    { 
        <!--LeagueContents-->
        <tr class="league">
            <td colspan="18">
                @item.LeagueName
            </td>
        </tr>
    }            
}

@helper ShowMatch(int index, NumberGameModel item)
{
    var classRow = string.Empty;
    if (index % 2 == 0)
    {
        classRow = "class=alt";
    }

    <tr @classRow>
        <td class="c">
            @index
        </td>
        <td>
            @Apollo.Age.Resources.Lang.numbergameno  @item.MatchCode
        </td>
        <td>
            @if (item.BetCountWarrior2ndBall != 0)
            {
                <a class="fcnum view-bet-list-new-game" match-id="@item.MatchId" bet-type="88" betlist-type="BettypeMatch" is-live="0" bet-team="h" 
                    href="javascript:void(0);" title="@Apollo.Age.Resources.Lang.ViewBetList">
                    @RazorHelper.FormatNegativeNumber(item.Warrior2ndBall)
                </a>
            }
        </td>
        <td>
            @if (item.BetCountWarrior3rdBall != 0)
            {
                <a class="fcnum view-bet-list-new-game" match-id="@item.MatchId" bet-type="88" betlist-type="BettypeMatch" is-live="0" bet-team="a" 
                    href="javascript:void(0);" title="@Apollo.Age.Resources.Lang.ViewBetList">
                    @RazorHelper.FormatNegativeNumber(item.Warrior3rdBall)
                </a>
            }
        </td>
        <td>
            @if (item.BetCountOU1stBall != 0)
            {
                <a class="fcnum view-bet-list" match-id="@item.MatchId" bet-type="81" betlist-type="BettypeMatch" is-live="0" 
                    href="javascript:void(0);" title="@Apollo.Age.Resources.Lang.ViewBetList">
                    @RazorHelper.FormatNegativeNumber(item.Over1stBall - item.Under1stBall)
                </a>
            }
        </td>
        <td>
            @if (item.BetCountOE1stBall != 0)
            {
                <a class="fcnum view-bet-list" match-id="@item.MatchId" bet-type="83" betlist-type="BettypeMatch" is-live="0" 
                    href="javascript:void(0);" title="@Apollo.Age.Resources.Lang.ViewBetList">
                    @RazorHelper.FormatNegativeNumber(item.Odd_1stBall - item.Even1stBall)
                </a>
            }
        </td>
        <td>
            @if (item.BetCountOULastBall != 0)
            {
                <a class="fcnum view-bet-list" match-id="@item.MatchId" bet-type="82" betlist-type="BettypeMatch" is-live="0" 
                    href="javascript:void(0);" title="@Apollo.Age.Resources.Lang.ViewBetList">
                    @RazorHelper.FormatNegativeNumber(item.OverLastBall - item.UnderLastBall)
                </a>
            }
        </td>
        
        <td>
            @if (item.BetCountOELastBall != 0)
            {
                <a class="fcnum view-bet-list" match-id="@item.MatchId" bet-type="84" betlist-type="BettypeMatch" is-live="0" 
                    href="javascript:void(0);" title="@Apollo.Age.Resources.Lang.ViewBetList">
                    @RazorHelper.FormatNegativeNumber(item.OddLastBall - item.EvenLastBall)
                </a>
            }
        </td>
        
        <td>
            @if (item.BetCountOUNext != 0)
            {
                <a class="fcnum view-bet-list" match-id="@item.MatchId" bet-type="85" betlist-type="BettypeMatch" is-live="1" 
                    href="javascript:void(0);" title="@Apollo.Age.Resources.Lang.ViewBetList">
                    @RazorHelper.FormatNegativeNumber(item.OverNext - item.UnderNext)
                </a>
            }
        </td>
        <td>
            @if (item.BetCountOENext != 0)
            {
                <a class="fcnum view-bet-list" match-id="@item.MatchId" bet-type="86" betlist-type="BettypeMatch" is-live="1" 
                    href="javascript:void(0);" title="@Apollo.Age.Resources.Lang.ViewBetList">
                    @RazorHelper.FormatNegativeNumber(item.OddNext - item.EvenNext)
                </a>
            }
        </td>
        <td>
            @if (item.BetCountHighLow != 0)
            {
                <a class="fcnum view-bet-list" match-id="@item.MatchId" bet-type="87" betlist-type="BettypeMatch" is-live="1" 
                    href="javascript:void(0);" title="@Apollo.Age.Resources.Lang.ViewBetList">
                    @RazorHelper.FormatNegativeNumber(item.High - item.Low)
                </a>
            }
        </td>
        <td>
            @if (item.BetCountNextComboOverOdd != 0)
            {
                <a class="fcnum view-bet-list-new-game" match-id="@item.MatchId" bet-type="89" betlist-type="BettypeMatch" is-live="1" bet-team="1:1" 
                    href="javascript:void(0);" title="@Apollo.Age.Resources.Lang.ViewBetList">
                    @RazorHelper.FormatNegativeNumber(item.NextComboOverOdd)
                </a>
            }
        </td>
        <td>
            @if (item.BetCountNextComboUnderOdd != 0)
            {
                <a class="fcnum view-bet-list-new-game" match-id="@item.MatchId" bet-type="89" betlist-type="BettypeMatch" is-live="1" bet-team="2:1" 
                    href="javascript:void(0);" title="@Apollo.Age.Resources.Lang.ViewBetList">
                    @RazorHelper.FormatNegativeNumber(item.NextComboUnderOdd)
                </a>
            }
        </td>
        <td>
            @if (item.BetCountNextComboOverEven != 0)
            {
                <a class="fcnum view-bet-list-new-game" match-id="@item.MatchId" bet-type="89" betlist-type="BettypeMatch" is-live="1" bet-team="1:2" 
                    href="javascript:void(0);" title="@Apollo.Age.Resources.Lang.ViewBetList">
                    @RazorHelper.FormatNegativeNumber(item.NextComboOverEven)
                </a>
            }
        </td>
        
        <td>
            @if (item.BetCountNextComboUnderEven != 0)
            {
                <a class="fcnum view-bet-list-new-game" match-id="@item.MatchId" bet-type="89" betlist-type="BettypeMatch" is-live="1" bet-team="2:2" 
                    href="javascript:void(0);" title="@Apollo.Age.Resources.Lang.ViewBetList">
                    @RazorHelper.FormatNegativeNumber(item.NextComboUnderEven)
                </a>
            }
        </td>
        <td>
            @if (item.BetCountOEFullTime != 0)
            {
                <a class="fcnum view-bet-list" match-id="@item.MatchId" bet-type="86" betlist-type="BettypeMatch" is-live="0" 
                    href="javascript:void(0);" title="@Apollo.Age.Resources.Lang.ViewBetList">
                    @RazorHelper.FormatNegativeNumber(item.OddFullTime - item.EvenFullTime)
                </a>
            }
        </td>
        <td>
            @if (item.BetCountNumberGroupLive != 0)
            {
                <a class="fcnum view-bet-list" match-id="@item.MatchId" bet-type="90" betlist-type="BettypeMatch" is-live="1" 
                    href="javascript:void(0);" title="@Apollo.Age.Resources.Lang.ViewBetList">
                    @RazorHelper.FormatNegativeNumber(item.NumberGroupLive)
                </a>
            }
        </td>
        <td>
            @if (item.BetCountNumberGroupPre != 0)
            {
                <a class="fcnum view-bet-list" match-id="@item.MatchId" bet-type="90" betlist-type="BettypeMatch" is-live="0" 
                    href="javascript:void(0);" title="@Apollo.Age.Resources.Lang.ViewBetList">
                    @RazorHelper.FormatNegativeNumber(item.NumberGroupPre)
                </a>
            }
        </td>
    </tr>  
}


<table class="tblRpt persist-area c">
    <thead class="persist-header">
        <tr class="RptHeader">
            <td rowspan="2">
                #
            </td>
            <td rowspan="2">
                @Apollo.Age.Resources.Lang.events
            </td>
            <td colspan="2">
                @Apollo.Age.Resources.Lang.warrior
            </td>
            <td colspan="2">
                @Apollo.Age.Resources.Lang.lbl1stBall
            </td>
            <td colspan="2">
                @Apollo.Age.Resources.Lang.lastball
            </td>
            <td colspan="3">
                @Apollo.Age.Resources.Lang.nextBall
            </td>
            <td colspan="4">
                @Apollo.Age.Resources.Lang.nextcombo
            </td>
            <td rowspan="2" title="@Apollo.Age.Resources.Lang.lblFTOddEven">
                @Apollo.Age.Resources.Lang.lblFTOE
            </td>
            <td colspan="2">
                @Apollo.Age.Resources.Lang.numberGroup
            </td>
        </tr>
        <tr class="RptHeader02">
            <td>
                @Apollo.Age.Resources.Lang.warrior2ndBall
            </td>
            <td>
                @Apollo.Age.Resources.Lang.warrior3rdBall
            </td>
            <td title="@Apollo.Age.Resources.Lang.lblOverUnder">
                @Apollo.Age.Resources.Lang.lblOU
            </td>
            <td title="@Apollo.Age.Resources.Lang.lblOddEven">
                @Apollo.Age.Resources.Lang.lblOE
            </td>
            <td title="@Apollo.Age.Resources.Lang.lblOverUnder">
                @Apollo.Age.Resources.Lang.lblOU
            </td>
            <td title="@Apollo.Age.Resources.Lang.lblOddEven">
                @Apollo.Age.Resources.Lang.lblOE
            </td>                                        
            <td title="@Apollo.Age.Resources.Lang.lblOverUnder">
                @Apollo.Age.Resources.Lang.lblOU
            </td>
            <td title="@Apollo.Age.Resources.Lang.lblOddEven">
                @Apollo.Age.Resources.Lang.lblOE
            </td>
            <td>
                @Apollo.Age.Resources.Lang.highlow
            </td>
            <td title="@Apollo.Age.Resources.Lang.lblOverOdd">
                @Apollo.Age.Resources.Lang.lblOO
            </td>
            <td title="@Apollo.Age.Resources.Lang.lblUnderOdd">
                @Apollo.Age.Resources.Lang.lblUO
            </td>
            <td title="@Apollo.Age.Resources.Lang.lblOverEven">
                @Apollo.Age.Resources.Lang.lblOE
            </td>
            <td title="@Apollo.Age.Resources.Lang.lblUnderEven">
                @Apollo.Age.Resources.Lang.lblUE
            </td>         
            <td>
                @Apollo.Age.Resources.Lang.LiveGame
            </td>
            <td>
                @Apollo.Age.Resources.Lang.PreGame
            </td>  
        </tr>
    </thead>
    <tbody>
        @if (Model != null && Model.Any())
        {
            int rowIndex = 0;
            int currentLeagueId = 0;

            foreach (var item in Model)
            {
                rowIndex++;

                @ShowLeague(currentLeagueId, item)
                @ShowMatch(rowIndex, item)

                currentLeagueId = item.LeagueId;
            }
        }
        else
        {
            @RazorHelper.ShowNoInfo(colspan: 18)
        }
    </tbody>
</table>

@section scripts
{
    <script src="~/Views/TotalBets/Resources/TotalBets.js" type="text/javascript"></script>
    <script type="text/javascript">
        $(function () {
            TOTALBETS.initViewBetListGame();
            TOTALBETS.initViewBetListNewGame();            
        });
    </script>    
}