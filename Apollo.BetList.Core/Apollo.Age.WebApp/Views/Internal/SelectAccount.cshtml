@using Apollo.Age.Resources
@using Apollo.Age.Configurations
@model Apollo.Age.Web.ViewModels.SelectAccountViewModel
@{
	string title = Apollo.Age.Resources.Lang.SignInAsAgent;
	ViewBag.Title = title;
}

@section css {
	<link href="~/views/internal/resources/style.css" rel="stylesheet" type="text/css" />
}

<div class="login-box">
@using (Html.BeginForm())
{
	<h1>@title</h1>	
    @Html.AntiForgeryToken()
	@Html.HiddenFor(m => m.Language)
	@Html.HiddenFor(m => m.AdminId)
	@Html.HiddenFor(m => m.AdminName)
	<p class="username">
		@Html.LabelFor(m => m.Agent, Lang.agent)
		@Html.TextBoxFor(m => m.Agent, new { @class = "input-text", autocomplete = "off" })
	</p>	
    if (AppSettings.AllowInternalUpdate)
    {
	<p>
		@Html.LabelFor(m => m.AllowUpdate)
		@Html.CheckBoxFor(m => m.AllowUpdate)
	</p>
    }
    if (!ViewData.ModelState.IsValid)
    {
		@Html.ValidationSummary()
    }
	<p>
		<input type="submit" value="@Lang.Continue &rarr;" />
	</p>
}
</div>

@section scripts {
	<script type="text/javascript">
	    function preventBack() {
	        window.history.forward();
	    }

	    setTimeout("preventBack()", 0);

	    window.onunload = function () { null };

	    window.onload = function () {	    
	        document.getElementById('Agent').focus();
	    };

	</script>
}