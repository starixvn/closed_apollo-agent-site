@using Apollo.Age.Wagers.ViewModels
@using Apollo.Age.Web.Mvc
@using Apollo.Age.Wagers.ViewModels.Basketball
@helper RenderMenu(string controller, string groupBetName, bool isEM)
    {
        var resMgr = new ResourceManager(typeof(Apollo.Age.Resources.Lang));
        var xDocument = WagerMenusConfiguration.MenuConfig;
        var xWagers = xDocument.Descendants("Wagers");
    <ul class="menu">
        @foreach (var itemWager in xWagers)
        {
            var xSport = itemWager.Descendants("Sport");

            foreach (var itemSport in xSport)
            {
                string currentController = itemSport.Attribute("Controller").Value;

                if (string.Compare(currentController, controller, true) == 0)
                {
                    var xBettype = itemSport.Descendants("BetType");
                    foreach (var itemBettype in xBettype)
                    {
                        string tempAction = itemBettype.Attribute("Action").Value;
                        string resourceKey = itemBettype.Attribute("ResourceKey").Value;
						
            <li class="@(string.Compare(groupBetName, tempAction, true) == 0 ? "active" : string.Empty)">
                <a href="~/wagers/wager?sportName=@controller&groupBetName=@tempAction&resourceKey=@resourceKey&isEM=@(isEM ? "true" : "false")" target="main">@resMgr.GetString(resourceKey)</a>
            </li>                           
                    }

                    break;
                }

            }
        }
    </ul>
}
@helper RenderFilter(string title, List<League> leagues, List<Agent> mainShareHolders)
    {
    <div id="header_main">@title</div>
    <div class="box-header" id="main-shareholder-box">
        <div class="row">
            <div class="cell">
                <div class="label">
                    <label for="ddlLeague">
                        @Lang.view&nbsp;:</label>
                </div>
                <div class="editor">
                    <select id="ViewOption" class="za_select">
                        @if (mainShareHolders.Count() > 0)
                        {
                            foreach (var mainShareHolder in mainShareHolders)
                            {
                            <option value="@mainShareHolder.Id">@mainShareHolder.Username</option>
                            }
                        }
                        else
                        {
                            <option value="0">@Lang.all</option>
                            <option value="-1">@Lang.DirectMembers</option>
                        }
                    </select>
                </div>
            </div>
            <div class="cell league-el">
                <div class="label">
                    <label for="ddlLeague">
                        @Lang.league&nbsp;:</label>
                </div>
                <div class="editor">
                    <select id="League" class="za_select league">
                        <option value="0">@Lang.all</option>
                        @if (!ReferenceEquals(leagues, null)
                            && leagues.Any())
                        {
                            foreach (var item in leagues)
                            {
                            <option value="@item.Id">@CacheRef.GetLeagueName(item.Id)</option>
                            }
                        }
                    </select>
                </div>
            </div>
        </div>
    </div>
}
@helper RenderBaseColumns(WagerViewModel item, string draw = "")
    {
        var showTime = item.ShowTime;
        var format = new HtmlString(string.IsNullOrEmpty(showTime) ? string.Empty : showTime.Replace("</font>", "<#font>").Replace('/', '-').Replace("<#font>", "</font>").TrimEnd('M'));
    <td class="width-40 show-time">
        @format
        @*@if (item.LiveIndicator)
        {
            <span class="red-num">@Lang.RunningBall</span>
        }*@
    </td>
    <td class="l">
        @item.LeagueName
    </td>
    <td class="l" style="width: 200px">
        @item.HomeName
        <br />
        @item.AwayName
        <br />
        <span class="pull-right text-green">
            @draw
        </span>
    </td>
}
@helper RederHeaderColumn(params string[] columnNames)
    {
    <thead>
        <tr class="RptHeader">
            <th style="width: 40px;">
                @Lang.time
            </th>
            <th>
                @Lang.league
            </th>
            <th class="nowrap">
                @Lang.lblhomeandguest
            </th>
            @foreach (string columnName in columnNames)
            {     
                <th class="nowrap">
                    @columnName
                </th>            
            }
        </tr>
    </thead>
}
@helper RenderBody(WagerViewModel item, Func<dynamic, HelperResult> template)
    {
    <tbody>
    </tbody>
}
@helper RenderBetTypeData(List<SpecialViewModel> list, int currentBettype)
    {         
        var groupBet = list.Where(m => m.Bettype == currentBettype).OrderBy(m => m.Type).ToList();
        var typeAll = groupBet.Where(m => m.Type == 0).FirstOrDefault();

        if (typeAll != null)
        {
    <div>
        @RenderColumn(typeAll)
        <br />
        0/0
        <br />
        0/0
    </div>
        }
        else
        {
            var typeHome = groupBet.Where(m => m.Type == 1).FirstOrDefault();
            var typeAway = groupBet.Where(m => m.Type == 2).FirstOrDefault();
            var typeDraw = groupBet.Where(m => m.Type == 3).FirstOrDefault();
    @RenderColumn(typeHome)
    <br />
    @RenderColumn(typeAway)
    <br />
    @RenderColumn(typeDraw)
        }        
}
@helper RenderColumn(SpecialViewModel item)
    {
        if (item != null)
        {    
    @RenderColumnData(item.BetTeam, (int)item.Count, item.Stake, item.LiveIndicator)
        }
        else
        { 
    <span>0/0</span>
        }
@*
    Type : 
        + 0 : All
        + 1 : Home
        + 2 : Away
        + 3 : Draw
*@
}
@helper RenderColumnData(string betTeams, int betCount, decimal stake, bool isLive)
    {    
        if (betCount != 0
            && stake != 0)
        { 
    <a href="#" class="red wager-link" data-betTeams="@betTeams" data-live="@isLive">@betCount/@Math.Round(stake)</a>   
        }
        else
        {
    <span>@betCount/@Math.Round(stake)</span>
        }        
}