@using Apollo.Age.Resources
@using Apollo.Age.Entities
@using Apollo.Age.Wagers.ViewModels.Soccer
@using Apollo.Age.Web.Mvc
@model List<TotalViewModel>
<table class="tblRpt soccer total @((bool)ViewBag.IsEM ? "emw" : string.Empty)">
    @WagerHelper.RederHeaderColumn(Lang.lblfirsthalfOdd, Lang.lblfirsthalfOven, Lang.odds, Lang.events, Lang.lbl0_1, Lang.lbl2_3, Lang.lbl4_6, Lang.lbl7up)
    @Model.List(
        @<tr class="c">
            @WagerHelper.RenderBaseColumns(item)
            <td class="border-right r red-num">
                @WagerHelper.RenderColumnData(item.HomeBetteamHTOE, item.HomeCountHTOE, item.HomeStakeHTOE, item.LiveIndicator)
            </td>
            <td class="border-right r red-num">
                @WagerHelper.RenderColumnData(item.AwayBetteamHTOE, item.AwayCountHTOE, item.AwayStakeHTOE, item.LiveIndicator)
            </td>
            <td class="border-right r red-num">
                @WagerHelper.RenderColumnData(item.HomeBetteamOE, item.HomeCountOE, item.HomeStakeOE, item.LiveIndicator)
            </td>
            <td class="border-right r red-num">
                @WagerHelper.RenderColumnData(item.AwayBetteamOE, item.AwayCountOE, item.AwayStakeOE, item.LiveIndicator)
            </td>
            <td class="border-right r red-num">
                @WagerHelper.RenderColumnData(item.Total01Betteam, item.Total01Count, item.Total01Stake, item.LiveIndicator)
            </td>
            <td class="border-right r red-num">
                @WagerHelper.RenderColumnData(item.Total23Betteam, item.Total23Count, item.Total23Stake, item.LiveIndicator)
            </td>
            <td class="border-right r red-num">
                @WagerHelper.RenderColumnData(item.Total46Betteam, item.Total46Count, item.Total46Stake, item.LiveIndicator)
            </td>
            <td class="border-right r red-num">
                @WagerHelper.RenderColumnData(item.Total7OverBetteam, item.Total7OverCount, item.Total7OverStake, item.LiveIndicator)
            </td>
        </tr>
    )
</table>
@Html.Hidden("TotalItems", (int)ViewBag.TotalItems)
