    [SuppressMessage("Microsoft.StyleCop.CSharp.DocumentationRules", "SA1600:ElementsMustBeDocumented")]
    public class BaseController : Controller
    {
        public BaseController()
        {
            //CurrentSession.Language = "vi-VN"; // for testing only

            Thread.CurrentThread.CurrentUICulture = CultureInfo.CreateSpecificCulture(CurrentSession.Language);
        }

        protected override void OnActionExecuting(ActionExecutingContext filterContext)
        {
            bool skipAuthorization = filterContext.ActionDescriptor.IsDefined(typeof(AllowAnonymousAttribute), inherit: true)
                || filterContext.ActionDescriptor.ControllerDescriptor.IsDefined(typeof(AllowAnonymousAttribute), inherit: true);

            if (!skipAuthorization)
            {
                CheckAuthenticationRequest();
                CheckValidDownline();
                CheckKickOut(filterContext);
            }

            base.OnActionExecuting(filterContext);
        }

        #region Auth
        
        private void CheckAuthenticationRequest()
        {
            if (!Request.IsAuthenticated || CurrentSession == null)
            {
                // redirect user to a page with corresponding message
                // your session is timeout or the request is not authenticated

                if (Request.IsAjaxRequest())
                {
                    // this will redirect the request to SignIn action
                    Response.Clear();
                    Response.StatusCode = 401;
                    Response.StatusDescription = GetResourceData("UnauthorizedMsg");
                }
                else
                {
                    Response.Redirect("~/Auth/Unauthorized");
                }
            }
        }

        private void CheckValidDownline()
        {
        }

        private void CheckKickOut(ActionExecutingContext filterContext)
        {
            var isKickOut = PermissionService.IsKickOut(CurrentSession.AgentId, CurrentSession.UserId);

            if (isKickOut)
            {
                if (Request.IsAjaxRequest())
                {
                    Response.Buffer = true;
                    Response.Write(GetResourceData("lblAccountWasStopped"));
                    Response.Flush();
                    Response.Close();
                    Response.End();
                }
                else
                {
                    Response.Redirect("~/Auth/AccountStopped");
                }
            }
        }

        #endregion

        private void DoSignOut()
        {
            Response.Cookies.Clear();
            Session.Abandon();
            FormsAuthentication.SignOut();
        }

        protected ICurrentSession CurrentSession
        {
            get { return SessionManager.Instance.CurrentSession; }
        }

        protected string RequestIP
        {
            get
            {
                string IP = string.Empty;
                string userHostAddress = System.Web.HttpContext.Current.Request.UserHostAddress;

                foreach (IPAddress itemIPA in Dns.GetHostAddresses(userHostAddress))
                {
                    if (itemIPA.AddressFamily.ToString().Equals("InterNetwork"))
                    {
                        IP = itemIPA.ToString();
                        break;
                    }
                }

                if (!string.IsNullOrWhiteSpace(IP))
                {
                    return IP;
                }

                foreach (IPAddress itemIPA in Dns.GetHostAddresses(Dns.GetHostName()))
                {
                    if (itemIPA.AddressFamily.ToString().Equals("InterNetwork", StringComparison.OrdinalIgnoreCase))
                    {
                        IP = itemIPA.ToString();
                        break;
                    }
                }

                return IP.Trim();
            }
        }

        protected string GetResourceData(string key)
        {
            ResourceManager rm = new ResourceManager(typeof(Apollo.Age.Resources.Lang));
            rm.IgnoreCase = true;
            return rm.GetString(key);
        }
    }
}